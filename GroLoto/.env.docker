# Configuration pour Docker
APP_ENV=prod
APP_SECRET=ChangeThisSecretInProduction123!

# Base de données PostgreSQL (service db)
DATABASE_URL="postgresql://groloto:secret@db:5432/groloto"

# Variables PostgreSQL pour docker-compose
POSTGRES_DB=groloto
POSTGRES_USER=groloto
POSTGRES_PASSWORD=secret

# Mailer (via MailPit dans Docker)
MAILER_DSN=smtp://mailer:1025

# Email de contact
CONTACT_EMAIL=contact@groloto.local
