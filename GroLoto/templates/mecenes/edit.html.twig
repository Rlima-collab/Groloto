{% extends 'base.html.twig' %}

{% block title %}Modifier le mécène{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/modele.css') }}">
    <style>
        .edit-container {
            max-width: 800px;
            margin: 40px auto;
            padding: 0 20px;
        }

        .edit-card {
            background: white;
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            padding: 30px;
        }

        .edit-header {
            margin-bottom: 30px;
            padding-bottom: 20px;
            border-bottom: 2px solid #f0f0f0;
        }

        .edit-header h1 {
            color: #0d1b2a;
            font-size: 28px;
            margin-bottom: 10px;
        }

        .edit-header p {
            color: #666;
            margin: 0;
        }

        .form-section {
            margin-bottom: 30px;
        }

        .form-section h5 {
            color: #0d1b2a;
            font-size: 18px;
            margin-bottom: 20px;
            padding-bottom: 10px;
            border-bottom: 1px solid #e0e0e0;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            font-weight: 600;
            color: #333;
            margin-bottom: 8px;
        }

        .form-control {
            width: 100%;
            padding: 10px 15px;
            border: 1px solid #ddd;
            border-radius: 8px;
            font-size: 15px;
            transition: border-color 0.3s;
        }

        .form-control:focus {
            outline: none;
            border-color: #006909;
            box-shadow: 0 0 0 3px rgba(0, 105, 9, 0.1);
        }

        .row {
            display: flex;
            gap: 20px;
            margin: 0 -10px;
        }

        .col-md-6 {
            flex: 1;
            padding: 0 10px;
        }

        .alert {
            padding: 15px 20px;
            border-radius: 8px;
            margin-bottom: 20px;
        }

        .alert-success {
            background: #d4edda;
            color: #155724;
            border-left: 4px solid #28a745;
        }

        .alert-danger {
            background: #f8d7da;
            color: #721c24;
            border-left: 4px solid #dc3545;
        }

        .alert-info {
            background: #cfe2ff;
            color: #084298;
            border-left: 4px solid #0d6efd;
        }

        .form-actions {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 30px;
            padding-top: 20px;
            border-top: 1px solid #e0e0e0;
        }

        .btn {
            padding: 12px 30px;
            border-radius: 8px;
            font-weight: 600;
            text-decoration: none;
            cursor: pointer;
            border: none;
            transition: all 0.3s;
            display: inline-block;
        }

        .btn-primary {
            background: #006909;
            color: white;
        }

        .btn-primary:hover {
            background: #005207;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(0, 105, 9, 0.3);
        }

        .btn-secondary {
            background: #6c757d;
            color: white;
        }

        .btn-secondary:hover {
            background: #5a6268;
        }

        .info-card {
            background: #f8f9fa;
            border-radius: 8px;
            padding: 20px;
            margin-top: 20px;
        }

        .info-card h6 {
            color: #0d1b2a;
            font-size: 16px;
            margin-bottom: 15px;
        }

        .info-card p {
            color: #666;
            margin: 5px 0;
            font-size: 14px;
        }

        .small-text {
            font-size: 13px;
            color: #666;
            margin-top: 5px;
        }

        .form-errors {
            color: #dc3545;
            font-size: 14px;
            margin-top: 5px;
        }
    </style>
{% endblock %}

{% block body %}
<div class="edit-container">
    <div class="edit-card">
        <div class="edit-header">
            <h1>Modifier le mécène</h1>
            <p>{{ mecene.organisation }}</p>
        </div>

        {% for message in app.flashes('success') %}
            <div class="alert alert-success">
                {{ message }}
            </div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="alert alert-danger">
                {{ message }}
            </div>
        {% endfor %}

        {{ form_start(form) }}

        <div class="form-section">
            <h5>Informations de contact</h5>
            
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        {{ form_label(form.prenom) }}
                        {{ form_widget(form.prenom) }}
                        {{ form_errors(form.prenom) }}
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        {{ form_label(form.nom) }}
                        {{ form_widget(form.nom) }}
                        {{ form_errors(form.nom) }}
                    </div>
                </div>
            </div>

            <div class="form-group">
                {{ form_label(form.email) }}
                {{ form_widget(form.email) }}
                {{ form_errors(form.email) }}
                <div class="small-text">Cette adresse email sera utilisée pour la connexion.</div>
            </div>

            <div class="form-group">
                {{ form_label(form.telephone) }}
                {{ form_widget(form.telephone) }}
                {{ form_errors(form.telephone) }}
            </div>
        </div>

        <div class="form-section">
            <h5>Informations de l'organisation</h5>
            
            <div class="form-group">
                {{ form_label(form.organisation) }}
                {{ form_widget(form.organisation) }}
                {{ form_errors(form.organisation) }}
                <div class="small-text">Nom de l'entreprise ou de l'organisation partenaire.</div>
            </div>

            <div class="form-group">
                {{ form_label(form.siret) }}
                {{ form_widget(form.siret) }}
                {{ form_errors(form.siret) }}
                <div class="small-text">Numéro SIRET à 14 chiffres (sans espaces).</div>
            </div>

            <div class="form-group">
                {{ form_label(form.adresse_postale) }}
                {{ form_widget(form.adresse_postale) }}
                {{ form_errors(form.adresse_postale) }}
                <div class="small-text">Adresse complète de l'organisation.</div>
            </div>
        </div>

        <div class="form-section">
            <h5>Logo de l'organisation</h5>
            
            {% if mecene.logo %}
            <div class="form-group">
                <label>Logo actuel</label>
                <div style="margin-bottom: 15px;">
                    <img src="{{ asset('uploads/logos/' ~ mecene.logo) }}" 
                         alt="Logo actuel" 
                         style="max-width: 200px; max-height: 150px; border: 1px solid #ddd; border-radius: 8px; padding: 5px;">
                </div>
                <div class="small-text">Laissez vide pour conserver le logo actuel.</div>
            </div>
            {% endif %}
            
            <div class="form-group">
                {{ form_label(form.logo) }}
                {{ form_widget(form.logo) }}
                {{ form_errors(form.logo) }}
                <div class="small-text">Formats acceptés : PNG, JPEG. Taille maximale : 2 Mo. {{ mecene.logo ? 'Laissez vide pour conserver le logo actuel.' : 'Optionnel.' }}</div>
            </div>
        </div>

        <div class="form-actions">
            <a href="{{ path('mecenes') }}" class="btn btn-secondary">
                Annuler
            </a>
            <button type="submit" class="btn btn-primary">
                Enregistrer les modifications
            </button>
        </div>

        {{ form_end(form) }}
    </div>

    {% if utilisateur %}
    <div class="info-card">
        <h6>Informations du compte</h6>
        <p><strong>Rôle :</strong> {{ utilisateur.role.nom|capitalize }}</p>
        <p><strong>Membre depuis :</strong> {{ utilisateur.dateCreation ? utilisateur.dateCreation|date('d/m/Y à H:i') : 'Non renseigné' }}</p>
        <p><strong>Dernière modification :</strong> {{ utilisateur.dateModification ? utilisateur.dateModification|date('d/m/Y à H:i') : 'Jamais' }}</p>
    </div>
    {% endif %}
</div>
{% endblock %}
