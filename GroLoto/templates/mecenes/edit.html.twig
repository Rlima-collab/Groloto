{% extends 'base.html.twig' %}

{% block title %}Modifier le mécène{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/modele.css') }}">
    <link rel="stylesheet" href="{{ asset('css/mecenes.css') }}">
{% endblock %}

{% block body %}
<div class="edit-container">
    <div class="edit-card">
        <div class="edit-header">
            <div style="display: flex; align-items: center; gap: 20px;">
                {% if utilisateur and utilisateur.profileImage %}
                    <img src="{{ asset(utilisateur.profileImage) }}" 
                         alt="Photo de profil" 
                         style="width: 80px; height: 80px; border-radius: 50%; object-fit: cover; border: 3px solid #006909; box-shadow: 0 2px 8px rgba(0,0,0,0.15);">
                {% else %}
                    <div style="width: 80px; height: 80px; border-radius: 50%; background: linear-gradient(135deg, #006909, #00a010); display: flex; align-items: center; justify-content: center; color: white; font-size: 28px; font-weight: bold; box-shadow: 0 2px 8px rgba(0,0,0,0.15);">
                        {{ utilisateur ? utilisateur.prenom|slice(0,1)|upper ~ utilisateur.nom|slice(0,1)|upper : '?' }}
                    </div>
                {% endif %}
                <div>
                    <h1>Modifier le mécène</h1>
                    <p style="margin: 5px 0 0 0;">
                        <strong>{{ utilisateur ? utilisateur.prenom ~ ' ' ~ utilisateur.nom : 'Contact inconnu' }}</strong>
                        <span style="color: #888;"> — </span>
                        {{ mecene.organisation }}
                    </p>
                </div>
            </div>
        </div>

        {% for message in app.flashes('success') %}
            <div class="alert alert-success">
                {{ message }}
            </div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="alert alert-danger">
                {{ message }}
            </div>
        {% endfor %}

        {{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}

        <div class="form-section">
            <h5>Informations de contact</h5>
            
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        {{ form_label(form.prenom) }}
                        {{ form_widget(form.prenom) }}
                        {{ form_errors(form.prenom) }}
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        {{ form_label(form.nom) }}
                        {{ form_widget(form.nom) }}
                        {{ form_errors(form.nom) }}
                    </div>
                </div>
            </div>

            <div class="form-group">
                {{ form_label(form.email) }}
                {{ form_widget(form.email) }}
                {{ form_errors(form.email) }}
                <div class="small-text">Cette adresse email sera utilisée pour la connexion.</div>
            </div>

            <div class="form-group">
                {{ form_label(form.telephone) }}
                {{ form_widget(form.telephone) }}
                {{ form_errors(form.telephone) }}
            </div>
        </div>

        <div class="form-section">
            <h5>Informations de l'organisation</h5>
            
            <div class="form-group">
                {{ form_label(form.organisation) }}
                {{ form_widget(form.organisation) }}
                {{ form_errors(form.organisation) }}
                <div class="small-text">Nom de l'entreprise ou de l'organisation partenaire.</div>
            </div>

            <div class="form-group">
                {{ form_label(form.siret) }}
                {{ form_widget(form.siret) }}
                {{ form_errors(form.siret) }}
                <div class="small-text">Numéro SIRET à 14 chiffres (sans espaces).</div>
            </div>

            <div class="form-group">
                {{ form_label(form.adresse_postale) }}
                {{ form_widget(form.adresse_postale) }}
                {{ form_errors(form.adresse_postale) }}
                <div class="small-text">Adresse complète de l'organisation.</div>
            </div>
        </div>

        <div class="form-section">
            <h5>Logo de l'organisation</h5>
            
            {% if mecene.logo %}
            <div class="form-group">
                <label>Logo actuel</label>
                <div style="margin-bottom: 15px;">
                    <img src="{{ asset(mecene.logo) }}" 
                         alt="Logo actuel" 
                         style="max-width: 200px; max-height: 150px; border: 1px solid #ddd; border-radius: 8px; padding: 5px; background: #f8f9fa;">
                </div>
            </div>
            {% endif %}
            
            <div class="form-group">
                {{ form_label(form.logo) }}
                {{ form_widget(form.logo) }}
                {{ form_errors(form.logo) }}
                <div class="small-text">
                    {% if mecene.logo %}
                        Uploadez un nouveau fichier pour remplacer le logo actuel. Laissez vide pour conserver le logo existant.
                    {% else %}
                        Formats acceptés : PNG, JPEG. Taille maximale : 2 Mo.
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="form-section">
            <h5>Réseaux sociaux</h5>
            
            <div class="form-group">
                {{ form_label(form.instagram) }}
                {{ form_widget(form.instagram) }}
                {{ form_errors(form.instagram) }}
                <div class="small-text">Lien vers le compte Instagram de l'organisation (optionnel).</div>
            </div>

            <div class="form-group">
                {{ form_label(form.facebook) }}
                {{ form_widget(form.facebook) }}
                {{ form_errors(form.facebook) }}
                <div class="small-text">Lien vers la page Facebook de l'organisation (optionnel).</div>
            </div>
        </div>

        <div class="form-actions">
            <a href="{{ path('mecenes') }}" class="btn btn-secondary">
                Annuler
            </a>
            <button type="submit" class="btn btn-primary">
                Enregistrer les modifications
            </button>
        </div>

        {{ form_end(form) }}
    </div>

    {% if utilisateur %}
    <div class="info-card">
        <h6>Informations du compte</h6>
        <p><strong>Rôle :</strong> {{ utilisateur.role.nom|capitalize }}</p>
        <p><strong>Membre depuis :</strong> {{ utilisateur.dateCreation ? utilisateur.dateCreation|date('d/m/Y à H:i') : 'Non renseigné' }}</p>
        <p><strong>Dernière modification :</strong> {{ utilisateur.dateModification ? utilisateur.dateModification|date('d/m/Y à H:i') : 'Jamais' }}</p>
    </div>
    {% endif %}
</div>
{% endblock %}
