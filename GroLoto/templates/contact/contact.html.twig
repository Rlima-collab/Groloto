{% extends 'base.html.twig' %}

{% block title %}Contact - Groloto{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/contact.css') }}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
{% endblock %}

{% block body %}
<!-- HERO NOCTURNE -->
<div class="hero-section weekend-hero">
    <div class="shine"></div>
    <div class="hero-content">
        <h1 class="hero-title">
            <i class="fas fa-envelope-open-text me-2"></i> Contactez-nous
        </h1>
        <p class="hero-description">
            Une question ? Une suggestion ? Nous sommes à votre écoute.
        </p>
        <a href="#contact-form" class="hero-btn black">
            <i class="fas fa-paper-plane me-2"></i> Envoyer un message
        </a>
    </div>
</div>

<!-- MESSAGES FLASH -->
<div class="container mt-4">
    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-check-circle me-2"></i> {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}
</div>

<!-- FORMULAIRE DE CONTACT -->
<section class="contact-section py-5" id="contact-form">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-9 col-xl-8"> <!-- LARGEUR AUGMENTÉE -->
                <div class="contact-card">

                    <!-- EN-TÊTE -->
                    <div class="card-header">
                        <h2>Formulaire de contact</h2>
                        <p class="mb-0">Tous les champs sont requis</p>
                    </div>

                    <!-- CORPS DU FORMULAIRE -->
                    {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': true, 'id': 'contactForm'}}) }}

                    <div class="form-body">

                        <!-- Ligne 1 : Nom + Email -->
                        <div class="row g-5"> <!-- ESPACE ENTRE COLONNES -->
                            <div class="col-md-6">
                                <div class="form-group">
                                    {{ form_label(form.nom, null, {'label_attr': {'class': 'form-label'}}) }}
                                    {{ form_widget(form.nom, {'attr': {
                                        'class': 'form-control form-control-lg',
                                        'placeholder': 'Jean Dupont'
                                    }}) }}
                                    <div class="invalid-feedback d-block">
                                        {{ form_errors(form.nom) }}
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    {{ form_label(form.email, null, {'label_attr': {'class': 'form-label'}}) }}
                                    {{ form_widget(form.email, {'attr': {
                                        'class': 'form-control form-control-lg',
                                        'placeholder': 'jean@example.com'
                                    }}) }}
                                    <div class="invalid-feedback d-block">
                                        {{ form_errors(form.email) }}
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Sujet -->
                        <div class="form-group mt-4">
                            {{ form_label(form.sujet, null, {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.sujet, {'attr': {
                                'class': 'form-control form-control-lg',
                                'placeholder': 'Sujet de votre message'
                            }}) }}
                            <div class="invalid-feedback d-block">
                                {{ form_errors(form.sujet) }}
                            </div>
                        </div>

                        <!-- Message -->
                        <div class="form-group mt-4">
                            {{ form_label(form.message, null, {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.message, {'attr': {
                                'class': 'form-control form-control-lg',
                                'rows': 7,
                                'placeholder': 'Écrivez votre message ici...'
                            }}) }}
                            <div class="invalid-feedback d-block">
                                {{ form_errors(form.message) }}
                            </div>
                        </div>

                        <!-- Bouton -->
                        <div class="text-center mt-5">
                            {{ form_widget(form.envoyer, {'attr': {'class': 'btn btn-primary px-5'}}) }}
                        </div>

                    </div>

                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('contactForm');
    if (!form) return;

    form.addEventListener('submit', async function(e) {
        e.preventDefault();
        
        const submitBtn = form.querySelector('button[type="submit"]');
        const originalBtnText = submitBtn.innerHTML;
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i> Envoi...';

        try {
            const formData = new FormData(form);
            const response = await fetch(window.location.href, {
                method: 'POST',
                body: formData,
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            });

            const data = await response.json();

            if (data.success) {
                // Créer une alerte de succès
                const alertDiv = document.createElement('div');
                alertDiv.className = 'alert alert-success alert-dismissible fade show shadow-sm';
                alertDiv.role = 'alert';
                alertDiv.innerHTML = `
                    <i class="fas fa-check-circle me-2"></i> Votre message a été envoyé avec succès !
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                `;
                
                // Insérer avant le formulaire ou dans le conteneur de flash messages
                const flashContainer = document.querySelector('.container.mt-4');
                if (flashContainer) {
                    flashContainer.innerHTML = ''; // Vider les anciens messages
                    flashContainer.appendChild(alertDiv);
                    flashContainer.scrollIntoView({ behavior: 'smooth' });
                }

                form.reset();
            } else {
                throw new Error(data.error || 'Une erreur est survenue');
            }
        } catch (error) {
            console.error(error);
            const alertDiv = document.createElement('div');
            alertDiv.className = 'alert alert-danger alert-dismissible fade show shadow-sm';
            alertDiv.role = 'alert';
            alertDiv.innerHTML = `
                <i class="fas fa-exclamation-circle me-2"></i> ${error.message || 'Une erreur est survenue lors de l\'envoi.'}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            `;
            
            const flashContainer = document.querySelector('.container.mt-4');
            if (flashContainer) {
                flashContainer.innerHTML = '';
                flashContainer.appendChild(alertDiv);
                flashContainer.scrollIntoView({ behavior: 'smooth' });
            }
        } finally {
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalBtnText;
        }
    });
});
</script>
{% endblock %}