{% extends 'base.html.twig' %}

{% block title %}Disponibilités - {{ weekend.nom }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/modele.css') }}">
    <link rel="stylesheet" href="{{ asset('css/stocks/stocks-common.css') }}">
    <link rel="stylesheet" href="{{ asset('css/weekends.css') }}?v={{ 'now'|date('U') }}">
    <style>
        .dispo-hero {
            background: linear-gradient(135deg, #1e3a5f 0%, #2d5a87 50%, #3b82f6 100%);
            padding: 2.5rem 2rem;
            color: white;
            margin: -1.5rem -1.5rem 2rem -1.5rem;
            position: relative;
            overflow: hidden;
            border-radius: 0 0 12px 12px;
        }
        
        .dispo-hero::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.05'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
            opacity: 0.5;
        }
        
        .dispo-hero-content {
            position: relative;
            z-index: 1;
            max-width: 800px;
        }
        
        .dispo-hero .breadcrumb-nav {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin-bottom: 1rem;
            font-size: 0.9rem;
            opacity: 0.9;
        }
        
        .dispo-hero .breadcrumb-nav a {
            color: rgba(255,255,255,0.8);
            text-decoration: none;
            transition: color 0.2s;
        }
        
        .dispo-hero .breadcrumb-nav a:hover {
            color: white;
        }
        
        .dispo-hero h1 {
            font-size: 2rem;
            font-weight: 700;
            margin: 0 0 0.5rem 0;
        }
        
        .dispo-hero .dates {
            font-size: 1.1rem;
            opacity: 0.9;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        
        .dispo-hero .dates svg {
            width: 20px;
            height: 20px;
        }

        .dispo-card {
            background: white;
            border-radius: 12px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
            overflow: hidden;
        }
        
        .dispo-card-header {
            padding: 1.25rem 1.5rem;
            border-bottom: 1px solid #e5e7eb;
            background: #f8fafc;
        }
        
        .dispo-card-header h2 {
            margin: 0;
            font-size: 1.25rem;
            color: #1f2937;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }
        
        .dispo-card-header h2 svg {
            width: 24px;
            height: 24px;
            color: #3b82f6;
        }
        
        .dispo-card-body {
            padding: 1.5rem;
        }
        
        .dispo-instructions {
            background: #eff6ff;
            border: 1px solid #bfdbfe;
            border-radius: 8px;
            padding: 1rem 1.25rem;
            margin-bottom: 1.5rem;
            color: #1e40af;
            font-size: 0.95rem;
        }

        .dispo-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            overflow: hidden;
        }
        
        .dispo-table th,
        .dispo-table td {
            padding: 1rem 1.25rem;
            text-align: center;
            border-bottom: 1px solid #e5e7eb;
        }
        
        .dispo-table th {
            background: #f1f5f9;
            font-weight: 600;
            color: #374151;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.025em;
        }
        
        .dispo-table th:first-child,
        .dispo-table td:first-child {
            text-align: left;
        }
        
        .dispo-table tbody tr:last-child td {
            border-bottom: none;
        }
        
        .dispo-table tbody tr:hover {
            background: #f8fafc;
        }
        
        .dispo-table tbody tr.weekend-day {
            background: #fef3c7;
        }
        
        .dispo-table tbody tr.weekend-day:hover {
            background: #fde68a;
        }
        
        .dispo-checkbox {
            width: 22px;
            height: 22px;
            cursor: pointer;
            accent-color: #3b82f6;
            border-radius: 4px;
        }

        .out-of-range {
            opacity: 0.55;
            pointer-events: none;
            background: #f3f4f6;
        }

        .out-of-range .jour-name,
        .out-of-range .jour-date {
            color: #9ca3af;
        }
        
        .jour-info {
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
        }
        
        .jour-name {
            font-weight: 600;
            color: #1f2937;
            font-size: 0.95rem;
        }
        
        .jour-date {
            font-size: 0.8rem;
            color: #6b7280;
        }
        
        .creneau-label {
            display: block;
            font-weight: normal;
            font-size: 0.75rem;
            color: #6b7280;
            margin-top: 0.25rem;
            text-transform: none;
            letter-spacing: 0;
        }
        
        .dispo-actions {
            display: flex;
            gap: 0.75rem;
            margin-top: 1.25rem;
            flex-wrap: wrap;
        }
        
        .btn-action {
            padding: 0.5rem 1rem;
            font-size: 0.875rem;
            font-weight: 500;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.2s;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }
        
        .btn-action-select {
            background: #dcfce7;
            color: #166534;
        }
        
        .btn-action-select:hover {
            background: #bbf7d0;
        }
        
        .btn-action-deselect {
            background: #fee2e2;
            color: #991b1b;
        }
        
        .btn-action-deselect:hover {
            background: #fecaca;
        }
        
        .form-group-dispo {
            margin-top: 2rem;
        }
        
        .form-group-dispo label {
            display: block;
            font-weight: 600;
            margin-bottom: 0.5rem;
            color: #374151;
        }
        
        .form-group-dispo textarea {
            width: 100%;
            padding: 0.875rem 1rem;
            border: 1px solid #d1d5db;
            border-radius: 8px;
            resize: vertical;
            font-size: 0.95rem;
            transition: border-color 0.2s, box-shadow 0.2s;
        }
        
        .form-group-dispo textarea:focus {
            outline: none;
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
        }
        
        .form-group-dispo textarea::placeholder {
            color: #9ca3af;
        }
        
        .dispo-submit-row {
            display: flex;
            gap: 1rem;
            margin-top: 2rem;
            padding-top: 1.5rem;
            border-top: 1px solid #e5e7eb;
        }
        
        .btn-submit {
            flex: 1;
            padding: 0.875rem 1.5rem;
            font-size: 1rem;
            font-weight: 600;
            background: linear-gradient(135deg, #3b82f6, #2563eb);
            color: white;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.2s;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }
        
        .btn-submit:hover {
            background: linear-gradient(135deg, #2563eb, #1d4ed8);
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
        }
        
        .btn-submit svg {
            width: 20px;
            height: 20px;
        }
        
        .btn-cancel {
            padding: 0.875rem 1.5rem;
            font-size: 1rem;
            font-weight: 500;
            background: #f3f4f6;
            color: #4b5563;
            border: 1px solid #d1d5db;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.2s;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
        }
        
        .btn-cancel:hover {
            background: #e5e7eb;
        }

        @media (max-width: 768px) {
            .dispo-hero {
                padding: 1.5rem 1rem;
                margin: -1rem -1rem 1.5rem -1rem;
            }
            
            .dispo-hero h1 {
                font-size: 1.5rem;
            }
            
            .dispo-table th,
            .dispo-table td {
                padding: 0.75rem 0.5rem;
            }
            
            .dispo-submit-row {
                flex-direction: column;
            }
        }
    </style>
{% endblock %}

{% block body %}
<div class="hero-section stocks-hero">
    <div class="shine"></div>
    <div class="hero-content">
        <div class="hero-text">
            <h1 class="hero-title">{{ weekend.nom }}</h1>
            <p class="hero-description">Du {{ weekend.dateDebut|date('d/m/Y') }} au {{ weekend.dateFin|date('d/m/Y') }}</p>
        </div>
    </div>
</div>

<div class="dispo-card">
    <form method="post">
        <table class="dispo-table">
            <thead>
                <tr>
                    <th>Jour</th>
                    <th>Matin</th>
                    <th>Après-midi</th>
                    <th>Soir</th>
                </tr>
            </thead>
            <tbody>
                {% for jour in jours %}
                    <tr>
                        <td>{{ jour|date('l, d/m/Y') }}</td>
                        <td><input type="checkbox" class="dispo-checkbox" name="disponibilites[{{ jour|date('Y-m-d') }}][]" value="matin"></td>
                        <td><input type="checkbox" class="dispo-checkbox" name="disponibilites[{{ jour|date('Y-m-d') }}][]" value="apres_midi"></td>
                        <td><input type="checkbox" class="dispo-checkbox" name="disponibilites[{{ jour|date('Y-m-d') }}][]" value="soir"></td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        <div class="dispo-card-footer" style="padding:1rem; border-top:1px solid #e5e7eb; display:flex; gap:0.75rem; justify-content:space-between; align-items:center; background:#fff;">
            <div>
                <button type="button" class="btn-action btn-action-select" onclick="selectAll()">
                    <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                    Tout cocher
                </button>
                <button type="button" class="btn-action btn-action-deselect" onclick="deselectAll()">
                    <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                    Tout décocher
                </button>
            </div>

            <div style="display:flex; gap:0.75rem;">
                <a href="{{ path('benevole_disponibilites_index') }}" class="btn-cancel">Annuler</a>
                <button type="submit" class="btn-submit">Enregistrer</button>
            </div>
        </div>
    </form>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        function selectAll() {
            document.querySelectorAll('.dispo-checkbox:not(:disabled)').forEach(cb => cb.checked = true);
        }

        function deselectAll() {
            document.querySelectorAll('.dispo-checkbox:not(:disabled)').forEach(cb => cb.checked = false);
        }
    </script>
{% endblock %}
