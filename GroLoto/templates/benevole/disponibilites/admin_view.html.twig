{% extends 'base.html.twig' %}

{% block title %}Disponibilités Bénévoles - {{ weekend.nom }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/modele.css') }}">
    <link rel="stylesheet" href="{{ asset('css/benevoles.css') }}">
{% endblock %}

{% block body %}
<div class="page-container">
    {% include 'sidebar/_nav_admin.html.twig' %}

    <main class="main-content">
        <div class="container">
            <div class="page-header" style="margin-bottom: 2rem;">
                <div>
                    <a href="{{ path('app_weekend_details', {id: weekend.id}) }}" style="display: inline-flex; align-items: center; gap: 0.5rem; color: #6b7280; text-decoration: none; margin-bottom: 0.5rem;">
                        ← Retour au weekend
                    </a>
                    <h1 class="page-title" style="margin: 0;">Disponibilités - {{ weekend.nom }}</h1>
                    <p style="color: #6b7280; margin-top: 0.5rem;">
                        Du {{ weekend.dateDebut|date('d/m/Y') }} au {{ weekend.dateFin|date('d/m/Y') }}
                    </p>
                </div>
            </div>

            <!-- Statistiques -->
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-value" style="color: #10b981;">{{ benevolesAvecDispos }}</div>
                    <div class="stat-label">Bénévoles ont répondu</div>
                </div>
                <div class="stat-card">
                    <div class="stat-value" style="color: #f59e0b;">{{ benevolesSansDispos }}</div>
                    <div class="stat-label">En attente de réponse</div>
                </div>
                <div class="stat-card">
                    <div class="stat-value">{{ totalBenevoles }}</div>
                    <div class="stat-label">Total bénévoles actifs</div>
                </div>
            </div>

            {% if disposParBenevole|length == 0 %}
                <div class="card">
                    <div class="card-content" style="padding: 3rem; text-align: center;">
                        <div style="font-size: 3rem; margin-bottom: 1rem;">📭</div>
                        <h3 style="color: #374151; margin-bottom: 0.5rem;">Aucune disponibilité renseignée</h3>
                        <p style="color: #6b7280;">Les bénévoles n'ont pas encore indiqué leurs disponibilités pour ce weekend.</p>
                    </div>
                </div>
            {% else %}
                <div class="card">
                    <div class="card-header" style="padding: 1.25rem 1.5rem; border-bottom: 1px solid #e5e7eb;">
                        <h2 style="margin: 0; font-size: 1.125rem; color: #1f2937;">📋 Tableau des disponibilités</h2>
                    </div>
                    <div class="card-content" style="padding: 0; overflow-x: auto;">
                        <table class="dispo-table">
                            <thead>
                                <tr>
                                    <th style="min-width: 200px;">Bénévole</th>
                                    {% for jour in jours %}
                                        <th style="min-width: 150px;">
                                            <div class="jour-header">{{ jour|date('l')|capitalize }}</div>
                                            <div class="jour-date">{{ jour|date('d/m') }}</div>
                                        </th>
                                    {% endfor %}
                                </tr>
                            </thead>
                            <tbody>
                                {% for data in disposParBenevole %}
                                    {% set benevole = data.benevole %}
                                    {% set joursDispos = data.jours %}
                                    <tr>
                                        <td>
                                            <div class="benevole-name">{{ benevole.utilisateur.prenom }} {{ benevole.utilisateur.nom }}</div>
                                            <div class="benevole-email">{{ benevole.utilisateur.email }}</div>
                                        </td>
                                        {% for jour in jours %}
                                            {% set jourKey = jour|date('Y-m-d') %}
                                            {% set dispo = joursDispos[jourKey]|default(null) %}
                                            <td>
                                                {% if dispo %}
                                                    <div style="display: flex; flex-wrap: wrap; gap: 0.25rem; justify-content: center;">
                                                        {% if dispo.matin %}
                                                            <span class="badge-dispo badge-matin">Matin</span>
                                                        {% endif %}
                                                        {% if dispo.apresMidi %}
                                                            <span class="badge-dispo badge-aprem">Après-midi</span>
                                                        {% endif %}
                                                        {% if dispo.soir %}
                                                            <span class="badge-dispo badge-soir">Soir</span>
                                                        {% endif %}
                                                        {% if not dispo.matin and not dispo.apresMidi and not dispo.soir %}
                                                            <span class="badge-dispo badge-none">Indisponible</span>
                                                        {% endif %}
                                                    </div>
                                                {% else %}
                                                    <span class="badge-dispo badge-none">-</span>
                                                {% endif %}
                                            </td>
                                        {% endfor %}
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            {% endif %}
        </div>
    </main>
</div>
{% endblock %}
