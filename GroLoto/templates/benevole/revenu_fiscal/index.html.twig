{% block body %}
<div class="container">
    <div class="card">
        <div class="card-header">
            <h1 class="card-title">
                Mes reçus fiscaux
            </h1>
            <p class="card-description">
                Historique de vos reçus fiscaux de bénévolat. Vous recevrez une notification lorsqu'un nouveau reçu sera disponible.
            </p>
        </div>

        {% if recus %}
            <div class="stats-bar">
                <div class="stat-item">
                    <div class="stat-icon">Statistiques</div>
                    <div class="stat-content">
                        <h4>{{ recus|length }}</h4>
                        <p>Reçu{{ recus|length > 1 ? 's' : '' }} fiscal{{ recus|length > 1 ? 's' : '' }}</p>
                    </div>
                </div>
                <div class="stat-item">
                    <div class="stat-icon">Calendrier</div>
                    <div class="stat-content">
                        <h4>{{ recus|first.annee }}</h4>
                        <p>Dernière année</p>
                    </div>
                </div>
            </div>

            <div class="recu-grid">
                {% for recu in recus %}
                    <div class="recu-card">
                        <div class="recu-header">
                            <div class="recu-icon">Bénévolat</div>
                            <div class="recu-info">
                                <h3>Reçu fiscal bénévole - {{ recu.annee }}</h3>
                                <div class="recu-meta">
                                    <div class="recu-meta-item">
                                        Envoyé le {{ recu.createdAt|date('d/m/Y à H:i') }}
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="recu-actions">
                            <a href="{{ asset(recu.fichier) }}" class="btn btn-primary" target="_blank">
                                Télécharger
                            </a>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="empty-state">
                <div class="empty-state-icon">Aucun document</div>
                <h3>Aucun reçu fiscal disponible</h3>
                <p>Vous n'avez pas encore reçu de reçus fiscaux. Ils apparaîtront ici lorsqu'ils seront envoyés par l'administration.</p>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
