{% block body %}
<div class="hero-section stocks-hero">
    <div class="shine"></div>
    <div class="hero-content">
            <h1 class="hero-title">Mes Reçus fiscaux</h1>
            <p class="hero-description">Gérez et téléchargez vos reçus fiscaux.</p>
    </div>
</div>

<div class="container">
    <div class="card">
        <div class="card-header">
            <h2 class="card-title">Modèle de reçu fiscal</h2>
            <p class="card-description">Téléchargez le modèle officiel</p>
        </div>
        <p>
            <a href="https://www.impots.gouv.fr/sites/default/files/formulaires/2041-mec-sd/2024/2041-mec-sd_4811.pdf" target="_blank" class="btn-primary">Télécharger le modèle</a>
        </p>
    </div>

    <div class="card">
        <div class="card-header">
            <h2 class="card-title">Envoyer mon reçu</h2>
            <p class="card-description">Uploadez et envoyez votre reçu aux administrateurs</p>
        </div>

        <form method="post" action="{{ path('mecene_recu_send') }}" enctype="multipart/form-data">
            <input type="hidden" name="_token" value="{{ csrf_token('send_recu_mecene') }}">
            <div class="form-group">
                <label for="recu_file" class="form-label">Sélectionnez votre reçu fiscal (PDF) :</label>
                <input type="file" id="recu_file" name="recu_file" class="file-input" accept="application/pdf" required>
            </div>
            <div>
                <button type="submit" class="btn-primary">Envoyer à l'admin</button>
            </div>
        </form>
    </div>

    <div class="card">
        <div class="card-header">
            <h2 class="card-title">Historique des envois</h2>
            <p class="card-description">Vos reçus fiscaux précédemment envoyés</p>
        </div>

        {% if messages is empty %}
            <div class="empty-state">
                <div class="empty-state-icon"></div>
                <h3>Aucun envoi</h3>
                <p>Vous n'avez pas encore envoyé de reçu fiscal.</p>
            </div>
        {% else %}
            <div class="table-wrapper">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Date d'envoi</th>
                            <th>Message</th>
                            <th>Fichier</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for m in messages %}
                        {% set parts = m.message|split('Fichier:') %}
                        {% set file = parts|length > 1 ? parts|last|trim : '' %}
                        {% set text = parts|first|trim %}
                        <tr>
                            <td>{{ m.createdAt ? m.createdAt|date('d/m/Y à H:i') : '—' }}</td>
                            <td>{{ text }}</td>
                            <td>
                                {% if file != '' %}
                                    <a href="{{ asset(file) }}" target="_blank" class="download-link">Télécharger</a>
                                {% else %}
                                    <span style="color: #94a3b8;">—</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            <p style="margin-top: 1rem; color: #64748b; font-size: 0.9rem;">
                <strong>{{ messages|length }}</strong> envoi(s) au total
            </p>
        {% endif %}
    </div>
</div>

{% endblock %}
