{% extends 'base.html.twig' %}
{% block body %}
<div class="page-header">
    <h1 class="page-title">Dashboard Groloto</h1>
    <p class="page-description">Gérez votre événement caritatif en toute simplicité</p>
</div>
<!-- Key Metrics Cards -->
<div class="metrics-grid">
    <div class="card metric-card yellow-border">
        <div class="card-header">
            <span class="metric-title">Bénévoles</span>
            <span class="icon yellow">👥</span>
        </div>
        <div class="card-content">
            <div class="metric-value">{{ volunteers_count }}</div>
            <p class="metric-change positive">+{{ new_volunteers }} ce mois</p>
        </div>
    </div>
    <div class="card metric-card green-border">
        <div class="card-header">
            <span class="metric-title">Mécènes</span>
            <span class="icon green">🎁</span>
        </div>
        <div class="card-content">
            <div class="metric-value">{{ sponsors_count }}</div>
            <p class="metric-change positive">+{{ new_sponsors }} ce mois</p>
        </div>
    </div>
    <div class="card metric-card blue-border">
        <div class="card-header">
            <span class="metric-title">Lots disponibles</span>
            <span class="icon blue">📦</span>
        </div>
        <div class="card-content">
            <div class="metric-value">{{ prizes_count }}</div>
            <p class="metric-change warning">{{ out_of_stock }} en rupture</p>
        </div>
    </div>
    <div class="card metric-card yellow-border">
        <div class="card-header">
            <span class="metric-title">Stock total</span>
            <span class="icon yellow">📊</span>
        </div>
        <div class="card-content">
            <div class="metric-value">€{{ stock_value|number_format(0, ',', ' ') }}</div>
            <p class="metric-change positive">Valeur estimée</p>
        </div>
    </div>
</div>
<!-- Calendar and Quick Actions -->
<div class="dashboard-grid">
    <!-- Calendar -->
    <div class="card calendar-card">
        <div class="card-header">
            <h3 class="card-title">📅 Prochains événements</h3>
        </div>
        <div class="card-content">
            <div class="events-list">
                {% for event in events %}
                    <div class="event-item {{ loop.index0 % 3 == 0 ? 'yellow-accent' : loop.index0 % 3 == 1 ? 'green-accent' : 'blue-accent' }}">
                        <div class="event-date">
                            <div class="event-month">{{ event.dateDebut|date('M')|upper }}</div>
                            <div class="event-day">{{ event.dateDebut|date('d') }}</div>
                        </div>
                        <div class="event-details">
                            <h4 class="event-title">{{ event.nom }}</h4>
                            <p class="event-time">{{ event.dateDebut|date('H\\hi') }} - {{ event.lieu }}</p>
                        </div>
                    </div>
                {% else %}
                    <p>Aucun événement à venir.</p>
                {% endfor %}
            </div>
        </div>
    </div>
    <!-- Quick Actions -->
    <div class="card actions-card">
        <div class="card-header">
            <h3 class="card-title">Actions rapides</h3>
            <p class="card-description">Accès direct aux fonctions principales</p>
        </div>
        <div class="card-content">
            <div class="actions-list">
                <button class="action-btn yellow">
                    <span class="btn-icon">👥</span>
                    Ajouter un bénévole
                </button>
                <button class="action-btn green">
                    <span class="btn-icon">🎁</span>
                    Nouveau mécène
                </button>
                <button class="action-btn blue">
                    <span class="btn-icon">📦</span>
                    Ajouter un lot
                </button>
                <button class="action-btn gray">
                    <span class="btn-icon">💬</span>
                    Planifier communication
                </button>
            </div>
        </div>
    </div>
</div>
{% endblock %}