{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/dashboard.css') }}?v={{ 'now'|date('U') }}">
{% endblock %}

{% block body %}
<div class="dashboard-container">
    <!-- En-tête -->
    <header class="dashboard-header">
        <h1>Tableau de bord</h1>
        <p>Gérez vos événements caritatifs avec efficacité</p>
    </header>

    <!-- Métriques générales (pour tous sauf utilisateurs non connectés) -->
    {% if app.user %}
        <section class="metrics-section">
            <a href="{{ path('benevoles') }}" class="metric-card" style="text-decoration: none; color: inherit;">
                <h3>Bénévoles actifs</h3>
                <p class="metric-value">{{ volunteers_count }}</p>
                <p class="metric-detail">+{{ new_volunteers }} ce mois</p>
            </a>
            <a href="{{ path('mecenes') }}" class="metric-card" style="text-decoration: none; color: inherit;">
                <h3>Mécènes</h3>
                <p class="metric-value">{{ sponsors_count }}</p>
                <p class="metric-detail">Partenaires actuels</p>
            </a>
            <a href="{{ path('stocks') }}" class="metric-card" style="text-decoration: none; color: inherit;">
                <h3>Lots disponibles</h3>
                <p class="metric-value">{{ prizes_count }}</p>
                <p class="metric-detail">{{ out_of_stock }} en rupture</p>
            </a>
            <a href="{{ path('stocks') }}" class="metric-card" style="text-decoration: none; color: inherit;">
                <h3>Valeur du stock</h3>
                <p class="metric-value">€{{ stock_value|number_format(0, ',', ' ') }}</p>
                <p class="metric-detail">Valeur estimée</p>
            </a>
        </section>
    {% endif %}

    <!-- Contenu spécifique par rôle -->
    <section class="role-specific-section">
        {% if is_granted('ROLE_ADMIN') %}
            <h2>Gestion administrative</h2>
            <div class="card">
                <h3>Inscriptions en attente</h3>
                <p class="metric-value">{{ role_data.pending_registrations|default(0) }}</p>
                <a href="{{ path('admin_inscriptions') }}" class="btn">Voir les inscriptions</a>
            </div>
            <div class="card">
                <h3>Événements à venir</h3>
                {% for event in upcoming_events %}
                    <div class="event-item">
                        <span class="event-date">{{ event.dateDebut|date('d/m/Y') }}</span>
                        <span class="event-name">{{ event.nom }}</span>
                        <span class="event-location">{{ event.lieu }}</span>
                    </div>
                {% else %}
                    <p>Aucun événement à venir.</p>
                {% endfor %}
                <a href="{{ path('app_weekends') }}" class="btn btn-primary">Voir tous les événements</a>
            </div>
        {% elseif is_granted('ROLE_MECENE') %}
            <h2>Vos contributions</h2>
            <div class="card">
                <h3>Valeur totale des lots</h3>
                <p class="metric-value">€{{ role_data.sponsor_contributions|default(0)|number_format(0, ',', ' ') }}</p>
                <a href="{{ path('stocks') }}" class="btn">Voir vos lots</a>
            </div>
            <div class="card">
                <h3>Événements à venir</h3>
                {% for event in upcoming_events %}
                    <div class="event-item">
                        <span class="event-date">{{ event.dateDebut|date('d/m/Y') }}</span>
                        <span class="event-name">{{ event.nom }}</span>
                        <span class="event-location">{{ event.lieu }}</span>
                    </div>
                {% else %}
                    <p>Aucun événement à venir.</p>
                {% endfor %}
                <a href="{{ path('mecene_inscription') }}" class="btn btn-primary">S'inscrire à un événement</a>
            </div>
        {% elseif is_granted('ROLE_BENEVOLE') %}
            <h2>Vos tâches</h2>
            <div class="card">
                <h3>Tâches en attente</h3>
                {% for task in role_data.pending_tasks|default([]) %}
                    <div class="task-item">
                        <span class="task-name">{{ task.nom }}</span>
                        <span class="task-deadline">{{ task.dateEcheance|date('d/m/Y') }}</span>
                    </div>
                {% else %}
                    <p>Aucune tâche en attente.</p>
                {% endfor %}
                <a href="{{ path('benevole_taches_disponibles') }}" class="btn">Voir toutes les tâches</a>
            </div>
            <div class="card">
                <h3>Événements à venir</h3>
                {% for event in upcoming_events %}
                    <div class="event-item">
                        <span class="event-date">{{ event.dateDebut|date('d/m/Y') }}</span>
                        <span class="event-name">{{ event.nom }}</span>
                        <span class="event-location">{{ event.lieu }}</span>
                    </div>
                {% else %}
                    <p>Aucun événement à venir.</p>
                {% endfor %}
                <a href="{{ path('app_weekends') }}" class="btn btn-primary">Voir tous les événements</a>
            </div>
        {% else %}
            <h2>Bienvenue sur Groloto</h2>
            <div class="card">
                <h3>Événements publics</h3>
                {% for event in role_data.public_events|default([]) %}
                    <div class="event-item">
                        <span class="event-date">{{ event.dateDebut|date('d/m/Y') }}</span>
                        <span class="event-name">{{ event.nom }}</span>
                        <span class="event-location">{{ event.lieu }}</span>
                    </div>
                {% else %}
                    <p>Aucun événement public à venir.</p>
                {% endfor %}
                <a href="{{ path('app_login') }}" class="btn">Connexion pour plus d'options</a>
            </div>
        {% endif %}
    </section>
</div>
{% endblock %}