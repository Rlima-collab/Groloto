{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/modele.css') }}">
{% endblock %}

{% block body %}
<div class="hero-section">
    <div class="shine"></div>
    <div class="hero-content">
        <h1 class="hero-title">Bienvenue sur Groloto Manager</h1>
        <p class="hero-description">Organisez vos événements caritatifs avec simplicité et efficacité.</p>
        <a href="{{ path('app_evenements') }}" class="hero-btn yellow">Découvrir les événements</a>
    </div>
</div>

<div class="page-header">
    <h1 class="page-title">Tableau de bord Groloto</h1>
</div>

<div class="metrics-grid">
    <div class="card metric-card yellow-border">
        <div class="card-header">
            <span class="metric-title">Bénévoles</span>
            <span class="icon yellow">👥</span>
        </div>
        <div class="card-content">
            <div class="metric-value">{{ volunteers_count }}</div>
            <p class="metric-change positive">+{{ new_volunteers }} ce mois</p>
        </div>
    </div>
    <div class="card metric-card green-border">
        <div class="card-header">
            <span class="metric-title">Mécènes</span>
            <span class="icon green">🎁</span>
        </div>
        <div class="card-content">
            <div class="metric-value">{{ sponsors_count }}</div>
            <p class="metric-change positive">+{{ new_sponsors }} ce mois</p>
        </div>
    </div>
    <div class="card metric-card blue-border">
        <div class="card-header">
            <span class="metric-title">Lots disponibles</span>
            <span class="icon blue">📦</span>
        </div>
        <div class="card-content">
            <div class="metric-value">{{ prizes_count }}</div>
            <p class="metric-change warning">{{ out_of_stock }} en rupture</p>
        </div>
    </div>
    <div class="card metric-card yellow-border">
        <div class="card-header">
            <span class="metric-title">Stock total</span>
            <span class="icon yellow">📊</span>
        </div>
        <div class="card-content">
            <div class="metric-value">€{{ stock_value|number_format(0, ',', ' ') }}</div>
            <p class="metric-change positive">Valeur estimée</p>
        </div>
    </div>
</div>

<div class="dashboard-grid">
    <!-- Calendar -->
    <div class="card calendar-card">
        <div class="card-header">
            <h3 class="card-title">📅 Prochains événements</h3>
        </div>
        <div class="card-content">
            <div class="events-list">
                {% for event in events %}
                    <div class="event-item {{ loop.index0 % 3 == 0 ? 'yellow-accent' : loop.index0 % 3 == 1 ? 'green-accent' : 'blue-accent' }}">
                        <div class="event-date">
                            <div class="event-month">{{ event.dateDebut|date('M')|upper }}</div>
                            <div class="event-day">{{ event.dateDebut|date('d') }}</div>
                        </div>
                        <div class="event-details">
                            <h4 class="event-title">{{ event.nom }}</h4>
                            <p class="event-time">{{ event.dateDebut|date('H\\hi') }} - {{ event.lieu }}</p>
                        </div>
                    </div>
                {% else %}
                    <p>Aucun événement à venir.</p>
                {% endfor %}
            </div>
        </div>
    </div>
</div>

<div class="full-width-container">
    <div class="card history-card">
        <div class="card-header">
            <h3 class="card-title">🕒 Historique des événements</h3>
        </div>
        <div class="card-content">
            <div class="history-list">
                {% for history in event_history %}
                    <div class="history-item {{ loop.index0 % 3 == 0 ? 'yellow-accent' : loop.index0 % 3 == 1 ? 'green-accent' : 'blue-accent' }}">
                        <div class="history-date">
                            <div class="history-day">{{ history.dateAction|date('d') }}</div>
                            <div class="history-month">{{ history.dateAction|date('M')|upper }}</div>
                        </div>
                        <div class="history-details">
                            <h4 class="history-title">{{ history.evenement.nom }} - {{ history.action|capitalize }}</h4>
                            <p class="history-description">{{ history.description|default('Aucune description') }}</p>
                            <p class="history-meta">
                                {% if history.utilisateur %}
                                    Par {{ history.utilisateur.prenom }} {{ history.utilisateur.nom }} le {{ history.dateAction|date('d/m/Y H:i') }}
                                {% else %}
                                    Action système le {{ history.dateAction|date('d/m/Y H:i') }}
                                {% endif %}
                            </p>
                        </div>
                    </div>
                {% else %}
                    <p>Aucun historique d'événement disponible.</p>
                {% endfor %}
            </div>
        </div>
    </div>
</div>
{% endblock %}