<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Groloto{% endblock %}</title>
    <link rel="icon" type="image/png" href="{{ asset('images/logo_gro.png') }}">
    <link rel="stylesheet" href="{{ asset('css/sidebar.css') }}?v={{ 'now'|date('U') }}">
    <link rel="stylesheet" href="{{ asset('css/header.css') }}?v={{ 'now'|date('U') }}">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    {% block stylesheets %}{% endblock %}
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body>
    <div class="app-container">
        <!-- Barre latérale -->
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-header">
                <button class="burger-menu" id="burgerMenu" aria-label="Toggle menu">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
            </div>
            {% if app.user %}
                <div class="user-info">
                    <div class="user-avatar">
                        {{ app.user.prenom|first|upper }}{{ app.user.nom|first|upper }}
                    </div>
                    <div class="user-role">
                        {{ app.user.role.nom|capitalize }}
                    </div>
                </div>
            {% endif %}
            <nav class="sidebar-nav">
                {% if is_granted('ROLE_ADMIN') %}
                    {% include 'sidebar/_nav_admin.html.twig' %}
                {% elseif is_granted('ROLE_MECENE') %}
                    {% include 'sidebar/_nav_mecene.html.twig' %}
                {% elseif is_granted('ROLE_BENEVOLE') %}
                    {% include 'sidebar/_nav_benevole.html.twig' %}
                {% else %}
                    {% include 'sidebar/_nav_default.html.twig' %}
                {% endif %}
            </nav>
        </aside>
        <!-- Conteneur principal -->
        <div class="main-content">
            <!-- Header -->
            {% include 'partials/header.html.twig' %}
            <!-- Messages flash -->
            <main class="content">
                {% for type, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show" role="alert">
                            {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    {% endfor %}
                {% endfor %}
                <!-- Contenu principal avec largeur totale -->
                <div class="container-fluid">
                    {% block body %}{% endblock %}
                </div>
            </main>
            <!-- Footer -->
            {% include 'partials/footer.html.twig' %}
        </div>
    </div>
    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="{{ asset('js/sidebar.js') }}?v={{ 'now'|date('U') }}"></script>
    {% block javascripts %}{% endblock %}
</body>
</html>