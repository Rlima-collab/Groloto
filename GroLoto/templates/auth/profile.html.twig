{% extends 'base.html.twig' %}

{% block title %}Mon profil{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
body { font-family: 'Inter', sans-serif; background: #f8f9fa; }
.profile-container { max-width: 900px; margin: 40px auto; padding: 0 20px; }
.profile-card { background: white; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); overflow: hidden; margin-bottom: 20px; }
.profile-header { background: linear-gradient(135deg, #1e3a8a 0%, #1e40af 100%); padding: 40px 30px; text-align: center; position: relative; }
.profile-avatar { width: 100px; height: 100px; border-radius: 50%; background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%); color: white; display: flex; align-items: center; justify-content: center; font-size: 36px; font-weight: 700; margin: 0 auto 15px; border: 4px solid rgba(255,255,255,0.2); box-shadow: 0 8px 20px rgba(0,0,0,0.2); object-fit: cover; }
.profile-avatar img { width: 100%; height: 100%; border-radius: 50%; object-fit: cover; }
.profile-header h2 { color: white; font-size: 28px; font-weight: 700; margin: 0 0 8px 0; }
.profile-role { display: inline-block; padding: 8px 16px; background: rgba(255,255,255,0.2); border-radius: 20px; color: white; font-size: 14px; font-weight: 600; backdrop-filter: blur(10px); }
.profile-body { padding: 30px; }
.info-section { margin-bottom: 30px; }
.info-section-title { font-size: 16px; font-weight: 700; color: #1f2937; margin-bottom: 20px; padding-bottom: 10px; border-bottom: 2px solid #e5e7eb; display: flex; align-items: center; gap: 10px; }
.info-section-title svg { width: 20px; height: 20px; color: #3b82f6; }
.info-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; }
.info-item { background: #f8fafc; padding: 18px; border-radius: 12px; border-left: 3px solid #3b82f6; transition: all 0.2s; }
.info-item:hover { background: #f1f5f9; transform: translateX(3px); }
.info-label { font-size: 12px; color: #6b7280; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 6px; }
.info-value { font-size: 15px; color: #1f2937; font-weight: 500; }
.info-value.empty { color: #9ca3af; font-style: italic; }
.alert-custom { padding: 16px 20px; border-radius: 12px; margin-bottom: 20px; display: flex; align-items: start; gap: 12px; }
.alert-custom.success { background: #dcfce7; border-left: 4px solid #22c55e; color: #166534; }
.alert-custom.error { background: #fee2e2; border-left: 4px solid #ef4444; color: #991b1b; }
.alert-custom svg { width: 20px; height: 20px; flex-shrink: 0; margin-top: 2px; }
.btn-group { display: flex; gap: 12px; flex-wrap: wrap; justify-content: space-between; margin-top: 30px; padding-top: 30px; border-top: 1px solid #e5e7eb; }
.btn-custom { padding: 12px 24px; border-radius: 10px; font-size: 14px; font-weight: 600; cursor: pointer; transition: all 0.2s; border: none; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; }
.btn-custom svg { width: 16px; height: 16px; }
.btn-primary { background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%); color: white; }
.btn-primary:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(59, 130, 246, 0.4); color: white; }
.btn-secondary { background: #6b7280; color: white; }
.btn-secondary:hover { background: #4b5563; color: white; }
.btn-danger { background: transparent; color: #ef4444; border: 2px solid #ef4444; }
.btn-danger:hover { background: #fee2e2; color: #dc2626; }
@media (max-width: 768px) {
    .profile-container { margin: 20px auto; }
    .profile-header { padding: 30px 20px; }
    .profile-avatar { width: 80px; height: 80px; font-size: 28px; }
    .profile-header h2 { font-size: 24px; }
    .info-grid { grid-template-columns: 1fr; }
    .btn-group { flex-direction: column; }
    .btn-custom { width: 100%; justify-content: center; }
}
</style>
{% endblock %}

{% block body %}
<div class="profile-container">
    <div class="profile-card">
        <div class="profile-header">
            <div class="profile-avatar">
                {% if user.profileImage %}
                    <img src="{{ asset('uploads/profiles/' ~ user.profileImage) }}" alt="{{ user.prenom }} {{ user.nom }}">
                {% else %}
                    {{ (user.prenom|default('U')|first ~ user.nom|default('S')|first)|upper }}
                {% endif %}
            </div>
            <h2>{{ user.prenom }} {{ user.nom }}</h2>
            <span class="profile-role">
                {% if user.role.nom == 'admin' %}Administrateur
                {% elseif user.role.nom == 'benevole' %}Bénévole
                {% else %}Mécène{% endif %}
            </span>
        </div>
        
        <div class="profile-body">
            {% for message in app.flashes('success') %}
                <div class="alert-custom success">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    <div>{{ message }}</div>
                </div>
            {% endfor %}

            {% for message in app.flashes('error') %}
                <div class="alert-custom error">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    <div>{{ message }}</div>
                </div>
            {% endfor %}

            <div class="info-section">
                <div class="info-section-title">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                    Informations personnelles
                </div>
                <div class="info-grid">
                    <div class="info-item">
                        <div class="info-label">Email</div>
                        <div class="info-value">{{ user.email }}</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Téléphone</div>
                        <div class="info-value {{ user.telephone ? '' : 'empty' }}">
                            {{ user.telephone ?? 'Non renseigné' }}
                        </div>
                    </div>
                </div>
            </div>

            <div class="info-section">
                <div class="info-section-title">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                    Informations du compte
                </div>
                <div class="info-grid">
                    <div class="info-item">
                        <div class="info-label">Membre depuis</div>
                        <div class="info-value">
                            {{ user.dateCreation ? user.dateCreation|date('d/m/Y à H:i') : 'Non renseigné' }}
                        </div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Dernière modification</div>
                        <div class="info-value {{ user.dateModification ? '' : 'empty' }}">
                            {{ user.dateModification ? user.dateModification|date('d/m/Y à H:i') : 'Jamais' }}
                        </div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Mot de passe</div>
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <span style="font-family: 'Courier New', monospace; font-weight: 600; letter-spacing: 2px; color: #6b7280;">•••••••••</span>
                            <span style="font-size: 11px; color: #9ca3af; font-style: italic;">(Sécurisé - non affichable)</span>
                        </div>
                    </div>
                </div>
            </div>

            {% if user.role.nom == 'benevole' %}
            <div class="info-section">
                <div class="info-section-title">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7h18M3 12h18M3 17h18"></path></svg>
                    Disponibilités (Bénévole)
                </div>
                {% set days = {'lundi':'Lun.','mardi':'Mar.','mercredi':'Mer.','jeudi':'Jeu.','vendredi':'Ven.','samedi':'Sam.','dimanche':'Dim.'} %}
                {% set slots = {'matin':'Matin','pm':'Après-midi','soir':'Soir'} %}
                {% if dispos is defined and dispos|length > 0 %}
                    <div class="info-grid">
                        <div class="info-item" style="grid-column: 1 / -1;">
                            <div class="info-label">Créneaux cochés</div>
                            <div class="info-value">
                                {% set labels = [] %}
                                {% for v in dispos %}
                                    {% set parts = v|split('_') %}
                                    {% if parts|length == 2 %}
                                        {% set d = parts[0] %}
                                        {% set s = parts[1] %}
                                        {% set labels = labels|merge([ (days[d]|default(d|capitalize)) ~ ' ' ~ (slots[s]|default(s)) ]) %}
                                    {% endif %}
                                {% endfor %}
                                {{ labels|join(', ') }}
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="info-item">
                        <div class="info-label">Créneaux cochés</div>
                        <div class="info-value empty">Aucune disponibilité renseignée</div>
                    </div>
                {% endif %}
            </div>

            <div class="info-section">
                <div class="info-section-title">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-8 8h10a2 2 0 002-2V6a2 2 0 00-2-2H7a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                    Note / Remarque
                </div>
                <div class="info-grid">
                    <div class="info-item" style="grid-column: 1 / -1;">
                        <div class="info-label">Votre remarque</div>
                        <div class="info-value {{ (user.role.nom == 'benevole' and user is defined and dispos is defined and benevoleRemark is defined) ? '' : '' }}">
                            {% set remark = benevoleRemark|default(null) %}
                            {{ remark ? remark : 'Aucune remarque renseignée' }}
                        </div>
                    </div>
                </div>
            </div>
            {% endif %}

            {% if user.role.nom == 'mecene' and mecene is defined and mecene %}
            <div class="info-section">
                <div class="info-section-title">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
                    Informations Mécène
                </div>
                <div class="info-grid">
                    <div class="info-item">
                        <div class="info-label">Organisation</div>
                        <div class="info-value {{ mecene.organisation ? '' : 'empty' }}">
                            {{ mecene.organisation ?? 'Non renseigné' }}
                        </div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">SIRET</div>
                        <div class="info-value {{ mecene.siret ? '' : 'empty' }}">
                            {{ mecene.siret ?? 'Non renseigné' }}
                        </div>
                    </div>
                    <div class="info-item" style="grid-column: 1 / -1;">
                        <div class="info-label">Adresse postale</div>
                        <div class="info-value {{ mecene.adressePostale ? '' : 'empty' }}" style="white-space: pre-line;">
                            {{ mecene.adressePostale ?? 'Non renseignée' }}
                        </div>
                    </div>
                    {% if mecene.logo %}
                    <div class="info-item" style="grid-column: 1 / -1;">
                        <div class="info-label">Logo</div>
                        <div class="info-value">
                            <img src="{{ asset(mecene.logo) }}" alt="Logo {{ mecene.organisation }}" style="max-width: 200px; max-height: 100px; object-fit: contain; border-radius: 8px; border: 1px solid #e5e7eb; padding: 5px; background: white;">
                        </div>
                    </div>
                    {% endif %}
                </div>
            </div>
            {% endif %}

            <div class="btn-group">
                <a href="{{ path('dashboard') }}" class="btn-custom btn-secondary">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                    Retour
                </a>
                <div style="display: flex; gap: 12px;">
                    <a href="{{ path('app_profile_edit') }}" class="btn-custom btn-primary">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                        Modifier
                    </a>
                    <a href="{{ path('app_logout') }}" class="btn-custom btn-danger">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
                        Déconnexion
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}