{% extends 'base.html.twig' %}

{% block title %}Mon profil{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ asset('css/admin.css') }}">
{% endblock %}

{% block body %}
<div class="profile-container">
    <div class="profile-card">
        <div class="profile-header">
            <div class="profile-avatar">
                {% if user.profileImage %}
                    <img src="{{ asset('uploads/profiles/' ~ user.profileImage) }}" alt="{{ user.prenom }} {{ user.nom }}">
                {% else %}
                    {{ (user.prenom|default('U')|first ~ user.nom|default('S')|first)|upper }}
                {% endif %}
            </div>
            <h2>{{ user.prenom }} {{ user.nom }}</h2>
            <span class="profile-role">
                {% if user.role.nom == 'admin' %}
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
                    Administrateur
                {% elseif user.role.nom == 'benevole' %}
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
                    Bénévole
                {% else %}
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
                    Mécène
                {% endif %}
            </span>
        </div>
        
        <div class="profile-body">
            {% for message in app.flashes('success') %}
                <div class="alert-custom success">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    <div>{{ message }}</div>
                </div>
            {% endfor %}

            {% for message in app.flashes('error') %}
                <div class="alert-custom error">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    <div>{{ message }}</div>
                </div>
            {% endfor %}

            <div class="info-section">
                <div class="info-section-title">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                    Informations personnelles
                </div>
                <div class="info-grid">
                    <div class="info-item">
                        <div class="info-label">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                            Email
                        </div>
                        <div class="info-value">{{ user.email }}</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                            Téléphone
                        </div>
                        <div class="info-value {{ user.telephone ? '' : 'empty' }}">
                            {{ user.telephone ?? 'Non renseigné' }}
                        </div>
                    </div>
                </div>
            </div>

            <div class="info-section">
                <div class="info-section-title">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
                    Informations du compte
                </div>
                <div class="info-grid">
                    <div class="info-item">
                        <div class="info-label">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                            Membre depuis
                        </div>
                        <div class="info-value">
                            {{ user.dateCreation ? user.dateCreation|date('d/m/Y à H:i') : 'Non renseigné' }}
                        </div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                            Dernière modification
                        </div>
                        <div class="info-value {{ user.dateModification ? '' : 'empty' }}">
                            {{ user.dateModification ? user.dateModification|date('d/m/Y à H:i') : 'Jamais' }}
                        </div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"></path></svg>
                            Mot de passe
                        </div>
                        <div style="display: flex; align-items: center; gap: 10px;">
                            <span style="font-family: monospace; font-weight: 700; letter-spacing: 3px; color: #64748b; font-size: 18px;">••••••••</span>
                            <span style="font-size: 11px; color: #94a3b8; background: #f1f5f9; padding: 4px 10px; border-radius: 20px;">Sécurisé</span>
                        </div>
                    </div>
                </div>
            </div>

            {% if user.role.nom == 'benevole' %}
            <div class="info-section">
                <div class="info-section-title">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    Disponibilités
                </div>
                {% set days = {'lundi':'Lun.','mardi':'Mar.','mercredi':'Mer.','jeudi':'Jeu.','vendredi':'Ven.','samedi':'Sam.','dimanche':'Dim.'} %}
                {% set slots = {'matin':'Matin','pm':'Après-midi','soir':'Soir'} %}
                {% if dispos is defined and dispos|length > 0 %}
                    <div class="info-item full-width">
                        <div class="info-label">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path></svg>
                            Créneaux disponibles
                        </div>
                        <div class="info-value">
                            {% set labels = [] %}
                            {% for v in dispos %}
                                {% set parts = v|split('_') %}
                                {% if parts|length == 2 %}
                                    {% set d = parts[0] %}
                                    {% set s = parts[1] %}
                                    {% set labels = labels|merge([ (days[d]|default(d|capitalize)) ~ ' ' ~ (slots[s]|default(s)) ]) %}
                                {% endif %}
                            {% endfor %}
                            {{ labels|join(' • ') }}
                        </div>
                    </div>
                {% else %}
                    <div class="info-item full-width">
                        <div class="info-label">Créneaux disponibles</div>
                        <div class="info-value empty">Aucune disponibilité renseignée</div>
                    </div>
                {% endif %}
            </div>

            <div class="info-section">
                <div class="info-section-title">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"></path></svg>
                    Note / Remarque
                </div>
                <div class="info-item full-width">
                    <div class="info-label">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                        Votre remarque
                    </div>
                    <div class="info-value {{ benevoleRemark|default(null) ? '' : 'empty' }}">
                        {{ benevoleRemark|default(null) ? benevoleRemark : 'Aucune remarque renseignée' }}
                    </div>
                </div>
            </div>
            {% endif %}

            {% if user.role.nom == 'mecene' and mecene is defined and mecene %}
            <div class="info-section">
                <div class="info-section-title">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
                    Informations Mécène
                </div>
                <div class="info-grid">
                    <div class="info-item">
                        <div class="info-label">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                            Organisation
                        </div>
                        <div class="info-value {{ mecene.organisation ? '' : 'empty' }}">
                            {{ mecene.organisation ?? 'Non renseigné' }}
                        </div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                            SIRET
                        </div>
                        <div class="info-value {{ mecene.siret ? '' : 'empty' }}" style="font-family: monospace; letter-spacing: 1px;">
                            {{ mecene.siret ?? 'Non renseigné' }}
                        </div>
                    </div>
                    <div class="info-item full-width">
                        <div class="info-label">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                            Adresse postale
                        </div>
                        <div class="info-value {{ mecene.adressePostale ? '' : 'empty' }}" style="white-space: pre-line;">
                            {{ mecene.adressePostale ?? 'Non renseignée' }}
                        </div>
                    </div>
                    {% if mecene.logo %}
                    <div class="info-item full-width logo-item">
                        <div class="logo-preview">
                            <img src="{{ asset(mecene.logo) }}" alt="Logo {{ mecene.organisation }}">
                        </div>
                        <div>
                            <div class="info-label">Logo de l'organisation</div>
                            <div class="info-value">{{ mecene.organisation }}</div>
                        </div>
                    </div>
                    {% endif %}
                </div>
            </div>

            {% if mecene.instagram or mecene.facebook %}
            <div class="info-section">
                <div class="info-section-title">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path></svg>
                    Réseaux sociaux
                </div>
                <div class="social-links">
                    {% if mecene.instagram %}
                    <a href="{{ mecene.instagram }}" target="_blank" rel="noopener noreferrer" class="social-link instagram">
                        <svg fill="currentColor" viewBox="0 0 24 24">
                            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                        </svg>
                        Instagram
                    </a>
                    {% endif %}
                    {% if mecene.facebook %}
                    <a href="{{ mecene.facebook }}" target="_blank" rel="noopener noreferrer" class="social-link facebook">
                        <svg fill="currentColor" viewBox="0 0 24 24">
                            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                        </svg>
                        Facebook
                    </a>
                    {% endif %}
                </div>
            </div>
            {% endif %}
            {% endif %}

            <div class="btn-group">
                <a href="{{ path('dashboard') }}" class="btn-custom btn-secondary">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                    Retour
                </a>
                <div style="display: flex; gap: 12px; flex-wrap: wrap;">
                    <a href="{{ path('app_profile_edit') }}" class="btn-custom btn-primary">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                        Modifier
                    </a>
                    <a href="{{ path('app_logout') }}" class="btn-custom btn-danger">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
                        Déconnexion
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}