{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/login.css') }}">
{% endblock %}

{% block body %}
<div class="login-container">
    <div class="login-card">
        <div class="shine"></div>
        <div class="login-content">
            <h2 class="login-title">Connexion</h2>
            <p class="login-subtitle">Accédez à votre espace personnel</p>

            {% if error %}
                <div class="login-alert alert-danger">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            <form method="post" class="login-form">
                <div class="login-form-group">
                    <label for="inputEmail" class="login-label">Email</label>
                    <input type="email" value="{{ last_username }}" name="_username" id="inputEmail"
                           class="login-input" autocomplete="email" required autofocus>
                </div>

                <div class="login-form-group">
                    <label for="inputPassword" class="login-label">Mot de passe</label>
                    <input type="password" name="_password" id="inputPassword"
                           class="login-input" autocomplete="current-password" required>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button class="login-btn" type="submit">Se connecter</button>
            </form>

            <div class="login-footer">
                <p>Pas encore de compte ?
                    <a href="{{ path('app_register_choice') }}" class="login-link">S'inscrire</a>
                </p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
