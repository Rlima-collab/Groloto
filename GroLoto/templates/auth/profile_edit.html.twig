{% extends 'base.html.twig' %}

{% block title %}Modifier mon profil{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
body { font-family: 'Inter', sans-serif; background: #f8f9fa; }
.profile-container { max-width: 900px; margin: 40px auto; padding: 0 20px; }
.profile-card { background: white; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); overflow: hidden; margin-bottom: 20px; }
.profile-header { background: linear-gradient(135deg, #1e3a8a 0%, #1e40af 100%); padding: 30px; text-align: center; }
.profile-header h2 { color: white; font-size: 24px; font-weight: 700; margin: 0; display: flex; align-items: center; justify-content: center; gap: 12px; }
.profile-header svg { width: 28px; height: 28px; }
.profile-body { padding: 35px; }
.form-section { margin-bottom: 35px; }
.form-section-title { font-size: 18px; font-weight: 700; color: #1f2937; margin-bottom: 20px; padding-bottom: 12px; border-bottom: 2px solid #e5e7eb; display: flex; align-items: center; gap: 10px; }
.form-section-title svg { width: 22px; height: 22px; color: #3b82f6; }
.form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; }
.form-group { margin-bottom: 20px; }
.form-group label { display: block; font-size: 13px; font-weight: 600; color: #374151; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.5px; }
.form-group label.required::after { content: ' *'; color: #ef4444; }
.form-control { width: 100%; padding: 12px 16px; border: 2px solid #e5e7eb; border-radius: 10px; font-size: 14px; color: #1f2937; font-family: 'Inter', sans-serif; transition: all 0.2s; background: #f8fafc; }
.form-control:focus { outline: none; border-color: #3b82f6; background: white; box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1); }
.form-control.is-invalid { border-color: #ef4444; background: #fee2e2; }
.form-text { font-size: 12px; color: #6b7280; margin-top: 6px; display: block; }
.invalid-feedback { color: #ef4444; font-size: 12px; margin-top: 6px; display: block; font-weight: 500; }
.alert-custom { padding: 16px 20px; border-radius: 12px; margin-bottom: 25px; display: flex; align-items: start; gap: 12px; }
.alert-custom.success { background: #dcfce7; border-left: 4px solid #22c55e; color: #166534; }
.alert-custom.error { background: #fee2e2; border-left: 4px solid #ef4444; color: #991b1b; }
.alert-custom.info { background: #dbeafe; border-left: 4px solid #3b82f6; color: #1e40af; }
.alert-custom.warning { background: #fef3c7; border-left: 4px solid #f59e0b; color: #92400e; }
.alert-custom svg { width: 20px; height: 20px; flex-shrink: 0; margin-top: 2px; }
.btn-group { display: flex; gap: 12px; justify-content: flex-end; margin-top: 35px; padding-top: 20px; border-top: 1px solid #e5e7eb; flex-wrap: wrap; }
.btn-custom { padding: 10px 20px; border-radius: 8px; font-size: 14px; font-weight: 500; cursor: pointer; transition: all 0.2s; border: none; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; }
.btn-custom svg { width: 16px; height: 16px; }
.btn-primary { background: #2563eb; color: white; }
.btn-primary:hover { background: #1d4ed8; transform: translateY(-1px); box-shadow: 0 4px 12px rgba(37, 99, 235, 0.2); }
.btn-secondary { background: white; color: #4b5563; border: 1px solid #d1d5db; }
.btn-secondary:hover { background: #f3f4f6; color: #1f2937; border-color: #9ca3af; }
.info-card { background: #f8fafc; border-radius: 8px; padding: 16px; border: 1px solid #e2e8f0; margin-top: 20px; }
.info-card-title { font-size: 14px; font-weight: 600; color: #1e293b; margin-bottom: 8px; }
.info-card-text { font-size: 13px; color: #64748b; line-height: 1.5; margin: 0; }
.profile-image-section { text-align: center; margin-bottom: 30px; padding: 20px; background: white; border-radius: 12px; border: 1px solid #e5e7eb; }
.profile-image-preview { width: 100px; height: 100px; border-radius: 50%; margin: 0 auto 15px; border: 3px solid #e5e7eb; overflow: hidden; background: #f1f5f9; display: flex; align-items: center; justify-content: center; color: #64748b; font-size: 32px; font-weight: 600; }
.profile-image-preview img { width: 100%; height: 100%; object-fit: cover; }
.file-input-wrapper { position: relative; display: inline-flex; gap: 10px; align-items: center; justify-content: center; }
.file-input-wrapper input[type="file"] { position: absolute; left: -9999px; }
.file-input-label { padding: 8px 16px; background: #f1f5f9; color: #475569; border: 1px solid #cbd5e1; border-radius: 6px; cursor: pointer; font-size: 13px; font-weight: 500; transition: all 0.2s; display: inline-flex; align-items: center; gap: 6px; }
.file-input-label:hover { background: #e2e8f0; color: #1e293b; border-color: #94a3b8; }
.file-input-label svg { width: 16px; height: 16px; }
.remove-image-btn { padding: 8px 16px; background: #fee2e2; color: #991b1b; border: 1px solid #fecaca; border-radius: 6px; cursor: pointer; font-size: 13px; font-weight: 500; transition: all 0.2s; display: inline-flex; align-items: center; gap: 6px; }
.remove-image-btn:hover { background: #fecaca; color: #7f1d1d; border-color: #fca5a5; }
.logo-section { margin-bottom: 30px; padding: 20px; background: white; border-radius: 12px; border: 1px solid #e5e7eb; }
.logo-preview { text-align: center; margin-bottom: 15px; padding: 15px; background: #f8fafc; border-radius: 8px; border: 1px dashed #cbd5e1; }
.logo-image { max-width: 150px; max-height: 80px; object-fit: contain; }
.logo-actions { display: flex; gap: 10px; align-items: center; justify-content: center; }
.logo-actions .file-input-label { padding: 10px 20px; min-height: 40px; }
.remove-logo-btn { padding: 10px 20px; min-height: 40px; background: #f1f5f9; color: #dc2626; border: 1px solid #e2e8f0; border-radius: 6px; cursor: pointer; font-size: 13px; font-weight: 500; transition: all 0.2s; display: inline-flex; align-items: center; gap: 6px; }
.remove-logo-btn:hover { background: #fee2e2; color: #b91c1c; border-color: #fecaca; }
.remove-logo-btn svg { width: 16px; height: 16px; }
@media (max-width: 768px) {
    .profile-container { margin: 20px auto; }
    .profile-header { padding: 25px 20px; }
    .profile-header h2 { font-size: 20px; }
    .profile-body { padding: 25px 20px; }
    .form-grid { grid-template-columns: 1fr; }
    .btn-group { flex-direction: column; }
    .btn-custom { width: 100%; justify-content: center; }
    .profile-image-section { padding: 20px; }
    .logo-section { padding: 20px; }
    .logo-preview { padding: 15px; }
    .logo-image { max-width: 150px; max-height: 75px; }
    .logo-actions { flex-wrap: wrap; }
}
</style>
{% endblock %}

{% block body %}
<div class="profile-container">
    <div class="profile-card">
        <div class="profile-header">
            <h2>
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                Modifier mon profil
            </h2>
        </div>
        
        <div class="profile-body">
            {% for message in app.flashes('success') %}
                <div class="alert-custom success">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    <div>{{ message }}</div>
                </div>
            {% endfor %}

            {% for message in app.flashes('error') %}
                <div class="alert-custom error">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    <div>{{ message }}</div>
                </div>
            {% endfor %}

            {{ form_start(form, {'attr': {'id': 'profile-edit-form', 'novalidate': 'novalidate', 'enctype': 'multipart/form-data'}}) }}
            
            <div class="alert-custom info">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                <div>
                    <strong>Information :</strong> Votre rôle ({{ user.role.nom|capitalize }}) ne peut pas être modifié. 
                    Pour toute question, contactez un administrateur.
                </div>
            </div>

            <!-- Section Image de profil -->
            <div class="profile-image-section">
                <div class="profile-image-preview" id="imagePreview">
                    {% if user.profileImage %}
                        <img src="{{ asset('uploads/profiles/' ~ user.profileImage) }}" alt="Profile" id="previewImg">
                    {% else %}
                        <span id="previewInitials">{{ (user.prenom|default('U')|first ~ user.nom|default('S')|first)|upper }}</span>
                    {% endif %}
                </div>
                <div class="file-input-wrapper">
                    <input type="file" id="profileImageInput" name="profileImage" accept="image/*" onchange="previewImage(event)">
                    <label for="profileImageInput" class="file-input-label">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                        Choisir une image
                    </label>
                    {% if user.profileImage %}
                        <button type="button" class="remove-image-btn" onclick="removeImage()">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                            Supprimer l'image
                        </button>
                        <input type="hidden" name="removeImage" id="removeImageFlag" value="0">
                    {% endif %}
                </div>
                <small class="form-text" style="display: block; margin-top: 10px;">JPG, PNG ou GIF. Maximum 2 Mo.</small>
            </div>

            {% if mecene is defined and mecene %}
            <!-- Section Logo Mécène -->
            <div class="logo-section">
                <h3 style="margin-bottom: 20px; color: #1f2937; font-size: 18px; font-weight: 700; display: flex; align-items: center; gap: 10px;">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" style="width: 22px; height: 22px; color: #3b82f6;">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                    </svg>
                    Logo de l'organisation
                </h3>
                {% if mecene.logo %}
                    <div class="logo-preview">
                        <img src="{{ asset(mecene.logo) }}" alt="Logo {{ mecene.organisation }}" class="logo-image">
                    </div>
                {% endif %}
                <div class="logo-actions">
                    <div class="file-input-wrapper">
                        <input type="file" id="logoInput" name="logo" accept=".png,.jpeg,.jpg" onchange="previewLogo(event)">
                        <label for="logoInput" class="file-input-label">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                            Choisir un logo
                        </label>
                    </div>
                    {% if mecene.logo %}
                    <button type="button" class="remove-logo-btn" onclick="deleteLogo()">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                        Supprimer le logo
                    </button>
                    {% endif %}
                </div>
                <small class="form-text" style="display: block; margin-top: 10px;">PNG ou JPEG uniquement. Recommandé: 200x100px maximum.</small>
            </div>

            <!-- Section Adresse Postale Mécène -->
            <div class="form-section">
                <div class="form-section-title">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" style="width: 22px; height: 22px; color: #3b82f6;">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    </svg>
                    Adresse de l'organisation
                </div>
                
                <div class="form-group">
                    <label for="adresse_postale">Adresse postale</label>
                    <textarea id="adresse_postale" name="adresse_postale" class="form-control" rows="3" 
                              placeholder="Entrez l'adresse complète de votre organisation...">{{ mecene.adressePostale|default('') }}</textarea>
                    <small class="form-text">Adresse complète (rue, code postal, ville)</small>
                </div>
            </div>

            <!-- Section Réseaux Sociaux Mécène -->
            <div class="form-section">
                <div class="form-section-title">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" style="width: 22px; height: 22px; color: #3b82f6;">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path>
                    </svg>
                    Réseaux sociaux
                </div>
                
                <div class="form-grid">
                    <div class="form-group">
                        <label for="instagram">
                            <svg style="width: 16px; height: 16px; display: inline-block; vertical-align: middle; margin-right: 6px;" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                            </svg>
                            Instagram
                        </label>
                        <input type="url" id="instagram" name="instagram" class="form-control" 
                               value="{{ mecene.instagram|default('') }}" 
                               placeholder="https://instagram.com/votre-compte">
                        <small class="form-text">URL complète de votre page Instagram</small>
                    </div>
                    <div class="form-group">
                        <label for="facebook">
                            <svg style="width: 16px; height: 16px; display: inline-block; vertical-align: middle; margin-right: 6px;" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                            </svg>
                            Facebook
                        </label>
                        <input type="url" id="facebook" name="facebook" class="form-control" 
                               value="{{ mecene.facebook|default('') }}" 
                               placeholder="https://facebook.com/votre-page">
                        <small class="form-text">URL complète de votre page Facebook</small>
                    </div>
                </div>
            </div>
            {% endif %}

            <div class="form-section">
                <div class="form-section-title">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                    Informations personnelles
                </div>
                
                <div class="form-grid">
                    <div class="form-group">
                        {{ form_label(form.prenom, null, {'label_attr': {'class': 'required'}}) }}
                        {{ form_widget(form.prenom, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.prenom) }}
                    </div>
                    <div class="form-group">
                        {{ form_label(form.nom, null, {'label_attr': {'class': 'required'}}) }}
                        {{ form_widget(form.nom, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.nom) }}
                    </div>
                </div>

                <div class="form-group">
                    {{ form_label(form.email, null, {'label_attr': {'class': 'required'}}) }}
                    {{ form_widget(form.email, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.email) }}
                    <small class="form-text">Cette adresse email sera utilisée pour vous connecter.</small>
                </div>

                <div class="form-group">
                    {{ form_label(form.telephone) }}
                    {{ form_widget(form.telephone, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.telephone) }}
                </div>
            </div>

            {# Disponibilités pour les bénévoles #}
            {% if user.role.nom == 'benevole' %}
            <div class="form-section">
                <div class="form-section-title">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                    Disponibilités (Bénévole)
                </div>
                <style>
                    .dispos-grid { overflow-x: auto; }
                    .dispos-table { width: 100%; border-collapse: collapse; }
                    .dispos-table th, .dispos-table td { border: 1px solid #e5e7eb; padding: 10px; text-align: center; }
                    .dispos-table thead th { background: #f8fafc; font-size: 13px; color: #374151; }
                    .slot-label { font-size: 12px; color: #374151; font-weight: 600; }
                    .day-label { text-align: left; font-weight: 600; color: #1f2937; background: #f8fafc; }
                </style>
                {% set days = ['lundi','mardi','mercredi','jeudi','vendredi','samedi','dimanche'] %}
                {% set slots = {'matin':'Matin','am':'Matin','pm':'Après-midi','soir':'Soir'} %}
                {% set slotKeys = ['matin','pm','soir'] %}
                {% set selected = dispos|default([]) %}
                <div class="dispos-grid">
                    <table class="dispos-table">
                        <thead>
                            <tr>
                                <th style="text-align:left">Jour</th>
                                <th>Matin</th>
                                <th>Après-midi</th>
                                <th>Soir</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for d in days %}
                            <tr>
                                <td class="day-label">{{ d|capitalize }}</td>
                                {% for sk in slotKeys %}
                                    {% set val = d ~ '_' ~ sk %}
                                    <td>
                                        <label class="slot-label">
                                            <input type="checkbox" name="disponibilites[]" value="{{ val }}" {% if val in selected %}checked{% endif %}>
                                        </label>
                                    </td>
                                {% endfor %}
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
                <small class="form-text">Cochez vos créneaux généraux de disponibilité. Ils serviront de référence lors des plannings.</small>
            </div>

            <div class="form-section">
                <div class="form-section-title">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-8 8h10a2 2 0 002-2V6a2 2 0 00-2-2H7a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                    Note / Remarque
                </div>
                <div class="form-group">
                    <label for="remarque">Votre remarque (optionnel)</label>
                    <textarea id="remarque" name="remarque" class="form-control" rows="3" maxlength="1000" placeholder="Ex : Je suis dispo les mercredis après-midi.">{{ app.request.request.get('remarque') ?? benevole.remarque|default('') }}</textarea>
                    <small class="form-text">Ajoutez une note pour clarifier vos préférences ou contraintes.</small>
                </div>
            </div>
            {% endif %}

            <div class="form-section">
                <div class="form-section-title">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
                    Sécurité
                </div>
                
                <div class="alert-custom warning">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                    <div>
                        <strong>Sécurité :</strong> Pour modifier votre profil, vous devez entrer votre mot de passe actuel.
                        Si vous souhaitez changer de mot de passe, remplissez les champs ci-dessous.
                    </div>
                </div>

                <div class="form-group">
                    {{ form_label(form.currentPassword, null, {'label_attr': {'class': 'required'}}) }}
                    {{ form_widget(form.currentPassword, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.currentPassword) }}
                    <small class="form-text">Requis pour valider les modifications.</small>
                </div>

                <div class="form-grid">
                    <div class="form-group">
                        {{ form_label(form.newPassword) }}
                        {{ form_widget(form.newPassword, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.newPassword) }}
                        <small class="form-text">Au moins 6 caractères. Laissez vide pour conserver l'actuel.</small>
                    </div>
                    <div class="form-group">
                        {{ form_label(form.confirmPassword) }}
                        {{ form_widget(form.confirmPassword, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.confirmPassword) }}
                    </div>
                </div>
            </div>

            <div class="btn-group">
                <a href="{{ path('app_profile') }}" class="btn-custom btn-secondary">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                    Annuler
                </a>
                <button type="submit" class="btn-custom btn-primary">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                    Enregistrer les modifications
                </button>
            </div>

            {{ form_end(form) }}
        </div>
    </div>

    <div class="info-card">
        <div class="info-card-title">Informations du compte</div>
        <p class="info-card-text">
            <strong>Membre depuis :</strong> {{ user.dateCreation ? user.dateCreation|date('d/m/Y à H:i') : 'Non renseigné' }}<br>
            <strong>Dernière modification :</strong> {{ user.dateModification ? user.dateModification|date('d/m/Y à H:i') : 'Jamais' }}
        </p>
    </div>
</div>

<script>
function previewImage(event) {
    const file = event.target.files[0];
    const preview = document.getElementById('imagePreview');
    const previewImg = document.getElementById('previewImg');
    const previewInitials = document.getElementById('previewInitials');
    
    if (file && file.size <= 2097152) { // 2 Mo max
        const reader = new FileReader();
        reader.onload = function(e) {
            if (previewImg) {
                previewImg.src = e.target.result;
            } else {
                preview.innerHTML = '<img src="' + e.target.result + '" alt="Preview" id="previewImg">';
            }
        };
        reader.readAsDataURL(file);
    } else if (file && file.size > 2097152) {
        alert('L\'image est trop volumineuse. Maximum 2 Mo.');
        event.target.value = '';
    }
}

function removeImage() {
    if (confirm('Êtes-vous sûr de vouloir supprimer votre image de profil ?')) {
        document.getElementById('removeImageFlag').value = '1';
        const preview = document.getElementById('imagePreview');
        const initials = '{{ (user.prenom|default("U")|first ~ user.nom|default("S")|first)|upper }}';
        preview.innerHTML = '<span id="previewInitials">' + initials + '</span>';
        document.getElementById('profileImageInput').value = '';
    }
}

function previewLogo(event) {
    const file = event.target.files[0];
    if (file) {
        // Validation simple
        const validTypes = ['image/png', 'image/jpeg', 'image/jpg', 'image/webp'];
        if (!validTypes.includes(file.type)) {
            alert('Le logo doit être au format PNG, JPEG ou WEBP.');
            event.target.value = '';
            return;
        }

        // Affichage de la prévisualisation
        const reader = new FileReader();
        reader.onload = function(e) {
            const logoSection = document.querySelector('.logo-section');
            let previewContainer = logoSection.querySelector('.logo-preview');
            
            if (!previewContainer) {
                previewContainer = document.createElement('div');
                previewContainer.className = 'logo-preview';
                // Insérer avant les actions
                const logoActions = logoSection.querySelector('.logo-actions');
                logoSection.insertBefore(previewContainer, logoActions);
            }
            
            previewContainer.innerHTML = '<img src="' + e.target.result + '" alt="Logo Preview" class="logo-image">';
        };
        reader.readAsDataURL(file);
    }
}

function deleteLogo() {
    document.getElementById('delete-logo-form').submit();
}
</script>

{% if mecene is defined and mecene and mecene.logo %}
<form id="delete-logo-form" action="{{ path('app_profile_remove_logo') }}" method="post" style="display: none;">
    <input type="hidden" name="_token" value="{{ csrf_token('remove_logo') }}">
</form>
{% endif %}
{% endblock %}