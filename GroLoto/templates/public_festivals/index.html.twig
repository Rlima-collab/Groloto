{% extends 'base.html.twig' %}

{% block title %}Festivals - Groloto{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="{{ asset('css/dashboard.css') }}?v={{ 'now'|date('U') }}">
<link rel="stylesheet" href="{{ asset('css/weekends.css') }}?v={{ 'now'|date('U') }}">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
{% endblock %}

{% block body %}
<div class="hero-section dashboard-hero">
    <div class="hero-content">
        <div class="hero-text">
            <h1 class="hero-title">Nos Festivals</h1>
            <p class="hero-description">Plongez dans l'univers de nos festivals exceptionnels. Découvrez des événements uniques, des moments de partage et des expériences inoubliables tout au long de l'année.</p>
        </div>
    </div>
</div>

<div class="weekends-grid">
    {% for weekend in weekends %}
        <a href="{{ path('public_festival_detail', {'id': weekend.id}) }}" class="weekend-card">
            <div class="card-image">
                {% if weekend.coverImage %}
                    {% if weekend.coverImage matches('/^uploads\\//') or weekend.coverImage matches('/^images\\//') %}
                        <img src="{{ asset(weekend.coverImage) }}" alt="{{ weekend.nom }}">
                    {% else %}
                        <img src="{{ asset('uploads/weekends/' ~ weekend.coverImage) }}" alt="{{ weekend.nom }}">
                    {% endif %}
                {% else %}
                    <div class="card-placeholder">
                        <i class="bi bi-calendar-event"></i>
                        <span class="placeholder-date">
                            {% if weekend.dateDebut %}{{ weekend.dateDebut|date('d M Y') }}{% endif %}
                        </span>
                    </div>
                {% endif %}
            </div>
            <div class="card-body">
                <h3 class="card-title">{{ weekend.nom }}</h3>
                {% if weekend.dateDebut %}
                    <div class="card-dates">
                        <i class="bi bi-calendar3"></i>
                        <span>{{ weekend.dateDebut|date('d/m/Y') }}{% if weekend.dateFin %} - {{ weekend.dateFin|date('d/m/Y') }}{% endif %}</span>
                    </div>
                {% endif %}
                {% if weekend.description %}
                    <p class="card-description">{{ weekend.description|length > 100 ? weekend.description|slice(0, 100) ~ '...' : weekend.description }}</p>
                {% endif %}
                <div class="card-action">
                    <span>Découvrir <i class="bi bi-arrow-right"></i></span>
                </div>
            </div>
        </a>
    {% else %}
        <div class="empty-state">
            <div class="empty-icon">
                <i class="bi bi-calendar-x"></i>
            </div>
            <h3>Aucun festival à venir</h3>
            <p>Les prochains festivals seront bientôt annoncés.<br>Revenez nous voir prochainement !</p>
        </div>
    {% endfor %}
</div>
{% endblock %}