{% extends 'base.html.twig' %}

{% block title %}{{ weekend.nom }} - Groloto{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="{{ asset('css/weekends.css') }}">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
{% endblock %}

{% block body %}
<div class="weekend-banner {% if not weekend.coverImage %}no-image{% endif %}">
    <a href="{{ path('public_festivals') }}" class="back-button" title="Retour à la liste">
        <i class="bi bi-arrow-left"></i>
    </a>
    {% if weekend.coverImage %}
        {% if weekend.coverImage matches('/^uploads\\//') or weekend.coverImage matches('/^images\\//') %}
            <img src="{{ asset(weekend.coverImage) }}" alt="{{ weekend.nom }}" class="banner-image">
        {% else %}
            <img src="{{ asset('uploads/weekends/' ~ weekend.coverImage) }}" alt="{{ weekend.nom }}" class="banner-image">
        {% endif %}
    {% else %}
        <div class="banner-placeholder">
            <i class="bi bi-calendar-event"></i>
            <span class="placeholder-date">{{ weekend.dateDebut|date('d M Y') }}</span>
        </div>
    {% endif %}
</div>

<div class="weekend-header">
    <h1>{{ weekend.nom }}</h1>
    <p class="weekend-description">{{ weekend.description }}</p>
    <div class="weekend-dates">
        <i class="bi bi-calendar3"></i>
        <span>Du {{ weekend.dateDebut|date('d/m/Y') }}{% if weekend.dateFin %} au {{ weekend.dateFin|date('d/m/Y') }}{% endif %}</span>
    </div>
</div>

<div class="weekend-content">
    {% if evenements|length > 0 %}
        <div class="events-timeline">
            {% for evenement in evenements %}
                <div class="event-row {% if loop.index is odd %}left-image{% else %}right-image{% endif %}">
                    <div class="event-image">
                        {% if evenement.image %}
                            <img src="{{ asset('images/evenements/' ~ evenement.image) }}" alt="{{ evenement.nom }}">
                        {% else %}
                            <img src="{{ asset('images/sidebar/logo_evenement.png') }}" alt="{{ evenement.nom }}">
                        {% endif %}
                    </div>
                    <div class="event-details">
                        <h2>{{ evenement.nom }}</h2>
                        <div class="event-info">
                            {% if evenement.dateDebut %}
                                <p class="event-date">
                                    <i class="bi bi-calendar-event"></i> 
                                    {{ evenement.dateDebut|date('l d F Y')|replace({
                                        'Monday': 'Lundi', 'Tuesday': 'Mardi', 'Wednesday': 'Mercredi', 'Thursday': 'Jeudi', 'Friday': 'Vendredi', 'Saturday': 'Samedi', 'Sunday': 'Dimanche',
                                        'January': 'Janvier', 'February': 'Février', 'March': 'Mars', 'April': 'Avril', 'May': 'Mai', 'June': 'Juin', 'July': 'Juillet', 'August': 'Août', 'September': 'Septembre', 'October': 'Octobre', 'November': 'Novembre', 'December': 'Décembre'
                                    }) }}
                                </p>
                            {% endif %}
                            {% if evenement.heureDebut %}
                                <p class="event-time">
                                    <i class="bi bi-clock"></i> 
                                    {{ evenement.heureDebut|date('H:i') }}
                                    {% if evenement.dureeMinutes %}
                                        {% set h = (evenement.dureeMinutes / 60)|round(0, 'floor') %}
                                        {% set m = evenement.dureeMinutes % 60 %}
                                        <span class="duration">
                                            ({% if h > 0 %}{{ h }}h{{ m > 0 ? (m < 10 ? '0' ~ m : m) : '' }}{% else %}{{ m }} min{% endif %})
                                        </span>
                                    {% endif %}
                                </p>
                            {% endif %}
                            {% if evenement.lieu %}
                                <p class="event-location">
                                    <i class="bi bi-geo-alt"></i> 
                                    {{ evenement.lieu }}
                                </p>
                            {% endif %}
                        </div>
                        <p class="event-description">
                            {{ evenement.description|nl2br }}
                        </p>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="no-events">
            <div class="no-events-icon">
                <i class="bi bi-calendar-x"></i>
            </div>
            <h3>Aucun événement programmé</h3>
            <p>Les événements de ce festival seront bientôt annoncés.</p>
        </div>
    {% endif %}
</div>
{% endblock %}