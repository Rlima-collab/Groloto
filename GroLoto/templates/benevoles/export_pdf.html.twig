<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Export Bénévoles</title>
    <style>
        * {
            margin: 0;
            padding: 0;
        }
        body {
            font-family: DejaVu Sans, Arial, sans-serif;
            font-size: 10px;
            color: #333;
            line-height: 1.4;
        }
        .header {
            text-align: center;
            margin-bottom: 30px;
            border-bottom: 2px solid #10b981;
            padding-bottom: 15px;
        }
        .header h1 {
            font-size: 24px;
            color: #10b981;
            margin-bottom: 5px;
        }
        .header p {
            font-size: 10px;
            color: #666;
        }
        .info-row {
            margin-bottom: 20px;
            display: flex;
            justify-content: space-between;
            font-size: 9px;
            color: #666;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }
        table th {
            background-color: #10b981;
            color: white;
            padding: 8px;
            text-align: left;
            font-weight: bold;
            font-size: 9px;
            border: 1px solid #ddd;
        }
        table td {
            padding: 6px;
            border: 1px solid #ddd;
            font-size: 9px;
        }
        table tr:nth-child(even) {
            background-color: #f5f5f5;
        }
        .footer {
            margin-top: 30px;
            text-align: center;
            font-size: 8px;
            color: #999;
            border-top: 1px solid #ddd;
            padding-top: 10px;
        }
        .stats {
            background-color: #f0fdf4;
            padding: 10px;
            border-radius: 5px;
            margin-bottom: 20px;
            font-size: 10px;
        }
        .stats-item {
            display: inline-block;
            margin-right: 20px;
            font-weight: bold;
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>Liste des Bénévoles</h1>
        <p>Export généré le {{ date_generation|date('d/m/Y à H:i:s') }}</p>
    </div>

    <div class="info-row">
        <span><strong>Total bénévoles:</strong> {{ benevoles|length }}</span>
        <span><strong>Tâches réalisées:</strong> {{ benevoles|reduce((carry, item) => carry + item.nb_taches_realisees, 0) }}</span>
    </div>

    <table>
        <thead>
            <tr>
                <th style="width: 15%">Prénom</th>
                <th style="width: 15%">Nom</th>
                <th style="width: 20%">Email</th>
                <th style="width: 15%">Téléphone</th>
                <th style="width: 12%">Date d'inscription</th>
                <th style="width: 10%">Tâches réalisées</th>
                <th style="width: 13%">Remarques</th>
            </tr>
        </thead>
        <tbody>
            {% for item in benevoles %}
                {% set benevole = item.benevole %}
                <tr>
                    <td>{{ benevole.utilisateur.prenom }}</td>
                    <td>{{ benevole.utilisateur.nom }}</td>
                    <td>{{ benevole.utilisateur.email }}</td>
                    <td>{{ benevole.utilisateur.telephone ?? 'N/A' }}</td>
                    <td>{{ benevole.utilisateur.dateCreation|date('d/m/Y') }}</td>
                    <td style="text-align: center;">{{ item.nb_taches_realisees }}</td>
                    <td>{{ benevole.remarque ?? 'Aucune' }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    <div class="footer">
        <p>Ce document a été généré automatiquement par le système de gestion de GroLoto.</p>
    </div>
</body>
</html>
