<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Planning - {{ weekend.nom }}</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'DejaVu Sans', Arial, sans-serif;
            font-size: 11pt;
            line-height: 1.6;
            color: #1e293b;
            padding: 20px;
        }
        
        .header {
            text-align: center;
            margin-bottom: 30px;
            padding-bottom: 20px;
            border-bottom: 3px solid #1a3c5a;
        }
        
        .header h1 {
            color: #1a3c5a;
            font-size: 24pt;
            margin-bottom: 10px;
        }
        
        .header .dates {
            color: #64748b;
            font-size: 12pt;
            margin-bottom: 5px;
        }
        
        .header .benevole {
            color: #475569;
            font-size: 10pt;
            font-style: italic;
        }
        
        .info-box {
            background: #f1f5f9;
            border-left: 4px solid #1a3c5a;
            padding: 15px;
            margin-bottom: 25px;
        }
        
        .info-box h3 {
            color: #1a3c5a;
            font-size: 12pt;
            margin-bottom: 8px;
        }
        
        .info-box p {
            color: #475569;
            font-size: 10pt;
        }
        
        .date-section {
            margin-top: 30px;
            page-break-inside: avoid;
        }
        
        .date-header {
            background: #1a3c5a;
            color: white;
            padding: 10px 15px;
            font-size: 13pt;
            font-weight: bold;
            margin-bottom: 15px;
        }
        
        .tache {
            background: white;
            border: 1px solid #e2e8f0;
            border-left: 4px solid #2b5d8a;
            padding: 15px;
            margin-bottom: 15px;
            page-break-inside: avoid;
        }
        
        .tache-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 12px;
            border-bottom: 1px solid #e2e8f0;
            padding-bottom: 8px;
        }
        
        .tache-title {
            color: #1a3c5a;
            font-size: 14pt;
            font-weight: bold;
        }
        
        .tache-time {
            color: white;
            background: #1a3c5a;
            padding: 5px 12px;
            border-radius: 4px;
            font-size: 10pt;
            font-weight: bold;
        }
        
        .tache-details {
            margin-top: 10px;
        }
        
        .detail-row {
            margin-bottom: 6px;
            color: #475569;
            font-size: 10pt;
        }
        
        .detail-label {
            display: inline-block;
            min-width: 100px;
            font-weight: bold;
            color: #1e293b;
        }
        
        .remarque {
            background: #fef3c7;
            border-left: 3px solid #f59e0b;
            padding: 10px;
            margin-top: 10px;
            font-size: 10pt;
            color: #92400e;
        }
        
        .summary {
            margin-top: 30px;
            background: #f8fafc;
            border: 2px solid #1a3c5a;
            padding: 15px;
            page-break-inside: avoid;
        }
        
        .summary h3 {
            color: #1a3c5a;
            font-size: 13pt;
            margin-bottom: 12px;
        }
        
        .summary-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }
        
        .summary-item {
            padding: 8px;
            background: white;
            border-radius: 4px;
        }
        
        .summary-label {
            color: #64748b;
            font-size: 9pt;
            margin-bottom: 3px;
        }
        
        .summary-value {
            color: #1a3c5a;
            font-size: 13pt;
            font-weight: bold;
        }
        
        .footer {
            margin-top: 40px;
            text-align: center;
            color: #94a3b8;
            font-size: 8pt;
            border-top: 1px solid #e2e8f0;
            padding-top: 15px;
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>{{ weekend.nom }}</h1>
        <div class="dates">
            📅 Du {{ weekend.dateDebut|date('d/m/Y') }} au {{ weekend.dateFin|date('d/m/Y') }}
        </div>
        <div class="benevole">
            Planning de : {{ benevole.utilisateur.prenom }} {{ benevole.utilisateur.nom }}
        </div>
    </div>

    {% if weekend.description %}
        <div class="info-box">
            <h3>ℹ️ Description du weekend</h3>
            <p>{{ weekend.description|nl2br }}</p>
        </div>
    {% endif %}

    {% set currentDate = null %}
    {% for tache in taches %}
        {% set tacheDate = tache.debut|date('Y-m-d') %}
        {% if currentDate != tacheDate %}
            {% set currentDate = tacheDate %}
            <div class="date-section">
                <div class="date-header">
                    {{ tache.debut|date('l d F Y')|capitalize }}
                </div>
        {% endif %}

        <div class="tache">
            <div class="tache-header">
                <div class="tache-title">{{ tache.titre }}</div>
                <div class="tache-time">
                    🕐 {{ tache.debut|date('H:i') }} - {{ tache.fin|date('H:i') }}
                </div>
            </div>

            <div class="tache-details">
                <div class="detail-row">
                    <span class="detail-label">⏱️ Durée :</span>
                    {{ ((tache.fin.timestamp - tache.debut.timestamp) / 3600)|number_format(1) }} heures
                </div>

                {% if tache.posteRequis %}
                    <div class="detail-row">
                        <span class="detail-label">👤 Poste :</span>
                        {{ tache.posteRequis }}
                    </div>
                {% endif %}

                {% if tache.maxPersonnes %}
                    <div class="detail-row">
                        <span class="detail-label">👥 Équipe :</span>
                        {{ tache.maxPersonnes }} personne{{ tache.maxPersonnes > 1 ? 's' : '' }} maximum
                    </div>
                {% endif %}
            </div>

            {% if tache.remarque %}
                <div class="remarque">
                    <strong>💬 Remarque :</strong> {{ tache.remarque }}
                </div>
            {% endif %}
        </div>

        {% if loop.last or taches[loop.index].debut|date('Y-m-d') != tacheDate %}
            </div>
        {% endif %}
    {% endfor %}

    <div class="summary">
        <h3>📊 Résumé de votre planning</h3>
        <div class="summary-grid">
            <div class="summary-item">
                <div class="summary-label">Nombre de tâches</div>
                <div class="summary-value">{{ taches|length }}</div>
            </div>
            <div class="summary-item">
                <div class="summary-label">Heures totales</div>
                <div class="summary-value">
                    {% set totalHeures = 0 %}
                    {% for tache in taches %}
                        {% set totalHeures = totalHeures + ((tache.fin.timestamp - tache.debut.timestamp) / 3600) %}
                    {% endfor %}
                    {{ totalHeures|number_format(1) }}h
                </div>
            </div>
        </div>
    </div>

    <div class="footer">
        Document généré le {{ "now"|date('d/m/Y à H:i') }} - GroLoto Planning
    </div>
</body>
</html>
