{% extends 'base.html.twig' %}

{% block title %}Planning de {{ benevole.utilisateur.prenom }} {{ benevole.utilisateur.nom }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/modele.css') }}">
    <link rel="stylesheet" href="{{ asset('css/benevoles.css') }}">
    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.css" rel="stylesheet">
{% endblock %}

{% block body %}
<div class="hero-section">
    <div class="shine"></div>
    <div class="hero-content">
        <h1 class="hero-title">Planning Bénévole</h1>
        <p class="hero-description">Consultez le planning et les disponibilités de {{ benevole.utilisateur.prenom }} {{ benevole.utilisateur.nom }}.</p>
        <a href="{{ path('benevoles') }}" class="hero-btn yellow">Retour aux bénévoles</a>
    </div>
</div>

<div class="page-header">
    <h1 class="page-title">Planning de {{ benevole.utilisateur.prenom }} {{ benevole.utilisateur.nom }}</h1>
    <a href="{{ path('benevoles') }}" class="btn btn-secondary">Retour à la liste</a>
</div>

<div class="benevoles-page">
    <div class="container">
        <div class="card main-card">
            <div class="card-header">
                <h2 class="card-title">Informations du bénévole</h2>
            </div>
            <div class="card-content">
                <div class="info-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 1.5rem;">
                    <div class="info-item">
                        <span class="info-label">Email:</span>
                        <span class="info-text">{{ benevole.utilisateur.email }}</span>
                    </div>
                    {% if benevole.utilisateur.telephone %}
                    <div class="info-item">
                        <span class="info-label">Téléphone:</span>
                        <span class="info-text">{{ benevole.utilisateur.telephone }}</span>
                    </div>
                    {% endif %}
                    <div class="info-item">
                        <span class="info-label">Inscrit le:</span>
                        <span class="info-text">{{ benevole.utilisateur.dateCreation|date('d/m/Y') }}</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="card main-card" style="margin-top: 1.5rem;">
            <div class="card-header">
                <h2 class="card-title">Calendrier des tâches assignées</h2>
            </div>
            <div class="card-content">
                <div class="row" style="display: flex; gap: 20px;">
                    <div style="flex: 2;">
                        <div class="card">
                            <div class="card-header">
                                <h5 class="card-title">Vue calendrier</h5>
                            </div>
                            <div class="card-content">
                                <div style="margin-bottom: 1em;">
                                    <button class="btn btn-outline-primary active" id="btn-month" onclick="changeCalendarView('dayGridMonth')">Mois</button>
                                    <button class="btn btn-outline-primary" id="btn-week" onclick="changeCalendarView('timeGridWeek')">Semaine</button>
                                </div>
                                <div id="calendar"></div>
                            </div>
                        </div>
                    </div>
                    
                    <div style="flex: 1;">
                        <div class="card">
                            <div class="card-header">
                                <h5 class="card-title">Tâches à venir</h5>
                            </div>
                            <div class="card-content">
                                {% if taches_proches is defined and taches_proches is not empty %}
                                    {% for tache in taches_proches %}
                                        <div class="card" style="margin-bottom: 10px; padding: 10px; border: 1px solid #ddd;">
                                            <h6>{{ tache.titre }}</h6>
                                            <p style="font-size: 0.9em; margin: 5px 0;">
                                                📅 {{ tache.debut|date('d/m/Y H:i') }}
                                                {% if tache.poste_requis %}
                                                    <br>💼 {{ tache.poste_requis }}
                                                {% endif %}
                                            </p>
                                        </div>
                                    {% endfor %}
                                {% else %}
                                    <div style="text-align: center; padding: 20px; color: #666;">
                                        Aucune tâche planifiée.
                                    </div>
                                {% endif %}
                            </div>
                        </div>

                        <div class="card" style="margin-top: 10px;">
                            <div class="card-header">
                                <h5 class="card-title">Tâches réalisées</h5>
                            </div>
                            <div class="card-content">
                                {% if taches_realisees is defined and taches_realisees is not empty %}
                                    {% for tache in taches_realisees %}
                                        <div class="card" style="margin-bottom: 10px; padding: 10px; border: 1px solid #e0e0e0; background:#fafafa;">
                                            <h6>{{ tache.titre }}</h6>
                                            <p style="font-size: 0.85em; margin: 5px 0; color:#666;">
                                                ✅ Du {{ tache.debut|date('d/m/Y H:i') }} au {{ tache.fin|date('d/m/Y H:i') }}
                                                {% if tache.poste_requis %}
                                                    <br>💼 {{ tache.poste_requis }}
                                                {% endif %}
                                            </p>
                                        </div>
                                    {% endfor %}
                                {% else %}
                                    <div style="text-align: center; padding: 12px; color: #666;">
                                        Aucune tâche réalisée pour le moment.
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
window.calendarInstance = null;

function loadFullCalendarScript() {
    return new Promise((resolve, reject) => {
        if (typeof FullCalendar !== 'undefined') {
            console.log('FullCalendar déjà disponible');
            resolve();
            return;
        }
        
        const script = document.createElement('script');
        script.src = '{{ asset('js/fullcalendar/index.global.min.js') }}';
        console.log('Chargement de FullCalendar depuis asset local:', script.src);
        
        script.onload = function() {
            console.log('Script FullCalendar chargé');
            setTimeout(() => {
                if (typeof FullCalendar !== 'undefined') {
                    console.log('FullCalendar disponible !');
                    resolve();
                } else {
                    console.error('FullCalendar non trouvé après chargement');
                    reject(new Error('FullCalendar non disponible après chargement'));
                }
            }, 100);
        };
        
        script.onerror = function(error) {
            console.error('Échec du chargement de FullCalendar:', error);
            reject(new Error('Impossible de charger FullCalendar'));
        };
        
        document.head.appendChild(script);
    });
}

function initializeCalendar(viewType = 'dayGridMonth') {
    console.log('Tentative d\'initialisation du calendrier...');
    const calendarEl = document.getElementById('calendar');
    if (!calendarEl) {
        console.error('Element #calendar non trouvé dans le DOM');
        return;
    }
    if (typeof FullCalendar === 'undefined') {
        loadFullCalendarScript().then(() => {
            setTimeout(() => {
                initializeCalendar(viewType);
            }, 100);
        }).catch(error => {
            loadFullCalendarAlternative();
        });
        return;
    }
    if (window.calendarInstance) {
        window.calendarInstance.destroy();
        window.calendarInstance = null;
    }
    const events = {{ taches|json_encode|raw }};
    try {
        window.calendarInstance = new FullCalendar.Calendar(calendarEl, {
            initialView: viewType,
            locale: 'fr',
            height: 'auto',
            hiddenDays: [],
            headerToolbar: {
                left: 'prev,next today',
                center: 'title',
                right: ''
            },
            buttonText: {
                today: 'Aujourd\'hui',
                month: 'Mois',
                week: 'Semaine',
                day: 'Jour',
            },
            events: events,
            eventClick: function(info) {
                const event = info.event;
                const props = event.extendedProps;
                let details = 'Titre: ' + event.title + '\n';
                details += 'Début: ' + event.start.toLocaleString() + '\n';
                details += 'Fin: ' + event.end.toLocaleString() + '\n';
                if (props.evenement) details += 'Événement: ' + props.evenement + '\n';
                if (props.poste_requis) details += 'Poste: ' + props.poste_requis + '\n';
                if (props.max_personnes) details += 'Max personnes: ' + props.max_personnes + '\n';
                if (props.remarques) details += 'Remarques: ' + props.remarques + '\n';
                alert(details);
            },
            eventDisplay: 'block',
            nowIndicator: true,
            slotMinTime: '07:00:00',
            slotMaxTime: '22:00:00',
            allDaySlot: false,
            firstDay: 1
        });
        window.calendarInstance.render();
    } catch (error) {
        loadFullCalendarAlternative();
    }
}

function changeCalendarView(viewType) {
    if (window.calendarInstance) {
        window.calendarInstance.changeView(viewType);
    } else {
        initializeCalendar(viewType);
    }
    document.getElementById('btn-month').classList.toggle('active', viewType === 'dayGridMonth');
    document.getElementById('btn-week').classList.toggle('active', viewType === 'timeGridWeek');
}

function loadFullCalendarAlternative() {
    console.log('Tentative de chargement alternatif de FullCalendar...');
    const calendarEl = document.getElementById('calendar');
    if (calendarEl) {
        calendarEl.innerHTML = '<div style="text-align: center; padding: 20px; color: #666;">' +
            '<p>⚠️ Impossible de charger le calendrier</p>' +
            '<p>Vérifiez votre connexion internet</p>' +
            '</div>';
    }
}

document.addEventListener('DOMContentLoaded', function() {
    console.log('DOM Content Loaded - Initialisation du calendrier');
    setTimeout(() => {
        initializeCalendar();
    }, 200);
});
</script>

{% endblock %}
