{% extends 'base.html.twig' %}

{% block title %}Mes Weekends{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/modele.css') }}">
    <link rel="stylesheet" href="{{ asset('css/benevoles/benevoles-common.css') }}">
    <link rel="stylesheet" href="{{ asset('css/benevoles/benevoles-list.css') }}">
{% endblock %}

{% block body %}
<div class="hero-section benevoles-hero">
    <div class="shine"></div>
    <div class="hero-content">
        <h1 class="hero-title">Mon Planning</h1>
        <p class="hero-description">Consultez vos weekends et téléchargez votre planning.</p>
        <a href="{{ path('dashboard') }}" class="btn-login">Retour au tableau de bord</a>
    </div>
</div>

<div class="metrics-grid">
    <div class="metric-card">
        <h3>Weekends</h3>
        <p class="metric-value">{{ total_weekends }}</p>
        <p class="metric-detail">Où vous êtes inscrit</p>
    </div>

    <div class="metric-card">
        <h3>Tâches futures</h3>
        <p class="metric-value">{{ total_taches_futures }}</p>
        <p class="metric-detail">À venir</p>
    </div>

    <div class="metric-card">
        <h3>Tâches réalisées</h3>
        <p class="metric-value">{{ total_taches_realisees }}</p>
        <p class="metric-detail">Terminées</p>
    </div>
</div>

<div class="container">
    <div class="card">
        <div class="card-header">
            <h5 class="card-title">Mes Weekends</h5>
        </div>
        <div class="card-content">
            {% if weekends is not empty %}
                <div class="weekends-grid">
                    {% for weekend in weekends %}
                        <div class="weekend-card">
                            {% if weekend.cover_image %}
                                {% set imagePath = weekend.cover_image %}
                                <div class="weekend-image">
                                    {% if imagePath starts with 'uploads/' %}
                                        <img src="{{ asset(imagePath) }}" alt="{{ weekend.nom }}">
                                    {% else %}
                                        <img src="{{ asset('uploads/weekends/' ~ imagePath) }}" alt="{{ weekend.nom }}">
                                    {% endif %}
                                    <div class="weekend-overlay"></div>
                                </div>
                            {% else %}
                                <div class="weekend-image-empty">
                                    <i class="bi bi-image"></i>
                                </div>
                            {% endif %}
                            <div class="weekend-content">
                                <div class="weekend-header">
                                    <h3>{{ weekend.nom }}</h3>
                                    <span class="weekend-date">
                                        <i class="bi bi-calendar-event"></i>
                                        {{ weekend.date_debut|date('d/m/Y') }} - {{ weekend.date_fin|date('d/m/Y') }}
                                    </span>
                                </div>
                                {% if weekend.description %}
                                    <div class="weekend-description">
                                        {{ weekend.description|length > 120 ? weekend.description|slice(0, 120) ~ '...' : weekend.description }}
                                    </div>
                                {% endif %}
                                <div class="weekend-footer">
                                    <div class="weekend-stats">
                                        <span class="stat-badge">
                                            <i class="bi bi-list-check"></i>
                                            {{ weekend.nb_taches }} tâche{{ weekend.nb_taches > 1 ? 's' : '' }}
                                        </span>
                                    </div>
                                    <a href="{{ path('benevole_planning_weekend', {id: weekend.id}) }}" class="btn-primary">
                                        <i class="bi bi-arrow-right"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <div class="empty-state">
                    <i class="bi bi-calendar-x" style="font-size: 4rem; color: #94a3b8;"></i>
                    <h3>Aucun weekend</h3>
                    <p>Vous n'êtes inscrit à aucune tâche pour le moment.</p>
                </div>
            {% endif %}
        </div>
    </div>
</div>

<style>
.weekends-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 1.5rem;
    margin-top: 1rem;
}

.weekend-card {
    background: white;
    border: 2px solid #e2e8f0;
    border-radius: 16px;
    padding: 0;
    overflow: hidden;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    display: flex;
    flex-direction: column;
    height: 100%;
    position: relative;
}

.weekend-card:hover {
    box-shadow: 0 12px 32px rgba(26, 60, 90, 0.2);
    transform: translateY(-6px);
    border-color: #1a3c5a;
}

.weekend-image {
    width: 100%;
    height: 220px;
    overflow: hidden;
    position: relative;
    background: linear-gradient(135deg, #f0f7ff 0%, #e0ecff 100%);
}

.weekend-image-empty {
    width: 100%;
    height: 220px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #f0f7ff 0%, #e0ecff 100%);
    color: #94a3b8;
    font-size: 3rem;
}

.weekend-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(180deg, rgba(26, 60, 90, 0) 0%, rgba(26, 60, 90, 0.15) 100%);
}

.weekend-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
}

.weekend-card:hover .weekend-image img {
    transform: scale(1.08);
}

.weekend-content {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    padding: 1.5rem;
}

.weekend-header {
    margin-bottom: 0.75rem;
}

.weekend-header h3 {
    color: #1a3c5a;
    font-size: 1.35rem;
    margin: 0 0 0.5rem 0;
    font-weight: 700;
    line-height: 1.3;
}

.weekend-date {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #64748b;
    font-size: 0.85rem;
    font-weight: 500;
}

.weekend-date i {
    color: #1a3c5a;
}

.weekend-description {
    color: #475569;
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 0.75rem 0;
    flex-grow: 1;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.weekend-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid #e2e8f0;
}

.weekend-stats {
    display: flex;
    gap: 0.5rem;
}

.stat-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.75rem;
    background: #f0f7ff;
    color: #1a3c5a;
    border-radius: 8px;
    font-size: 0.8rem;
    font-weight: 600;
    border: 1px solid #d0e4f7;
}

.stat-badge i {
    font-size: 0.85rem;
}

.btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    background: linear-gradient(135deg, #1a3c5a 0%, #2b5d8a 100%);
    color: white;
    text-decoration: none;
    border-radius: 10px;
    font-weight: 600;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
    font-size: 1.1rem;
    flex-shrink: 0;
}

.btn-primary:hover {
    background: linear-gradient(135deg, #2b5d8a 0%, #3c7aaa 100%);
    transform: translateY(-2px) scale(1.05);
    box-shadow: 0 6px 16px rgba(26, 60, 90, 0.25);
}

.btn-primary:active {
    transform: translateY(0) scale(0.98);
}

.empty-state {
    text-align: center;
    padding: 4rem 2rem;
    color: #64748b;
}

.empty-state i {
    display: block;
    margin-bottom: 1rem;
    color: #cbd5e1;
}

.empty-state h3 {
    color: #1a3c5a;
    margin-top: 1rem;
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
}

.empty-state p {
    margin: 0;
    font-size: 1rem;
}
</style>

<style>
.modal {
    position: fixed;
    z-index: 1000;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    overflow: auto;
    background-color: rgba(0,0,0,0.4);
}

.modal-content {
    background-color: #fefefe;
    margin: 10% auto;
    padding: 20px;
    border: 1px solid #888;
    border-radius: 8px;
    width: 80%;
}

.close {
    color: #aaa;
    float: right;
    font-size: 28px;
    font-weight: bold;
    cursor: pointer;
}

.close:hover,
.close:focus {
    color: black;
}

.form-group {
    margin-bottom: 1rem;
}

.form-group label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 600;
}

.form-control {
    width: 100%;
    padding: 0.5rem;
    border: 1px solid #d1d5db;
    border-radius: 0.375rem;
    font-size: 1rem;
}

.btn-small {
    padding: 0.25rem 0.5rem;
    font-size: 0.875rem;
}

.btn-danger {
    background-color: #dc2626;
    color: white;
    border: none;
    cursor: pointer;
}

.btn-danger:hover {
    background-color: #b91c1c;
}

.btn-outline-night-blue {
    background: transparent;
    border: 2px solid #1a3c5a;
    color: #1a3c5a;
    padding: 0.5rem 1rem;
    border-radius: 0.375rem;
    cursor: pointer;
    transition: all 0.2s;
}

.btn-outline-night-blue:hover,
.btn-outline-night-blue.active {
    background: #1a3c5a;
    color: white;
}
</style>
{% endblock %}
