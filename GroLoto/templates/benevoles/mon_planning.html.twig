{% extends 'base.html.twig' %}

{% block title %}Mon Planning{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/modele.css') }}">
    <link rel="stylesheet" href="{{ asset('css/benevoles/benevoles-common.css') }}">
    <link rel="stylesheet" href="{{ asset('css/benevoles/benevoles-list.css') }}">
    <link rel="stylesheet" href="{{ asset('css/festival/festival-list.css') }}">

    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.css" rel="stylesheet">
{% endblock %}

{% block body %}
<div class="hero-section benevoles-hero">
    <div class="shine"></div>
    <div class="hero-content">
        <h1 class="hero-title">Mon Planning</h1>
        <p class="hero-description">Consultez vos weekends et téléchargez votre planning.</p>
        <a href="https://www.impots.gouv.fr/sites/default/files/formulaires/2041-rd/2023/2041-rd_4298.pdf" target="_blank" class="btn-login">Télécharger son reçu fiscal</a>
        <form method="post" action="{{ path('benevole_recu_send') }}" style="display:inline-block;margin-left:10px;">
            <input type="hidden" name="_token" value="{{ csrf_token('send_recu_benevole') }}">
            <button type="submit" class="btn-login btn-secondary">Envoyer au admin</button>
        </form>
    </div>
</div>
<br>

 
<div class="metrics-grid">
    <div class="metric-card">
        <h3>Total tâches</h3>
        <p class="metric-value">{{ total_taches }}</p>
        <p class="metric-detail">Toutes les tâches</p>
    </div>

    <div class="metric-card">
        <h3>Tâches futures</h3>
        <p class="metric-value">{{ total_futures }}</p>
        <p class="metric-detail">À venir</p>
    </div>

    <div class="metric-card">
        <h3>Tâches réalisées</h3>
        <p class="metric-value">{{ total_realisees }}</p>
        <p class="metric-detail">Complétées</p>
    </div>
</div>

<div class="container">
    <div class="dashboard-grid" style="display: grid; grid-template-columns: 2fr 1fr; gap: 1.5rem;">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title">Calendrier des tâches</h5>
            </div>
            <div class="card-content">
                <div style="margin-bottom: 1rem; text-align: center;">
                    <button class="btn-outline-night-blue active" id="btn-month" onclick="changeCalendarView('dayGridMonth')">Mois</button>
                    <button class="btn-outline-night-blue" id="btn-week" onclick="changeCalendarView('timeGridWeek')">Semaine</button>
                </div>
                <div id="calendar"></div>
            </div>
        </div>
        
        <div>
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title">Tâches à venir</h5>
                </div>
                <div class="card-content">
                    <div class="events-list" style="max-height: 300px; overflow-y: auto;">
                        {% if taches_proches is defined and taches_proches is not empty %}
                            {% for tache in taches_proches %}
                                <div class="event-item blue-night-accent animate-fade-in">
                                    <div class="event-date">
                                        <div class="event-month">{{ tache.debut|date('M')|upper }}</div>
                                        <div class="event-day">{{ tache.debut|date('d') }}</div>
                                    </div>
                                    <div class="event-details" style="flex: 1;">
                                        <h4 class="event-title">{{ tache.titre }}</h4>
                                        <p class="event-time">{{ tache.debut|date('H\\hi') }}{% if tache.poste_requis %} - {{ tache.poste_requis }}{% endif %}</p>
                                    </div>
                                    <div class="event-actions" style="margin-left: 0.5rem;">
                                        {% if tache.demande_annulation_en_attente %}
                                            <span class="badge" style="background: #f59e0b; color: white; padding: 0.25rem 0.5rem; border-radius: 0.25rem; font-size: 0.75rem;">
                                                Annulation demandée
                                            </span>
                                        {% elseif tache.affectation_id %}
                                            <button type="button" 
                                                    class="btn btn-small btn-danger"
                                                    style="font-size: 0.75rem; padding: 0.25rem 0.5rem;"
                                                    onclick="openAnnulationModal({{ tache.affectation_id }}, '{{ tache.titre|e('js') }}')"
                                                    title="Demander l'annulation">
                                                Annuler
                                            </button>
                                        {% endif %}
                                    </div>
                                </div>
                            {% endfor %}
                        {% else %}
                            <p style="text-align: center; color: #64748b; padding: 2rem;">Aucune tâche à venir.</p>
                        {% endif %}
                    </div>
                </div>
            </div>

            <div class="card" style="margin-top: 1rem;">
                <div class="card-header">
                    <h5 class="card-title">Tâches réalisées</h5>
                </div>
                <div class="card-content">
                    <div class="events-list" style="max-height: 300px; overflow-y: auto;">
                        {% if taches_realisees is defined and taches_realisees is not empty %}
                            {% for tache in taches_realisees|slice(0, 5) %}
                                <div class="history-item blue-night-accent animate-fade-in">
                                    <div class="history-date">
                                        <div class="history-day">{{ tache.debut|date('d') }}</div>
                                        <div class="history-month">{{ tache.debut|date('M')|upper }}</div>
                                    </div>
                                    <div class="history-details">
                                        <h4 class="history-title">{{ tache.titre }}</h4>
                                        <p class="history-description">
                                            {{ tache.debut|date('d/m/Y H\\hi') }}{% if tache.poste_requis %} - {{ tache.poste_requis }}{% endif %}
                                        </p>
                                    </div>
                                </div>
                            {% endfor %}
                        {% else %}
                            <p style="text-align: center; color: #64748b; padding: 2rem;">Aucune tâche réalisée.</p>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Demande d'annulation -->
<div id="annulationModal" class="modal" style="display: none;">
    <div class="modal-content" style="max-width: 500px;">
        <span class="close" onclick="closeAnnulationModal()">&times;</span>
        <h2 style="margin-top: 0; color: #dc2626;">Demander une annulation</h2>
        <p><strong>Tâche:</strong> <span id="annulationTacheNom"></span></p>
        <form id="annulationForm" method="POST">
            <input type="hidden" name="_token" id="annulationCsrfToken">
            <div class="form-group">
                <label for="motif">Motif de la demande d'annulation</label>
                <textarea name="motif" id="motif" class="form-control" rows="4" placeholder="Expliquez pourquoi vous souhaitez annuler cette tâche..." required></textarea>
            </div>
            <div style="display: flex; gap: 1rem; justify-content: flex-end; margin-top: 1.5rem;">
                <button type="button" class="btn btn-secondary" onclick="closeAnnulationModal()">Annuler</button>
                <button type="submit" class="btn btn-danger">Envoyer la demande</button>
            </div>
        </form>
    </div>
</div>

<style>
.modal {
    position: fixed;
    z-index: 1000;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    overflow: auto;
    background-color: rgba(0,0,0,0.4);
}

.modal-content {
    background-color: #fefefe;
    margin: 10% auto;
    padding: 20px;
    border: 1px solid #888;
    border-radius: 8px;
    width: 80%;
}

.close {
    color: #aaa;
    float: right;
    font-size: 28px;
    font-weight: bold;
    cursor: pointer;
}

.close:hover,
.close:focus {
    color: black;
}

.form-group {
    margin-bottom: 1rem;
}

.form-group label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 600;
}

.form-control {
    width: 100%;
    padding: 0.5rem;
    border: 1px solid #d1d5db;
    border-radius: 0.375rem;
    font-size: 1rem;
}

.btn-small {
    padding: 0.25rem 0.5rem;
    font-size: 0.875rem;
}

.btn-danger {
    background-color: #dc2626;
    color: white;
    border: none;
    cursor: pointer;
}

.btn-danger:hover {
    background-color: #b91c1c;
}

.btn-outline-night-blue {
    background: transparent;
    border: 2px solid #1a3c5a;
    color: #1a3c5a;
    padding: 0.5rem 1rem;
    border-radius: 0.375rem;
    cursor: pointer;
    transition: all 0.2s;
}

.btn-outline-night-blue:hover,
.btn-outline-night-blue.active {
    background: #1a3c5a;
    color: white;
}
</style>

<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.js"></script>
<script>
// Générer les tokens CSRF pour chaque affectation
var csrfTokens = {
    {% for tache in taches_proches %}
        {% if tache.affectation_id %}
        {{ tache.affectation_id }}: '{{ csrf_token('demander_annulation_' ~ tache.affectation_id) }}',
        {% endif %}
    {% endfor %}
};

function openAnnulationModal(affectationId, tacheNom) {
    document.getElementById('annulationTacheNom').textContent = tacheNom;
    document.getElementById('annulationForm').action = '/benevole/demander-annulation/' + affectationId;
    document.getElementById('annulationCsrfToken').value = csrfTokens[affectationId] || '';
    document.getElementById('annulationModal').style.display = 'block';
}

function closeAnnulationModal() {
    document.getElementById('annulationModal').style.display = 'none';
    document.getElementById('motif').value = '';
}

// Fermer le modal si on clique en dehors
window.onclick = function(event) {
    var modal = document.getElementById('annulationModal');
    if (event.target == modal) {
        closeAnnulationModal();
    }
}

// Calendar
var calendar;

document.addEventListener('DOMContentLoaded', function() {
    var calendarEl = document.getElementById('calendar');
    calendar = new FullCalendar.Calendar(calendarEl, {
        initialView: 'dayGridMonth',
        locale: 'fr',
        headerToolbar: {
            left: 'prev,next today',
            center: 'title',
            right: ''
        },
        events: {{ taches|raw }},
        eventClick: function(info) {
            alert('Tâche: ' + info.event.title);
        }
    });
    calendar.render();
});

function changeCalendarView(view) {
    calendar.changeView(view);
    document.querySelectorAll('.btn-outline-night-blue').forEach(btn => btn.classList.remove('active'));
    if (view === 'dayGridMonth') {
        document.getElementById('btn-month').classList.add('active');
    } else {
        document.getElementById('btn-week').classList.add('active');
    }
}
</script>
{% endblock %}
