{% extends 'base.html.twig' %}

{% block title %}Mon Planning{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/dashboard.css') }}">
    <link rel="stylesheet" href="{{ asset('css/benevoles.css') }}">
    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.css" rel="stylesheet">
{% endblock %}

{% block body %}
<div class="dashboard-container">
    <div class="dashboard-header">
        <h1>Mon Planning</h1>
        <p>{{ benevole.utilisateur.prenom }} {{ benevole.utilisateur.nom }}</p>
    </div>

    <!-- Informations du bénévole -->
    <section class="role-specific-section">
        <div class="card">
            <h3>Mes informations</h3>
            <div class="info-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem;">
                <div class="info-item">
                    <span style="font-weight: 600; color: #6b7280;">Email:</span>
                    <span style="color: #1a3c5a;">{{ benevole.utilisateur.email }}</span>
                </div>
                {% if benevole.utilisateur.telephone %}
                <div class="info-item">
                    <span style="font-weight: 600; color: #6b7280;">Téléphone:</span>
                    <span style="color: #1a3c5a;">{{ benevole.utilisateur.telephone }}</span>
                </div>
                {% endif %}
                <div class="info-item">
                    <span style="font-weight: 600; color: #6b7280;">Inscrit le:</span>
                    <span style="color: #1a3c5a;">{{ benevole.utilisateur.dateCreation|date('d/m/Y') }}</span>
                </div>
            </div>
        </div>
    </section>

    <!-- Calendrier -->
    <section class="role-specific-section">
        <h2>Calendrier de mes tâches</h2>
        <div class="card">
            <div style="display: flex; gap: 20px; flex-wrap: wrap;">
                <!-- Calendrier -->
                <div style="flex: 2; min-width: 300px;">
                    <div style="margin-bottom: 1em;">
                        <button class="btn btn-secondary active" id="btn-month" onclick="changeCalendarView('dayGridMonth')">Mois</button>
                        <button class="btn btn-secondary" id="btn-week" onclick="changeCalendarView('timeGridWeek')">Semaine</button>
                    </div>
                    <div id="calendar"></div>
                </div>
                
                <!-- Tâches à venir -->
                <div style="flex: 1; min-width: 250px;">
                    <div class="card" style="margin-bottom: 15px;">
                        <h3 style="font-size: 1.1rem; margin-bottom: 1rem;">Tâches à venir</h3>
                        {% if taches_proches is not empty %}
                            {% for tache in taches_proches %}
                                <div class="event-item" style="padding: 10px; margin-bottom: 10px; border-bottom: 1px solid #e5e7eb;">
                                    <h4 style="font-size: 0.95rem; color: #1a3c5a; margin: 0 0 5px 0;">{{ tache.titre }}</h4>
                                    <p style="font-size: 0.85em; margin: 0; color: #6b7280;">
                                        📅 {{ tache.debut|date('d/m/Y H:i') }}
                                        {% if tache.poste_requis %}
                                            <br>💼 {{ tache.poste_requis }}
                                        {% endif %}
                                    </p>
                                </div>
                            {% endfor %}
                        {% else %}
                            <p style="text-align: center; padding: 20px; color: #666;">Aucune tâche planifiée.</p>
                        {% endif %}
                    </div>

                    <div class="card">
                        <h3 style="font-size: 1.1rem; margin-bottom: 1rem;">Tâches réalisées</h3>
                        {% if taches_realisees is not empty %}
                            {% for tache in taches_realisees %}
                                <div class="event-item" style="padding: 10px; margin-bottom: 10px; border-bottom: 1px solid #e5e7eb; background: #fafafa;">
                                    <h4 style="font-size: 0.9rem; color: #1a3c5a; margin: 0 0 5px 0;">{{ tache.titre }}</h4>
                                    <p style="font-size: 0.8em; margin: 0; color: #666;">
                                        ✅ {{ tache.debut|date('d/m/Y H:i') }}
                                    </p>
                                </div>
                            {% endfor %}
                        {% else %}
                            <p style="text-align: center; padding: 20px; color: #666;">Aucune tâche réalisée.</p>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Bouton retour -->
    <div style="margin-top: 2rem;">
        <a href="{{ path('dashboard') }}" class="btn btn-secondary">Retour au tableau de bord</a>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var calendarEl = document.getElementById('calendar');
            var calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'dayGridMonth',
                locale: 'fr',
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: ''
                },
                buttonText: {
                    today: "Aujourd'hui",
                    month: 'Mois',
                    week: 'Semaine',
                    day: 'Jour'
                },
                events: {{ taches|json_encode|raw }},
                eventClick: function(info) {
                    var props = info.event.extendedProps;
                    var details = 'Événement: ' + (props.evenement || 'Non défini') + '\n';
                    details += 'Poste: ' + (props.poste_requis || 'Non défini') + '\n';
                    details += 'Début: ' + info.event.start.toLocaleString('fr-FR') + '\n';
                    details += 'Fin: ' + info.event.end.toLocaleString('fr-FR');
                    if (props.remarques) {
                        details += '\nRemarques: ' + props.remarques;
                    }
                    alert(details);
                }
            });
            calendar.render();

            // Fonction pour changer la vue
            window.changeCalendarView = function(viewType) {
                calendar.changeView(viewType);
                
                // Mettre à jour les boutons actifs
                document.querySelectorAll('.btn-secondary').forEach(btn => {
                    btn.classList.remove('active');
                });
                
                if (viewType === 'dayGridMonth') {
                    document.getElementById('btn-month').classList.add('active');
                } else if (viewType === 'timeGridWeek') {
                    document.getElementById('btn-week').classList.add('active');
                }
            };
        });
    </script>
{% endblock %}
