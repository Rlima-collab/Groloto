{% extends 'base.html.twig' %}

{% block title %}Mes Weekends{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/modele.css') }}">
    <link rel="stylesheet" href="{{ asset('css/benevoles/benevoles-common.css') }}">
    <link rel="stylesheet" href="{{ asset('css/benevoles/benevoles-list.css') }}">
{% endblock %}

{% block body %}
<div class="hero-section benevoles-hero">
    <div class="shine"></div>
    <div class="hero-content">
        <h1 class="hero-title">Mon Planning</h1>
        <p class="hero-description">Consultez vos weekends et téléchargez votre planning.</p>
        <a href="https://www.impots.gouv.fr/sites/default/files/formulaires/2041-rd/2023/2041-rd_4298.pdf" target="_blank" class="btn-login">Télécharger son reçu fiscal</a>
        <form method="post" action="{{ path('benevole_recu_send') }}" style="display:inline-block;margin-left:10px;">
            <input type="hidden" name="_token" value="{{ csrf_token('send_recu_benevole') }}">
            <button type="submit" class="btn-login btn-secondary">Envoyer au admin</button>
        </form>
    </div>
</div>

<div class="metrics-grid">
    <div class="metric-card">
        <h3>Weekends</h3>
        <p class="metric-value">{{ total_weekends }}</p>
        <p class="metric-detail">Où vous êtes inscrit</p>
    </div>

    <div class="metric-card">
        <h3>Tâches futures</h3>
        <p class="metric-value">{{ total_taches_futures }}</p>
        <p class="metric-detail">À venir</p>
    </div>

    <div class="metric-card">
        <h3>Tâches réalisées</h3>
        <p class="metric-value">{{ total_taches_realisees }}</p>
        <p class="metric-detail">Terminées</p>
    </div>
</div>

<div class="container">
    <div class="card">
        <div class="card-header">
            <h5 class="card-title">Mes Weekends</h5>
        </div>
        <div class="card-content">
            {% if weekends is not empty %}
                <div class="weekends-grid">
                    {% for weekend in weekends %}
                        <div class="weekend-card">
                            {% if weekend.cover_image %}
                                {% set imagePath = weekend.cover_image %}
                                <div class="weekend-image">
                                    {% if imagePath starts with 'uploads/' %}
                                        <img src="{{ asset(imagePath) }}" alt="{{ weekend.nom }}">
                                    {% else %}
                                        <img src="{{ asset('uploads/weekends/' ~ imagePath) }}" alt="{{ weekend.nom }}">
                                    {% endif %}
                                </div>
                            {% endif %}
                            <div class="weekend-header">
                                <h3>{{ weekend.nom }}</h3>
                                <span class="weekend-date">
                                    <i class="bi bi-calendar-event"></i>
                                    {{ weekend.date_debut|date('d/m/Y') }} - {{ weekend.date_fin|date('d/m/Y') }}
                                </span>
                            </div>
                            {% if weekend.description %}
                                <div class="weekend-description">
                                    {{ weekend.description|length > 100 ? weekend.description|slice(0, 100) ~ '...' : weekend.description }}
                                </div>
                            {% endif %}
                            <div class="weekend-actions">
                                <a href="{{ path('benevole_planning_weekend', {id: weekend.id}) }}" class="btn-primary">
                                    <i class="bi bi-eye"></i> Voir mon planning
                                </a>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <div class="empty-state">
                    <i class="bi bi-calendar-x" style="font-size: 4rem; color: #94a3b8;"></i>
                    <h3>Aucun weekend</h3>
                    <p>Vous n'êtes inscrit à aucune tâche pour le moment.</p>
                </div>
            {% endif %}
        </div>
    </div>
</div>

<style>
.weekends-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: 1.5rem;
    margin-top: 1rem;
}

.weekend-card {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 0;
    overflow: hidden;
    transition: all 0.3s ease;
}

.weekend-card:hover {
    box-shadow: 0 8px 24px rgba(26, 60, 90, 0.15);
    transform: translateY(-4px);
    border-color: #1a3c5a;
}

.weekend-image {
    width: 100%;
    height: 200px;
    overflow: hidden;
}

.weekend-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
}

.weekend-card:hover .weekend-image img {
    transform: scale(1.05);
}

.weekend-header,
.weekend-description,
.weekend-actions {
    padding: 0 1.5rem;
}

.weekend-header {
    padding-top: 1.5rem;
}

.weekend-actions {
    padding-bottom: 1.5rem;
}

.weekend-header h3 {
    color: #1a3c5a;
    font-size: 1.4rem;
    margin: 0 0 0.5rem 0;
    font-weight: 600;
}

.weekend-date {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #64748b;
    font-size: 0.9rem;
    margin-bottom: 1rem;
}

.weekend-date i {
    color: #1a3c5a;
}

.weekend-description {
    color: #475569;
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 1rem 0;
    padding: 1rem;
    background: #f8fafc;
    border-radius: 8px;
}

.weekend-actions {
    margin-top: 1.5rem;
    display: flex;
    gap: 0.5rem;
}

.btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    background: #1a3c5a;
    color: white;
    text-decoration: none;
    border-radius: 8px;
    font-weight: 500;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
}

.btn-primary:hover {
    background: #2b5d8a;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(26, 60, 90, 0.3);
}

.empty-state {
    text-align: center;
    padding: 4rem 2rem;
    color: #64748b;
}

.empty-state h3 {
    color: #1e293b;
    margin: 1rem 0 0.5rem;
}

.empty-state p {
    color: #64748b;
    font-size: 1rem;
}
</style>

{% endblock %}
