{% extends 'base.html.twig' %}

{% block title %}Tâches disponibles{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/dashboard.css') }}">
    <link rel="stylesheet" href="{{ asset('css/taches.css') }}">
{% endblock %}

{% block body %}
<div class="page-header">
    <h1 class="page-title">Tâches disponibles</h1>
    <a href="{{ path('dashboard') }}" class="btn btn-secondary">Retour au tableau de bord</a>
</div>

<div class="container" style="max-width: 1200px; margin: 0 auto; padding: 2rem;">
    
    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger">{{ message }}</div>
    {% endfor %}

    <div class="tabs" style="margin-bottom: 2rem;">
        <a href="#" class="tab selected" id="tab-disponibles" onclick="showTab('disponibles')">
            <span class="tab-text">Tâches disponibles</span>
        </a>
        <a href="#" class="tab" id="tab-mes-demandes" onclick="showTab('mes-demandes')">
            <span class="tab-text">Mes demandes</span>
        </a>
    </div>

    <div id="content-disponibles" class="tab-content">
        <div class="card">
            <div class="card-header">
                <h2 class="card-title">Tâches disponibles</h2>
                <p class="card-description">Vous pouvez demander à rejoindre ces tâches. L'administrateur validera votre demande.</p>
            </div>
            <div class="card-content">
                {% if taches_disponibles|length > 0 %}
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Tâche</th>
                                    <th>Événement</th>
                                    <th>Date et heure</th>
                                    <th>Poste</th>
                                    <th>Places</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for item in taches_disponibles %}
                                    {% set tache = item.tache %}
                                    <tr>
                                        <td><strong>{{ tache.titre }}</strong></td>
                                        <td>
                                            {% if tache.evenement %}
                                                {{ tache.evenement.nom }}
                                            {% else %}
                                                <span style="color: #999;">Aucun événement</span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            <div>{{ tache.debut|date('d/m/Y H:i') }}</div>
                                            <div style="font-size: 0.9em; color: #666;">au {{ tache.fin|date('d/m/Y H:i') }}</div>
                                        </td>
                                        <td>{{ tache.posteRequis ?: '-' }}</td>
                                        <td>
                                            <span class="badge {% if item.nbAffectations >= tache.maxPersonnes %}badge-danger{% elseif item.nbAffectations >= (tache.maxPersonnes * 0.8) %}badge-warning{% else %}badge-success{% endif %}">
                                                {{ item.nbAffectations }} / {{ tache.maxPersonnes }}
                                            </span>
                                        </td>
                                        <td>
                                            <button type="button" 
                                                    class="btn btn-small btn-primary" 
                                                    data-csrf-tache="{{ tache.id }}"
                                                    data-csrf-token="{{ csrf_token('demander_tache_' ~ tache.id) }}"
                                                    onclick="openDemandeModal({{ tache.id }}, '{{ tache.titre|escape('js') }}')">
                                                Demander
                                            </button>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <div class="alert alert-info">
                        Aucune tâche disponible pour le moment. Toutes les tâches futures sont soit complètes, soit vous y êtes déjà affecté.
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    <div id="content-mes-demandes" class="tab-content" style="display: none;">
        <div class="card">
            <div class="card-header">
                <h2 class="card-title">Mes demandes</h2>
                <p class="card-description">Historique de vos demandes d'affectation</p>
            </div>
            <div class="card-content">
                {% if mes_demandes|length > 0 %}
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Tâche</th>
                                    <th>Date demande</th>
                                    <th>Statut</th>
                                    <th>Message</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for demande in mes_demandes %}
                                    <tr class="{% if demande.statut == 'acceptee' %}row-success{% elseif demande.statut == 'refusee' %}row-muted{% endif %}">
                                        <td>
                                            <strong>{{ demande.tache.titre }}</strong>
                                            <div style="font-size: 0.9em; color: #666;">{{ demande.tache.debut|date('d/m/Y H:i') }}</div>
                                        </td>
                                        <td>{{ demande.dateDemande|date('d/m/Y H:i') }}</td>
                                        <td>
                                            {% if demande.statut == 'en_attente' %}
                                                <span class="badge badge-warning">En attente</span>
                                            {% elseif demande.statut == 'acceptee' %}
                                                <span class="badge badge-success">Acceptée</span>
                                            {% else %}
                                                <span class="badge badge-danger">Refusée</span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            {% if demande.messageBenevole %}
                                                <div style="font-size: 0.9em; margin-bottom: 5px;"><strong>Votre message:</strong> {{ demande.messageBenevole }}</div>
                                            {% endif %}
                                            {% if demande.messageAdmin %}
                                                <div style="font-size: 0.9em; color: #2563eb;"><strong>Réponse admin:</strong> {{ demande.messageAdmin }}</div>
                                            {% endif %}
                                        </td>
                                        <td>
                                            {% if demande.statut == 'en_attente' %}
                                                <form method="POST" action="{{ path('benevole_annuler_demande', {'id': demande.id}) }}" style="display: inline;">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('annuler_demande_' ~ demande.id) }}">
                                                    <button type="submit" class="btn btn-small btn-danger" onclick="return confirm('Êtes-vous sûr de vouloir annuler cette demande ?')">
                                                        Annuler
                                                    </button>
                                                </form>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <div class="alert alert-info">
                        Vous n'avez fait aucune demande pour le moment.
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>

<!-- Modal pour faire une demande -->
<div id="demandeModal" class="modal" style="display: none;">
    <div class="modal-content" style="max-width: 500px;">
        <span class="close" onclick="closeDemandeModal()">&times;</span>
        <h2 style="margin-top: 0;">Demander à rejoindre la tâche</h2>
        <p id="tacheNom" style="font-weight: bold; color: #2563eb;"></p>
        <form id="demandeForm" method="POST">
            <input type="hidden" name="_token" id="csrfToken">
            <div class="form-group">
                <label for="message">Message (optionnel)</label>
                <textarea name="message" id="message" class="form-control" rows="4" placeholder="Expliquez pourquoi vous souhaitez rejoindre cette tâche..."></textarea>
            </div>
            <div style="display: flex; gap: 1rem; justify-content: flex-end; margin-top: 1.5rem;">
                <button type="button" class="btn btn-secondary" onclick="closeDemandeModal()">Annuler</button>
                <button type="submit" class="btn btn-primary">Envoyer la demande</button>
            </div>
        </form>
    </div>
</div>

<style>
.modal {
    position: fixed;
    z-index: 1000;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    overflow: auto;
    background-color: rgba(0,0,0,0.4);
}

.modal-content {
    background-color: #fefefe;
    margin: 10% auto;
    padding: 20px;
    border: 1px solid #888;
    border-radius: 8px;
    width: 80%;
}

.close {
    color: #aaa;
    float: right;
    font-size: 28px;
    font-weight: bold;
    cursor: pointer;
}

.close:hover,
.close:focus {
    color: black;
}

.row-success {
    background-color: #f0fdf4;
}

.row-muted {
    background-color: #f9fafb;
    color: #6b7280;
}
</style>

<script>
function showTab(tabName) {
    document.querySelectorAll('.tab-content').forEach(content => {
        content.style.display = 'none';
    });
    
    document.querySelectorAll('.tab').forEach(tab => {
        tab.classList.remove('selected');
    });
    
    const contentEl = document.getElementById('content-' + tabName);
    if (contentEl) {
        contentEl.style.display = 'block';
    }
    
    const tabEl = document.getElementById('tab-' + tabName);
    if (tabEl) {
        tabEl.classList.add('selected');
    }
}

function openDemandeModal(tacheId, tacheNom) {
    document.getElementById('tacheNom').textContent = tacheNom;
    const form = document.getElementById('demandeForm');
    form.action = `/benevole/demander-tache/${tacheId}`;
    
    // Générer le token CSRF côté template
    const tokenInput = document.getElementById('csrfToken');
    tokenInput.name = '_token';
    tokenInput.value = generateCsrfToken(tacheId);
    
    document.getElementById('demandeModal').style.display = 'block';
}

// Fonction pour générer le token - on utilise une astuce avec les attributs data
function generateCsrfToken(tacheId) {
    // Le token est généré par Twig et stocké dans un attribut data
    const tokenElement = document.querySelector(`[data-csrf-tache="${tacheId}"]`);
    if (tokenElement) {
        return tokenElement.getAttribute('data-csrf-token');
    }
    // Fallback - utiliser un token générique
    return document.querySelector('[data-csrf-generic]')?.getAttribute('data-csrf-generic') || '';
}

function closeDemandeModal() {
    document.getElementById('demandeModal').style.display = 'none';
    document.getElementById('message').value = '';
}

// Fermer le modal si on clique en dehors
window.onclick = function(event) {
    const modal = document.getElementById('demandeModal');
    if (event.target == modal) {
        closeDemandeModal();
    }
}
</script>

{% endblock %}
