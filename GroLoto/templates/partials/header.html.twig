<link rel="stylesheet" href="{{ asset('css/header.css') }}">

<header class="site-header">
    <div class="container">
        <div class="logo">
            <a href="/">
                <img src="{{ asset('images/logo_gro.png') }}" alt="Groloto Logo">
            </a>
        </div>
        <button class="burger-menu" id="burgerMenu" aria-label="Toggle menu">
            <span></span>
            <span></span>
            <span></span>
        </button>
        <nav class="nav-menu" id="navMenu">
            <a href="/">Tableau de bord</a>
            <a href="{{ path('app_evenements') }}">Événements</a>
            {% if app.user %}
                <a href="{{ path('benevoles') }}">Bénévoles</a>
            {% endif %}
            {% if is_granted('ROLE_MECENE') %}
                <a href="{{ path('mecenes') }}">Mécènes & Lots</a>
            {% endif %}
            {% if app.user %}
                <a class="nav-link" href="{{ path('stocks') }}">Stocks</a>
            {% endif %}
            <a href="#">Communication</a>
            <a class="nav-link" href="{{ path('public_index') }}">Public</a>
            <a class="nav-link" href="{{ path('app_contact') }}">Contact</a>
            {% if app.user %}
                <div class="settings-dropdown">
                    <a href="#" onclick="toggleSettingsMenu(event)">
                        <span class="settings-text">Paramètres</span>
                        <img src="{{ asset('images/settings.png') }}" alt="Paramètres" class="settings-icon">
                    </a>
                    <div class="settings-menu" id="settingsMenu">
                        <a href="{{ path('app_profile') }}">Mon profil</a>
                        <a href="{{ path('app_logout') }}">
                            Déconnexion <img src="{{ asset('images/logout.png') }}" alt="Déconnexion" class="logout-icon">
                        </a>
                    </div>
                </div>
            {% else %}
                <a class="nav-link btn-login" href="{{ path('app_login') }}">Connexion</a>
            {% endif %}
        </nav>
    </div>
</header>

<script>
function toggleSettingsMenu(event) {
    event.preventDefault();
    event.stopPropagation();
    
    const menu = document.getElementById('settingsMenu');
    
    if (menu.style.display === 'block') {
        menu.style.display = 'none';
    } else {
        menu.style.display = 'block';
    }
}

document.addEventListener('click', function(event) {
    const menu = document.getElementById('settingsMenu');
    const settingsDropdown = document.querySelector('.settings-dropdown');
    
    if (menu && settingsDropdown && !settingsDropdown.contains(event.target)) {
        menu.style.display = 'none';
    }
});

document.addEventListener('DOMContentLoaded', function() {
    const burgerMenu = document.getElementById('burgerMenu');
    const navMenu = document.getElementById('navMenu');

    burgerMenu.addEventListener('click', function(event) {
        event.stopPropagation();
        burgerMenu.classList.toggle('active');
        navMenu.classList.toggle('active');
    });

    document.addEventListener('click', function(event) {
        if (!navMenu.contains(event.target) && !burgerMenu.contains(event.target)) {
            navMenu.classList.remove('active');
            burgerMenu.classList.remove('active');
        }
    });

    navMenu.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', function() {
            navMenu.classList.remove('active');
            burgerMenu.classList.remove('active');
        });
    });
});
</script>