<link rel="stylesheet" href="{{ asset('css/header.css') }}">

<header class="site-header">
    <div class="container">
        <div class="logo">
            <a href="/">
                <img src="{{ asset('images/logo.png') }}" alt="Groloto Logo">
            </a>
        </div>
        <nav class="nav-menu">
            <a href="/">Tableau de bord</a>
            <a href="{{ path('benevoles') }}">Bénévoles</a>
            <a href="#">Mécènes & Lots</a>
            <a class="nav-link" href="{{ path('stocks') }}">Stocks</a>
            <a href="#">Communication</a>
            <a class="nav-link" href="{{ path('public_index') }}">Public</a>
            
            {% if app.user %}
                <div class="settings-dropdown">
                    <a href="#" onclick="toggleSettingsMenu(event)"><span class="settings">⚙</span></a>
                    <div class="settings-menu" id="settingsMenu">
                        <a href="{{ path('app_profile') }}">Mon profil</a>
                        <a href="{{ path('app_logout') }}">Déconnexion</a>
                    </div>
                </div>
            {% else %}
                <a class="nav-link btn-login" href="{{ path('app_login') }}">Connexion</a>
            {% endif %}
        </nav>
    </div>
</header>

<script>
function toggleSettingsMenu(event) {
    event.preventDefault();
    event.stopPropagation();
    
    const menu = document.getElementById('settingsMenu');
    
    // Toggle la visibilité du menu
    if (menu.style.display === 'block') {
        menu.style.display = 'none';
    } else {
        menu.style.display = 'block';
    }
}

// Fermer le menu si on clique ailleurs
document.addEventListener('click', function(event) {
    const menu = document.getElementById('settingsMenu');
    const settingsDropdown = document.querySelector('.settings-dropdown');
    
    if (menu && settingsDropdown && !settingsDropdown.contains(event.target)) {
        menu.style.display = 'none';
    }
});
</script>
