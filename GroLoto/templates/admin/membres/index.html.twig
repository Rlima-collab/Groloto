{% extends 'base.html.twig' %}

{% block title %}Gestion des Membres - Admin{% endblock %}

{% block body %}
<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center">
            <h1>
                <i class="fas fa-users"></i> Gestion des Membres
            </h1>
            <div class="btn-group" role="group">
                <a href="{{ path('admin_membres_export') }}" class="btn btn-success">
                    <i class="fas fa-download"></i> Exporter en Excel
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Import Section -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card border-primary">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">
                    <i class="fas fa-upload"></i> Importer des Membres
                </h5>
            </div>
            <div class="card-body">
                <form method="POST" enctype="multipart/form-data" class="d-flex align-items-end gap-2">
                    <div class="flex-grow-1">
                        <label for="excel_file" class="form-label fw-bold">Sélectionner un fichier Excel (.xlsx)</label>
                        <input type="file" class="form-control" id="excel_file" name="excel_file" accept=".xlsx" required>
                        <small class="text-muted d-block mt-2">
                            Format attendu: Colonne A=Nom, B=Prénom, C=Email, D=Numéro Billet, E=Tarif, F=Date Création, G=Date Séance, H=Montant Tarif, I=Code Promo, J=Montant Code Promo
                        </small>
                    </div>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-file-import"></i> Importer
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Stats -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card bg-light">
            <div class="card-body text-center">
                <h3 class="card-title text-primary">{{ total_membres }}</h3>
                <p class="card-text text-muted">Membres Total</p>
            </div>
        </div>
    </div>
</div>

<!-- Members List -->
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Liste des Membres</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Nom</th>
                            <th>Prénom</th>
                            <th>Email</th>
                            <th>Numéro Billet</th>
                            <th>Tarif</th>
                            <th>Date Création</th>
                            <th>Date Séance</th>
                            <th>Montant Tarif</th>
                            <th>Code Promo</th>
                            <th style="width: 80px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% if membres|length > 0 %}
                            {% for membre in membres %}
                            <tr>
                                <td>{{ membre.nom }}</td>
                                <td>{{ membre.prenom }}</td>
                                <td>
                                    <a href="mailto:{{ membre.email }}">{{ membre.email }}</a>
                                </td>
                                <td>{{ membre.numeroBillet ?? '-' }}</td>
                                <td>{{ membre.tarif ?? '-' }}</td>
                                <td>
                                    {% if membre.dateCreation %}
                                        {{ membre.dateCreation|date('d/m/Y') }}
                                    {% else %}
                                        -
                                    {% endif %}
                                </td>
                                <td>
                                    {% if membre.dateSeance %}
                                        {{ membre.dateSeance|date('d/m/Y') }}
                                    {% else %}
                                        -
                                    {% endif %}
                                </td>
                                <td>{{ membre.montantTarif ?? '-' }}</td>
                                <td>{{ membre.codePromo ?? '-' }}</td>
                                <td>
                                    <form method="POST" action="{{ path('admin_membres_delete', {id: membre.id}) }}" style="display:inline;">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ membre.id) }}">
                                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Êtes-vous sûr?')">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                            {% endfor %}
                        {% else %}
                            <tr>
                                <td colspan="10" class="text-center text-muted py-4">
                                    Aucun membre pour le moment
                                </td>
                            </tr>
                        {% endif %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .table-hover tbody tr:hover {
        background-color: #f8f9fa;
    }
    
    .card {
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
    }
    
    .card-header {
        background-color: #f8f9fa;
        border-bottom: 1px solid #dee2e6;
    }
</style>
{% endblock %}
