{% extends 'base.html.twig' %}

{% block title %}Aperçu d'Import - Admin{% endblock %}

{% block body %}
<div class="row mb-4">
    <div class="col-12">
        <h1>
            <i class="fas fa-eye"></i> Aperçu de l'Import
        </h1>
        <p class="text-muted">Vérifiez les données avant de confirmer l'import</p>
    </div>
</div>

<!-- Alert -->
<div class="row mb-4">
    <div class="col-12">
        <div class="alert alert-info" role="alert">
            <i class="fas fa-info-circle"></i> <strong>{{ total_rows }}</strong> membres trouvés dans le fichier
        </div>
    </div>
</div>

<!-- Preview Table -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Données à importer</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Nom</th>
                            <th>Prénom</th>
                            <th>Email</th>
                            <th>Numéro Billet</th>
                            <th>Tarif</th>
                            <th>Date Création</th>
                            <th>Date Séance</th>
                            <th>Montant Tarif</th>
                            <th>Code Promo</th>
                            <th>Montant Code Promo</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in preview_data %}
                        <tr>
                            <td>{{ row.nom ?? '-' }}</td>
                            <td>{{ row.prenom ?? '-' }}</td>
                            <td>{{ row.email ?? '-' }}</td>
                            <td>{{ row.numero_billet ?? '-' }}</td>
                            <td>{{ row.tarif ?? '-' }}</td>
                            <td>{{ row.date_creation ?? '-' }}</td>
                            <td>{{ row.date_seance ?? '-' }}</td>
                            <td>{{ row.montant_tarif ?? '-' }}</td>
                            <td>{{ row.code_promo ?? '-' }}</td>
                            <td>{{ row.montant_code_promo ?? '-' }}</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Action Buttons -->
<div class="row">
    <div class="col-12 d-flex gap-2 justify-content-between">
        <a href="{{ path('admin_membres_index') }}" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Retour
        </a>
        <form method="POST" action="{{ path('admin_membres_import_confirm') }}" class="flex-grow-1">
            <input type="hidden" name="members_json" value="{{ preview_data|json_encode }}">
            <button type="submit" class="btn btn-success btn-lg w-100">
                <i class="fas fa-check"></i> Confirmer l'Import ({{ total_rows }} membres)
            </button>
        </form>
    </div>
</div>

<style>
    .table-responsive {
        max-height: 600px;
        overflow-y: auto;
    }
    
    .table thead th {
        position: sticky;
        top: 0;
        background-color: #f8f9fa;
    }
</style>
{% endblock %}
