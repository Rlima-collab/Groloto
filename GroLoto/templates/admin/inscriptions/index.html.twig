{% extends 'base.html.twig' %}

{% block title %}Gestion des Inscriptions Mécènes{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/modele.css') }}">
    <link rel="stylesheet" href="{{ asset('css/dashboard.css') }}">
{% endblock %}

{% block body %}
<style>
/* Options menu global styles */
.options-menu {
    position: absolute;
    z-index: 10000;
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 6px;
    min-width: 180px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.18);
    overflow: visible;
}
.no-hover:hover, .no-hover:focus {
    background: #f3f4f6 !important;
    color: #374151 !important;
    box-shadow: none !important;
    transform: none !important;
}
</style>

<script>
function openOptions(btn, token, acceptUrl) {
    // close existing
    if (window.__currentOptionsMenu) {
        window.__currentOptionsMenu.remove();
        window.__currentOptionsMenu = null;
    }

    const rect = btn.getBoundingClientRect();
    const menu = document.createElement('div');
    menu.className = 'options-menu';
    const menuWidth = 180;
    const left = Math.max(8 + window.scrollX, rect.right + window.scrollX - menuWidth);
    const top = rect.bottom + 8 + window.scrollY;
    menu.style.left = left + 'px';
    menu.style.top = top + 'px';

    const form = document.createElement('form');
    form.method = 'post';
    form.action = acceptUrl;
    form.style.margin = '0';

    const input = document.createElement('input');
    input.type = 'hidden';
    input.name = '_token';
    input.value = token;
    form.appendChild(input);

    const acceptBtn = document.createElement('button');
    acceptBtn.type = 'submit';
    acceptBtn.className = 'btn btn-success';
    acceptBtn.style.width = '100%';
    acceptBtn.style.borderRadius = '0';
    acceptBtn.style.background = 'none';
    acceptBtn.style.color = '#15803d';
    acceptBtn.style.textAlign = 'left';
    acceptBtn.style.padding = '0.75rem 1rem';
    acceptBtn.style.fontWeight = '600';
    acceptBtn.textContent = '✓ Accepter';
    form.appendChild(acceptBtn);

    menu.appendChild(form);
    document.body.appendChild(menu);
    window.__currentOptionsMenu = menu;

    setTimeout(() => document.addEventListener('mousedown', function onDocClick(e) {
        if (!menu.contains(e.target) && !btn.contains(e.target)) {
            closeOptions();
            document.removeEventListener('mousedown', onDocClick);
        }
    }), 0);
}

function closeOptions() {
    if (window.__currentOptionsMenu) {
        try { window.__currentOptionsMenu.remove(); } catch(e) {}
        window.__currentOptionsMenu = null;
    }
}

function openOptionsRefuser(btn, inscriptionId, organisation, token) {
    // close existing
    if (window.__currentOptionsMenu) {
        window.__currentOptionsMenu.remove();
        window.__currentOptionsMenu = null;
    }

    const rect = btn.getBoundingClientRect();
    const menu = document.createElement('div');
    menu.className = 'options-menu';
    const menuWidth = 180;
    const left = Math.max(8 + window.scrollX, rect.right + window.scrollX - menuWidth);
    const top = rect.bottom + 8 + window.scrollY;
    menu.style.left = left + 'px';
    menu.style.top = top + 'px';

    const btnRefuser = document.createElement('button');
    btnRefuser.type = 'button';
    btnRefuser.className = 'btn btn-danger';
    btnRefuser.style.width = '100%';
    btnRefuser.style.borderRadius = '0';
    btnRefuser.style.background = 'none';
    btnRefuser.style.color = '#dc2626';
    btnRefuser.style.textAlign = 'left';
    btnRefuser.style.padding = '0.75rem 1rem';
    btnRefuser.style.fontWeight = '600';
    btnRefuser.style.border = 'none';
    btnRefuser.textContent = '✗ Refuser';
    btnRefuser.onclick = function() {
        closeOptions();
        confirmRefuser(inscriptionId, organisation, token);
    };

    menu.appendChild(btnRefuser);
    document.body.appendChild(menu);
    window.__currentOptionsMenu = menu;

    setTimeout(() => document.addEventListener('mousedown', function onDocClick(e) {
        if (!menu.contains(e.target) && !btn.contains(e.target)) {
            closeOptions();
            document.removeEventListener('mousedown', onDocClick);
        }
    }), 0);
}
</script>
<div class="hero-section">
    <div class="shine"></div>
    <div class="hero-content">
        <h1 class="hero-title">Gestion des Inscriptions</h1>
        <p class="hero-description">Validez ou refusez les demandes d'inscription des mécènes aux événements.</p>
    </div>
</div>

<div class="page-header">
    <h1 class="page-title">🔍 Demandes d'Inscription Mécènes</h1>
</div>

<!-- Messages flash -->
{% for message in app.flashes('success') %}
    <div class="alert alert-success" style="max-width: 1400px; margin: 0 auto 1.5rem; padding: 1rem; background: #dcfce7; border-left: 4px solid #16a34a; border-radius: 8px; color: #15803d;">
        <strong>✓ Succès :</strong> {{ message }}
    </div>
{% endfor %}

{% for message in app.flashes('error') %}
    <div class="alert alert-danger" style="max-width: 1400px; margin: 0 auto 1.5rem; padding: 1rem; background: #fee2e2; border-left: 4px solid #dc2626; border-radius: 8px; color: #991b1b;">
        <strong>❌ Erreur :</strong> {{ message }}
    </div>
{% endfor %}

<!-- Statistiques -->
<div class="metrics-grid" style="max-width: 1400px; margin: 0 auto 2rem; padding: 0 2rem;">
    <div class="card metric-card blue-border" style="cursor: pointer;" onclick="filterInscriptions('all')">
        <div class="card-header">
            <span class="metric-title">Total demandes</span>
        </div>
        <div class="card-content">
            <div class="metric-value">{{ stats.total }}</div>
            <p class="metric-change positive">Toutes les demandes</p>
        </div>
    </div>
    <div class="card metric-card yellow-border" style="cursor: pointer;" onclick="filterInscriptions('en_attente')">
        <div class="card-header">
            <span class="metric-title">En attente</span>
        </div>
        <div class="card-content">
            <div class="metric-value">{{ stats.en_attente }}</div>
            <p class="metric-change warning">À traiter</p>
        </div>
    </div>
    <div class="card metric-card green-border" style="cursor: pointer;" onclick="filterInscriptions('accepte')">
        <div class="card-header">
            <span class="metric-title">Acceptées</span>
        </div>
        <div class="card-content">
            <div class="metric-value">{{ stats.acceptees }}</div>
            <p class="metric-change positive">Validées</p>
        </div>
    </div>
    <div class="card metric-card red-border" style="cursor: pointer; border-left: 4px solid #dc2626 !important; background: linear-gradient(135deg, #ffffff 0%, #fff8f8 100%) !important;" onclick="filterInscriptions('refuse')">
        <div class="card-header">
            <span class="metric-title">Refusées</span>
        </div>
        <div class="card-content">
            <div class="metric-value">{{ stats.refusees }}</div>
            <p class="metric-change danger" style="color: #dc2626 !important;">Refusées</p>
        </div>
    </div>
</div>

<!-- Liste des inscriptions -->
<div style="max-width: 1400px; margin: 0 auto; padding: 0 2rem 2rem;">
    <!-- Message pour catégories vides -->
    <div id="empty-message" style="display: none;">
        <div class="card" style="text-align: center; padding: 3rem; background: #f9fafb;">
            <div style="font-size: 3rem; margin-bottom: 1rem; opacity: 0.3;">📋</div>
            <h3 style="color: #9ca3af; margin-bottom: 0; font-weight: 500;">Aucune inscription dans cette catégorie</h3>
        </div>
    </div>
    
    {% if inscriptions|length > 0 %}
        <div class="inscriptions-list">
            {% for inscription in inscriptions %}
                <div class="card inscription-item" data-statut="{{ inscription.statut }}">
                    <div class="card-header" style="display: flex; justify-content: space-between; align-items: start; gap: 1rem; flex-wrap: wrap;">
                        <div style="flex: 1; min-width: 300px;">
                            <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.5rem;">
                                <h3 class="card-title" style="margin: 0;">🏢 {{ inscription.mecene.organisation }}</h3>
                                <span class="badge status-badge 
                                    {% if inscription.statut == 'accepte' %}status-success
                                    {% elseif inscription.statut == 'refuse' %}status-danger
                                    {% else %}status-warning{% endif %}">
                                    {% if inscription.statut == 'accepte' %}✓ Acceptée
                                    {% elseif inscription.statut == 'refuse' %}✗ Refusée
                                    {% else %}⏳ En attente{% endif %}
                                </span>
                            </div>
                            <p class="card-description" style="margin: 0;">
                                👤 {{ inscription.mecene.utilisateur.prenom }} {{ inscription.mecene.utilisateur.nom }}
                                <span style="margin: 0 0.5rem;">•</span>
                                📧 {{ inscription.mecene.utilisateur.email }}
                            </p>
                        </div>
                        <div style="text-align: right;">
                            <div class="event-info">
                                <strong style="color: #374151; font-size: 1rem;">{{ inscription.evenement.nom }}</strong>
                                <div style="font-size: 0.875rem; color: #6b7280; margin-top: 0.25rem;">
                                    📅 {{ inscription.evenement.dateDebut|date('d/m/Y') }}
                                    {% if inscription.evenement.lieu %}
                                        <br>📍 {{ inscription.evenement.lieu }}
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="card-content">
                        <div class="inscription-grid">
                            {% if inscription.nomDon %}
                            <div class="info-section highlight-section">
                                <label class="info-label">📦 Article pour le stock</label>
                                <p class="info-value" style="font-weight: 600; font-size: 1.1rem; color: #006909;">{{ inscription.nomDon }}</p>
                                {% if inscription.categorie %}
                                    <span class="category-badge category-{{ inscription.categorie }}">
                                        {% if inscription.categorie == 'bar' %}🍺 Bar
                                        {% elseif inscription.categorie == 'resto' %}🍽️ Resto
                                        {% elseif inscription.categorie == 'deco' %}🎨 Déco
                                        {% else %}📋 Autre{% endif %}
                                    </span>
                                {% endif %}
                            </div>

                            <div class="info-section">
                                <label class="info-label">📊 Quantité</label>
                                <p class="info-value">
                                    <strong style="font-size: 1.25rem; color: #059669;">{{ inscription.quantite }}</strong>
                                </p>
                            </div>

                            {% if inscription.valeurUnitaire %}
                            <div class="info-section">
                                <label class="info-label">💵 Valeur unitaire</label>
                                <p class="info-value amount">{{ inscription.valeurUnitaire|number_format(2, ',', ' ') }} €</p>
                            </div>
                            {% endif %}
                            {% endif %}

                            <div class="info-section">
                                <label class="info-label">�💝 Description du don</label>
                                <p class="info-value">{{ inscription.descriptionDon }}</p>
                            </div>

                            {% if inscription.montantEstime %}
                            <div class="info-section">
                                <label class="info-label">💰 Valeur totale estimée</label>
                                <p class="info-value amount">{{ inscription.montantEstime|number_format(2, ',', ' ') }} €</p>
                            </div>
                            {% endif %}

                            {% if inscription.remarques %}
                            <div class="info-section">
                                <label class="info-label">📝 Remarques</label>
                                <p class="info-value">{{ inscription.remarques }}</p>
                            </div>
                            {% endif %}

                            <div class="info-section">
                                <label class="info-label">📆 Date de soumission</label>
                                <p class="info-value">{{ inscription.dateInscription|date('d/m/Y à H:i') }}</p>
                            </div>
                        </div>

                        {% if inscription.statut == 'en_attente' %}
                        <div class="action-buttons" style="margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1px solid #e5e7eb;">
                            <form method="post" action="{{ path('admin_inscription_accepter', {'id': inscription.id}) }}" style="display: inline;">
                                <input type="hidden" name="_token" value="{{ csrf_token('accepter_inscription_' ~ inscription.id) }}">
                                <button type="submit" class="btn btn-success">
                                    <span>✓</span> Accepter
                                </button>
                            </form>
                            <button type="button" class="btn btn-danger" onclick="confirmRefuser({{ inscription.id }}, '{{ inscription.mecene.organisation|e('js') }}', '{{ csrf_token('refuser_inscription_' ~ inscription.id) }}')">
                                <span>✗</span> Refuser
                            </button>
                        </div>
                        {% elseif inscription.statut == 'accepte' %}
                        <div style="margin-bottom: 1rem; display: flex; justify-content: flex-end;">
                            <button type="button" class="btn btn-secondary no-hover" onclick="openOptionsRefuser(this, {{ inscription.id }}, '{{ inscription.mecene.organisation|e('js') }}', '{{ csrf_token('refuser_inscription_' ~ inscription.id) }}')" style="background: #f3f4f6; color: #374151;">
                                Options <span>⋯</span>
                            </button>
                        </div>
                        {% elseif inscription.statut == 'refuse' %}
                        <div style="margin-bottom: 1rem; display: flex; justify-content: flex-end;">
                            <button class="btn btn-secondary no-hover" type="button" onclick="openOptions(this, '{{ csrf_token('accepter_inscription_' ~ inscription.id) }}', '{{ path('admin_inscription_accepter', {'id': inscription.id}) }}')" style="background: #f3f4f6; color: #374151;">
                                Options <span>⋯</span>
                            </button>
                        </div>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="card">
            <div class="card-content" style="text-align: center; padding: 3rem;">
                <div style="font-size: 4rem; margin-bottom: 1rem; opacity: 0.5;">📋</div>
                <h3 style="color: #374151; margin-bottom: 0.5rem;">Aucune inscription</h3>
                <p style="color: #6b7280; margin: 0;">Il n'y a pas encore de demandes d'inscription.</p>
            </div>
        </div>
    {% endif %}
</div>

<!-- Modal pour la remarque de refus -->
<div id="modalRefus" class="modal" style="display: none;">
    <div class="modal-overlay" onclick="closeModalRefus()"></div>
    <div class="modal-content">
        <div class="modal-header">
            <h3 class="modal-title">Refuser l'inscription</h3>
            <button type="button" class="modal-close" onclick="closeModalRefus()">✕</button>
        </div>
        <form id="formRefus" method="post" action="">
            <div class="modal-body">
                <p class="modal-description">Vous êtes sur le point de refuser l'inscription de <strong id="orgaRefus"></strong>.</p>
                <p class="modal-description">Vous pouvez optionnellement ajouter une remarque qui sera visible par le mécène :</p>
                
                <input type="hidden" name="_token" id="tokenRefus" value="">
                <div class="form-group">
                    <label for="remarque_refus" class="form-label">Raison du refus (optionnel)</label>
                    <textarea name="remarque_refus" id="remarque_refus" class="form-control" rows="4" placeholder="Ex: Le don ne correspond pas aux besoins de l'événement..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="closeModalRefus()">Annuler</button>
                <button type="submit" class="btn btn-danger">Confirmer le refus</button>
            </div>
        </form>
    </div>
</div>

