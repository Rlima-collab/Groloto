<script>
function filterInscriptions(statut) {
    const items = document.querySelectorAll('.inscription-item');
    const metricCards = document.querySelectorAll('.metric-card');
    const emptyMessage = document.getElementById('empty-message');
    
    // Update active card
    metricCards.forEach(card => card.classList.remove('active-filter'));
    event.target.closest('.metric-card').classList.add('active-filter');
    
    // Filter items and count visible
    let visibleCount = 0;
    items.forEach(item => {
        if (statut === 'all' || item.dataset.statut === statut) {
            item.style.display = 'block';
            visibleCount++;
        } else {
            item.style.display = 'none';
        }
    });
    
    // Show empty message if no items visible
    if (visibleCount === 0) {
        emptyMessage.style.display = 'block';
    } else {
        emptyMessage.style.display = 'none';
    }
}

function confirmRefuser(id, organisation, token) {
    // Ouvrir le modal
    const modal = document.getElementById('modalRefus');
    const form = document.getElementById('formRefus');
    const orgaElement = document.getElementById('orgaRefus');
    const tokenInput = document.getElementById('tokenRefus');
    const remarqueTextarea = document.getElementById('remarque_refus');
    
    // Configurer le modal
    form.action = `/admin/inscriptions/${id}/refuser`;
    orgaElement.textContent = organisation;
    tokenInput.value = token;
    remarqueTextarea.value = '';
    
    // Afficher le modal
    modal.style.display = 'block';
}

function closeModalRefus() {
    const modal = document.getElementById('modalRefus');
    modal.style.display = 'none';
}

function confirmSupprimer(id, organisation, token) {
    if (confirm(`⚠️ ATTENTION ⚠️\n\nÊtes-vous sûr de vouloir ANNULER l'inscription de "${organisation}" ?\n\nSi l'inscription était acceptée, elle sera passée en statut "Refusée" et le stock associé sera supprimé.`)) {
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = `/admin/inscriptions/${id}/supprimer`;
        
        const tokenInput = document.createElement('input');
        tokenInput.type = 'hidden';
        tokenInput.name = '_token';
        tokenInput.value = token;
        form.appendChild(tokenInput);
        
        document.body.appendChild(form);
        form.submit();
    }
}
</script>
{% endblock %}
