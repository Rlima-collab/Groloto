{% extends 'base.html.twig' %}

{% block title %}Éditer un administrateur{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/admin/admin-edit.css') }}">
{% endblock %}

{% block body %}

<div class="admin-edit-container">
    <div class="admin-edit-card">
        <div class="admin-edit-header">
            <h2>
                <i class="bi bi-pencil-square"></i>
                Éditer l'administrateur
            </h2>
            <div class="admin-edit-email">
                <i class="bi bi-envelope"></i> {{ admin.email }}
            </div>
        </div>

        <div class="admin-edit-content">
            {% if errors is defined and errors|length > 0 %}
                <div class="alert-edit alert-edit-danger">
                    <ul>
                        {% for err in errors %}
                            <li>{{ err }}</li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}

            <form method="post" class="admin-edit-form">
                <div class="form-group-edit">
                    <label for="prenom">Prénom</label>
                    <input type="text" id="prenom" name="prenom" class="form-control" placeholder="Jean" value="{{ admin.prenom ?: '' }}">
                </div>

                <div class="form-group-edit">
                    <label for="nom">Nom</label>
                    <input type="text" id="nom" name="nom" class="form-control" placeholder="Dupont" value="{{ admin.nom ?: '' }}">
                </div>

                <div class="form-group-edit">
                    <label for="email">Email</label>
                    <input type="text" id="email" class="form-control" disabled value="{{ admin.email }}" title="L'email ne peut pas être modifié">
                    <small style="color: var(--gray-500); margin-top: 0.3rem;">Non modifiable</small>
                </div>

                <div class="form-section-edit">
                    <div class="form-section-edit-title">
                        <i class="bi bi-lock-fill"></i> Sécurité
                    </div>

                    <div class="form-row-edit">
                        <div class="form-group-edit">
                            <label for="password">
                                Nouveau mot de passe
                                <span class="form-label-optional">(optionnel)</span>
                            </label>
                            <input type="password" id="password" name="password" class="form-control" placeholder="Laisser vide pour conserver l'actuel">
                        </div>

                        <div class="form-group-edit">
                            <label for="confirm-password">
                                Confirmer le mot de passe
                                <span class="form-label-optional">(optionnel)</span>
                            </label>
                            <input type="password" id="confirm-password" name="confirm_password" class="form-control" placeholder="Confirmer">
                        </div>
                    </div>
                </div>

                <div class="admin-edit-actions">
                    <button type="submit" class="btn-edit btn-edit-primary">
                        <i class="bi bi-check-circle"></i>
                        Enregistrer les modifications
                    </button>
                    <a href="{{ path('admin_manage') }}" class="btn-edit btn-edit-secondary">
                        <i class="bi bi-arrow-left"></i>
                        Retour à la gestion
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

{% endblock %}
