{% extends 'base.html.twig' %}

{% block title %}Créer un administrateur{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/admin/admin-create.css') }}">
{% endblock %}

{% block body %}

<div class="admin-container">
    <div class="admin-card">
        <!-- Onglets -->
        <ul class="admin-tabs nav nav-tabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="admin-tabs nav-link active" id="create-tab" data-bs-toggle="tab" data-bs-target="#create-content" type="button" role="tab" aria-controls="create-content" aria-selected="true">
                    <i class="bi bi-plus-lg"></i>
                    <span>Créer un administrateur</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="admin-tabs nav-link" id="manage-tab" data-bs-toggle="tab" data-bs-target="#manage-content" type="button" role="tab" aria-controls="manage-content" aria-selected="false">
                    <i class="bi bi-gear-fill"></i>
                    <span>Gérer les administrateurs</span>
                </button>
            </li>
        </ul>

        <div class="admin-tab-content tab-content">
            <!-- Contenu Créer -->
            <div class="tab-pane fade show active" id="create-content" role="tabpanel" aria-labelledby="create-tab">
                <div class="admin-header">
                    <h2>Nouvel Administrateur</h2>
                </div>

                {% if errors is defined and errors|length > 0 %}
                    <div class="alert-admin alert-admin-danger">
                        <ul>
                            {% for err in errors %}
                                <li>{{ err }}</li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}

                <form method="post" action="{{ path('admin_create_user') }}" class="admin-form">
                    <div class="form-group">
                        <label for="prenom">Prénom</label>
                        <input type="text" id="prenom" name="prenom" class="form-control" placeholder="Jean" required>
                    </div>

                    <div class="form-group">
                        <label for="nom">Nom</label>
                        <input type="text" id="nom" name="nom" class="form-control" placeholder="Dupont" required>
                    </div>

                    <div class="form-group">
                        <label for="email">Email</label>
                        <input type="email" id="email" name="email" class="form-control" placeholder="jean.dupont@example.com" required>
                    </div>

                    <div class="form-row-two">
                        <div class="form-group">
                            <label for="password">Mot de passe</label>
                            <input type="password" id="password" name="password" class="form-control" placeholder="••••••••••" required>
                        </div>
                        <div class="form-group">
                            <label for="confirm-password">Confirmer le mot de passe</label>
                            <input type="password" id="confirm-password" name="confirm_password" class="form-control" placeholder="••••••••••" required>
                        </div>
                    </div>

                    <div class="btn-action-group">
                        <button type="submit" class="btn-admin btn-admin-primary">
                            <i class="bi bi-check-circle"></i>
                            Créer le compte
                        </button>
                        <a href="{{ path('dashboard') }}" class="btn-admin btn-admin-secondary">
                            <i class="bi bi-x-circle"></i>
                            Annuler
                        </a>
                    </div>
                </form>
            </div>

            <!-- Contenu Gérer -->
            <div class="tab-pane fade" id="manage-content" role="tabpanel" aria-labelledby="manage-tab">
                <div class="admin-header">
                    <h2>Gestion des Administrateurs</h2>
                </div>
                {% include 'admin/_admin_list.html.twig' %}
            </div>
        </div>
    </div>
</div>

{% endblock %}
