{% extends 'base.html.twig' %}

{% block title %}Créer un administrateur{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/festival/festival-create.css') }}">
{% endblock %}

{% block body %}

<div class="weekend-create-container">
    <div class="weekend-form-card">
        <div class="weekend-form-header">
            <h2>Informations du nouvel administrateur</h2>
        </div>

        {% if errors is defined and errors|length > 0 %}
            <div class="alert alert-danger">
                <ul>
                    {% for err in errors %}
                        <li>{{ err }}</li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        <form method="post" action="{{ path('admin_create_user') }}">
            <div class="mb-4">
                <label class="form-label">Prénom</label>
                <input type="text" name="prenom" class="form-control" placeholder="Prénom">
            </div>
            <div class="mb-4">
                <label class="form-label">Nom</label>
                <input type="text" name="nom" class="form-control" placeholder="Nom">
            </div>
            <div class="mb-4">
                <label class="form-label">Email</label>
                <input type="email" name="email" class="form-control" placeholder="email@exemple.com" required>
            </div>
            <div class="form-row mb-4">
                <div class="form-col">
                    <label class="form-label">Mot de passe</label>
                    <input type="password" name="password" class="form-control" required>
                </div>
                <div class="form-col">
                    <label class="form-label">Confirmer le mot de passe</label>
                    <input type="password" name="confirm_password" class="form-control" required>
                </div>
            </div>

            <div class="text-center mt-8">
                <button type="submit" style="background:#0d1b2a; color:white; border:none; padding:10px 28px; border-radius:8px; font-weight:600; cursor:pointer; transition:all .2s;" onmouseover="this.style.background='#1e3a5f'; this.style.transform='translateY(-1px)'" onmouseout="this.style.background='#0d1b2a'; this.style.transform='translateY(0)'">Créer le compte</button>
                <a href="{{ path('dashboard') }}" style="margin-left:12px; background:transparent; color:#e74c3c; border:2px solid #e74c3c; padding:8px 24px; border-radius:8px; text-decoration:none; font-weight:600; display:inline-block; transition:all .2s;" onmouseover="this.style.background='#e74c3c'; this.style.color='white'" onmouseout="this.style.background='transparent'; this.style.color='#e74c3c'">Annuler</a>
            </div>
        </form>

    </div>
</div>

{% endblock %}
