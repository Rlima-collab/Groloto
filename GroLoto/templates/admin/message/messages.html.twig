}

function renderMessages(messages) {
chatMessages.innerHTML = '';
messages.forEach((msg, index) => {
const userEmail = '{{ app.user.email|e('js') }}';
// Un message est "reçu" (gauche) s'il vient de l'interlocuteur (currentOtherEmail)
// Sinon il est "envoyé" (droite) car il vient d'un admin (moi ou un autre)
const isReceived = msg.email === currentOtherEmail;
const isSent = !isReceived;

const wrapper = document.createElement('div');
wrapper.className = 'message-wrapper ' + (isSent ? 'sent' : 'received');
wrapper.dataset.messageId = msg.id;

// Nettoyer le message des préfixes [MODIFIÉ], [SUPPRIMÉ] pour le data-attribute
let cleanMessage = msg.message;
if (msg.isEdited) {
	cleanMessage = msg.message.replace(/^\[MODIFIÉ\]\s*/, '');
}
if (msg.isDeleted) {
	cleanMessage = msg.message.replace(/^\[SUPPRIMÉ\]\s*/, '');
}
// Retirer également le sujet
cleanMessage = cleanMessage.replace(/^\[[^\]]+\]\s*/, '');
wrapper.dataset.messageContent = cleanMessage;

// Si c'est envoyé (droite), c'est un Admin. Si c'est reçu (gauche), c'est l'utilisateur.
const displayName = isSent ? 'Admin' : msg.nom;
// Avatar : Si envoyé (Admin), mon avatar. Si reçu (User), avatar de l'user.
// Note: Pour les autres admins, on n'a pas leur avatar facilement ici, on met le mien par défaut ou "Admin"
const avatarHtml = isSent ? createAvatarHtml(currentUserName, currentUserProfileImage) : createAvatarHtml(displayName, currentRecipientProfileImage);

let notificationHtml = '';
if (msg.isEdited) {
	notificationHtml = '<div class="message-notification edited">Modifié</div>';
}

let actionsHtml = '';
if (isSent && !msg.isDeleted && msg.id) {
	actionsHtml = '<div class="message-actions"><button class="message-menu-btn" onclick="toggleMessageMenu(event, ' + msg.id + ')">⋮</button><div class="message-actions-dropdown" id="msgMenu' + msg.id + '"><button class="message-action-item" onclick="editMessage(event, ' + msg.id + ')">Modifier</button><button class="message-action-item delete" onclick="deleteMessage(event, ' + msg.id + ')">Supprimer</button></div></div>';
}

// Nettoyer le texte du message à afficher (retirer les préfixes)
let displayMessage = msg.message;
if (msg.isEdited) {
	displayMessage = displayMessage.replace(/^\[MODIFIÉ\]\s*/, '');
}
if (msg.isDeleted) {
	displayMessage = displayMessage.replace(/^\[SUPPRIMÉ\]\s*/, '');
}
// Retirer le sujet pour l'affichage
displayMessage = displayMessage.replace(/^\[[^\]]+\]\s*/, '');

const messageText = msg.isDeleted ? '<em style="opacity: 0.6;">Ce message a été supprimé</em>' : escapeHtml(displayMessage).replace(/\n/g, '<br>');

wrapper.innerHTML = notificationHtml + '<div class="message-header"><div class="message-avatar">' + avatarHtml + '</div><span class="message-sender">' + escapeHtml(displayName) + '</span><span class="message-number">#' + (index + 1) + '</span>' + actionsHtml + '</div><div class="message-bubble"><div class="message-content">' + messageText + '</div><div class="message-time">' + msg.date + '</div></div>';
chatMessages.appendChild(wrapper);
});
}
sendBtn.addEventListener('click', sendMessage);
chatInput.addEventListener('keydown', function(e) { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMessage(); } });

async function sendMessage() {
console.log('sendMessage called', currentConversationId, currentRecipient);
const message = chatInput.value.trim();
if (!message || !currentConversationId) return;

// Pour un nouveau message, on utilise currentRecipient et currentSubject (définis dans le modal)
if (currentConversationId === 'new') {
    if (!currentRecipient) {
        showToast('Destinataire manquant', 'error');
        return;
    }
    if (!currentSubject) {
        showToast('Sujet manquant', 'error');
        return;
    }
}

sendBtn.disabled = true;
try {
	const formData = new FormData();
	if (currentConversationId === 'new') {
		formData.set('message', message);
		formData.set('to', currentRecipient);
		formData.set('subject', currentSubject);
	} else {
		formData.set('message', message);
	}
	
	let url;
	if (currentConversationId === 'new') {
		url = '{{ path('admin_message_new') }}';
	} else {
		url = '{{ path('admin_message_reply', {'id': 'PLACEHOLDER'}) }}'.replace('PLACEHOLDER', currentConversationId);
		formData.set('reponse', message);
	}
	
	const response = await fetch(url, { method: 'POST', body: formData, headers: {'X-Requested-With': 'XMLHttpRequest'} });
	const data = await response.json();
	
	if (data.success) {
		// clear input
		chatInput.value = '';
		chatInput.style.height = 'auto';

        // Handle mass mailing success
        if (data.sentCount) {
             showToast(data.message, 'success');
             // On continue l'exécution pour ajouter la conversation à la liste
        }

	// Pour les conversations existantes, ajouter le message au DOM
	if (currentConversationId !== 'new') {
		const dateNow = (new Date()).toLocaleString();
		const messageId = data.messageId || currentConversationId; // Utiliser l'ID du message si disponible
		const wrapper = document.createElement('div');
		wrapper.className = 'message-wrapper sent';
		wrapper.dataset.messageId = messageId;
		wrapper.dataset.messageContent = message;
		const avatarHtml = createAvatarHtml(currentUserName, currentUserProfileImage);
		const messageCount = chatMessages.querySelectorAll('.message-wrapper').length + 1;
		
		// Ajouter les boutons d'action (3 points)
		const actionsHtml = '<div class="message-actions"><button class="message-menu-btn" onclick="toggleMessageMenu(event, ' + messageId + ')">⋮</button><div class="message-actions-dropdown" id="msgMenu' + messageId + '"><button class="message-action-item" onclick="editMessage(event, ' + messageId + ')">Modifier</button><button class="message-action-item delete" onclick="deleteMessage(event, ' + messageId + ')">Supprimer</button></div></div>';
		
		wrapper.innerHTML = '<div class="message-header"><div class="message-avatar">' + avatarHtml + '</div><span class="message-sender">' + escapeHtml(currentUserName) + '</span><span class="message-number">#' + messageCount + '</span>' + actionsHtml + '</div><div class="message-bubble"><div class="message-content">' + escapeHtml(message).replace(/\n/g, '<br>') + '</div><div class="message-time">' + dateNow + '</div></div>';
		chatMessages.appendChild(wrapper);
		scrollToBottom();
		// Remettre le focus sur le textarea
		chatInput.focus();
		
		// Mettre à jour l'aperçu de la conversation à gauche avec le dernier message
		const convItem = document.querySelector(`.conversation-item[data-id="${currentConversationId}"]`);
		if (convItem) {
			// Nettoyer le message des préfixes avant de l'afficher dans l'aperçu
			let cleanPreview = message.replace(/^\[MODIFIÉ\]\s*/, '').replace(/^\[SUPPRIMÉ\]\s*/, '').replace(/^\[[^\]]+\]\s*/, '');
			
			// Mettre à jour l'aperçu
			const preview = convItem.querySelector('.conversation-preview');
			if (preview) {
				preview.textContent = cleanPreview.slice(0, 50) + (cleanPreview.length > 50 ? '...' : '');
			}
			// Mettre à jour l'heure
			const timeEl = convItem.querySelector('.conversation-time');
			if (timeEl) {
				timeEl.textContent = new Date().toLocaleDateString('fr-FR', {day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit'});
			}
			
			// Déplacer la conversation en haut de la liste
			conversationsList.insertBefore(convItem, conversationsList.firstChild);
		}
	}
		
		// Si c'était un nouveau message, basculer vers la conversation créée et afficher les actions
		if (currentConversationId === 'new') {
			currentConversationId = data.conversationId || null;
			chatTitle.textContent = 'Conversation avec ' + (currentRecipientName || currentRecipient);
			
			// Créer l'élément de conversation dans la liste à gauche
			if (data.conversationId) {
				// Créer un objet message pour inclure dans la conversation
				const firstMessage = {
					id: data.conversationId,
					nom: currentUserName,
					email: '{{ app.user.email }}',
					message: message,
					date: new Date().toLocaleString('fr-FR'),
					createdAt: new Date().toISOString(),
					destinataire: currentRecipient,
					isFromCurrentUser: true
				};
				
				const newConvItem = document.createElement('div');
				newConvItem.className = 'conversation-item active';
				newConvItem.dataset.id = data.conversationId;
				newConvItem.dataset.subject = escapeHtml(currentSubject);
				newConvItem.dataset.conversation = JSON.stringify([]);
				newConvItem.dataset.sender = escapeHtml(currentRecipientName || currentRecipient); // Utiliser le nom complet
				newConvItem.dataset.email = escapeHtml(currentRecipient);
				newConvItem.dataset.message = escapeHtml(message); // Stocker le message sans le préfixe sujet
				newConvItem.dataset.date = (new Date()).toLocaleString('fr-FR');
				newConvItem.dataset.closed = 'false';
				
				// Nettoyer le message pour l'aperçu (sans préfixes)
				let cleanPreview = message.replace(/^\[MODIFIÉ\]\s*/, '').replace(/^\[SUPPRIMÉ\]\s*/, '').replace(/^\[[^\]]+\]\s*/, '');
				
				// Construire le nom avec le rôle
				const displayName = currentRecipientName || currentRecipient;
				const nameWithRole = currentRecipientRole ? `${displayName} (${currentRecipientRole})` : displayName;
				
				newConvItem.innerHTML = `
					<div class="conversation-item-content">
						<div class="conversation-name">${escapeHtml(currentSubject)}</div>
						<div class="conversation-sender">${escapeHtml(nameWithRole)}</div>
						<div class="conversation-preview">${escapeHtml(cleanPreview.slice(0, 50))}${cleanPreview.length > 50 ? '...' : ''}</div>
						<div class="conversation-time">${new Date().toLocaleDateString('fr-FR', {day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit'})}</div>
					</div>
					<div class="conversation-item-menu">
						<button class="conversation-menu-btn" onclick="toggleConversationMenu(event, ${data.conversationId})">
							<svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><circle cx="12" cy="5" r="2"></circle><circle cx="12" cy="12" r="2"></circle><circle cx="12" cy="19" r="2"></circle></svg>
						</button>
						<div class="conversation-dropdown" id="convMenu${data.conversationId}">
							<button class="conversation-dropdown-item" onclick="closeConversation(event, ${data.conversationId})">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"></path></svg>
								Clôturer
							</button>
							<button class="conversation-dropdown-item delete" onclick="deleteConversation(event, ${data.conversationId})">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
								Supprimer
							</button>
						</div>
					</div>
				`;
				
				// Cacher le message "Aucune conversation"
				const emptyConversations = document.getElementById('emptyConversations');
				if (emptyConversations) {
					emptyConversations.style.display = 'none';
				}
				
				// Désactiver les autres conversations avant d'ajouter la nouvelle
				document.querySelectorAll('.conversation-item').forEach(i => i.classList.remove('active'));
				
				// Ajouter en haut de la liste
				conversationsList.insertBefore(newConvItem, conversationsList.firstChild);
				
				// Ajouter l'écouteur de clic
				newConvItem.addEventListener('click', function() {
					document.querySelectorAll('.conversation-item').forEach(i => i.classList.remove('active'));
					this.classList.add('active');
					currentConversationId = this.dataset.id;
					currentSubject = this.dataset.subject;
					chatInput.value = '';
					chatInput.style.height = 'auto';
					markConversationNotificationsAsRead(currentConversationId);
					const conversationData = this.dataset.conversation;
					const sender = this.dataset.sender;
					const email = this.dataset.email;
					const messageData = this.dataset.message;
					const date = this.dataset.date;
					const isClosed = this.dataset.closed === 'true';
					
					chatHeader.style.display = 'flex';
					chatInputContainer.style.display = 'block';
					chatTitle.textContent = sender;
					
					if (isClosed) {
						closedIndicator.style.display = 'block';
						chatInput.disabled = true;
						sendBtn.disabled = true;
						chatInput.placeholder = 'Cette conversation est clôturée';
					} else {
						closedIndicator.style.display = 'none';
						chatInput.disabled = false;
						sendBtn.disabled = false;
						chatInput.placeholder = 'Écrivez votre message...';
					}
					
					const conversation = conversationData ? JSON.parse(conversationData) : [];
					const allMessages = [{
						id: currentConversationId,
						nom: sender,
						email: email,
						message: messageData,
						date: date,
						isEdited: messageData.includes('[MODIFIÉ]'),
						isDeleted: messageData.includes('[SUPPRIMÉ]')
					}, ...conversation.map(msg => ({
						...msg,
						isEdited: msg.isEdited || (msg.message && msg.message.includes('[MODIFIÉ]')),
						isDeleted: msg.isDeleted || (msg.message && msg.message.includes('[SUPPRIMÉ]'))
					}))];
					renderMessages(allMessages);
					scrollToBottom();
				});
				
				// Afficher immédiatement le message dans la zone de chat
				const displayMessage = {
					id: data.conversationId,
					nom: currentUserName,
					email: '{{ app.user.email }}',
					message: message,
					date: new Date().toLocaleString('fr-FR'),
					isEdited: false,
					isDeleted: false
				};
				renderMessages([displayMessage]);
				scrollToBottom();
				
				// Activer l'interface de chat
				chatHeader.style.display = 'flex';
				chatInputContainer.style.display = 'block';
				chatInput.disabled = false;
				sendBtn.disabled = false;
				chatInput.focus();
			}
			
			currentRecipient = '';
			currentSubject = '';
		}
	} else {
		// Afficher le message d'erreur avec un toast
		showToast(data.error || 'Erreur lors de envoi du message', 'error');
	}
} catch (err) {
console.error(err);
showToast('Erreur réseau', 'error');
} finally {
sendBtn.disabled = false;
}
}

function scrollToBottom() { chatMessages.scrollTop = chatMessages.scrollHeight; }

// Gérer le menu des actions de message
window.toggleMessageMenu = function(event, messageId) {
	event.stopPropagation();
	const menu = document.getElementById('msgMenu' + messageId);
	const allMenus = document.querySelectorAll('.message-actions-dropdown');
	
	// Fermer tous les autres menus
	allMenus.forEach(m => {
		if (m !== menu) m.classList.remove('active');
	});
	
	// Toggle le menu actuel
	menu.classList.toggle('active');
}

// Fermer les menus quand on clique ailleurs
document.addEventListener('click', (e) => {
	if (!e.target.closest('.message-actions')) {
		document.querySelectorAll('.message-actions-dropdown').forEach(m => m.classList.remove('active'));
	}
});

// Modifier un message
window.editMessage = async function(event, messageId) {
	event.stopPropagation();
	// Fermer le menu
	document.querySelectorAll('.message-actions-dropdown').forEach(m => m.classList.remove('active'));
	
	const wrapper = document.querySelector(`.message-wrapper[data-message-id="${messageId}"]`);
	if (!wrapper) return;
	
	const originalContent = wrapper.dataset.messageContent;
	
	// Retirer les préfixes [MODIFIÉ], [SUPPRIMÉ] et [Sujet]
	let cleanContent = originalContent
		.replace(/^\[MODIFIÉ\]\s*/, '')
		.replace(/^\[SUPPRIMÉ\]\s*/, '')
		.replace(/^\[[^\]]+\]\s*/, ''); // Retire le sujet
	
	// Ouvrir le modal d'édition
	editMessageInput.value = cleanContent;
	currentEditMessageId = messageId;
	editMessageModal.classList.add('active');
	editMessageInput.focus();
}

// Gestionnaire de confirmation d'édition
editMessageConfirm.addEventListener('click', async () => {
	const newContent = editMessageInput.value.trim();
	if (!newContent || !currentEditMessageId) return;
	
	try {
		const response = await fetch('{{ path('admin_message_edit', {'id': 'PLACEHOLDER'}) }}'.replace('PLACEHOLDER', currentEditMessageId), {
			method: 'POST',
			headers: {
				'Content-Type': 'application/x-www-form-urlencoded',
				'X-Requested-With': 'XMLHttpRequest'
			},
			body: 'message=' + encodeURIComponent(newContent)
		});
		
		const data = await response.json();
		
		if (data.success) {
			// Fermer le modal
			editMessageModal.classList.remove('active');
			editMessageInput.value = '';
			
			// Mettre à jour le message dans le DOM
			const wrapper = document.querySelector(`.message-wrapper[data-message-id="${currentEditMessageId}"]`);
			if (wrapper) {
				const contentEl = wrapper.querySelector('.message-content');
				if (contentEl) {
					contentEl.innerHTML = escapeHtml(newContent).replace(/\n/g, '<br>');
				}
				// Stocker le contenu nettoyé dans data-attribute
				wrapper.dataset.messageContent = newContent;
				
				// Ajouter la notification de modification
				let notif = wrapper.querySelector('.message-notification');
				if (!notif) {
					notif = document.createElement('div');
					notif.className = 'message-notification edited';
					wrapper.insertBefore(notif, wrapper.firstChild);
				}
				notif.className = 'message-notification edited';
				notif.textContent = 'Modifié';
			}
			
			// Mettre à jour l'aperçu dans la liste des conversations à gauche
			const convItem = document.querySelector(`.conversation-item[data-id="${currentConversationId}"]`);
			if (convItem) {
				const preview = convItem.querySelector('.conversation-preview');
				if (preview) {
					// Nettoyer le message des préfixes
					let cleanPreview = newContent.replace(/^\[MODIFIÉ\]\s*/, '').replace(/^\[SUPPRIMÉ\]\s*/, '').replace(/^\[[^\]]+\]\s*/, '');
					preview.textContent = cleanPreview.slice(0, 50) + (cleanPreview.length > 50 ? '...' : '');
				}
			}
			
			showToast('Message modifié', 'success');
			currentEditMessageId = null;
		} else {
			showToast(data.error || 'Erreur lors de la modification', 'error');
		}
	} catch (error) {
		console.error('Erreur:', error);
		showToast('Erreur de connexion', 'error');
	}
});

// Supprimer un message
// Supprimer un message
window.deleteMessage = async function(event, messageId) {
	event.stopPropagation();
	// Fermer le menu
	document.querySelectorAll('.message-actions-dropdown').forEach(m => m.classList.remove('active'));
	
	// Utiliser le modal de confirmation
	confirmMessage.textContent = 'Êtes-vous sûr de vouloir supprimer ce message ?';
	confirmModal.classList.add('active');
	
	// Définir l'action de confirmation
	confirmCallback = async () => {
		try {
			const response = await fetch('{{ path('admin_message_delete_msg', {'id': 'PLACEHOLDER'}) }}'.replace('PLACEHOLDER', messageId), {
				method: 'POST',
				headers: {
					'X-Requested-With': 'XMLHttpRequest'
				}
			});
			
			const data = await response.json();
			
			if (data.success) {
				// Mettre à jour le message dans le DOM
				const wrapper = document.querySelector(`.message-wrapper[data-message-id="${messageId}"]`);
				if (wrapper) {
					const contentEl = wrapper.querySelector('.message-content');
					if (contentEl) {
						contentEl.innerHTML = '<em style="opacity: 0.6;">Ce message a été supprimé</em>';
					}
					wrapper.dataset.messageContent = 'Ce message a été supprimé par son auteur';
					
					// Retirer les boutons d'actions
					const actionsContainer = wrapper.querySelector('.message-actions');
					if (actionsContainer) {
						actionsContainer.remove();
					}
				}
				
				// Mettre à jour l'aperçu dans la liste des conversations à gauche
				const convItem = document.querySelector(`.conversation-item[data-id="${currentConversationId}"]`);
				if (convItem) {
					const preview = convItem.querySelector('.conversation-preview');
					if (preview) {
						preview.textContent = 'Ce message a été supprimé';
					}
				}
				
				showToast('Message supprimé', 'success');
			} else {
				showToast(data.error || 'Erreur lors de la suppression', 'error');
			}
		} catch (error) {
			console.error('Erreur:', error);
			showToast('Erreur de connexion', 'error');
		}
	};
}

function escapeHtml(text) { const div = document.createElement('div'); div.textContent = text; return div.innerHTML; }

function createAvatarHtml(name, profileImage) {
	if (profileImage && profileImage.trim() !== '') {
		const baseUrl = document.querySelector('[data-base-url]')?.getAttribute('data-base-url') || '{{ path('app_home') }}'.replace(/\/$/, '');
		const imagePath = profileImage.startsWith('/') ? profileImage : '/uploads/profiles/' + profileImage;
		return '<img src="' + baseUrl + imagePath + '" alt="Photo de profil">';
	} else {
		const initials = name.split(' ').map(n => n[0]).join('').toUpperCase().slice(0, 2);
		return initials;
	}
}
});
