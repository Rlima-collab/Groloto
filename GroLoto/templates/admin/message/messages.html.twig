		const date = targetItem.dataset.date;
		const isClosed = targetItem.dataset.closed === 'true';
		
		// Mettre à jour l'affichage
		const conversation = conversationData ? JSON.parse(conversationData) : [];
		const allMessages = [{
			id: conversationId,
			nom: sender,
			email: email,
			message: message,
			date: date,
			isEdited: message.includes('[MODIFIÉ]'),
			isDeleted: message.includes('[SUPPRIMÉ]')
		}, ...conversation.map(msg => ({
			...msg,
			isEdited: msg.isEdited || (msg.message && msg.message.includes('[MODIFIÉ]')),
			isDeleted: msg.isDeleted || (msg.message && msg.message.includes('[SUPPRIMÉ]'))
		}))];
		renderMessages(allMessages);
