            closedIndicator.textContent = '🔒 Conversation clôturée';
		} else if (reponduPar && reponduPar !== adminEmail) {
            closedIndicator.style.display = 'block';
            closedIndicator.textContent = `👤 Pris en charge par ${reponduParNom || reponduPar}`;
            closedIndicator.style.background = 'rgba(59, 130, 246, 0.2)';
