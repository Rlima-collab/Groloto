{% extends 'base.html.twig' %}
{% block title %}Messagerie{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ asset('css/shared/messaging.css') }}">
{% endblock %}

{% block body %}
<div class="chat-container">
<div class="chat-sidebar">
<div class="chat-sidebar-header">
<h2>Messagerie</h2>
<button class="new-chat-btn" id="newChatBtn">Nouveau message</button>
<div class="search-box" style="margin-top: 15px;">
<input type="text" id="searchConversations" placeholder="Rechercher une conversation..." style="width: 100%; padding: 10px 15px; border: 2px solid rgba(255,255,255,0.2); border-radius: 10px; background: rgba(255,255,255,0.1); color: white; font-size: 14px; transition: all 0.3s;">
</div>
</div>
<div class="conversations-list" id="conversationsList">
{% if messages|length == 0 %}
<div class="empty-conversations" id="emptyConversations" style="text-align: center; padding: 40px 20px; color: #6b7280;"><p>Aucune conversation</p></div>
{% else %}
{% for msg in messages %}
{% set parts = msg.message|split('] ', 2) %}
{% set hasSubject = parts|length > 1 and parts[0]|slice(0,1) == '[' %}
{% set subject = hasSubject ? parts[0]|slice(1) : 'Sans sujet' %}
{% set body = hasSubject ? parts[1] : msg.message %}
{% set lastMessageText = msg.lastMessage|default(body) %}
{% set lastMessageParts = lastMessageText|split('] ', 2) %}
{% set lastMessageBody = lastMessageParts|length > 1 and lastMessageParts[0]|slice(0,1) == '[' ? lastMessageParts[1] : lastMessageText %}
{% set isToAdmin = msg.destinataire and 'admin' in msg.destinataire|lower %}
{% set conversationArray = [] %}
{% for reply in msg.conversation|default([]) %}
{% set conversationArray = conversationArray|merge([{
'nom': reply.nom,
'email': reply.email,
'message': reply.message,
'date': reply.createdAt|date('d/m/Y à H:i'),
'isEdited': reply.message starts with '[MODIFIÉ]',
'isDeleted': reply.message starts with '[SUPPRIMÉ]'
}]) %}
{% endfor %}
<div class="conversation-item {% if isToAdmin %}to-admin{% endif %} {% if msg.cloturee %}conversation-closed{% endif %} {% if msg.reponduPar %}conversation-replied{% endif %}" 
    data-id="{{ msg.id }}" 
    data-subject="{{ subject|e('html_attr') }}" 
    data-conversation="{{ conversationArray|json_encode|e('html_attr') }}" 
    data-sender="{{ msg.nom }}" 
    data-email="{{ msg.email }}" 
    data-other-email="{{ msg.otherUserEmail|default('') }}"
    data-other-role="{{ msg.otherUserRole|default('Utilisateur') }}"
    data-repondu-par="{{ msg.reponduPar ? msg.reponduPar.email : '' }}"
    data-repondu-par-nom="{{ msg.reponduPar ? (msg.reponduPar.prenom ~ ' ' ~ msg.reponduPar.nom)|trim : '' }}"
    data-message="{{ body|e('html_attr') }}" 
    data-date="{{ msg.createdAt|date('d/m/Y à H:i') }}" 
    data-closed="{{ msg.cloturee ? 'true' : 'false' }}" 
    data-profile-image="{{ msg.otherUserProfileImage|default('') }}">
	<div class="conversation-item-content">
		<div class="conversation-name">
			{{ subject }}
			{% if msg.cloturee %}
			<span class="closed-badge">🔒 Clôturée</span>
			{% endif %}
			{% if msg.reponduPar %}
				<span class="replied-badge">✅ Répondu</span>
			{% endif %}
			{% if msg.reponduPar and msg.reponduPar.email != app.user.email %}
			<span class="closed-badge" style="background: rgba(59, 130, 246, 0.2); color: #3b82f6;">👤 Pris par {{ msg.reponduPar.prenom }}</span>
			{% endif %}
		</div>
		<div class="conversation-sender">{{ msg.otherUserName|default(msg.nom) }} <span style="font-size: 11px; color: #9ca3af;">({{ msg.otherUserRole|default('Utilisateur') }})</span></div>
		<div class="conversation-preview">{{ lastMessageBody|slice(0, 50) }}{% if lastMessageBody|length > 50 %}...{% endif %}</div>
		<div class="conversation-time">{{ msg.lastMessageDate|default(msg.createdAt)|date('d/m H:i') }}</div>
	</div>
	<div class="conversation-item-menu">
		<button class="conversation-menu-btn" onclick="toggleConversationMenu(event, {{ msg.id }})">
			<svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><circle cx="12" cy="5" r="2"></circle><circle cx="12" cy="12" r="2"></circle><circle cx="12" cy="19" r="2"></circle></svg>
		</button>
		<div class="conversation-dropdown" id="convMenu{{ msg.id }}">
			<button class="conversation-dropdown-item" onclick="closeConversation(event, {{ msg.id }})">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"></path></svg>
				Clôturer
			</button>
			<button class="conversation-dropdown-item delete" onclick="deleteConversation(event, {{ msg.id }})">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
				Supprimer
			</button>
		</div>
	</div>
</div>
{% endfor %}
{% endif %}
</div>
</div>
<div class="chat-main">
<div class="chat-header" id="chatHeader" style="display: none;">
	<button class="back-btn-mobile" id="backToListBtn">
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
			<path d="M19 12H5M12 19l-7-7 7-7"/>
		</svg>
		Retour
	</button>
	<h3 id="chatTitle">Conversation</h3>
	<span id="closedIndicator" style="display: none; font-size: 12px; padding: 6px 12px; background: rgba(251, 191, 36, 0.2); color: #fbbf24; border-radius: 20px; font-weight: 600;">🔒 Conversation clôturée</span>
</div>
<div class="chat-messages" id="chatMessages">
<div class="chat-empty">
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
<p>Sélectionnez une conversation</p>
</div>
</div>
<div class="chat-input-container" id="chatInputContainer" style="display: none;">
    <div class="chat-input-wrapper">
        <input type="email" id="chatRecipient" class="chat-recipient" placeholder="Email destinataire" style="display:none;">
        <input type="text" id="chatSubject" class="chat-subject" placeholder="Sujet de la conversation" style="display:none;">
        <textarea class="chat-input" id="chatInput" placeholder="Écrivez votre message..." rows="1"></textarea>
        <button class="chat-send-btn" id="sendBtn">Envoyer</button>
	</div>
	<div style="margin-top:10px; display:flex; flex-direction:column; gap:8px;">
		<div style="display:flex; align-items:center; justify-content:space-between; gap:12px;">
			<a href="#" class="chat-send-btn" id="sendEmailBtn" style="display:none; background: linear-gradient(135deg, #2563eb 0%, #3b82f6 100%); color: white; text-decoration: none; text-align: center; padding:10px 14px; border-radius:8px;">
				<i class="bi bi-envelope"></i> Répondre par email
			</a>

			<div id="markRepliedContainer" style="display: none;">
				<label style="display:flex; align-items:center; gap:10px; font-size:14px; color:#374151;">
					<input type="checkbox" id="markRepliedCheckbox" style="width:18px; height:18px;"> <span id="markRepliedLabel">Cocher si vous avez répondu par email</span>
				</label>
			</div>
		</div>

		<div id="externalUserNotice" style="display: none; padding: 10px 15px; background: rgba(59,130,246,0.06); border: 1px solid rgba(59,130,246,0.12); border-radius: 8px; font-size: 13px; color: #1e3a8a;">
			<i class="bi bi-info-circle"></i> Cet utilisateur n'est pas inscrit sur l'application. Utilisez le bouton "Répondre par email" pour lui envoyer une réponse via votre client email.
		</div>
	</div>
</div>
</div>
</div>
</div>

<!-- POPUP MODAL POUR DESTINATAIRE + SUJET -->
<div class="modal-overlay" id="newMessageModal">
	<div class="modal-content">
		<div class="modal-header">Nouveau message Admin</div>
		<div style="position: relative;">
			<input type="text" id="modalRecipient" class="modal-input" placeholder="Email du destinataire (ou cliquez sur 'Tous les bénévoles')" autocomplete="off">
			<div id="autocompleteList" style="position: absolute; top: calc(100% + 1px); left: 0; right: 0; background: white; border: 1px solid #d1d5db; border-top: none; border-radius: 0 0 8px 8px; max-height: 200px; overflow-y: auto; z-index: 1000; display: none; box-shadow: 0 4px 6px rgba(0,0,0,0.1);"></div>
		</div>
		<div style="display:flex; gap:15px; margin-top:15px; margin-bottom: 15px;">
			<button type="button" id="modalAllBenevoles" class="modal-btn" style="background: linear-gradient(135deg,#10b981 0%,#059669 100%); color:white;">Tous les bénévoles</button>
			<button type="button" id="modalAllMecenes" class="modal-btn" style="background: linear-gradient(135deg,#3b82f6 0%,#2563eb 100%); color:white;">Tous les mécènes</button>
		</div>
		<input type="text" id="modalSubject" class="modal-input" placeholder="Sujet de la conversation" autocomplete="off">
		<div class="modal-actions">
			<button class="modal-btn modal-btn-cancel" id="modalCancel">Annuler</button>
			<button class="modal-btn modal-btn-confirm" id="modalConfirm">Continuer</button>
		</div>
	</div>
</div>

<!-- MODAL DE CONFIRMATION -->
<div class="modal-overlay" id="confirmModal">
	<div class="modal-content">
		<div class="modal-header" id="confirmTitle">Confirmation</div>
		<p id="confirmMessage" style="padding: 20px; color: #374151; line-height: 1.6;"></p>
		<div class="modal-actions">
			<button class="modal-btn modal-btn-cancel" id="confirmCancel">Annuler</button>
			<button class="modal-btn modal-btn-confirm" id="confirmOk">Confirmer</button>
		</div>
	</div>
</div>

<!-- MODAL D'ÉDITION DE MESSAGE -->
<div class="modal-overlay" id="editMessageModal">
	<div class="modal-content">
		<div class="modal-header">Modifier le message</div>
		<textarea id="editMessageInput" class="modal-input" rows="4" style="resize: vertical; min-height: 80px;" placeholder="Écrivez votre message..."></textarea>
		<div class="modal-actions">
			<button class="modal-btn modal-btn-cancel" id="editMessageCancel">Annuler</button>
			<button class="modal-btn modal-btn-confirm" id="editMessageConfirm">Modifier</button>
		</div>
	</div>
</div>

<!-- TOAST NOTIFICATIONS -->
<div id="toastContainer" style="position: fixed; bottom: 20px; right: 20px; z-index: 10000; display: flex; flex-direction: column; gap: 10px;"></div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
// Base URL for fetch API calls - handles subdirectory deployments
window.APP_BASE_URL = '{{ path('app_home')|slice(0, -1) }}';
</script>
<script src="{{ asset('js/shared/messaging.js') }}"></script>
<script src="{{ asset('js/admin/messaging.js') }}"></script>
<script>
const adminEmail = '{{ adminEmail|default('admin@groloto.local') }}';
const currentUserName = '{{ app.user ? (app.user.prenom ~ ' ' ~ app.user.nom)|e('js') : 'Admin' }}';
const currentUserProfileImage = '{{ app.user.profileImage|default('')|e('js') }}';
// Variables déjà déclarées dans messaging.js : currentConversationId, currentSubject, currentRecipient, etc.

// Système de confirmation modal
// confirmCallback déjà déclaré dans messaging.js

function showConfirm(title, message, onConfirm) {
	const modal = document.getElementById('confirmModal');
	const titleEl = document.getElementById('confirmTitle');
	const messageEl = document.getElementById('confirmMessage');
	
	titleEl.textContent = title;
	messageEl.textContent = message;
	confirmCallback = onConfirm;
	modal.classList.add('active');
}

// Système de toast notifications
function showToast(message, type = 'info') {
	const container = document.getElementById('toastContainer');
	const toast = document.createElement('div');
	toast.className = `toast ${type}`;
	
	const icon = type === 'success' ? '✓' : type === 'error' ? '✕' : 'ℹ';
	toast.innerHTML = `<span style="font-size: 20px;">${icon}</span><span>${message}</span>`;
	
	container.appendChild(toast);
	
	setTimeout(() => {
		toast.style.animation = 'slideIn 0.3s ease reverse';
		setTimeout(() => toast.remove(), 300);
	}, 3000);
}

document.addEventListener('DOMContentLoaded', function() {
const items = document.querySelectorAll('.conversation-item');
const chatMessages = document.getElementById('chatMessages');
const chatInput = document.getElementById('chatInput');
const sendBtn = document.getElementById('sendBtn');
const sendEmailBtn = document.getElementById('sendEmailBtn');
const externalUserNotice = document.getElementById('externalUserNotice');
const newChatBtn = document.getElementById('newChatBtn');
const chatHeader = document.getElementById('chatHeader');
const chatInputContainer = document.getElementById('chatInputContainer');
const chatTitle = document.getElementById('chatTitle');
const conversationsList = document.getElementById('conversationsList');
const closedIndicator = document.getElementById('closedIndicator');
const searchInput = document.getElementById('searchConversations');
const backToListBtn = document.getElementById('backToListBtn');
const markRepliedCheckbox = document.getElementById('markRepliedCheckbox');

// Gérer la checkbox 'marqué comme répondu' (AJAX)
if (markRepliedCheckbox) {
	markRepliedCheckbox.addEventListener('change', async function() {
		if (!currentConversationId) {
			showToast('Aucune conversation sélectionnée', 'error');
			this.checked = !this.checked;
			return;
		}

		const mark = this.checked ? '1' : '0';
		try {
			const url = '{{ path('admin_message_mark_replied', {'id':'PLACEHOLDER'}) }}'.replace('PLACEHOLDER', currentConversationId);
			const response = await fetch(url, {
				method: 'POST',
				headers: {
					'X-Requested-With': 'XMLHttpRequest',
					'Content-Type': 'application/x-www-form-urlencoded'
				},
				body: 'mark=' + encodeURIComponent(mark)
			});
			const data = await response.json();
			if (data.success) {
				showToast(this.checked ? 'Marqué comme répondu' : 'Démarquée', 'success');
				// Mettre à jour l'attribut data-repondu-par sur la conversation
				const convItem = document.querySelector(`.conversation-item[data-id="${currentConversationId}"]`);
				if (convItem) {
					convItem.dataset.reponduPar = this.checked ? '{{ app.user.email|e('js') }}' : '';
					// Mettre à jour l'affichage (badge + style)
					const nameEl = convItem.querySelector('.conversation-name');
					if (nameEl) {
						let repliedSpan = nameEl.querySelector('.replied-badge');
						if (this.checked) {
							if (!repliedSpan) {
								repliedSpan = document.createElement('span');
								repliedSpan.className = 'replied-badge';
								repliedSpan.textContent = '✅ Répondu';
								nameEl.insertBefore(repliedSpan, nameEl.childNodes[2] || null);
							}
							convItem.classList.add('conversation-replied');
						} else {
							if (repliedSpan) repliedSpan.remove();
							convItem.classList.remove('conversation-replied');
						}
					}
				}
			} else {
				showToast(data.error || 'Erreur', 'error');
				this.checked = !this.checked;
			}
		} catch (err) {
			console.error(err);
			showToast('Erreur réseau', 'error');
			this.checked = !this.checked;
		}
	});
}

// Bouton retour pour mobile
if (backToListBtn) {
	backToListBtn.addEventListener('click', function() {
		document.querySelector('.chat-sidebar').classList.remove('hidden-mobile');
		document.querySelector('.chat-main').classList.remove('active-mobile');
		chatHeader.style.display = 'none';
		chatInputContainer.style.display = 'none';
	});
}

// Fonction de recherche des conversations
searchInput.addEventListener('input', function() {
	const searchTerm = this.value.toLowerCase().trim();
	const conversations = document.querySelectorAll('.conversation-item');
	
	conversations.forEach(conv => {
		const name = conv.querySelector('.conversation-name')?.textContent.toLowerCase() || '';
		const sender = conv.querySelector('.conversation-sender')?.textContent.toLowerCase() || '';
		const preview = conv.querySelector('.conversation-preview')?.textContent.toLowerCase() || '';
		
		// Recherche dans le nom, l'expéditeur et l'aperçu du message
		if (name.includes(searchTerm) || sender.includes(searchTerm) || preview.includes(searchTerm)) {
			conv.style.display = '';
		} else {
			conv.style.display = 'none';
		}
	});
	
	// Afficher/masquer le message "Aucune conversation"
	const visibleConvs = Array.from(conversations).filter(c => c.style.display !== 'none');
	const emptyMessage = document.getElementById('emptyConversations');
	if (emptyMessage) {
		emptyMessage.style.display = visibleConvs.length === 0 ? 'block' : 'none';
	}
});

// Style du champ de recherche au focus
searchInput.addEventListener('focus', function() {
	this.style.background = 'rgba(255,255,255,0.15)';
	this.style.borderColor = 'rgba(59, 130, 246, 0.5)';
});

searchInput.addEventListener('blur', function() {
	this.style.background = 'rgba(255,255,255,0.1)';
	this.style.borderColor = 'rgba(255,255,255,0.2)';
});

// Modal
const newMessageModal = document.getElementById('newMessageModal');
const modalRecipient = document.getElementById('modalRecipient');
const modalSubject = document.getElementById('modalSubject');
const modalCancel = document.getElementById('modalCancel');
const modalConfirm = document.getElementById('modalConfirm');

// Modal de confirmation
const confirmModal = document.getElementById('confirmModal');
const confirmCancel = document.getElementById('confirmCancel');
const confirmOk = document.getElementById('confirmOk');

// Modal d'édition de message
const editMessageModal = document.getElementById('editMessageModal');
const editMessageInput = document.getElementById('editMessageInput');
const editMessageCancel = document.getElementById('editMessageCancel');
const editMessageConfirm = document.getElementById('editMessageConfirm');
let currentEditMessageId = null;

editMessageCancel.addEventListener('click', () => {
	editMessageModal.classList.remove('active');
	editMessageInput.value = '';
	currentEditMessageId = null;
});

confirmCancel.addEventListener('click', () => {
	confirmModal.classList.remove('active');
	confirmCallback = null;
});

confirmOk.addEventListener('click', () => {
	confirmModal.classList.remove('active');
	if (confirmCallback) {
		confirmCallback();
		confirmCallback = null;
	}
});

// Fonctions pour gérer les menus sur les conversation-items
window.toggleConversationMenu = function(e, convId) {
	e.stopPropagation();
	// Fermer tous les autres menus
	document.querySelectorAll('.conversation-dropdown').forEach(m => m.classList.remove('show'));
	// Ouvrir celui-ci
	document.getElementById('convMenu' + convId).classList.add('show');
};

window.closeConversation = async function(e, convId) {
	e.stopPropagation();
	
	showConfirm(
		'Clôturer la conversation',
		'Les deux parties ne pourront plus envoyer de messages. Êtes-vous sûr ?',
		async function() {
			try {
				const response = await fetch('{{ path('admin_message_close', {'id': 'PLACEHOLDER'}) }}'.replace('PLACEHOLDER', convId), {
					method: 'POST',
					headers: {'X-Requested-With': 'XMLHttpRequest', 'Content-Type': 'application/json'}
				});
				const data = await response.json();
				
				if (data.success) {
					document.getElementById('convMenu' + convId).classList.remove('show');
					showToast('Conversation clôturée avec succès', 'success');
					
					// Mettre à jour l'attribut data-closed de la conversation
					const convItem = document.querySelector(`.conversation-item[data-id="${convId}"]`);
					if (convItem) {
						convItem.dataset.closed = 'true';
						convItem.classList.add('conversation-closed');
						// Ajouter le badge dans le nom
						const nameEl = convItem.querySelector('.conversation-name');
						if (nameEl && !nameEl.querySelector('.closed-badge')) {
							nameEl.innerHTML += ' <span class="closed-badge">🔒 Clôturée</span>';
						}
					}
					
					// Si c'est la conversation active, désactiver l'input et afficher l'indicateur
					if (currentConversationId == convId) {
						chatInput.disabled = true;
						sendBtn.disabled = true;
						chatInput.placeholder = 'Cette conversation est clôturée';
						closedIndicator.style.display = 'block';
					}
				} else {
					showToast(data.error || 'Erreur lors de la clôture', 'error');
				}
			} catch (err) {
				console.error(err);
				showToast('Erreur réseau', 'error');
			}
		}
	);
};

window.deleteConversation = async function(e, convId) {
	e.stopPropagation();
	
	showConfirm(
		'Supprimer la conversation',
		'Cette conversation sera supprimée de votre liste. Êtes-vous sûr ?',
		async function() {
			try {
				const response = await fetch('{{ path('admin_message_delete', {'id': 'PLACEHOLDER'}) }}'.replace('PLACEHOLDER', convId), {
					method: 'POST',
					headers: {'X-Requested-With': 'XMLHttpRequest'}
				});
				const data = await response.json();
				
				if (data.success) {
					document.getElementById('convMenu' + convId).classList.remove('show');
					showToast('Conversation supprimée', 'success');
					
					const convItem = document.querySelector(`.conversation-item[data-id="${convId}"]`);
					if (convItem) convItem.remove();
					
					if (currentConversationId == convId) {
						chatHeader.style.display = 'none';
						chatInputContainer.style.display = 'none';
						chatMessages.innerHTML = '<div class="chat-empty"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg><p>Sélectionnez une conversation</p></div>';
						currentConversationId = null;
					}
				} else {
					showToast(data.error || 'Erreur lors de la suppression', 'error');
				}
			} catch (err) {
				console.error(err);
				showToast('Erreur réseau', 'error');
			}
		}
	);
};

// Fermer les menus si on clique ailleurs
document.addEventListener('click', () => {
	document.querySelectorAll('.conversation-dropdown').forEach(m => m.classList.remove('show'));
});

chatInput.addEventListener('input', function() { this.style.height = 'auto'; this.style.height = Math.min(this.scrollHeight, 120) + 'px'; });

// Gérer le bouton "Nouveau message" - ouvrir le modal
newChatBtn.addEventListener('click', function() {
	newMessageModal.classList.add('active');
	modalRecipient.value = '';
	modalSubject.value = '';
	modalRecipient.focus();
});

// Gérer le bouton "Contacter les bénévoles"
const contactBenevolesBtn = document.getElementById('contactBenevolesBtn');
if (contactBenevolesBtn) {
    contactBenevolesBtn.addEventListener('click', function() {
        newMessageModal.classList.add('active');
        modalRecipient.value = 'ALL_BENEVOLES';
        modalSubject.value = '';
        modalSubject.focus();
        showToast('Destinataire : Tous les bénévoles', 'info');
    });
}

// Autocomplétion pour le champ email
const autocompleteList = document.getElementById('autocompleteList');
let autocompleteTimeout;
let selectedIndex = -1;

// Navigation au clavier dans l'autocomplétion
modalRecipient.addEventListener('keydown', function(e) {
	const items = autocompleteList.querySelectorAll('.autocomplete-item');
	
	if (items.length === 0) return;
	
	if (e.key === 'ArrowDown') {
		e.preventDefault();
		selectedIndex = (selectedIndex + 1) % items.length;
		updateSelectedItem(items);
	} else if (e.key === 'ArrowUp') {
		e.preventDefault();
		selectedIndex = selectedIndex <= 0 ? items.length - 1 : selectedIndex - 1;
		updateSelectedItem(items);
	} else if (e.key === 'Enter' && selectedIndex >= 0) {
		e.preventDefault();
		items[selectedIndex].click();
	} else if (e.key === 'Escape') {
		autocompleteList.style.display = 'none';
		selectedIndex = -1;
	}
});

function updateSelectedItem(items) {
	items.forEach((item, index) => {
		if (index === selectedIndex) {
			item.classList.add('selected');
			item.scrollIntoView({ block: 'nearest' });
		} else {
			item.classList.remove('selected');
		}
	});
}

modalRecipient.addEventListener('input', function() {
	const query = this.value.trim();
	
	clearTimeout(autocompleteTimeout);
	selectedIndex = -1; // Réinitialiser la sélection
	
	if (query.length < 2) {
		autocompleteList.style.display = 'none';
		return;
	}
	
	autocompleteTimeout = setTimeout(async () => {
		try {
			const response = await fetch('{{ path('admin_message_emails_list') }}?q=' + encodeURIComponent(query));
			const users = await response.json();
			
			if (users.length > 0) {
				autocompleteList.innerHTML = users.map(user => {
					// Déterminer le rôle en français
					let roleLabel = '';
					if (user.role === 'ROLE_BENEVOLE') roleLabel = 'Bénévole';
					else if (user.role === 'ROLE_MECENE') roleLabel = 'Mécène';
					
					return `
						<div class="autocomplete-item" data-email="${user.email}" data-name="${user.prenom} ${user.nom}" data-role="${roleLabel}">
							<div class="autocomplete-item-email">${user.email}</div>
							<div class="autocomplete-item-name">${user.prenom} ${user.nom} ${roleLabel ? '(' + roleLabel + ')' : ''}</div>
						</div>
					`;
				}).join('');
				autocompleteList.style.display = 'block';
				
				// Gérer le clic sur un élément d'autocomplétion
				autocompleteList.querySelectorAll('.autocomplete-item').forEach(item => {
					item.addEventListener('click', function() {
						modalRecipient.value = this.dataset.email;
						currentRecipientName = this.dataset.name; // Stocker le nom
						currentRecipientRole = this.dataset.role; // Stocker le rôle
						autocompleteList.style.display = 'none';
						selectedIndex = -1;
						modalSubject.focus();
					});
				});
			} else {
				autocompleteList.style.display = 'none';
			}
		} catch (err) {
			console.error('Erreur autocomplétion:', err);
		}
	}, 300);
});

// Fermer l'autocomplétion si on clique ailleurs
document.addEventListener('click', (e) => {
	if (!modalRecipient.contains(e.target) && !autocompleteList.contains(e.target)) {
