});

// Confirmer le modal - ouvrir la zone de composition
modalConfirm.addEventListener('click', async () => {
	const recipient = modalRecipient.value.trim();
	const subject = modalSubject.value.trim();

	if (!recipient) {
		showToast('Veuillez saisir un destinataire', 'error');
		modalRecipient.focus();
		return;
	}

	if (!subject) {
		showToast('Veuillez saisir un sujet', 'error');
		modalSubject.focus();
		return;
	}

	// Gérer les destinataires de groupe spéciaux (ex: ALL_BENEVOLES, ALL_MECENES)
	// Normaliser : minuscules, sans accents, espaces -> underscores
	const normalized = recipient.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/\s+/g, '_');
	const isAllBene = ['all_benevoles', 'tous_les_benevoles', 'tous_benevoles', 'tous'].includes(normalized);
	const isAllMec = ['all_mecenes', 'tous_les_mecenes', 'tous_mecenes'].includes(normalized);

	modalConfirm.disabled = true;

	if (isAllBene || isAllMec) {
		// Pas de vérification d'email nécessaire, on enverra au back-end en masse
		currentRecipient = isAllBene ? 'ALL_BENEVOLES' : 'ALL_MECENES';
		currentRecipientName = isAllBene ? 'Tous les bénévoles' : 'Tous les mécènes';
		currentRecipientRole = isAllBene ? 'Bénévole' : 'Mécène';
		currentSubject = subject;
		currentConversationId = 'new';
	} else {
		// Vérifier que l'email existe dans la base de données
		try {
			const response = await fetch('{{ path('admin_message_emails_list') }}?q=' + encodeURIComponent(recipient));
			const users = await response.json();
			const exactMatch = users.find(u => u.email.toLowerCase() === recipient.toLowerCase());

			if (!exactMatch) {
				showToast('L\'adresse email n\'est pas enregistrée dans l\'application', 'error');
				modalRecipient.focus();
				modalConfirm.disabled = false;
				return;
			}

			// Stocker le nom complet du destinataire et son rôle
			currentRecipientName = `${exactMatch.prenom} ${exactMatch.nom}`;
			if (exactMatch.role === 'ROLE_BENEVOLE') currentRecipientRole = 'Bénévole';
			else if (exactMatch.role === 'ROLE_MECENE') currentRecipientRole = 'Mécène';
			else currentRecipientRole = '';

			currentRecipient = recipient;
			currentSubject = subject;
			currentConversationId = 'new';
		} catch (err) {
			console.error('Erreur validation email:', err);
			showToast('Erreur lors de la vérification de l\'email', 'error');
			modalConfirm.disabled = false;
			return;
		}
	}
	
	// Afficher la zone de composition
	chatHeader.style.display = 'block';
	chatInputContainer.style.display = 'block';
	chatTitle.textContent = 'Nouveau message - ' + recipient;
	document.querySelectorAll('.conversation-item').forEach(item => item.classList.remove('active'));

	chatMessages.innerHTML = `
		<div class="chat-empty">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
				<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
			</svg>
			<p>Commencez votre nouveau message...</p>
		</div>
	`;
	chatInput.value = '';
	chatInput.disabled = false;
	sendBtn.disabled = false;
	chatInput.focus();
	
	// Fermer le modal
	newMessageModal.classList.remove('active');
});

