{% extends 'base.html.twig' %}

{% block title %}Gestion des Membres - Admin{% endblock %}

{% block stylesheets %}
{{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/modele.css') }}">
    <link rel="stylesheet" href="{{ asset('css/benevoles/benevoles-common.css') }}">
{% endblock %}

{% block body %}
<div class="hero-section benevoles-hero">
    <div class="shine"></div>
    <div class="hero-content">
        <h1 class="hero-title">Gestion des Membres</h1>
        <p class="hero-description">Importez, gérez et exportez vos données de membres</p>
        <a href="#contenu-membres" class="btn-login">Gérer les membres</a>
    </div>
</div>

<br>

<div class="excel-manager" id="contenu-membres">
    <div class="row" style="max-width: 1400px; margin: 0 auto; padding: 0 20px;">
        <!-- Sidebar Sheets -->
        <div class="col-lg-3">
            <div class="sheets-panel">
                <div class="sheets-header">
                    <h3 class="sheets-title">
                        <i class="fas fa-layer-group"></i> Feuilles
                    </h3>
                    <span class="badge bg-primary">{{ sheets|length }}</span>
                </div>

                {% if sheets|length > 0 %}
                    <div class="sheets-list">
                        {% for sheet in sheets %}
                        <a href="{{ path('admin_excel_index', {sheet: sheet.sheetName}) }}"
                           class="sheet-item {% if current_sheet and current_sheet.id == sheet.id %}active{% endif %}">
                            <div class="sheet-name">
                                <i class="fas fa-table"></i> {{ sheet.sheetName }}
                            </div>
                            <div class="sheet-meta">
                                <span class="row-count">{{ sheet.rowCount }} lignes</span>
                                <span class="col-count">{{ sheet.columns|length }} colonnes</span>
                            </div>
                        </a>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="empty-state">
                        <i class="fas fa-inbox"></i>
                        <p>Aucune donnée</p>
                    </div>
                {% endif %}
            </div>
        </div>

        <!-- Main Content -->
        <div class="col-lg-9">
            <!-- Export Button Bar -->
            <div style="display: flex; justify-content: flex-end; margin-bottom: 20px;">
                {% if current_sheet %}
                    <a href="{{ path('admin_excel_export') }}" class="btn btn-success btn-lg">
                        <i class="fas fa-download"></i> Exporter tout
                    </a>
                {% endif %}
            </div>

            <!-- Upload Section -->
            <div class="upload-section mb-4">
                <div class="upload-card">
                    <div class="upload-icon">
                        <i class="fas fa-cloud-upload-alt"></i>
                    </div>
                    <h3>Importer un fichier Excel</h3>
                    <p class="text-muted">Sélectionnez un fichier .xlsx pour importer vos données</p>
                    
                    <form method="POST" action="{{ path('admin_excel_upload') }}" enctype="multipart/form-data" class="upload-form">
                        <div class="file-input-wrapper">
                            <input type="file" id="excel_file" name="excel_file" accept=".xlsx" required>
                            <label for="excel_file" class="file-label">
                                <i class="fas fa-folder-open"></i> Cliquez pour sélectionner
                            </label>
                            <div id="file-selected" class="file-selected" style="display: none;">
                                <i class="fas fa-check-circle"></i>
                                <span id="file-name"></span>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary btn-lg" id="submit-btn">
                            <i class="fas fa-upload"></i> Importer
                        </button>
                    </form>
                </div>
            </div>

            <!-- Current Sheet Display -->
            {% if current_sheet %}
            <div class="sheet-content">
                <div class="sheet-header-bar">
                    <div>
                        <h2 class="sheet-name-title">{{ current_sheet.sheetName }}</h2>
                        <p class="sheet-info">
                            <i class="fas fa-calendar-alt"></i>
                            Importé le {{ current_sheet.importedAt|date('d/m/Y à H:i') }}
                        </p>
                    </div>
                    <div class="sheet-actions">
                        <form method="POST" action="{{ path('admin_excel_delete', {id: current_sheet.id}) }}" style="display:inline;">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ current_sheet.id) }}">
                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Êtes-vous sûr de vouloir supprimer cette feuille?')">
                                <i class="fas fa-trash"></i> Supprimer
                            </button>
                        </form>
                    </div>
                </div>

                <!-- Table Display -->
                <div class="table-wrapper">
                    <table class="data-table">
                        <thead>
                            <tr>
                                {% for column in current_sheet.columns %}
                                <th>{{ column }}</th>
                                {% endfor %}
                            </tr>
                        </thead>
                        <tbody>
                            {% if current_sheet.data|length > 0 %}
                                {% for row in current_sheet.data %}
                                <tr>
                                    {% for column in current_sheet.columns %}
                                    <td>{{ row[column] ?? '-' }}</td>
                                    {% endfor %}
                                </tr>
                                {% endfor %}
                            {% else %}
                                <tr>
                                    <td colspan="{% if current_sheet.columns|length %}{{ current_sheet.columns|length }}{% else %}1{% endif %}" class="text-center text-muted py-4">
                                        Aucune donnée
                                    </td>
                                </tr>
                            {% endif %}
                        </tbody>
                    </table>
                </div>

                <!-- Stats -->
                <div class="sheet-stats">
                    <div class="stat-item">
                        <span class="stat-label">Lignes</span>
                        <span class="stat-value">{{ current_sheet.rowCount }}</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">Colonnes</span>
                        <span class="stat-value">{{ current_sheet.columns|length }}</span>
                    </div>
                </div>
            </div>
            {% endif %}
        </div>
    </div>
</div>

<style>
    :root {
        --primary-dark: #0d1b2a;
        --secondary-dark: #1e3a5f;
        --accent-color: #3b82f6;
        --border-light: #e5e7eb;
        --bg-light: #f9fafb;
        --text-dark: #1f2937;
        --text-muted: #6b7280;
    }

    .excel-manager {
        padding: 30px 0;
    }

    /* Sheets Panel */
    .sheets-panel {
        background: white;
        border: 1px solid var(--border-light);
        padding: 20px;
        height: fit-content;
        position: sticky;
        top: 20px;
    }

    .sheets-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        padding-bottom: 15px;
        border-bottom: 1px solid var(--border-light);
    }

    .sheets-title {
        margin: 0;
        font-size: 1rem;
        font-weight: 600;
        color: var(--text-dark);
    }

    .sheets-list {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .sheet-item {
        display: block;
        padding: 10px 12px;
        background: var(--bg-light);
        border: 1px solid var(--border-light);
        border-left: 3px solid transparent;
        text-decoration: none;
        color: var(--text-dark);
        transition: all 0.2s ease;
    }

    .sheet-item:hover {
        background: white;
        border-left-color: var(--accent-color);
    }

    .sheet-item.active {
        background: var(--accent-color);
        color: white;
        border-left-color: var(--accent-color);
        font-weight: 600;
    }

    .sheet-name {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 4px;
        font-weight: 500;
    }

    .sheet-meta {
        display: flex;
        gap: 8px;
        font-size: 0.8rem;
    }

    .sheet-item.active .sheet-meta {
        opacity: 0.9;
    }

    .sheet-item:not(.active) .sheet-meta {
        color: var(--text-muted);
    }

    .row-count, .col-count {
        padding: 2px 6px;
        border-radius: 3px;
    }

    .sheet-item:not(.active) .row-count,
    .sheet-item:not(.active) .col-count {
        background: white;
    }

    .empty-state {
        text-align: center;
        padding: 30px 20px;
        color: var(--text-muted);
    }

    .empty-state i {
        font-size: 2.5rem;
        margin-bottom: 10px;
        opacity: 0.5;
    }

    /* Upload Section */
    .upload-section {
        margin-bottom: 30px;
    }

    .upload-card {
        background: white;
        border: 2px dashed var(--border-light);
        padding: 40px;
        text-align: center;
        transition: all 0.2s ease;
    }

    .upload-card:hover {
        border-color: var(--accent-color);
        background: var(--bg-light);
    }

    .upload-icon {
        font-size: 3rem;
        color: var(--accent-color);
        margin-bottom: 15px;
    }

    .upload-card h3 {
        margin: 0 0 5px 0;
        color: var(--text-dark);
        font-weight: 600;
    }

    .upload-card p {
        margin: 0 0 20px 0;
        color: var(--text-muted);
    }

    .file-input-wrapper {
        margin-bottom: 20px;
    }

    #excel_file {
        display: none;
    }

    .file-label {
        display: inline-block;
        padding: 12px 24px;
        background: white;
        border: 2px solid var(--accent-color);
        color: var(--accent-color);
        cursor: pointer;
        font-weight: 500;
        transition: all 0.2s ease;
        margin-bottom: 15px;
    }

    .file-label:hover {
        background: var(--accent-color);
        color: white;
    }

    /* Sheet Content */
    .sheet-content {
        background: white;
        border: 1px solid var(--border-light);
    }

    .sheet-header-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px;
        border-bottom: 1px solid var(--border-light);
    }

    .sheet-name-title {
        margin: 0;
        font-size: 1.3rem;
        color: var(--text-dark);
        font-weight: 600;
    }

    .sheet-info {
        margin: 5px 0 0 0;
        font-size: 0.9rem;
        color: var(--text-muted);
    }

    .sheet-actions {
        display: flex;
        gap: 10px;
    }

    /* Table */
    .table-wrapper {
        overflow-x: auto;
        border-bottom: 1px solid var(--border-light);
        -webkit-overflow-scrolling: touch;
    }

    .data-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.95rem;
        min-width: min-content;
    }

    .data-table thead {
        background: var(--bg-light);
        border-bottom: 2px solid var(--border-light);
        position: sticky;
        top: 0;
        z-index: 10;
    }

    .data-table th {
        padding: 12px 15px;
        text-align: left;
        font-weight: 600;
        color: var(--text-dark);
        white-space: nowrap;
        background: var(--bg-light);
        min-width: 120px;
    }

    .data-table td {
        padding: 12px 15px;
        border-bottom: 1px solid var(--border-light);
        color: var(--text-dark);
        min-width: 120px;
        word-break: break-word;
    }

    .data-table tbody tr:hover {
        background: var(--bg-light);
    }

    .data-table tbody tr:last-child td {
        border-bottom: none;
    }

    /* Stats */
    .sheet-stats {
        display: flex;
        gap: 20px;
        padding: 20px;
        border-top: 1px solid var(--border-light);
    }

    .stat-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 15px 25px;
        background: var(--bg-light);
        flex: 1;
        border: 1px solid var(--border-light);
    }

    .stat-label {
        font-size: 0.8rem;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 5px;
    }

    .stat-value {
        font-size: 1.8rem;
        font-weight: 700;
        color: var(--accent-color);
    }

    /* Responsive */
    /* Responsive */
    @media (max-width: 1200px) {
        .data-table th,
        .data-table td {
            padding: 10px 12px;
            font-size: 0.9rem;
            min-width: 100px;
        }
    }

    @media (max-width: 992px) {
        .sheets-panel {
            position: static;
            margin-bottom: 30px;
        }

        .sheet-header-bar {
            flex-direction: column;
            align-items: flex-start;
        }

        .sheet-actions {
            width: 100%;
            margin-top: 15px;
        }

        .sheet-stats {
            flex-direction: column;
        }

        .data-table th,
        .data-table td {
            padding: 8px 10px;
            font-size: 0.85rem;
            min-width: 80px;
        }
    }

    @media (max-width: 768px) {
        .data-table th,
        .data-table td {
            padding: 8px;
            font-size: 0.8rem;
            min-width: 70px;
        }

        .upload-card {
            padding: 25px;
        }

        .upload-icon {
            font-size: 2.5rem;
        }
    }

    /* Buttons */
    .btn-lg {
        padding: 10px 24px;
        font-size: 0.95rem;
        font-weight: 600;
    }

    .btn-primary {
        background: var(--accent-color);
        border: none;
        color: white;
        transition: all 0.2s ease;
    }

    .btn-primary:hover {
        background: var(--secondary-dark);
        color: white;
    }

    .btn-success {
        background: #10b981;
        border: none;
        color: white;
    }

    .btn-success:hover {
        background: #059669;
    }

    .btn-danger {
        background: #ef4444;
        border: none;
        color: white;
    }

    .btn-danger:hover {
        background: #dc2626;
    }

    /* File Selection Feedback */
    .file-selected {
        margin-top: 15px;
        padding: 12px 16px;
        background: #ecfdf5;
        border: 2px solid #10b981;
        border-radius: 8px;
        color: #059669;
        font-weight: 500;
        animation: slideDown 0.3s ease;
    }

    .file-selected i {
        margin-right: 8px;
        font-size: 1.1rem;
    }

    #file-name {
        font-weight: 600;
        margin-left: 4px;
    }

    @keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Highlight submit button when file is selected */
    .btn-primary:not(:disabled) {
        cursor: pointer;
    }

    .btn-primary.file-ready {
        background: #10b981;
        box-shadow: 0 0 20px rgba(16, 185, 129, 0.3);
    }

    .btn-primary.file-ready:hover {
        background: #059669;
    }
</style>

<script>
document.getElementById('excel_file').addEventListener('change', function(e) {
    const fileName = e.target.files[0]?.name;
    const fileSelectedDiv = document.getElementById('file-selected');
    const fileNameSpan = document.getElementById('file-name');
    const submitBtn = document.getElementById('submit-btn');

    if (fileName) {
        fileNameSpan.textContent = fileName;
        fileSelectedDiv.style.display = 'flex';
        fileSelectedDiv.style.alignItems = 'center';
        submitBtn.classList.add('file-ready');
    } else {
        fileSelectedDiv.style.display = 'none';
        submitBtn.classList.remove('file-ready');
    }
});
</script>
{% endblock %}
