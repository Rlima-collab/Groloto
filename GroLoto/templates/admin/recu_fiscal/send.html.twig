{% extends 'base.html.twig' %}

{% block title %}Envoyer un reçu fiscal{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/modele.css') }}">
    <link rel="stylesheet" href="{{ asset('css/recu_fiscal.css') }}">
    <link rel="stylesheet" href="{{ asset('css/public/public-common.css') }}">
{% endblock %}

{% block body %}
<!-- Hero Section -->
<div class="hero-section public-hero">
    <div class="shine"></div>
    <div class="hero-content">
        <h1 class="hero-title">Reçus Fiscaux</h1>
        <p class="hero-description">Distribuez les attestations aux bénévoles et mécènes</p>
    </div>
</div>

<div class="recu-fiscal-container">
    <div class="recu-fiscal-card">
        <div class="recu-fiscal-header">
            <h2 class="recu-fiscal-title">Envoyer un reçu fiscal</h2>
            <p class="recu-fiscal-description">
                Sélectionnez un utilisateur, le type de reçu et uploadez le fichier PDF du reçu fiscal.
                Le destinataire recevra une notification et pourra télécharger son document.
            </p>
        </div>

        {% for message in app.flashes('success') %}
            <div class="recu-alert recu-alert-success">
                <span>{{ message }}</span>
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="recu-alert recu-alert-error">
                <span>{{ message }}</span>
            </div>
        {% endfor %}

        <form method="post" enctype="multipart/form-data" id="recu-form">
            <div class="recu-form-section">
                <h3 class="recu-form-section-title">Année fiscale</h3>
                <div class="recu-form-group">
                    <label class="recu-form-label" for="annee">Année fiscale <span class="required">*</span></label>
                    <input type="number" name="annee" id="annee" class="recu-form-input" value="{{ current_year }}" min="2020" max="{{ current_year + 1 }}" required>
                    <input type="hidden" name="type" value="mecene">
                </div>
            </div>

            <div class="recu-form-section">
                <h3 class="recu-form-section-title">Sélection du destinataire</h3>
                <div class="recu-form-group">
                    <label class="recu-form-label">Mécène destinataire <span class="required">*</span></label>

                    <div id="mecene-list" class="recu-user-list">
                        <div class="recu-search-container" style="margin-bottom: 1rem;">
                            <input type="text" id="search-mecene" class="recu-form-input" placeholder="Rechercher un mécène..." style="width: 100%;">
                        </div>
                        <h4 class="recu-user-list-title">Mécènes disponibles</h4>
                        {% if mecenes is empty %}
                            <p style="color: #6b7280; text-align: center; padding: 2rem;">Aucun mécène disponible</p>
                        {% else %}
                            {% for mecene in mecenes %}
                                <div class="recu-user-item" data-user-id="{{ mecene.id }}" data-type="mecene" data-search="{{ mecene.prenom|lower }} {{ mecene.nom|lower }} {{ mecene.email|lower }}">
                                    <div class="recu-user-avatar">
                                        {{ mecene.prenom|first|upper ~ mecene.nom|first|upper }}
                                    </div>
                                    <div class="recu-user-info">
                                        <h4>{{ mecene.prenom }} {{ mecene.nom }}</h4>
                                        <p>{{ mecene.email }}</p>
                                    </div>
                                </div>
                            {% endfor %}
                        {% endif %}
                    </div>

                    <input type="hidden" name="destinataire" id="selected-user" required>
                </div>
            </div>

            <div class="recu-form-section">
                <h3 class="recu-form-section-title">Document fiscal</h3>
                <div class="recu-form-group">
                    <label class="recu-form-label">Fichier PDF du reçu fiscal <span class="required">*</span></label>
                    <div class="recu-file-upload-area" id="file-upload-area">
                        <input type="file" name="recu_file" id="recu_file" accept=".pdf" required style="display: none;">
                        <div id="upload-placeholder" class="recu-upload-placeholder">
                            <p>Cliquez pour sélectionner un fichier</p>
                            <p>ou glissez-déposez votre fichier PDF ici</p>
                            <p style="font-size: 0.875rem; color: #9ca3af; margin-top: 0.5rem;">Formats acceptés : PDF uniquement</p>
                        </div>
                        <div id="file-info" class="recu-file-info" style="display: none;">
                            <p id="file-name" class="recu-file-name"></p>
                            <p style="margin: 0; color: #6b7280;">Fichier prêt à être envoyé</p>
                        </div>
                    </div>
                </div>
            </div>

            <div style="text-align: center; margin-top: 2rem;">
                <input type="hidden" name="_token" value="{{ csrf_token('send_recu_fiscal') }}">
                <button type="submit" class="recu-btn recu-btn-primary" id="submit-btn">
                    <span id="btn-text">Envoyer le reçu fiscal</span>
                    <span id="btn-loading" style="display: none;"><div class="recu-loading-spinner"></div></span>
                </button>
            </div>
        </form>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const typeRadios = document.querySelectorAll('input[name="type"]');
    const meceneList = document.getElementById('mecene-list');
    const benevoleList = document.getElementById('benevole-list');
    const selectedUserInput = document.getElementById('selected-user');
    const fileUploadArea = document.getElementById('file-upload-area');
    const fileInput = document.getElementById('recu_file');
    const uploadPlaceholder = document.getElementById('upload-placeholder');
    const fileInfo = document.getElementById('file-info');
    const fileName = document.getElementById('file-name');
    const form = document.getElementById('recu-form');
    const submitBtn = document.getElementById('submit-btn');
    const btnText = document.getElementById('btn-text');
    const btnLoading = document.getElementById('btn-loading');

    // Gestion du changement de type
    typeRadios.forEach(radio => {
        radio.addEventListener('change', function() {
            if (this.value === 'mecene') {
                meceneList.style.display = 'block';
                benevoleList.style.display = 'none';
            } else {
                meceneList.style.display = 'none';
                benevoleList.style.display = 'block';
            }
            selectedUserInput.value = '';
            document.querySelectorAll('.recu-user-item.selected').forEach(item => {
                item.classList.remove('selected');
            });
        });
    });

    // Gestion de la sélection d'utilisateur
    document.addEventListener('click', function(e) {
        if (e.target.closest('.recu-user-item')) {
            const item = e.target.closest('.recu-user-item');
            const userId = item.dataset.userId;
            document.querySelectorAll('.recu-user-item.selected').forEach(selectedItem => {
                selectedItem.classList.remove('selected');
            });
            item.classList.add('selected');
            selectedUserInput.value = userId;
        }
    });

    // Gestion de la recherche
    const searchMecene = document.getElementById('search-mecene');
    const searchBenevole = document.getElementById('search-benevole');

    function filterUsers(searchInput, userList) {
        const searchTerm = searchInput.value.toLowerCase();
        const userItems = userList.querySelectorAll('.recu-user-item');

        userItems.forEach(item => {
            const searchText = item.dataset.search;
            if (searchText.includes(searchTerm)) {
                item.style.display = 'flex';
            } else {
                item.style.display = 'none';
            }
        });
    }

    searchMecene.addEventListener('input', function() {
        filterUsers(searchMecene, meceneList);
    });

    searchBenevole.addEventListener('input', function() {
        filterUsers(searchBenevole, benevoleList);
    });

    // Gestion du drag & drop
    ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
        fileUploadArea.addEventListener(eventName, preventDefaults, false);
    });
    function preventDefaults(e) {
        e.preventDefault();
        e.stopPropagation();
    }
    ['dragenter', 'dragover'].forEach(eventName => {
        fileUploadArea.addEventListener(eventName, highlight, false);
    });
    ['dragleave', 'drop'].forEach(eventName => {
        fileUploadArea.addEventListener(eventName, unhighlight, false);
    });
    function highlight() { fileUploadArea.classList.add('dragover'); }
    function unhighlight() { fileUploadArea.classList.remove('dragover'); }

    fileUploadArea.addEventListener('drop', handleDrop, false);
    function handleDrop(e) {
        const dt = e.dataTransfer;
        const files = dt.files;
        if (files.length > 0) {
            fileInput.files = files;
            handleFileSelect(files[0]);
        }
    }

    fileUploadArea.addEventListener('click', () => fileInput.click());
    fileInput.addEventListener('change', function(e) {
        if (e.target.files.length > 0) {
            handleFileSelect(e.target.files[0]);
        }
    });

    function handleFileSelect(file) {
        if (file.type !== 'application/pdf') {
            alert('Veuillez sélectionner un fichier PDF uniquement.');
            return;
        }
        fileName.textContent = file.name;
        uploadPlaceholder.style.display = 'none';
        fileInfo.style.display = 'block';
    }

    // Gestion soumission
    form.addEventListener('submit', function(e) {
        const selectedUser = selectedUserInput.value;
        const selectedFile = fileInput.files[0];
        if (!selectedUser) {
            e.preventDefault();
            alert('Veuillez sélectionner un destinataire.');
            return;
        }
        if (!selectedFile) {
            e.preventDefault();
            alert('Veuillez sélectionner un fichier PDF.');
            return;
        }
        btnText.style.display = 'none';
        btnLoading.style.display = 'inline-block';
        submitBtn.disabled = true;
    });
});
</script>
{% endblock %}
