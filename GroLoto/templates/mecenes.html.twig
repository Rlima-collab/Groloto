{% extends 'base.html.twig' %}

{% block title %}Gestion des Mécènes{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/modele.css') }}">
    <link rel="stylesheet" href="{{ asset('css/benevoles/benevoles-common.css') }}">
    <link rel="stylesheet" href="{{ asset('css/benevoles/benevoles-list.css') }}">
{% endblock %}

{% block body %}
<div class="hero-section benevoles-hero">
    <div class="shine"></div>
    <div class="hero-content">
        <h1 class="hero-title">Gestion des Mécènes</h1>
        <p class="hero-description">Partenaires, lots et conventions pour vos événements caritatifs.</p>
        <a href="#liste-mecenes" class="btn-login">Voir les mécènes</a>
    </div>
</div>

<br>

<div class="metrics-grid">
    <div class="metric-card">
        <h3>Total mécènes</h3>
        <p class="metric-value">{{ metriques.total }}</p>
        <p class="metric-detail">Mécènes actifs</p>
    </div>

    <div class="metric-card">
        <h3>Nouveaux ce mois</h3>
        <p class="metric-value">{{ metriques.nouveaux }}</p>
        <p class="metric-detail">Inscriptions récentes</p>
    </div>

    <div class="metric-card">
        <h3>Lots disponibles</h3>
        <p class="metric-value">{{ metriques.disponibles }}</p>
        <p class="metric-detail">Contributions offertes</p>
    </div>
</div>

<div class="container">
    <div class="card main-card" id="liste-mecenes">
        <div class="card-header">
            <h2 class="card-title">Liste des Mécènes</h2>
            <p class="card-description">Gestion des mécènes et partenaires</p>
        </div>
        <div class="card-content">
            {% if mecenes|length > 0 %}
                <div class="benevoles-grid">
                    {% for mecene in mecenes %}
                        <div class="benevole-card">
                            <div class="benevole-header">
                                <h3 class="benevole-name">
                                    {{ mecene.utilisateur.prenom }} {{ mecene.utilisateur.nom }}
                                </h3>
                                <span class="badge status success">Actif</span>
                            </div>
                            
                            <div class="benevole-info">
                                <div class="info-item">
                                    <span class="info-text"><strong>Organisation:</strong> {{ mecene.organisation }}</span>
                                </div>
                                <div class="info-item">
                                    <span class="info-text"><strong>Email:</strong> {{ mecene.utilisateur.email }}</span>
                                </div>
                                {% if mecene.utilisateur.telephone %}
                                <div class="info-item">
                                    <span class="info-text"><strong>Téléphone:</strong> {{ mecene.utilisateur.telephone }}</span>
                                </div>
                                {% endif %}
                                <div class="info-item">
                                    <span class="info-text"><strong>SIRET:</strong> {{ mecene.siret }}</span>
                                </div>
                                <div class="info-item">
                                    <span class="info-text"><strong>Inscrit le:</strong> {{ mecene.utilisateur.dateCreation|date('d/m/Y') }}</span>
                                </div>
                            </div>
                            
                            {% if is_granted('ROLE_ADMIN') %}
                            <div class="benevole-actions">
                                <a href="{{ path('mecene_voir_lots', {'id': mecene.id}) }}" class="btn btn-small btn-primary">Voir lots</a>
                                <a href="{{ path('mecene_edit', {'id': mecene.id}) }}" class="btn btn-small btn-secondary">Modifier</a>
                                <button type="button" 
                                        class="btn btn-small btn-danger" 
                                        data-mecene-id="{{ mecene.id }}"
                                        data-mecene-nom="{{ mecene.organisation }}"
                                        data-csrf-token="{{ csrf_token('delete_mecene_' ~ mecene.id) }}"
                                        onclick="confirmDeleteMecene(this)">Supprimer</button>
                            </div>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <div class="empty-state">
                    <h3>Aucun mécène trouvé</h3>
                    <p>Commencez par ajouter des mécènes à votre base de données.</p>
                    {% if is_granted('ROLE_ADMIN') %}
                    <a href="#" class="btn btn-primary">Ajouter un mécène</a>
                    {% endif %}
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
function confirmDeleteMecene(button) {
    const meceneId = button.getAttribute('data-mecene-id');
    const meceneNom = button.getAttribute('data-mecene-nom');
    const csrfToken = button.getAttribute('data-csrf-token');
    
    if (confirm(`Êtes-vous sûr de vouloir supprimer le mécène "${meceneNom}" ?\n\nCette action est irréversible et supprimera toutes les données associées.`)) {
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = `/mecenes/${meceneId}/delete`;
        
        const csrfInput = document.createElement('input');
        csrfInput.type = 'hidden';
        csrfInput.name = '_token';
        csrfInput.value = csrfToken;
        form.appendChild(csrfInput);
        
        document.body.appendChild(form);
        form.submit();
    }
}
</script>
{% endblock %}
