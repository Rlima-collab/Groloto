{% extends 'base.html.twig' %}

{% block title %}Gestion des Mécènes{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/modele.css') }}">
    <link rel="stylesheet" href="{{ asset('css/benevoles/benevoles-common.css') }}">
    <link rel="stylesheet" href="{{ asset('css/benevoles/benevoles-list.css') }}">
    <link rel="stylesheet" href="{{ asset('css/mecenes.css') }}">
{% endblock %}

{% block body %}
<div class="hero-section benevoles-hero">
    <div class="shine"></div>
    <div class="hero-content">
        <h1 class="hero-title">Gestion des Mécènes</h1>
        <p class="hero-description">Partenaires, lots et conventions pour vos événements caritatifs.</p>
        <a href="#liste-mecenes" class="btn-login">Voir les mécènes</a>
    </div>
</div>

<br>

<div class="metrics-grid">
    <div class="metric-card">
        <h3>Total mécènes</h3>
        <p class="metric-value">{{ metriques.total }}</p>
        <p class="metric-detail">Mécènes actifs</p>
    </div>

    <div class="metric-card">
        <h3>Nouveaux ce mois</h3>
        <p class="metric-value">{{ metriques.nouveaux }}</p>
        <p class="metric-detail">Inscriptions récentes</p>
    </div>

    <div class="metric-card">
        <h3>Lots disponibles</h3>
        <p class="metric-value">{{ metriques.disponibles }}</p>
        <p class="metric-detail">Contributions offertes</p>
    </div>
</div>

<div class="container">
    <div class="card main-card" id="liste-mecenes">
        <div class="card-header">
            <h2 class="card-title">Liste des Mécènes</h2>
            <p class="card-description">Gestion des mécènes et partenaires</p>
            {% if is_granted('ROLE_ADMIN') %}
            <div class="header-actions">
                <a href="{{ path('mecenes_download_logos', app.request.query.all|merge({'weekend': weekend_filtre ? weekend_filtre.id : null})) }}" class="btn btn-primary">Télécharger tous les logos</a>
                <a href="{{ path('mecenes_export_social_csv', app.request.query.all|merge({'weekend': weekend_filtre ? weekend_filtre.id : null})) }}" class="btn btn-secondary">Exporter en CSV les réseaux sociaux</a>
                <a href="{{ path('mecenes_export_csv') }}" class="btn btn-primary" title="Exporter la liste complète en CSV">
                    <i class="bi bi-file-earmark-spreadsheet"></i> Export CSV
                </a>
                <a href="{{ path('mecenes_export_pdf') }}" class="btn btn-primary" title="Exporter la liste complète en PDF">
                    <i class="bi bi-file-earmark-pdf"></i> Export PDF
                </a>
            </div>
            {% endif %}
        </div>

        <div class="card-content">
            <form method="GET" id="filtersForm">
                <div class="search-bar-container">
                    <input type="text" id="searchInput" name="search" class="search-input" placeholder="Rechercher par nom, organisation, email..." value="{{ app.request.query.get('search') }}">
                </div>
                
                <div class="filters-container">
                    <div class="filter-group">
                        <label for="sortBy" class="filter-label">Trier par :</label>
                        <select id="sortBy" name="sort" class="filter-select" onchange="document.getElementById('filtersForm').submit()">
                            <option value="nom-asc" {% if app.request.query.get('sort') == 'nom-asc' %}selected{% endif %}>Nom (A-Z)</option>
                            <option value="nom-desc" {% if app.request.query.get('sort') == 'nom-desc' %}selected{% endif %}>Nom (Z-A)</option>
                            <option value="organisation-asc" {% if app.request.query.get('sort') == 'organisation-asc' %}selected{% endif %}>Organisation (A-Z)</option>
                            <option value="organisation-desc" {% if app.request.query.get('sort') == 'organisation-desc' %}selected{% endif %}>Organisation (Z-A)</option>
                            <option value="date-desc" {% if app.request.query.get('sort') == 'date-desc' or not app.request.query.get('sort') %}selected{% endif %}>Date (Plus récent)</option>
                            <option value="date-asc" {% if app.request.query.get('sort') == 'date-asc' %}selected{% endif %}>Date (Plus ancien)</option>
                        </select>
                    </div>

                    <div class="filter-group">
                        <label for="itemsPerPage" class="filter-label">Afficher :</label>
                        <select id="itemsPerPage" name="per_page" class="filter-select" onchange="document.getElementById('filtersForm').submit()">
                            <option value="10" {% if app.request.query.get('per_page') == '10' or not app.request.query.get('per_page') %}selected{% endif %}>10 par page</option>
                            <option value="20" {% if app.request.query.get('per_page') == '20' %}selected{% endif %}>20 par page</option>
                            <option value="50" {% if app.request.query.get('per_page') == '50' %}selected{% endif %}>50 par page</option>
                            <option value="all" {% if app.request.query.get('per_page') == 'all' %}selected{% endif %}>Tous</option>
                        </select>
                    </div>

                    <div class="filter-group">
                        <button type="button" id="resetFilters" class="btn-reset-filters" onclick="resetFilters()">Réinitialiser</button>
                    </div>
                </div>
            </form>

            <div id="resultsCount" class="results-count">
                Affichage de <span id="countCurrent">{{ mecenes|length }}</span> mécène(s)
            </div>
        </div>

        <div class="card-content">
            {% if mecenes|length > 0 %}
                <div class="benevoles-grid" id="mecenesList">
                    {% for mecene in mecenes %}
                        {% include 'mecenes/_card.html.twig' %}
                    {% endfor %}
                </div>
                
                <!-- Pagination -->
                <div class="pagination-container" id="paginationContainer">
                    <button id="prevPage" class="pagination-button">Précédent</button>
                    <span class="pagination-info">
                        Page <span id="currentPage">1</span> sur <span id="totalPages">1</span>
                    </span>
                    <button id="nextPage" class="pagination-button">Suivant</button>
                </div>
            {% else %}
                <div class="empty-state">
                    <h3>Aucun mécène trouvé</h3>
                    <p>Commencez par ajouter des mécènes à votre base de données.</p>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
document.addEventListener('DOMContentLoaded', function() {
    const searchInput = document.getElementById('searchInput');
    const sortSelect = document.getElementById('sortBy');
    const itemsPerPageSelect = document.getElementById('itemsPerPage');
    const resetBtn = document.getElementById('resetFilters');
    const mecenesList = document.getElementById('mecenesList');
    const countCurrent = document.getElementById('countCurrent');
    const paginationContainer = document.getElementById('paginationContainer');
    const prevPageBtn = document.getElementById('prevPage');
    const nextPageBtn = document.getElementById('nextPage');
    const currentPageSpan = document.getElementById('currentPage');
    const totalPagesSpan = document.getElementById('totalPages');
    
    let currentPage = 1;
    let itemsPerPage = 10;

    // Fonction pour charger les mécènes filtrés via AJAX - Filtres en TEMPS RÉEL
    function loadFilteredMecenes() {
        const searchTerm = searchInput.value.trim();
        const sortBy = sortSelect.value || 'date-desc';
        
        const params = new URLSearchParams();
        if (searchTerm) params.append('search', searchTerm);
        params.append('sort', sortBy);
        
        // Afficher un indicateur de chargement
        mecenesList.style.opacity = '0.5';
        
        fetch('{{ path('api_mecenes_filter') }}?' + params.toString())
            .then(response => {
                if (!response.ok) throw new Error('Erreur réseau');
                return response.json();
            })
            .then(data => {
                if (data.success) {
                    mecenesList.innerHTML = data.html;
                    countCurrent.textContent = data.count;
                    currentPage = 1;
                    displayPage(1);
                    updatePagination();
                    
                    // Réattacher les event listeners pour les boutons de suppression
                    attachDeleteHandlers();
                }
                mecenesList.style.opacity = '1';
            })
            .catch(error => {
                console.error('Erreur lors du filtrage:', error);
                mecenesList.style.opacity = '1';
            });
    }

    // Afficher une page de résultats
    function displayPage(page) {
        currentPage = page;
        const cards = document.querySelectorAll('#mecenesList .benevole-card');
        
        cards.forEach(card => card.style.display = 'none');
        
        const startIdx = (page - 1) * itemsPerPage;
        const endIdx = startIdx + itemsPerPage;
        
        Array.from(cards).slice(startIdx, endIdx).forEach(card => {
            card.style.display = 'block';
        });
        
        currentPageSpan.textContent = page;
    }

    // Mettre à jour la pagination
    function updatePagination() {
        const cards = document.querySelectorAll('#mecenesList .benevole-card');
        const totalItems = cards.length;
        const totalPages = Math.ceil(totalItems / itemsPerPage);
        
        if (itemsPerPage === Infinity || totalPages <= 1) {
            paginationContainer.style.display = 'none';
            displayPage(1); // Afficher tous
            return;
        }
        
        totalPagesSpan.textContent = totalPages;
        prevPageBtn.disabled = currentPage === 1;
        nextPageBtn.disabled = currentPage === totalPages;
        paginationContainer.style.display = 'flex';
    }

    // Attacher les event listeners pour la suppression
    function attachDeleteHandlers() {
        document.querySelectorAll('.btn-danger[data-mecene-id]').forEach(btn => {
            btn.removeEventListener('click', handleDelete);
            btn.addEventListener('click', handleDelete);
        });
    }

    function handleDelete(e) {
        const meceneId = this.getAttribute('data-mecene-id');
        const meceneName = this.getAttribute('data-mecene-nom');
        const csrfToken = this.getAttribute('data-csrf-token');
        
        if (confirm(`Êtes-vous sûr de vouloir supprimer le mécène "${meceneName}" ? Cette action est irréversible.`)) {
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = `/mecene/${meceneId}/delete`;
            
            const tokenInput = document.createElement('input');
            tokenInput.type = 'hidden';
            tokenInput.name = '_token';
            tokenInput.value = csrfToken;
            
            form.appendChild(tokenInput);
            document.body.appendChild(form);
            form.submit();
        }
    }

    // Événements de filtrage EN TEMPS RÉEL (sans recharge de page)
    let debounceTimer;
    searchInput.addEventListener('input', function() {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => {
            loadFilteredMecenes();
        }, 300); // Délai de 300ms pour éviter trop de requêtes
    });

    sortSelect.addEventListener('change', () => {
        loadFilteredMecenes();
    });

    itemsPerPageSelect.addEventListener('change', function() {
        itemsPerPage = this.value === 'all' ? Infinity : parseInt(this.value);
        currentPage = 1;
        updatePagination();
    });

    // Bouton réinitialiser - Remet tous les filtres par défaut
    resetBtn.addEventListener('click', function(e) {
        e.preventDefault();
        searchInput.value = '';
        sortSelect.value = 'date-desc';
        itemsPerPageSelect.value = '10';
        itemsPerPage = 10;
        currentPage = 1;
        
        // Recharger les mécènes avec les filtres par défaut
        loadFilteredMecenes();
    });

    // Navigation pagination
    prevPageBtn.addEventListener('click', () => {
        if (currentPage > 1) {
            displayPage(currentPage - 1);
            updatePagination();
        }
    });

    nextPageBtn.addEventListener('click', () => {
        const totalPages = Math.ceil(document.querySelectorAll('#mecenesList .benevole-card').length / itemsPerPage);
        if (currentPage < totalPages) {
            displayPage(currentPage + 1);
            updatePagination();
        }
    });

    // Initialisation au chargement
    updatePagination();
    attachDeleteHandlers();
});
</script>
{% endblock %}

