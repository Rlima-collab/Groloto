{% extends 'base.html.twig' %}

{% block title %}Créer un weekend{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/modele.css') }}">
    <link rel="stylesheet" href="{{ asset('css/festival/festival-common.css') }}">
    <link rel="stylesheet" href="{{ asset('css/festival/festival-create.css') }}">
{% endblock %}

{% block body %}
<div class="hero-section weekend-hero">
    <div class="shine"></div>
    <div class="hero-content">
        <h1 class="hero-title">Créer un Weekend</h1>
        <p class="hero-description">Organisez un nouveau weekend d'événements caritatifs.</p>
        <a href="{{ path('app_weekends') }}" class="btn-login">Voir tous les weekends</a>
    </div>
</div>

<div class="weekend-create-container">
    <div class="weekend-form-card">
        <div class="weekend-form-header">
            <h2>Informations du Weekend</h2>
        </div>

        {{ form_start(form, {'attr': {'class': 'form-night-blue'}}) }}

            <div class="mb-4">
                {{ form_row(form.nom, {'attr': {'class': 'form-control', 'placeholder': 'Ex: Weekend Groloto Novembre 2025'}}) }}
            </div>

            <div class="grid-2 mb-4">
                {{ form_row(form.date_vendredi, {'attr': {'class': 'form-control'}}) }}
                {{ form_row(form.nombre_jours, {'attr': {'class': 'form-control'}}) }}
            </div>
            
            <div class="alert alert-info mb-4" style="background: #e0f2fe; border-left: 4px solid #0ea5e9; padding: 1rem; border-radius: 8px;">
                <strong>Info :</strong> Les dates du samedi et dimanche seront calculées automatiquement à partir de la date de départ et du nombre de jours.
            </div>

            <div class="mb-4">
                {{ form_row(form.cover_image, {'attr': {'class': 'form-control'}}) }}
            </div>

            <div class="mt-6">
                <div class="weekend-form-header">
                    <h2>Événements du weekend</h2>
                </div>
                
                <div id="evenements" class="mt-4" data-prototype="{{ form_widget(form.evenements.vars.prototype)|e('html_attr') }}">
                    {% for evenement in form.evenements %}
                        <div class="evenement-item animate-fade-in">
                            {{ form_row(evenement.nom, {'attr': {'class': 'form-control', 'placeholder': 'Nom de l\'événement'}}) }}
                            <div class="grid-2 mt-3">
                                {{ form_row(evenement.date_debut, {'attr': {'class': 'form-control'}}) }}
                                {{ form_row(evenement.lieu, {'attr': {'class': 'form-control', 'placeholder': 'Lieu de l\'événement'}}) }}
                            </div>
                            {{ form_row(evenement.description, {'attr': {'class': 'form-control', 'rows': 3, 'placeholder': 'Description de l\'événement...'}}) }}
                            <button type="button" class="btn-remove-evenement remove-evenement mt-3">
                                Supprimer cet événement
                            </button>
                        </div>
                    {% endfor %}
                </div>
                
                <button type="button" id="add-evenement" class="btn-add-evenement mt-4">
                    + Ajouter un événement
                </button>
            </div>

            <div class="text-center mt-8">
                <button type="submit" class="btn-night-blue">
                    Créer le weekend
                </button>
                <a href="{{ path('app_weekends') }}" class="btn-outline-night-blue ml-3">
                    Annuler
                </a>
            </div>

            <div style="display: none;">
                {{ form_rest(form) }}
            </div>

        {{ form_end(form, {'render_rest': false}) }}
    </div>
</div>

<script>
document.getElementById('add-evenement').addEventListener('click', function() {
    const collection = document.getElementById('evenements');
    const widget = collection.dataset.prototype;
    const index = collection.children.length;
    const newWidget = widget.replace(/__name__/g, index);
    const div = document.createElement('div');
    div.innerHTML = newWidget;
    div.className = 'evenement-item animate-fade-in';
    
    // Ajouter le bouton de suppression
    const deleteBtn = document.createElement('button');
    deleteBtn.type = 'button';
    deleteBtn.className = 'btn-remove-evenement remove-evenement mt-3';
    deleteBtn.innerHTML = 'Supprimer cet événement';
    div.appendChild(deleteBtn);
    
    collection.appendChild(div);
});

document.addEventListener('click', function(e) {
    if (e.target.classList.contains('remove-evenement')) {
        const item = e.target.closest('.evenement-item');
        if (item) {
            item.style.animation = 'fadeOut 0.3s ease';
            setTimeout(() => item.remove(), 300);
        }
    }
});
</script>

<style>
@keyframes fadeOut {
    from {
        opacity: 1;
        transform: scale(1);
    }
    to {
        opacity: 0;
        transform: scale(0.95);
    }
}

.ml-3 {
    margin-left: 1rem;
}
</style>
{% endblock %}