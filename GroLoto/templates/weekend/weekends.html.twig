{% extends 'base.html.twig' %}

{% block title %}Gestion des Weekends{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="{{ asset('css/modele.css') }}" rel="stylesheet">
    <link href="{{ asset('css/festival/festival-common.css') }}" rel="stylesheet">
    <link href="{{ asset('css/festival/festival-list.css') }}" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.css" rel="stylesheet">
{% endblock %}

{% block body %}
<div class="hero-section weekend-hero">
    <div class="shine"></div>
    <div class="hero-content">
        <h1 class="hero-title">
            {% if is_granted('IS_AUTHENTICATED_REMEMBERED') %}
                Gestion des Weekends
            {% else %}
                Voir les Weekends
            {% endif %}
        </h1>
        <p class="hero-description">Organisez et planifiez vos événements caritatifs avec efficacité.</p>
        {% if is_granted('ROLE_MECENE') and not is_granted('ROLE_ADMIN') %}
            <a href="{{ path('mecene_inscription') }}" class="btn-night-blue">S'inscrire à un événement</a>
        {% else %}
            <a href="{% if isAdmin %}{{ path('app_weekend_create') }}{% else %}#calendar{% endif %}" 
               class="btn-login">
                {% if isAdmin %}Créer un Weekend{% else %}Voir le planning{% endif %}
            </a>
        {% endif %}
    </div>
</div>

<h2 style="font-size: 1.8rem; color: #1a3c5a; margin-bottom: 20px; text-align: center;">Planning des Weekends</h2>

<div class="metrics-grid">
    <div class="metric-card">
        <h3>Total Événements</h3>
        <p class="metric-value">{{ total_evenements }}</p>
        <p class="metric-detail">Tous les événements</p>
    </div>
    <div class="metric-card">
        <h3>Événements Futurs</h3>
        <p class="metric-value">{{ evenements_futurs|length }}</p>
        <p class="metric-detail">À venir</p>
    </div>
    <div class="metric-card">
        <h3>Événements Passés</h3>
        <p class="metric-value">{{ evenements_passes|length }}</p>
        <p class="metric-detail">Terminés</p>
    </div>
    <div class="metric-card">
        <h3>Ce mois-ci</h3>
        <p class="metric-value">{{ evenements_ce_mois }}</p>
        <p class="metric-detail">Événements planifiés</p>
    </div>
</div>

<div class="dashboard-grid">
    <div class="card">
        <div class="card-header">
            <h5 class="card-title">Calendrier des Weekends</h5>
        </div>
        <div class="card-content">
            <div style="margin-bottom: 1rem; text-align: center;">
                <button class="btn-outline-night-blue active" id="btn-month">Mois</button>
                <button class="btn-outline-night-blue" id="btn-week">Semaine</button>
            </div>
            <div id="calendar"></div>
        </div>
    </div>
    
    <div class="card">
        <div class="card-header">
            <h5 class="card-title">Prochains Weekends</h5>
        </div>
        <div class="card-content">
            <div class="events-list">
                {% if evenements_futurs|length > 0 %}
                    {% for evenement in evenements_futurs|slice(0, 20) %}
                        <div class="event-item blue-night-accent animate-fade-in">
                            <div class="event-date">
                                <div class="event-month">{{ evenement.dateDebut|date('M')|upper }}</div>
                                <div class="event-day">{{ evenement.dateDebut|date('d') }}</div>
                            </div>
                            <div class="event-details">
                                <h4 class="event-title">{{ evenement.nom }}</h4>
                                <p class="event-time">{{ evenement.dateDebut|date('H\\hi') }} - {{ evenement.lieu }}</p>
                            </div>
                        </div>
                    {% endfor %}
                {% else %}
                    <p style="text-align: center; color: #64748b; padding: 2rem;">Aucun événement à venir.</p>
                {% endif %}
            </div>
        </div>
    </div>
</div>

<div class="full-width-container">
    <div class="card history-card">
        <div class="card-header">
            <h3 class="card-title">Historique des Weekends</h3>
        </div>
        <div class="card-content">
            <div class="history-list">
                {% if evenements_passes|length > 0 %}
                    {% for evenement in evenements_passes|slice(0, 5) %}
                        <div class="history-item blue-night-accent">
                            <div class="history-date">
                                <div class="history-day">{{ evenement.dateDebut|date('d') }}</div>
                                <div class="history-month">{{ evenement.dateDebut|date('M')|upper }}</div>
                            </div>
                            <div class="history-details">
                                <h4 class="history-title">{{ evenement.nom }} - Terminé</h4>
                                <p class="history-description">
                                    {{ evenement.description|default('Événement organisé avec succès')|slice(0, 80) }}{{ evenement.description|length > 80 ? '...' }}
                                </p>
                                <p class="history-meta">
                                    Événement du {{ evenement.dateDebut|date('d/m/Y') }}
                                    {% if evenement.lieu %} - {{ evenement.lieu }}{% endif %}
                                </p>
                            </div>
                        </div>
                    {% endfor %}
                {% else %}
                    <p style="text-align: center; color: #64748b; padding: 2rem;">Aucun événement dans l'historique.</p>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        window.calendarEvents = {{ creneaux|raw }};
        window.taches = {{ taches|raw }};
    </script>

    <script>
        window.calendarInstance = null;

        const loadFullCalendar = () => {
            return new Promise((resolve, reject) => {
                if (typeof FullCalendar !== 'undefined') return resolve();
                const script = document.createElement('script');
                script.src = 'https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.js';
                script.onload = () => setTimeout(resolve, 100);
                script.onerror = reject;
                document.head.appendChild(script);
            });
        };

        const initCalendar = (view = 'dayGridMonth') => {
            const el = document.getElementById('calendar');
            if (!el) return;

            if (typeof FullCalendar === 'undefined') {
                loadFullCalendar().then(() => setTimeout(() => initCalendar(view), 100));
                return;
            }

            if (window.calendarInstance) window.calendarInstance.destroy();

            // Les données sont déjà des objets JavaScript, pas besoin de parser
            const events = window.taches || [];
            const evenements = window.calendarEvents || [];

            window.calendarInstance = new FullCalendar.Calendar(el, {
                initialView: view,
                locale: 'fr',
                height: 'auto',
                headerToolbar: { left: 'prev,next today', center: 'title', right: '' },
                buttonText: { today: 'Aujourd\'hui', month: 'Mois', week: 'Semaine' },
                hiddenDays: [1, 2, 3, 4],
                weekends: true,
                firstDay: 5,
                events: [...evenements, ...events],
                eventClick: info => {
                    const e = info.event;
                    const p = e.extendedProps;
                    let msg = `${e.title}\nDu ${e.start.toLocaleString()}`;
                    if (e.end) msg += `\nAu ${e.end.toLocaleString()}`;
                    if (p.description) msg += `\n\n${p.description}`;
                    if (p.lieu) msg += `\nLieu: ${p.lieu}`;
                    alert(msg);
                },
                nowIndicator: true,
                slotMinTime: '07:00:00',
                slotMaxTime: '22:00:00',
                allDaySlot: false
            });
            window.calendarInstance.render();
        };

        const changeView = view => {
            if (window.calendarInstance) window.calendarInstance.changeView(view);
            document.getElementById('btn-month').classList.toggle('active', view === 'dayGridMonth');
            document.getElementById('btn-week').classList.toggle('active', view === 'timeGridWeek');
        };

        document.addEventListener('DOMContentLoaded', () => {
            document.getElementById('btn-month')?.addEventListener('click', () => changeView('dayGridMonth'));
            document.getElementById('btn-week')?.addEventListener('click', () => changeView('timeGridWeek'));
            setTimeout(() => initCalendar(), 200);
        });
    </script>
{% endblock %}