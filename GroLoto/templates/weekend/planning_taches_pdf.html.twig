<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Planning Tâches - {{ weekend.nom }}</title>
    <style>
        @page {
            margin: 8mm 6mm;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            font-size: 8px;
            color: #1e293b;
            line-height: 1.2;
        }

        .header {
            background: #0f172a;
            color: white;
            padding: 10px 14px;
            margin-bottom: 8px;
            border-radius: 4px;
        }

        .header h1 {
            font-size: 14px;
            font-weight: bold;
            margin-bottom: 2px;
        }

        .header-info {
            font-size: 9px;
            opacity: 0.9;
        }

        .planning-grid {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 10px;
            table-layout: fixed;
        }

        .planning-grid th,
        .planning-grid td {
            border: 1px solid #000;
            padding: 2px 3px;
            text-align: center;
            vertical-align: middle;
            height: 14px;
        }

        .planning-grid th {
            background: #0f172a;
            color: white;
            font-weight: bold;
            font-size: 11px;
            height: 24px;
        }

        .planning-grid th.time-header {
            width: 70px;
            background: #fff;
            color: #000;
            border: 1px solid #000;
        }

        .planning-grid .time-cell {
            background: #fff;
            font-weight: normal;
            text-align: left;
            font-size: 7px;
            padding-left: 4px;
            color: #000;
        }

        .planning-grid td.task-cell {
            background: #d3d3d3;
            vertical-align: middle;
            font-size: 8px;
        }

        .planning-grid td.task-cell.has-task {
            background: #ffffff;
        }

        .benevole-info {
            font-weight: bold;
            font-size: 9px;
            line-height: 1.3;
        }

        .benevole-name {
            display: block;
        }

        .benevole-hours {
            font-weight: normal;
            font-size: 8px;
            color: #333;
        }

        .footer {
            margin-top: 10px;
            text-align: center;
            font-size: 8px;
            color: #64748b;
        }

        .no-tasks {
            text-align: center;
            padding: 40px;
            color: #64748b;
            font-style: italic;
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>Planning des Tâches - {{ weekend.nom }}</h1>
        <div class="header-info">
            Du {{ weekend.dateDebut|date('d/m/Y') }} au {{ weekend.dateFin|date('d/m/Y') }}
        </div>
    </div>

    {% if planningData|length > 0 %}
        <table class="planning-grid">
            <thead>
                <tr>
                    <th class="time-header"></th>
                    {% for jour, dayData in planningData %}
                        <th colspan="{{ dayData.maxCols }}">{{ dayData.jourNom|upper }}</th>
                    {% endfor %}
                </tr>
            </thead>
            <tbody>
                {% for slot in timeSlots %}
                    <tr>
                        <td class="time-cell">{{ slot.label }}</td>
                        {% for jour, dayData in planningData %}
                            {# Trouver les bénévoles actifs pour ce créneau #}
                            {% set activeBenevoles = [] %}
                            {% for assignment in dayData.assignments %}
                                {% set slotParts = slot.key|split(':') %}
                                {% set slotMinutes = (slotParts[0] * 60) + slotParts[1] %}
                                {% set startParts = assignment.debut|split(':') %}
                                {% set startMinutes = (startParts[0] * 60) + startParts[1] %}
                                {% set endParts = assignment.fin|split(':') %}
                                {% set endMinutes = (endParts[0] * 60) + endParts[1] %}
                                {% if slotMinutes >= startMinutes and slotMinutes < endMinutes %}
                                    {% set activeBenevoles = activeBenevoles|merge([assignment]) %}
                                {% endif %}
                            {% endfor %}
                            
                            {% for i in 0..(dayData.maxCols - 1) %}
                                {% if activeBenevoles[i] is defined %}
                                    <td class="task-cell has-task">
                                        <div class="benevole-info">
                                            <span class="benevole-name">{{ activeBenevoles[i].nom }}</span>
                                            <span class="benevole-hours">{{ activeBenevoles[i].heuresLabel }}</span>
                                        </div>
                                    </td>
                                {% else %}
                                    <td class="task-cell"></td>
                                {% endif %}
                            {% endfor %}
                        {% endfor %}
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% else %}
        <div class="no-tasks">
            <p>Aucune tâche planifiée pour ce weekend.</p>
        </div>
    {% endif %}

    <div class="footer">
        Planning généré le {{ "now"|date('d/m/Y à H\\hi') }} | GroLoto
    </div>
</body>
</html>
