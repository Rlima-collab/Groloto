{% extends 'base.html.twig' %}

{% block title %}Modifier {{ weekend.nom }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/modele.css') }}">
    <link rel="stylesheet" href="{{ asset('css/festival/festival-common.css') }}">
    <link rel="stylesheet" href="{{ asset('css/festival/festival-create.css') }}">
{% endblock %}

{% block body %}
<div class="hero-section weekend-hero">
    <div class="shine"></div>
    <div class="hero-content">
        <h1 class="hero-title">Modifier le Weekend</h1>
        <p class="hero-description">{{ weekend.nom }}</p>
        <a href="{{ path('app_weekend_liste') }}" class="btn-login">← Retour à la liste</a>
    </div>
</div>

<div class="weekend-create-container">
    <div class="weekend-form-card">
        <div class="weekend-form-header">
            <h2>Informations du Weekend</h2>
        </div>

        {% for message in app.flashes('warning') %}
            <div class="alert alert-warning">{{ message }}</div>
        {% endfor %}

        {{ form_start(form, {'attr': {'class': 'form-night-blue'}}) }}

            <div class="mb-4">
                {{ form_row(form.nom, {'attr': {'class': 'form-control', 'placeholder': 'Ex: Weekend Groloto Novembre 2025'}}) }}
            </div>

            <div class="grid-2 mb-4">
                {{ form_row(form.date_debut, {'attr': {'class': 'form-control'}}) }}
                {{ form_row(form.date_dimanche, {'attr': {'class': 'form-control'}}) }}
            </div>

            <div class="mb-4">
                {{ form_row(form.description, {'attr': {'class': 'form-control', 'rows': 4, 'placeholder': 'Description du weekend...'}}) }}
            </div>

            <div class="mb-4">
                {{ form_label(form.cover_image) }}
                
                {% if weekend.coverImage %}
                    <div class="current-image">
                        <p>Image actuelle :</p>
                        <img src="{{ asset(weekend.coverImage) }}" alt="Image de couverture actuelle" style="max-width: 300px; border-radius: 8px; margin: 1rem 0;">
                    </div>
                {% endif %}
                
                {{ form_widget(form.cover_image, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.cover_image) }}
                <small class="form-help">Laissez vide pour conserver l'image actuelle</small>
            </div>

            <div class="text-center mt-8">
                <button type="submit" class="btn-night-blue">
                    Enregistrer les modifications
                </button>
                <a href="{{ path('app_weekend_liste') }}" class="btn-outline-night-blue ml-3">
                    Annuler
                </a>
            </div>

            <div style="display: none;">
                {{ form_rest(form) }}
            </div>

        {{ form_end(form, {'render_rest': false}) }}
    </div>
</div>

<style>
.ml-3 {
    margin-left: 1rem;
}

.mt-8 {
    margin-top: 2rem;
}

.grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
}

.alert {
    padding: 1rem 1.5rem;
    border-radius: 8px;
    margin-bottom: 1.5rem;
    font-weight: 500;
}

.alert-warning {
    background: #fef3c7;
    color: #92400e;
    border: 1px solid #fbbf24;
}

.current-image p {
    font-weight: 600;
    color: #475569;
    margin-bottom: 0.5rem;
}

.form-help {
    display: block;
    color: #64748b;
    font-size: 0.875rem;
    margin-top: 0.5rem;
}

@media (max-width: 768px) {
    .grid-2 {
        grid-template-columns: 1fr;
    }
}
</style>
{% endblock %}
