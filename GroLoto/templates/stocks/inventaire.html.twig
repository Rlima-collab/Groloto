{% extends 'base.html.twig' %}

{% block title %}Inventaire - Gestion des Stocks{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/stocks/stocks-common.css') }}">
    <link rel="stylesheet" href="{{ asset('css/stocks/stocks-list.css') }}">
{% endblock %}

{% block body %}
<!-- Hero Section -->
<div class="hero-section stocks-hero">
    <div class="shine"></div>
    <div class="hero-content">
        <h1 class="hero-title">Inventaire</h1>
        <p class="hero-description">Liste complète des articles en stock</p>
        <a href="{{ path('stocks_export_inventaire') }}" class="btn-login">Exporter en CSV</a>
    </div>
</div>

<div class="container" style="padding-top: 2rem; padding-bottom: 3rem;">

    <!-- Cartes de statistiques -->
    <div class="metrics-grid">
        <div class="metric-card">
            <h3>Articles</h3>
            <p class="metric-value">{{ total_items }}</p>
            <p class="metric-detail">Inventaire actuel</p>
        </div>

        <div class="metric-card">
            <h3>Valeur totale</h3>
            <p class="metric-value">{{ stock_value|number_format(0, ',', ' ') }} €</p>
            <p class="metric-detail">Estimation globale</p>
        </div>

        <div class="metric-card">
            <h3>Alertes stock</h3>
            <p class="metric-value">{{ low_stock_count }}</p>
            <p class="metric-detail">Articles critiques</p>
        </div>

        <div class="metric-card">
            <h3>Catégories</h3>
            <p class="metric-value">{{ categories_count }}</p>
            <p class="metric-detail">Types d'articles</p>
        </div>
    </div>

    <!-- Inventaire -->
    <div class="card shadow-sm border-0">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 class="mb-0" style="color: #0d1b2a; font-weight: 600;">
                    <i class="bi bi-box-seam me-2"></i>Inventaire des lots
                </h3>
            </div>

            <!-- Filtres -->
            <div class="filters-section" style="background: #f8f9fa; padding: 1.5rem; border-radius: 8px; margin-bottom: 2rem;">
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem;">
                    <!-- Filtre Catégorie -->
                    <div>
                        <label for="filter-category" style="font-weight: 600; color: #0d1b2a; display: block; margin-bottom: 0.5rem;">
                            <i class="bi bi-filter"></i> Catégorie
                        </label>
                        <select id="filter-category" class="form-control" style="padding: 0.5rem;">
                            <option value="">-- Toutes les catégories --</option>
                            <option value="bar">🍺 Bar</option>
                            <option value="resto">🍽️ Resto</option>
                            <option value="deco">🎨 Déco</option>
                            <option value="materiel">🔧 Matériel</option>
                            <option value="autre">📋 Autre</option>
                        </select>
                    </div>

                    <!-- Filtre Source -->
                    <div>
                        <label for="filter-source" style="font-weight: 600; color: #0d1b2a; display: block; margin-bottom: 0.5rem;">
                            <i class="bi bi-filter"></i> Source
                        </label>
                        <select id="filter-source" class="form-control" style="padding: 0.5rem;">
                            <option value="">-- Toutes les sources --</option>
                            <option value="achat">Achat</option>
                            <option value="don">Don</option>
                            <option value="pret">Prêt</option>
                        </select>
                    </div>

                    <!-- Filtre Statut -->
                    <div>
                        <label for="filter-status" style="font-weight: 600; color: #0d1b2a; display: block; margin-bottom: 0.5rem;">
                            <i class="bi bi-filter"></i> Statut
                        </label>
                        <select id="filter-status" class="form-control" style="padding: 0.5rem;">
                            <option value="">-- Tous les statuts --</option>
                            <option value="normal">Normal</option>
                            <option value="faible">Faible</option>
                            <option value="critique">Critique</option>
                        </select>
                    </div>

                    <!-- Recherche texte -->
                    <div>
                        <label for="filter-search" style="font-weight: 600; color: #0d1b2a; display: block; margin-bottom: 0.5rem;">
                            <i class="bi bi-search"></i> Rechercher
                        </label>
                        <input type="text" id="filter-search" class="form-control" placeholder="Nom de l'article..." style="padding: 0.5rem;">
                    </div>

                    <!-- Tri -->
                    <div>
                        <label for="sort-by" style="font-weight: 600; color: #0d1b2a; display: block; margin-bottom: 0.5rem;">
                            <i class="bi bi-sort-down"></i> Trier par
                        </label>
                        <select id="sort-by" class="form-control" style="padding: 0.5rem;">
                            <option value="">-- Ordre par défaut --</option>
                            <option value="name-asc">Nom (A → Z)</option>
                            <option value="name-desc">Nom (Z → A)</option>
                            <option value="stock-asc">Stock (↑ faible)</option>
                            <option value="stock-desc">Stock (↓ élevé)</option>
                            <option value="value-asc">Valeur (↑ faible)</option>
                            <option value="value-desc">Valeur (↓ élevée)</option>
                            <option value="threshold-asc">Seuil (↑ faible)</option>
                            <option value="threshold-desc">Seuil (↓ élevé)</option>
                        </select>
                    </div>
                </div>
                <div style="margin-top: 1rem;">
                    <button id="reset-filters" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-arrow-counterclockwise me-1"></i>Réinitialiser filtres
                    </button>
                </div>
            </div>

            {% if stock_items is empty %}
                <div class="empty-state">
                    <i class="bi bi-inbox"></i>
                    <h3>Aucun article en stock</h3>
                    <p>Commencez par ajouter des articles à votre inventaire.</p>
                </div>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th style="width: 25%;">Article</th>
                                <th style="width: 15%;">Catégorie</th>
                                <th style="width: 10%; text-align: right;">Stock</th>
                                <th style="width: 10%; text-align: right;">Seuil</th>
                                <th style="width: 15%; text-align: right;">Valeur estimée</th>
                                <th style="width: 10%;">Unité</th>
                                <th style="width: 10%;">Source</th>
                                <th style="width: 15%; text-align: center;">Statut</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for item in stock_items %}
                                <tr>
                                    <td class="name">{{ item.nom }}</td>
                                    <td>
                                        <span class="badge category">
                                            {% if item.categorie == 'bar' %}🍺 Bar
                                            {% elseif item.categorie == 'resto' %}🍽️ Resto
                                            {% elseif item.categorie == 'deco' %}🎨 Déco
                                            {% else %}📋 {{ item.categorie|capitalize }}{% endif %}
                                        </span>
                                    </td>
                                    <td class="text-right">
                                        <strong>{{ item.quantite }}</strong>
                                    </td>
                                    <td class="text-right text-muted">{{ item.seuil }}</td>
                                    <td class="text-right value">
                                        {{ (item.quantite * item.valeurUnitaire)|number_format(2, ',', ' ') }} €
                                    </td>
                                    <td>
                                        <span class="badge unit">{{ item.unite }}</span>
                                    </td>
                                    <td>
                                        {% if item.source == 'achat' %}
                                            <span class="badge bg-primary">Achat</span>
                                        {% elseif item.source == 'don' %}
                                            <span class="badge bg-success">Don</span>
                                        {% elseif item.source == 'pret' %}
                                            <span class="badge bg-warning text-dark">Prêt</span>
                                            {% if item.dateRetour %}
                                                <br><small class="text-muted">Retour: {{ item.dateRetour|date('d/m/Y') }}</small>
                                            {% endif %}
                                            {% if item.preteur %}
                                                <br><small class="text-muted">De: {{ item.preteur }}</small>
                                            {% endif %}
                                        {% else %}
                                            <span class="badge bg-secondary">{{ item.source|default('Inconnu') }}</span>
                                        {% endif %}
                                    </td>
                                    <td style="text-align: center;">
                                        {% if item.quantite <= item.seuil * 0.5 %}
                                            <span class="badge status danger">
                                                <i class="bi bi-exclamation-triangle me-1"></i>Critique
                                            </span>
                                        {% elseif item.quantite <= item.seuil %}
                                            <span class="badge status warning">
                                                <i class="bi bi-exclamation-circle me-1"></i>Faible
                                            </span>
                                        {% else %}
                                            <span class="badge status success">
                                                <i class="bi bi-check-circle me-1"></i>Normal
                                            </span>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const filterCategory = document.getElementById('filter-category');
    const filterSource = document.getElementById('filter-source');
    const filterStatus = document.getElementById('filter-status');
    const filterSearch = document.getElementById('filter-search');
    const sortBy = document.getElementById('sort-by');
    const resetButton = document.getElementById('reset-filters');
    const table = document.querySelector('table tbody');

    if (!table) return;

    function applyFilters() {
        const rows = Array.from(table.querySelectorAll('tr'));
        const categoryValue = filterCategory.value.toLowerCase();
        const sourceValue = filterSource.value.toLowerCase();
        const statusValue = filterStatus.value.toLowerCase();
        const searchValue = filterSearch.value.toLowerCase();
        const sortValue = sortBy.value;

        // Filtrer les lignes
        const visibleRows = rows.filter(row => {
            let show = true;

            // Filtre Catégorie
            if (categoryValue) {
                const categoryBadge = row.querySelector('.category');
                if (!categoryBadge || !categoryBadge.textContent.toLowerCase().includes(categoryValue)) {
                    show = false;
                }
            }

            // Filtre Source
            if (sourceValue && show) {
                const sourceCell = row.cells[6];
                if (!sourceCell.textContent.toLowerCase().includes(sourceValue)) {
                    show = false;
                }
            }

            // Filtre Statut
            if (statusValue && show) {
                const statusBadge = row.querySelector('.status');
                if (!statusBadge || !statusBadge.textContent.toLowerCase().includes(statusValue)) {
                    show = false;
                }
            }

            // Recherche texte (sur le nom de l'article)
            if (searchValue && show) {
                const nameCell = row.cells[0];
                if (!nameCell.textContent.toLowerCase().includes(searchValue)) {
                    show = false;
                }
            }

            return show;
        });

        // Trier les lignes
        if (sortValue) {
            visibleRows.sort((a, b) => {
                let aValue, bValue;

                switch (sortValue) {
                    case 'name-asc':
                        aValue = a.cells[0].textContent.toLowerCase();
                        bValue = b.cells[0].textContent.toLowerCase();
                        return aValue.localeCompare(bValue);
                    
                    case 'name-desc':
                        aValue = a.cells[0].textContent.toLowerCase();
                        bValue = b.cells[0].textContent.toLowerCase();
                        return bValue.localeCompare(aValue);
                    
                    case 'stock-asc':
                        aValue = parseInt(a.cells[2].textContent);
                        bValue = parseInt(b.cells[2].textContent);
                        return aValue - bValue;
                    
                    case 'stock-desc':
                        aValue = parseInt(a.cells[2].textContent);
                        bValue = parseInt(b.cells[2].textContent);
                        return bValue - aValue;
                    
                    case 'value-asc':
                        aValue = parseFloat(a.cells[4].textContent.replace(/[^\d,]/g, '').replace(',', '.'));
                        bValue = parseFloat(b.cells[4].textContent.replace(/[^\d,]/g, '').replace(',', '.'));
                        return aValue - bValue;
                    
                    case 'value-desc':
                        aValue = parseFloat(a.cells[4].textContent.replace(/[^\d,]/g, '').replace(',', '.'));
                        bValue = parseFloat(b.cells[4].textContent.replace(/[^\d,]/g, '').replace(',', '.'));
                        return bValue - aValue;
                    
                    case 'threshold-asc':
                        aValue = parseInt(a.cells[3].textContent);
                        bValue = parseInt(b.cells[3].textContent);
                        return aValue - bValue;
                    
                    case 'threshold-desc':
                        aValue = parseInt(a.cells[3].textContent);
                        bValue = parseInt(b.cells[3].textContent);
                        return bValue - aValue;
                    
                    default:
                        return 0;
                }
            });
        }

        // Réafficher les lignes dans le bon ordre
        rows.forEach(row => {
            if (visibleRows.includes(row)) {
                row.style.display = '';
                table.appendChild(row);
            } else {
                row.style.display = 'none';
            }
        });
        
        // Réordonner les lignes visibles
        visibleRows.forEach(row => {
            table.appendChild(row);
        });
    }

    function resetFilters() {
        filterCategory.value = '';
        filterSource.value = '';
        filterStatus.value = '';
        filterSearch.value = '';
        sortBy.value = '';
        applyFilters();
    }

    filterCategory.addEventListener('change', applyFilters);
    filterSource.addEventListener('change', applyFilters);
    filterStatus.addEventListener('change', applyFilters);
    filterSearch.addEventListener('keyup', applyFilters);
    sortBy.addEventListener('change', applyFilters);
    resetButton.addEventListener('click', resetFilters);
});
</script>
{% endblock %}
