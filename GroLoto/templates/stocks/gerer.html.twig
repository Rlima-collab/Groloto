{% extends 'base.html.twig' %}

{% block title %}Gérer Stock - Gestion des Stocks{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/stocks/stocks-common.css') }}">
    <link rel="stylesheet" href="{{ asset('css/stocks/stocks-list.css') }}">
{% endblock %}

{% block body %}
<!-- Hero Section -->
<div class="hero-section stocks-hero">
    <div class="shine"></div>
    <div class="hero-content">
        <h1 class="hero-title">Gérer Stock</h1>
        <p class="hero-description">Ajouter des mouvements de stock (entrées/sorties)</p>
        <a href="{{ path('stocks_inventaire') }}" class="btn-login">Voir l'inventaire</a>
    </div>
</div>

<div class="container" style="padding-top: 2rem; padding-bottom: 3rem;">

    <!-- Flash Messages -->
    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>{{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>{{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    <!-- Cartes de statistiques -->
    <div class="metrics-grid">
        <div class="metric-card">
            <h3>Articles</h3>
            <p class="metric-value">{{ total_items }}</p>
            <p class="metric-detail">Inventaire actuel</p>
        </div>

        <div class="metric-card">
            <h3>Valeur totale</h3>
            <p class="metric-value">{{ stock_value|number_format(0, ',', ' ') }} €</p>
            <p class="metric-detail">Estimation globale</p>
        </div>

        <div class="metric-card">
            <h3>Alertes stock</h3>
            <p class="metric-value">{{ low_stock_count }}</p>
            <p class="metric-detail">Articles critiques</p>
        </div>

        <div class="metric-card">
            <h3>Catégories</h3>
            <p class="metric-value">{{ categories_count }}</p>
            <p class="metric-detail">Types d'articles</p>
        </div>
    </div>

    <!-- Formulaire d'ajout -->
    <div class="row">
        <div class="col-lg-6 mb-4">
            {% include 'stocks/_ajouter.html.twig' %}
        </div>
        <div class="col-lg-6 mb-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h3 class="mb-3" style="color: #0d1b2a; font-weight: 600;">
                        <i class="bi bi-plus-square me-2"></i>Créer un nouvel article
                    </h3>
                    <p class="text-muted mb-4">Ajouter une nouvelle référence au stock</p>

                    {{ form_start(form) }}
                    
                    <div class="row g-3">
                        <div class="col-md-12">
                            {{ form_row(form.nom, {'attr': {'class': 'form-control'}}) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_row(form.categorie, {'attr': {'class': 'form-select'}}) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_row(form.unite, {'attr': {'class': 'form-control'}}) }}
                        </div>
                        
                        <div class="col-md-4">
                            {{ form_row(form.quantite, {'attr': {'class': 'form-control'}}) }}
                        </div>
                        <div class="col-md-4">
                            {{ form_row(form.seuil, {'attr': {'class': 'form-control'}}) }}
                        </div>
                        <div class="col-md-4">
                            {{ form_row(form.valeur_unitaire, {'attr': {'class': 'form-control'}}) }}
                        </div>
                        
                        <div class="col-12">
                            <hr class="my-2">
                            <h6 class="text-muted mb-3">Source et Provenance</h6>
                        </div>
                        
                        <div class="col-md-12">
                            {{ form_row(form.source, {'attr': {'class': 'form-check-inline'}}) }}
                        </div>
                        
                        <div class="col-md-6" id="preteur-field">
                            {{ form_row(form.preteur, {'attr': {'class': 'form-control'}}) }}
                        </div>
                        <div class="col-md-6" id="date-retour-field">
                            {{ form_row(form.date_retour, {'attr': {'class': 'form-control'}}) }}
                        </div>
                        
                        <div class="col-12">
                            {{ form_row(form.remarque, {'attr': {'class': 'form-control'}}) }}
                        </div>
                    </div>
                    
                    <div class="mt-4 text-end">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save me-1"></i> Créer l'article
                        </button>
                    </div>
                    
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const sourceInputs = document.querySelectorAll('input[name="stock[source]"]');
        const preteurField = document.getElementById('preteur-field');
        const dateRetourField = document.getElementById('date-retour-field');
        
        function updateFields() {
            let selectedSource = '';
            sourceInputs.forEach(input => {
                if (input.checked) selectedSource = input.value;
            });
            
            if (selectedSource === 'pret') {
                preteurField.style.display = 'block';
                dateRetourField.style.display = 'block';
            } else {
                preteurField.style.display = 'none';
                dateRetourField.style.display = 'none';
            }
        }
        
        sourceInputs.forEach(input => {
            input.addEventListener('change', updateFields);
        });
        
        updateFields();
    });
</script>
{% endblock %}
