<div class="card shadow-sm border-0">
    <div class="card-body">
        <h3 class="mb-3" style="color: #0d1b2a; font-weight: 600;">
            <i class="bi bi-bar-chart me-2"></i>Analyse des Mouvements de Stock
        </h3>
        <p class="text-muted mb-4">Visualisation des entrées, sorties et niveaux de stock</p>

        <div class="row g-4">
            <!-- Évolution des entrées/sorties -->
            <div class="col-md-12">
                <div class="chart-container">
                    <h4 class="chart-title">
                        <i class="bi bi-graph-up me-2"></i>Évolution des mouvements (7 derniers jours)
                    </h4>
                    <div style="height: 250px;">
                        <canvas id="mouvementsChart"></canvas>
                    </div>
                </div>
            </div>

            <!-- Répartition par catégorie -->
            <div class="col-md-6">
                <div class="chart-container">
                    <h4 class="chart-title">
                        <i class="bi bi-pie-chart me-2"></i>Répartition par catégorie
                    </h4>
                    <div style="height: 250px;">
                        <canvas id="categoriesChart"></canvas>
                    </div>
                </div>
            </div>

            <!-- État global des stocks -->
            <div class="col-md-6">
                <div class="chart-container">
                    <h4 class="chart-title">
                        <i class="bi bi-speedometer2 me-2"></i>État global des stocks
                    </h4>
                    <div style="height: 250px;">
                        <canvas id="etatStockChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="alert alert-info border-0 mt-4">
            <i class="bi bi-info-circle me-2"></i>
            <strong>Note :</strong> Les graphiques affichent des données simulées. 
            Connectez votre système de suivi pour voir les vraies statistiques.
        </div>
    </div>
</div>

