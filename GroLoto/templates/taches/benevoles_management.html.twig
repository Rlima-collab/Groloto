{% extends 'base.html.twig' %}

{% block title %}Gestion des Bénévoles - Tâches{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/modele.css') }}">
    <link rel="stylesheet" href="{{ asset('css/festival/festival-common.css') }}">
{% endblock %}

{% block body %}
<div class="hero-section weekend-hero">
    <div class="shine"></div>
    <div class="hero-content">
        <h1 class="hero-title">Gestion Groupée des Bénévoles</h1>
        <p class="hero-description">Assignez plusieurs tâches à un bénévole en une seule fois</p>
        <a href="{{ path('tache_index') }}" class="btn-login">Retour aux tâches</a>
    </div>
</div>

<div class="container" style="max-width: 1400px; margin: 2rem auto; padding: 0 2rem;">
    
    <!-- Liste des bénévoles -->
    <div class="benevoles-grid" style="display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));">
        {% for data in benevolesData %}
        <div class="benevole-card" style="background: white; border-radius: 12px; padding: 1.5rem; box-shadow: 0 2px 8px rgba(0,0,0,0.1); border: 2px solid #e5e7eb;">
            <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1rem;">
                <div style="width: 50px; height: 50px; border-radius: 50%; background: linear-gradient(135deg, #0d1b2a, #1e3a5f); display: flex; align-items: center; justify-content: center; color: white; font-weight: 700; font-size: 1.2rem;">
                    {{ data.prenom|slice(0,1)|upper }}{{ data.nom|slice(0,1)|upper }}
                </div>
                <div style="flex: 1;">
                    <h3 style="margin: 0; color: #0d1b2a; font-size: 1.1rem; font-weight: 700;">
                        {{ data.prenom }} {{ data.nom }}
                    </h3>
                    <p style="margin: 0.25rem 0 0; color: #6b7280; font-size: 0.875rem;">
                        {{ data.email }}
                    </p>
                </div>
            </div>

            <div style="background: #f9fafb; border-radius: 8px; padding: 1rem; margin-bottom: 1rem; border-left: 4px solid #3b82f6;">
                <div style="display: flex; align-items: center; justify-content: space-between;">
                    <span style="color: #4b5563; font-weight: 600;">Tâches assignées</span>
                    <span style="background: #dbeafe; color: #1e40af; padding: 0.25rem 0.75rem; border-radius: 12px; font-weight: 700; font-size: 1.1rem;">
                        {{ data.nbTaches }}
                    </span>
                </div>
            </div>

            <div style="display: flex; gap: 0.5rem;">
                <button 
                    class="btn-assign-tasks"
                    data-benevole-id="{{ data.benevole.id }}"
                    data-benevole-nom="{{ data.prenom }} {{ data.nom }}"
                    style="flex: 1; padding: 0.65rem 1rem; background: linear-gradient(135deg, #10b981, #059669); color: white; border: none; border-radius: 8px; font-weight: 600; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; gap: 0.5rem;"
                    onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 4px 12px rgba(16,185,129,0.3)';"
                    onmouseout="this.style.transform=''; this.style.boxShadow='';"
                >
                    <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                    </svg>
                    Assigner
                </button>

                <button 
                    class="btn-remove-tasks"
                    data-benevole-id="{{ data.benevole.id }}"
                    data-benevole-nom="{{ data.prenom }} {{ data.nom }}"
                    style="padding: 0.65rem 1rem; background: linear-gradient(135deg, #fca5a5, #ef4444); color: white; border: none; border-radius: 8px; font-weight: 600; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center;"
                    onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 4px 12px rgba(239,68,68,0.3)';"
                    onmouseout="this.style.transform=''; this.style.boxShadow='';"
                    title="Retirer des tâches"
                >
                    <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                    </svg>
                </button>
            </div>
        </div>
        {% else %}
        <div style="grid-column: 1 / -1; text-align: center; padding: 3rem; color: #6b7280;">
            <p>Aucun bénévole disponible</p>
        </div>
        {% endfor %}
    </div>
</div>

<!-- Modal d'assignation de tâches -->
<div id="assign-modal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 9999; align-items: center; justify-content: center; backdrop-filter: blur(4px);">
    <div style="background: white; border-radius: 16px; width: min(900px, 95vw); max-height: 90vh; overflow: hidden; box-shadow: 0 20px 60px rgba(0,0,0,0.3);">
        <!-- Header -->
        <div style="padding: 1.5rem 2rem; border-bottom: 2px solid #e5e7eb; display: flex; align-items: center; justify-content: space-between; background: linear-gradient(135deg, #0d1b2a, #1e3a5f);">
            <h2 id="modal-title" style="margin: 0; color: white; font-size: 1.3rem; font-weight: 700;">Assigner des tâches</h2>
            <button id="modal-close" style="background: rgba(255,255,255,0.2); border: none; color: white; width: 36px; height: 36px; border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; transition: all 0.2s;">×</button>
        </div>

        <!-- Body -->
        <div style="padding: 2rem; overflow-y: auto; max-height: calc(90vh - 180px);">
            <div id="modal-loading" style="text-align: center; padding: 3rem; color: #6b7280;">
                <div style="display: inline-block; width: 40px; height: 40px; border: 4px solid #e5e7eb; border-top-color: #3b82f6; border-radius: 50%; animation: spin 1s linear infinite;"></div>
                <p style="margin-top: 1rem;">Chargement des tâches...</p>
            </div>

            <div id="modal-content" style="display: none;">
                <div style="margin-bottom: 1.5rem; padding: 1rem; background: #eff6ff; border-left: 4px solid #3b82f6; border-radius: 8px;">
                    <p style="margin: 0; color: #1e40af; font-weight: 600;">
                        <svg style="display: inline; width: 18px; height: 18px; margin-right: 0.5rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        Les tâches en <span style="color: #dc2626;">conflit horaire</span> sont grisées et non sélectionnables
                    </p>
                </div>

                <div id="tasks-list" style="display: grid; gap: 0.75rem;">
                    <!-- Tâches chargées dynamiquement -->
                </div>
            </div>
        </div>

        <!-- Footer -->
        <div style="padding: 1.25rem 2rem; border-top: 2px solid #e5e7eb; background: #f9fafb; display: flex; gap: 1rem; justify-content: flex-end;">
            <button id="modal-cancel" style="padding: 0.75rem 1.5rem; background: white; border: 2px solid #d1d5db; color: #374151; border-radius: 8px; font-weight: 600; cursor: pointer; transition: all 0.2s;">
                Annuler
            </button>
            <button id="modal-submit" style="padding: 0.75rem 1.5rem; background: linear-gradient(135deg, #10b981, #059669); border: none; color: white; border-radius: 8px; font-weight: 600; cursor: pointer; transition: all 0.2s; box-shadow: 0 2px 8px rgba(16,185,129,0.3);">
                Valider l'assignation
            </button>
        </div>
    </div>
</div>

<link rel="stylesheet" href="{{ asset('css/taches.css') }}">

<script>
document.addEventListener('DOMContentLoaded', function() {
    const modal = document.getElementById('assign-modal');
    const modalTitle = document.getElementById('modal-title');
    const modalClose = document.getElementById('modal-close');
    const modalCancel = document.getElementById('modal-cancel');
    const modalSubmit = document.getElementById('modal-submit');
    const modalLoading = document.getElementById('modal-loading');
    const modalContent = document.getElementById('modal-content');
    const tasksList = document.getElementById('tasks-list');

    let currentBenevoleId = null;
    let availableTasks = [];
    let isRemoveMode = false;

    // Ouvrir modal d'assignation
    document.querySelectorAll('.btn-assign-tasks').forEach(btn => {
        btn.addEventListener('click', async function() {
            currentBenevoleId = this.dataset.benevoleId;
            const benevoleNom = this.dataset.benevoleNom;
            isRemoveMode = false;
            
            modalTitle.textContent = `Assigner des tâches à ${benevoleNom}`;
            modalSubmit.textContent = 'Valider l\'assignation';
            modalSubmit.style.background = 'linear-gradient(135deg, #10b981, #059669)';
            modal.style.display = 'flex';
            modalLoading.style.display = 'block';
            modalContent.style.display = 'none';

            // Charger les tâches disponibles
            try {
                const response = await fetch(`/taches/api/benevole/${currentBenevoleId}/available-tasks`);
                availableTasks = await response.json();
                
                renderTasks();
                modalLoading.style.display = 'none';
                modalContent.style.display = 'block';
            } catch (error) {
                alert('Erreur lors du chargement des tâches');
                modal.style.display = 'none';
            }
        });
    });

    // Ouvrir modal de suppression
    document.querySelectorAll('.btn-remove-tasks').forEach(btn => {
        btn.addEventListener('click', async function() {
            currentBenevoleId = this.dataset.benevoleId;
            const benevoleNom = this.dataset.benevoleNom;
            isRemoveMode = true;
            
            modalTitle.textContent = `Retirer des tâches de ${benevoleNom}`;
            modalSubmit.textContent = 'Retirer les tâches';
            modalSubmit.style.background = 'linear-gradient(135deg, #ef4444, #dc2626)';
            modal.style.display = 'flex';
            modalLoading.style.display = 'block';
            modalContent.style.display = 'none';

            // Charger les tâches assignées au bénévole
            try {
                const response = await fetch(`/taches/api/benevole/${currentBenevoleId}/assigned-tasks`);
                availableTasks = await response.json();
                
                renderTasksForRemoval();
                modalLoading.style.display = 'none';
                modalContent.style.display = 'block';
            } catch (error) {
                alert('Erreur lors du chargement des tâches');
                modal.style.display = 'none';
            }
        });
    });

    // Fonction pour parser une date au format "dd/mm/yyyy HH:mm"
    function parseTaskDate(dateStr) {
        if (!dateStr) return null;
        const parts = dateStr.match(/(\d{2})\/(\d{2})\/(\d{4}) (\d{2}):(\d{2})/);
        if (!parts) return null;
        return new Date(parts[3], parts[2] - 1, parts[1], parts[4], parts[5]);
    }

    // Fonction pour vérifier si deux tâches se chevauchent
    function tasksOverlap(task1, task2) {
        const debut1 = parseTaskDate(task1.debut);
        const fin1 = parseTaskDate(task1.fin);
        const debut2 = parseTaskDate(task2.debut);
        const fin2 = parseTaskDate(task2.fin);

        if (!debut1 || !fin1 || !debut2 || !fin2) return false;

        // Chevauchement : (debut1 < fin2) && (debut2 < fin1)
        return (debut1 < fin2 && debut2 < fin1);
    }

    // Mettre à jour l'état des tâches en fonction des sélections
    function updateTaskAvailability() {
        const checkedTasks = availableTasks.filter(task => {
            const taskDiv = document.querySelector(`.task-item[data-task-id="${task.id}"]`);
            const checkbox = taskDiv?.querySelector('.task-checkbox');
            return checkbox?.checked && !task.hasConflict;
        });

        // Pour chaque tâche, vérifier si elle entre en conflit avec les tâches cochées
        availableTasks.forEach(task => {
            if (task.hasConflict) return; // Déjà désactivée par le serveur

            const taskDiv = document.querySelector(`.task-item[data-task-id="${task.id}"]`);
            const checkbox = taskDiv?.querySelector('.task-checkbox');
            
            if (!checkbox || checkbox.checked) return;

            // Vérifier si cette tâche chevauche une des tâches cochées
            let hasConflictWithSelected = false;
            for (const checkedTask of checkedTasks) {
                if (checkedTask.id !== task.id && tasksOverlap(task, checkedTask)) {
                    hasConflictWithSelected = true;
                    break;
                }
            }

            // Désactiver/griser si conflit détecté
            if (hasConflictWithSelected) {
                checkbox.disabled = true;
                taskDiv.classList.add('disabled');
                taskDiv.style.opacity = '0.5';
                taskDiv.style.pointerEvents = 'none';
            } else {
                checkbox.disabled = false;
                taskDiv.classList.remove('disabled');
                taskDiv.style.opacity = '1';
                taskDiv.style.pointerEvents = 'auto';
            }
        });
    }

    function renderTasks() {
        tasksList.innerHTML = '';

        if (availableTasks.length === 0) {
            tasksList.innerHTML = '<p style="text-align:center; color:#6b7280; padding:2rem;">Aucune tâche disponible</p>';
            return;
        }

        availableTasks.forEach(task => {
            const isConflict = task.hasConflict;
            
            const taskDiv = document.createElement('div');
            taskDiv.className = `task-item ${isConflict ? 'disabled' : ''}`;
            taskDiv.dataset.taskId = task.id;
            
            taskDiv.innerHTML = `
                <div style="display: flex; align-items: center; gap: 1rem;">
                    <input 
                        type="checkbox" 
                        class="task-checkbox" 
                        ${isConflict ? 'disabled' : ''}
                        style="width: 20px; height: 20px; cursor: pointer;"
                    >
                    <div style="flex: 1;">
                        <div style="font-weight: 700; color: #0d1b2a; margin-bottom: 0.25rem;">
                            ${task.titre}
                            ${isConflict ? '<span style="color: #dc2626; font-size: 0.875rem; margin-left: 0.5rem;">⚠️ Conflit horaire</span>' : ''}
                        </div>
                        <div style="color: #6b7280; font-size: 0.875rem;">
                            📅 ${task.debut} → ${task.fin}
                            ${task.weekendNom ? ` | 🎪 ${task.weekendNom}` : ''}
                        </div>
                    </div>
                    ${!isConflict ? `
                        <div style="display: flex; gap: 0.5rem; align-items: center;">
                            <label style="display: flex; align-items: center; gap: 0.25rem; padding: 0.4rem 0.75rem; border-radius: 6px; cursor: pointer; transition: all 0.2s; background: #dbeafe; color: #1e40af; font-weight: 600; font-size: 0.875rem;">
                                <input type="radio" name="action_${task.id}" value="assigner" checked style="margin: 0;">
                                Assigner
                            </label>
                            <label style="display: flex; align-items: center; gap: 0.25rem; padding: 0.4rem 0.75rem; border-radius: 6px; cursor: pointer; transition: all 0.2s; background: #fef3c7; color: #92400e; font-weight: 600; font-size: 0.875rem;">
                                <input type="radio" name="action_${task.id}" value="proposer" style="margin: 0;">
                                Proposer
                            </label>
                        </div>
                    ` : ''}
                </div>
            `;

            if (!isConflict) {
                const checkbox = taskDiv.querySelector('.task-checkbox');
                checkbox.addEventListener('change', function() {
                    taskDiv.classList.toggle('selected', this.checked);
                    updateTaskAvailability(); // Mettre à jour les conflits dynamiques
                });

                taskDiv.addEventListener('click', function(e) {
                    if (e.target.type !== 'checkbox' && e.target.type !== 'radio') {
                        checkbox.checked = !checkbox.checked;
                        checkbox.dispatchEvent(new Event('change'));
                    }
                });
            }

            tasksList.appendChild(taskDiv);
        });
    }

    function renderTasksForRemoval() {
        tasksList.innerHTML = '';

        if (availableTasks.length === 0) {
            tasksList.innerHTML = '<p style="text-align:center; color:#6b7280; padding:2rem;">Aucune tâche assignée à retirer</p>';
            return;
        }

        availableTasks.forEach(task => {
            const taskDiv = document.createElement('div');
            taskDiv.className = 'task-item';
            taskDiv.dataset.taskId = task.id;
            
            taskDiv.innerHTML = `
                <div style="display: flex; align-items: center; gap: 1rem;">
                    <input 
                        type="checkbox" 
                        class="task-checkbox" 
                        style="width: 20px; height: 20px; cursor: pointer;"
                    >
                    <div style="flex: 1;">
                        <div style="font-weight: 700; color: #0d1b2a; margin-bottom: 0.25rem;">
                            ${task.titre}
                        </div>
                        <div style="color: #6b7280; font-size: 0.875rem;">
                            📅 ${task.debut} → ${task.fin}
                            ${task.weekendNom ? ` | 🎪 ${task.weekendNom}` : ''}
                        </div>
                    </div>
                </div>
            `;

            const checkbox = taskDiv.querySelector('.task-checkbox');
            checkbox.addEventListener('change', function() {
                taskDiv.classList.toggle('selected', this.checked);
            });

            taskDiv.addEventListener('click', function(e) {
                if (e.target.type !== 'checkbox') {
                    checkbox.checked = !checkbox.checked;
                    checkbox.dispatchEvent(new Event('change'));
                }
            });

            tasksList.appendChild(taskDiv);
        });
    }

    // Valider l'assignation ou la suppression
    modalSubmit.addEventListener('click', async function() {
        const selectedTasks = [];

        document.querySelectorAll('.task-checkbox:checked').forEach(checkbox => {
            const taskDiv = checkbox.closest('.task-item');
            const taskId = parseInt(taskDiv.dataset.taskId);
            
            if (isRemoveMode) {
                selectedTasks.push(taskId);
            } else {
                const actionRadio = taskDiv.querySelector(`input[name="action_${taskId}"]:checked`);
                const action = actionRadio ? actionRadio.value : 'assigner';

                selectedTasks.push({
                    tache_id: taskId,
                    action: action
                });
            }
        });

        if (selectedTasks.length === 0) {
            alert(isRemoveMode ? 'Veuillez sélectionner au moins une tâche à retirer' : 'Veuillez sélectionner au moins une tâche');
            return;
        }

        // Envoyer au serveur
        try {
            const endpoint = isRemoveMode 
                ? `/taches/benevole/${currentBenevoleId}/batch-remove`
                : `/taches/benevole/${currentBenevoleId}/batch-assign`;
            
            const body = isRemoveMode 
                ? JSON.stringify({ tache_ids: selectedTasks })
                : JSON.stringify({ tasks: selectedTasks });

            const response = await fetch(endpoint, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: body
            });

            const result = await response.json();
            
            if (result.success) {
                if (isRemoveMode) {
                    alert(`✅ ${result.count || selectedTasks.length} tâche(s) retirée(s) avec succès !`);
                } else {
                    alert(`✅ ${result.stats.success} tâche(s) traitée(s) avec succès !`);
                }
                window.location.reload();
            } else {
                alert('Erreur: ' + (result.message || 'Une erreur est survenue'));
            }
        } catch (error) {
            console.error(error);
            alert(isRemoveMode ? 'Erreur lors de la suppression' : 'Erreur lors de l\'assignation');
        }

        modal.style.display = 'none';
    });

    // Fermer modal
    [modalClose, modalCancel].forEach(btn => {
        btn.addEventListener('click', () => modal.style.display = 'none');
    });

    modal.addEventListener('click', (e) => {
        if (e.target === modal) modal.style.display = 'none';
    });
});
</script>
{% endblock %}
