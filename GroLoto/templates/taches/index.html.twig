{% extends 'base.html.twig' %}

{% block title %}Gestion des Taches{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/modele.css') }}">
    <link rel="stylesheet" href="{{ asset('css/taches/taches-common.css') }}">
    <link rel="stylesheet" href="{{ asset('css/taches/taches-list.css') }}">
{% endblock %}

{% block body %}
<div class="taches-page">
<div class="hero-section taches-hero">
    <div class="shine"></div>
    <div class="hero-content">
        <h1 class="hero-title">Gestion des Tâches</h1>
        <p class="hero-description">Créez, modifiez et assignez des tâches aux bénévoles pour vos événements.</p>
        <a href="{{ path('tache_new') }}" class="btn-login">+ Créer une tâche</a>
    </div>
</div>

<div class="container">
    <div class="page-header">
        <h1 class="page-title">Toutes les Tâches</h1>
        <div style="display: flex; gap: 1rem;">
            <a href="{{ path('tache_benevoles_management') }}" class="btn btn-secondary" style="background: linear-gradient(135deg, #10b981, #059669); border-color: #10b981;">
                <svg style="display: inline; width: 18px; height: 18px; margin-right: 0.5rem; vertical-align: middle;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
                </svg>
                Gestion Bénévoles
            </a>
            <a href="{{ path('admin_demandes_taches') }}" class="btn btn-secondary">Demandes en attente</a>
            <a href="{{ path('tache_new') }}" class="btn btn-primary">+ Nouvelle tâche</a>
        </div>
    </div>

    {# Filtres et Tri #}
    <div class="card" style="margin-bottom: 1.5rem;">
        <div class="card-content" style="padding: 1.25rem;">
            <div style="display: flex; gap: 2rem; align-items: center; flex-wrap: wrap;">
                {# Filtres par statut #}
                <div style="flex: 1; min-width: 300px;">
                    <label style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: #374151; font-size: 0.875rem;">
                        Filtrer par statut
                    </label>
                    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                        <a href="{{ path('tache_index', {filtre: 'toutes', tri: triActif}) }}" 
                           class="btn btn-small {{ filtreActif == 'toutes' ? 'btn-night-blue' : 'btn-outline-secondary' }}">
                            Toutes
                        </a>
                        <a href="{{ path('tache_index', {filtre: 'futures', tri: triActif}) }}" 
                           class="btn btn-small {{ filtreActif == 'futures' ? 'btn-night-blue' : 'btn-outline-secondary' }}">
                            À venir
                        </a>
                        <a href="{{ path('tache_index', {filtre: 'en_cours', tri: triActif}) }}" 
                           class="btn btn-small {{ filtreActif == 'en_cours' ? 'btn-night-blue' : 'btn-outline-secondary' }}">
                            En cours
                        </a>
                        <a href="{{ path('tache_index', {filtre: 'passees', tri: triActif}) }}" 
                           class="btn btn-small {{ filtreActif == 'passees' ? 'btn-night-blue' : 'btn-outline-secondary' }}">
                            Terminées
                        </a>
                    </div>
                </div>

                {# Tri #}
                <div style="flex: 1; min-width: 250px;">
                    <label style="display: block; font-weight: 600; margin-bottom: 0.5rem; color: #374151; font-size: 0.875rem;">
                        Trier par
                    </label>
                    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                        <a href="{{ path('tache_index', {filtre: filtreActif, tri: 'date_proche'}) }}" 
                           class="btn btn-small {{ triActif == 'date_proche' ? 'btn-outline-night-blue active' : 'btn-outline-secondary' }}">
                            Date croissante
                        </a>
                        <a href="{{ path('tache_index', {filtre: filtreActif, tri: 'date_eloignee'}) }}" 
                           class="btn btn-small {{ triActif == 'date_eloignee' ? 'btn-outline-night-blue active' : 'btn-outline-secondary' }}">
                            Date décroissante
                        </a>
                        <a href="{{ path('tache_index', {filtre: filtreActif, tri: 'titre'}) }}" 
                           class="btn btn-small {{ triActif == 'titre' ? 'btn-outline-night-blue active' : 'btn-outline-secondary' }}">
                            Titre (A-Z)
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card main-card">
        <div class="card-header">
            <h2 class="card-title">Liste des taches ({{ tachesData|length }})</h2>
            <p class="card-description">Gerez toutes les taches de vos evenements</p>
        </div>
            <div class="card-content">
                {% if tachesData|length > 0 %}
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Titre</th>
                                    <th>Evenement</th>
                                    <th>Plages horaires</th>
                                    <th>Benevoles assignes</th>
                                    <th>Max personnes</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for data in tachesData %}
                                    {% set tache = data.tache %}
                                    {% set now = date() %}
                                    {% set isPast = tache.fin < now %}
                                    {% set isFuture = tache.debut > now %}
                                    <tr class="{{ isPast ? 'table-row-muted' : (isFuture ? 'table-row-future' : 'table-row-current') }}">
                                        <td>{{ tache.id }}</td>
                                        <td>
                                            <strong>{{ tache.titre }}</strong>
                                            {% if isPast %}
                                                <span class="badge status" style="background: #9ca3af;">Terminee</span>
                                            {% elseif isFuture %}
                                                <span class="badge status" style="background: #3b82f6;">A venir</span>
                                            {% else %}
                                                <span class="badge status" style="background: #10b981;">En cours</span>
                                            {% endif %}
                                        </td>
                                        <td>
                                                {% if tache.weekend %}
                                                    <span class="badge" style="background: #8b5cf6;">{{ tache.weekend.nom }}</span>
                                            {% else %}
                                                <span style="color: #9ca3af;">—</span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            {% if tache.plagesHoraires|length > 0 %}
                                                <div style="font-size: 0.85em;">
                                                    {% for plage in tache.plagesHoraires %}
                                                        <div style="margin: 2px 0;">
                                                            <span class="badge" style="background: #06b6d4;">{{ plage.jour|date('d/m') }}</span>
                                                            <span class="badge" style="background: #14b8a6;">{{ plage.heureDebut|date('H:i') }} - {{ plage.heureFin|date('H:i') }}</span>
                                                        </div>
                                                    {% endfor %}
                                                </div>
                                            {% else %}
                                                <span style="color: #dc2626;">Pas de plage définie</span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            {# Bouton pour voir les bénévoles #}
                                            <a href="{{ path('tache_benevoles', {'id': tache.id}) }}" 
                                               class="btn btn-small btn-outline-secondary" 
                                               title="Voir les bénévoles assignés">
                                                {% if data.nbAssignes > 0 %}
                                                    <i class="bi bi-people-fill"></i> {{ data.nbAssignes }} assigné{{ data.nbAssignes > 1 ? 's' : '' }}
                                                {% else %}
                                                    <i class="bi bi-people"></i> Aucun
                                                {% endif %}
                                                {% if data.nbProposees > 0 %}
                                                    <br><small style="color: #f59e0b;">{{ data.nbProposees }} en attente</small>
                                                {% endif %}
                                            </a>
                                        </td>
                                        <td>
                                            {% if tache.maxPersonnes %}
                                                <div style="text-align: center;">
                                                    <strong>{{ tache.maxPersonnes }}</strong>
                                                    {% if data.placesRestantes is not null %}
                                                        <br>
                                                        {% if data.placesRestantes == 0 %}
                                                            <span class="badge" style="background: #10b981;">Complet</span>
                                                        {% elseif data.placesRestantes == 1 %}
                                                            <span class="badge" style="background: #f59e0b;">1 place</span>
                                                        {% else %}
                                                            <span class="badge" style="background: #3b82f6;">{{ data.placesRestantes }} places</span>
                                                        {% endif %}
                                                    {% endif %}
                                                </div>
                                            {% else %}
                                                <span style="color: #9ca3af;">—</span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            <div class="btn-group">
                                                <a href="{{ path('tache_edit', {'id': tache.id}) }}" 
                                                   class="btn btn-small btn-primary" 
                                                   title="Modifier">Modifier</a>
                                                <a href="{{ path('tache_duplicate', {'id': tache.id}) }}" 
                                                   class="btn btn-small btn-success" 
                                                   title="Dupliquer la tâche">Dupliquer</a>
                                                {% set isFull = tache.maxPersonnes and data.nbAssignes >= tache.maxPersonnes %}
                                                <a href="{{ path('tache_proposer', {'id': tache.id}) }}" 
                                                   class="btn btn-small {% if isFull %}btn-secondary disabled{% else %}btn-info{% endif %}" 
                                                   title="{% if isFull %}Tâche complète{% else %}Gérer les bénévoles{% endif %}"
                                                   {% if isFull %}style="opacity: 0.6; cursor: not-allowed;"{% endif %}>
                                                   Bénévoles {% if isFull %}<i class="bi bi-check-circle-fill"></i>{% endif %}
                                                </a>
                                                <button type="button" 
                                                        class="btn btn-small btn-danger" 
                                                        data-tache-id="{{ tache.id }}"
                                                        data-tache-titre="{{ tache.titre }}"
                                                        data-csrf-token="{{ csrf_token('delete_tache_' ~ tache.id) }}"
                                                        onclick="confirmDelete(this)"
                                                        title="Supprimer">Supprimer</button>
                                            </div>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <div class="empty-state">
                        <div class="empty-icon"><i class="bi bi-clipboard-check-fill" style="font-size: 3rem;"></i></div>
                        <h3>Aucune tache trouvee</h3>
                        <p>Commencez par creer des taches pour vos evenements.</p>
                        <a href="{{ path('tache_new') }}" class="btn btn-primary">+ Creer une tache</a>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>

<script>
function confirmDelete(button) {
    const tacheId = button.getAttribute('data-tache-id');
    const tacheTitre = button.getAttribute('data-tache-titre');
    const csrfToken = button.getAttribute('data-csrf-token');
    
    if (confirm(`Etes-vous sur de vouloir supprimer la tache "${tacheTitre}" ?\n\nCette action supprimera egalement toutes les affectations de benevoles associees.`)) {
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = `/taches/${tacheId}/delete`;
        
        const csrfInput = document.createElement('input');
        csrfInput.type = 'hidden';
        csrfInput.name = '_token';
        csrfInput.value = csrfToken;
        form.appendChild(csrfInput);
        
        document.body.appendChild(form);
        form.submit();
    }
}
</script>
{% endblock %}
