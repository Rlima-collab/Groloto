{% extends 'base.html.twig' %}

{% block title %}Créer une tâche{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/modele.css') }}">
    <link rel="stylesheet" href="{{ asset('css/taches/taches-common.css') }}">
    <link rel="stylesheet" href="{{ asset('css/taches/taches-forms.css') }}">
{% endblock %}

{% block body %}
<div class="taches-page">
<div class="container" style="padding-top: calc(71px + 2rem);">
    <div class="page-header">
        <h1 class="page-title">Créer une nouvelle tâche</h1>
        <a href="{{ path('tache_index') }}" class="btn btn-secondary">Retour à la liste</a>
    </div>

    <div style="max-width: 800px; margin: 0 auto;">
        <div class="card">
            <div class="card-header">
                <h2 class="card-title">Informations de la tâche</h2>
                <p class="card-description">Remplissez les détails de la nouvelle tâche</p>
            </div>
            <div class="card-content">
                {{ form_start(form) }}
                    <div class="form-grid">
                        <div class="form-group required">
                            {{ form_label(form.titre) }}
                            {{ form_widget(form.titre) }}
                            {{ form_errors(form.titre) }}
                        </div>

                        <div class="form-group">
                            {{ form_label(form.weekend) }}
                            {{ form_widget(form.weekend) }}
                            {{ form_errors(form.weekend) }}
                            <small class="form-text">Le weekend auquel cette tâche est rattachée</small>
                        </div>

                        <div class="form-group required">
                            {{ form_label(form.debut) }}
                            {{ form_widget(form.debut) }}
                            {{ form_errors(form.debut) }}
                        </div>

                        <div class="form-group required">
                            {{ form_label(form.fin) }}
                            {{ form_widget(form.fin) }}
                            {{ form_errors(form.fin) }}
                        </div>

                        <div class="form-group">
                            {{ form_label(form.posteRequis) }}
                            {{ form_widget(form.posteRequis) }}
                            {{ form_errors(form.posteRequis) }}
                        </div>

                        <div class="form-group">
                            {{ form_label(form.maxPersonnes) }}
                            {{ form_widget(form.maxPersonnes) }}
                            {{ form_errors(form.maxPersonnes) }}
                        </div>

                        <div class="form-group full-width">
                            {{ form_label(form.remarque) }}
                            {{ form_widget(form.remarque) }}
                            {{ form_errors(form.remarque) }}
                        </div>

                        <div class="form-group full-width" id="benevoles-section" style="display: none; background: #f9fafb; padding: 1.5rem; border-radius: 0.5rem; border: 1px solid #e5e7eb;">
                            <h3 style="font-size: 1.1rem; font-weight: 600; margin-bottom: 1rem; color: #1f2937;">Proposer aux bénévoles disponibles</h3>
                            <p style="font-size: 0.9rem; color: #6b7280; margin-bottom: 1rem;">Les bénévoles déjà occupés sur ce créneau sont grisés.</p>
                            
                            <div style="margin-bottom: 1rem; position: relative;">
                                <i class="bi bi-search" style="position: absolute; left: 10px; top: 50%; transform: translateY(-50%); color: #9ca3af;"></i>
                                <input type="text" id="benevole-search" class="form-control" placeholder="Rechercher un bénévole..." style="padding-left: 2.5rem;">
                            </div>

                            <div class="benevoles-list" style="max-height: 300px; overflow-y: auto; border: 1px solid #e5e7eb; border-radius: 0.375rem; background: white;">
                                {% for child in form.benevoles %}
                                    <div class="benevole-option" style="padding: 0.75rem; border-bottom: 1px solid #f3f4f6; display: flex; align-items: center; transition: background-color 0.2s;">
                                        {{ form_widget(child, {'attr': {'style': 'width: 1.2rem; height: 1.2rem; margin-right: 0.75rem; cursor: pointer;'}}) }}
                                        {{ form_label(child, null, {'label_attr': {'style': 'margin-bottom: 0; cursor: pointer; flex: 1; font-weight: 500;'}}) }}
                                    </div>
                                {% endfor %}
                            </div>
                            <div style="margin-top: 0.5rem; font-size: 0.85rem; color: #6b7280; text-align: right;">
                                <span id="count-selected">0</span> bénévole(s) sélectionné(s)
                            </div>
                        </div>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary">Créer la tâche</button>
                        <a href="{{ path('tache_index') }}" class="btn btn-secondary">Annuler</a>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const debutInput = document.getElementById('tache_debut');
    const finInput = document.getElementById('tache_fin');
    const benevolesSection = document.getElementById('benevoles-section');
    const checkboxes = document.querySelectorAll('.benevole-option input[type="checkbox"]');
    const labels = document.querySelectorAll('.benevole-option label');
    const searchInput = document.getElementById('benevole-search');
    const benevoleOptions = document.querySelectorAll('.benevole-option');
    const countSelectedSpan = document.getElementById('count-selected');

    // Recherche en temps réel
    if (searchInput) {
        searchInput.addEventListener('input', function(e) {
            const term = e.target.value.toLowerCase();
            benevoleOptions.forEach(option => {
                const label = option.querySelector('label').textContent.toLowerCase();
                if (label.includes(term)) {
                    option.style.display = 'flex';
                } else {
                    option.style.display = 'none';
                }
            });
        });
    }

    // Compteur de sélection
    function updateCount() {
        if (countSelectedSpan) {
            const count = document.querySelectorAll('.benevole-option input[type="checkbox"]:checked').length;
            countSelectedSpan.textContent = count;
        }
    }

    checkboxes.forEach(cb => {
        cb.addEventListener('change', updateCount);
    });

    function updateAvailability() {
        const start = debutInput.value;
        const end = finInput.value;

        if (start && end) {
            benevolesSection.style.display = 'block';
            
            // Appel API pour vérifier la disponibilité
            fetch(`/taches/api/check-availability?start=${encodeURIComponent(start)}&end=${encodeURIComponent(end)}`)
                .then(response => response.json())
                .then(data => {
                    const unavailableIds = data.unavailable_ids || [];
                    
                    checkboxes.forEach(cb => {
                        const benevoleId = parseInt(cb.value);
                        const label = cb.nextElementSibling; // Le label est juste après
                        const parentDiv = cb.closest('.benevole-option');

                        if (unavailableIds.includes(benevoleId)) {
                            cb.disabled = true;
                            cb.checked = false;
                            parentDiv.style.opacity = '0.5';
                            parentDiv.title = 'Indisponible sur ce créneau';
                            if (!label.innerHTML.includes('(Indisponible)')) {
                                label.innerHTML += ' <span style="color: #dc2626; font-size: 0.8em;">(Indisponible)</span>';
                            }
                        } else {
                            cb.disabled = false;
                            parentDiv.style.opacity = '1';
                            parentDiv.title = 'Disponible';
                            // Nettoyer le label si besoin
                            label.innerHTML = label.innerHTML.replace(' <span style="color: #dc2626; font-size: 0.8em;">(Indisponible)</span>', '');
                        }
                    });
                })
                .catch(err => console.error('Erreur lors de la vérification des disponibilités:', err));
        } else {
            benevolesSection.style.display = 'none';
        }
    }

    if (debutInput && finInput) {
        debutInput.addEventListener('change', updateAvailability);
        finInput.addEventListener('change', updateAvailability);
        // Vérifier au chargement si des dates sont déjà là (ex: rechargement après erreur)
        updateAvailability();
    }
});
</script>
{% endblock %}

