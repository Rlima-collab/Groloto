{% extends 'base.html.twig' %}

{% block title %}Créer une tâche{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/modele.css') }}">
    <link rel="stylesheet" href="{{ asset('css/taches/taches-common.css') }}">
    <link rel="stylesheet" href="{{ asset('css/taches/taches-forms.css') }}">
{% endblock %}

{% block body %}
<div class="taches-page">
<div class="container" style="padding-top: calc(71px + 2rem);">
    <div class="page-header" style="display: flex; align-items: center; justify-content: center; position: relative;">
        <a href="{{ path('tache_index') }}" class="btn btn-secondary" style="position: absolute; left: 0;">← Retour à la liste</a>
        <h1 class="page-title" style="margin: 0 auto; text-align: center; width: 100%;">Créer une nouvelle tâche</h1>
    </div>

    <div style="max-width: 800px; margin: 0 auto;">
        <div class="card">
            <div class="card-header">
                <h2 class="card-title">Informations de la tâche</h2>
                <p class="card-description">Remplissez les détails de la nouvelle tâche</p>
            </div>
            <div class="card-content">
                {{ form_start(form) }}
                    <div class="form-grid">
                        <div class="form-group required full-width">
                            {{ form_label(form.titre) }}
                            {{ form_widget(form.titre) }}
                            {{ form_errors(form.titre) }}
                        </div>

                        <div class="form-group required full-width">
                            {{ form_label(form.weekend) }}
                            {{ form_widget(form.weekend) }}
                            {{ form_errors(form.weekend) }}
                            <small class="form-text">Le weekend auquel cette tâche est rattachée</small>
                        </div>
                    </div>

                    {# Plage horaire sur une ligne #}
                    <div style="background: #f8fafc; padding: 1rem; border-radius: 0.375rem; margin: 1.5rem 0;">
                        <label style="display: block; font-weight: 600; margin-bottom: 1rem; color: #1f2937;">📅 Plage horaire</label>
                        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem;">
                            <div class="form-group">
                                {{ form_label(form.jour_plage) }}
                                {{ form_widget(form.jour_plage) }}
                                {{ form_errors(form.jour_plage) }}
                            </div>
                            <div class="form-group">
                                {{ form_label(form.heure_debut_plage) }}
                                {{ form_widget(form.heure_debut_plage) }}
                                {{ form_errors(form.heure_debut_plage) }}
                            </div>
                            <div class="form-group">
                                {{ form_label(form.heure_fin_plage) }}
                                {{ form_widget(form.heure_fin_plage) }}
                                {{ form_errors(form.heure_fin_plage) }}
                            </div>
                        </div>
                    </div>

                    <div class="form-grid">
                        <div class="form-group">
                            {{ form_label(form.maxPersonnes) }}
                            {{ form_widget(form.maxPersonnes) }}
                            {{ form_errors(form.maxPersonnes) }}
                            <small class="form-text">Limite globale de bénévoles</small>
                        </div>

                        <div class="form-group full-width">
                            {{ form_label(form.remarque) }}
                            {{ form_widget(form.remarque) }}
                            {{ form_errors(form.remarque) }}
                        </div>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary">Créer la tâche</button>
                        <a href="{{ path('tache_index') }}" class="btn btn-secondary">Annuler</a>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>

        <div class="card alert-conseil">
            <div class="card-content">
                <h4>💡 Besoin d'ajouter d'autres plages?</h4>
                <p>
                    Vous pouvez créer la tâche avec une première plage horaire, puis utiliser le bouton "Dupliquer" dans la liste pour créer d'autres plages sur d'autres jours!
                </p>
            </div>
        </div>
    </div>
</div>
</div>
{% endblock %}

