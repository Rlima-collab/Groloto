{% extends 'base.html.twig' %}

{% block title %}Modifier la tâche{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/modele.css') }}">
    <link rel="stylesheet" href="{{ asset('css/taches/taches-common.css') }}">
    <link rel="stylesheet" href="{{ asset('css/taches/taches-forms.css') }}">
{% endblock %}

{% block body %}
<div class="taches-page">
<div class="container" style="padding-top: calc(71px + 2rem);">
    <div class="page-header">
        <h1 class="page-title">Modifier la tâche : {{ tache.titre }}</h1>
        <a href="{{ path('tache_index') }}" class="btn btn-secondary">Retour à la liste</a>
    </div>

    <div style="max-width: 800px; margin: 0 auto;">
        <div class="card">
            <div class="card-header">
                <h2 class="card-title">Informations de la tâche</h2>
                <p class="card-description">Modifiez les détails de la tâche #{{ tache.id }}</p>
            </div>
            <div class="card-content">
                {{ form_start(form) }}
                    <div class="form-grid">
                        <div class="form-group required full-width">
                            {{ form_label(form.titre) }}
                            {{ form_widget(form.titre) }}
                            {{ form_errors(form.titre) }}
                        </div>

                        <div class="form-group full-width">
                            {{ form_label(form.weekend) }}
                            {{ form_widget(form.weekend) }}
                            {{ form_errors(form.weekend) }}
                            <small class="form-text">Le weekend auquel cette tâche est rattachée</small>
                        </div>
                    </div>

                    {# Affichage des plages horaires existantes #}
                    {% if tache.plagesHoraires|length > 0 %}
                    <div class="card" style="margin: 1.5rem 0; background: #f8fafc;">
                        <div class="card-header" style="padding-bottom: 0.75rem;">
                            <h3 style="margin: 0; font-size: 1rem;">Plages horaires existantes</h3>
                        </div>
                        <div class="card-content">
                            <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                                {% for plage in tache.plagesHoraires %}
                                    <div style="padding: 0.75rem; background: white; border-radius: 0.375rem; border-left: 4px solid #3b82f6;">
                                        <strong>{{ plage.jour|date('d/m/Y') }}</strong> 
                                        <span style="color: #6b7280;">{{ plage.heureDebut|date('H:i') }} - {{ plage.heureFin|date('H:i') }}</span>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                    {% endif %}

                    <div class="form-grid">
                        <div class="form-group">
                            {{ form_label(form.maxPersonnes) }}
                            {{ form_widget(form.maxPersonnes) }}
                            {{ form_errors(form.maxPersonnes) }}
                            <small class="form-text">Limite globale de bénévoles</small>
                        </div>

                        <div class="form-group full-width">
                            {{ form_label(form.remarque) }}
                            {{ form_widget(form.remarque) }}
                            {{ form_errors(form.remarque) }}
                        </div>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary">Enregistrer les modifications</button>
                        <a href="{{ path('tache_index') }}" class="btn btn-secondary">Annuler</a>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
</div>
{% endblock %}
