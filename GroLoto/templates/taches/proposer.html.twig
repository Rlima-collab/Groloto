{% extends 'base.html.twig' %}

{% block title %}Proposer la tâche - {{ tache.titre }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/modele.css') }}">
    <link rel="stylesheet" href="{{ asset('css/taches/taches-common.css') }}">
    <link rel="stylesheet" href="{{ asset('css/taches/taches-forms.css') }}">
    <style>
        .benevole-item {
            display: flex;
            align-items: center;
            padding: 1rem;
            border-bottom: 1px solid #e5e7eb;
        }
        .benevole-item:last-child {
            border-bottom: none;
        }
        .benevole-info {
            flex: 1;
        }
        .benevole-status {
            margin-left: 1rem;
            font-size: 0.875rem;
            font-weight: 600;
        }
        .status-disponible { color: #059669; }
        .status-indisponible { color: #dc2626; }
        .status-assigne { color: #2563eb; }
        .status-proposee { color: #d97706; }
        
        .benevole-item.disabled {
            background-color: #f3f4f6;
            opacity: 0.7;
        }
    </style>
{% endblock %}

{% block body %}
<div class="taches-page">
<div class="container" style="padding-top: calc(71px + 2rem);">
    <div class="page-header">
        <h1 class="page-title">Proposer la tâche aux bénévoles</h1>
        <a href="{{ path('tache_index') }}" class="btn btn-secondary">Retour à la liste</a>
    </div>

    <div style="max-width: 900px; margin: 0 auto;">
        <div class="card alert-info">
            <div class="card-content">
                <h3>{{ tache.titre }}</h3>
                <div>
                    <p><strong>Période :</strong> {{ tache.debut|date('d/m/Y H:i') }} - {{ tache.fin|date('d/m/Y H:i') }}</p>
                    {% if tache.maxPersonnes %}
                        <p><strong>Nombre de personnes souhaité :</strong> {{ tache.maxPersonnes }}</p>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h2 class="card-title">Rechercher des bénévoles</h2>
                <form method="get" action="{{ path('tache_proposer', {id: tache.id}) }}" class="search-form" style="margin-top: 1rem;">
                    <div style="display: flex; gap: 1rem;">
                        <input type="text" name="q" value="{{ search }}" placeholder="Commencez à taper pour rechercher (nom, prénom, email)..." class="form-control" style="flex: 1;" autocomplete="off">
                    </div>
                </form>
            </div>
            
            <div class="card-content">
                <form method="post">
                    <div class="benevoles-list" id="benevoles-list-container">
                        {% include 'taches/_benevoles_list.html.twig' %}
                    </div>

                    <div class="form-actions" style="margin-top: 2rem; border-top: 1px solid #e5e7eb; padding-top: 1rem;">
                        <button type="submit" class="btn btn-primary">Envoyer les propositions</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const searchInput = document.querySelector('input[name="q"]');
        const listContainer = document.getElementById('benevoles-list-container');
        let timeoutId;

        searchInput.addEventListener('input', function() {
            clearTimeout(timeoutId);
            const query = this.value;
            
            timeoutId = setTimeout(() => {
                // Mise à jour de l'URL pour l'historique
                const currentUrl = new URL(window.location.href);
                if (query) {
                    currentUrl.searchParams.set('q', query);
                } else {
                    currentUrl.searchParams.delete('q');
                }
                window.history.replaceState({}, '', currentUrl);

                // Requête AJAX
                const fetchUrl = new URL(window.location.href);
                fetchUrl.searchParams.set('q', query);
                fetchUrl.searchParams.set('ajax', '1');
                
                fetch(fetchUrl)
                    .then(response => response.text())
                    .then(html => {
                        listContainer.innerHTML = html;
                    })
                    .catch(error => console.error('Error:', error));
            }, 300); // Debounce de 300ms
        });
        
        // Empêcher la soumission du formulaire de recherche classique
        const searchForm = document.querySelector('.search-form');
        if(searchForm) {
            searchForm.addEventListener('submit', function(e) {
                e.preventDefault();
                // On pourrait déclencher l'événement input manuellement si besoin, 
                // mais le debounce s'en charge déjà lors de la frappe.
            });
        }
    });
</script>
{% endblock %}
