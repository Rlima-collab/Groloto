{% extends 'base.html.twig' %}

{% block title %}Créer un Weekend{% endblock %}

{% block body %}
<div class="container mx-auto max-w-2xl p-6">
    <h1 class="text-3xl font-bold text-gray-800 mb-8">Créer un weekend</h1>

    {{ form_start(form, {'attr': {'class': 'space-y-8'}}) }}

        <div class="bg-white p-6 rounded-xl shadow-sm border">
            <h2 class="text-xl font-semibold text-gray-700 mb-4">Informations</h2>
            <div class="grid md:grid-cols-2 gap-6">
                {{ form_row(form.nom) }}
            </div>
        </div>

        <div class="bg-blue-50 p-6 rounded-xl border border-blue-200">
            <h2 class="text-xl font-semibold text-blue-800 mb-2">Date du vendredi</h2>
            <p class="text-sm text-blue-700 mb-4">
                Le weekend durera automatiquement <strong>vendredi, samedi, dimanche</strong>.
            </p>
            <div class="max-w-xs">
                {{ form_row(form.dateVendredi) }}
            </div>
        </div>

        <div class="flex justify-end">
            <button type="submit" class="bg-green-600 hover:bg-green-700 text-white font-bold py-3 px-8 rounded-lg shadow-lg transition">
                Créer le weekend
            </button>
        </div>

    {{ form_end(form) }}
</div>
{% endblock %}