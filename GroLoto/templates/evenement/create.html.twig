{% extends 'base.html.twig' %}

{% block title %}Créer un événement{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/modele.css') }}">
    <link rel="stylesheet" href="{{ asset('css/festival/festival-common.css') }}">
    <link rel="stylesheet" href="{{ asset('css/festival/festival-create.css') }}">
{% endblock %}

{% block body %}
<div class="hero-section weekend-hero">
    <div class="shine"></div>
    <div class="hero-content">
        <h1 class="hero-title">Créer un Événement</h1>
        <p class="hero-description">Planifiez un nouvel événement caritatif.</p>
        <a href="{{ path('app_evenements') }}" class="btn-login">Voir tous les événements</a>
    </div>
</div>

<div class="weekend-create-container">
    <div class="weekend-form-card">
        <div class="weekend-form-header">
            <h2>Informations de l'Événement</h2>
        </div>

        {{ form_start(form, {'attr': {'class': 'form-night-blue', 'id': 'evenement-form'}}) }}

            <div class="mb-4">
                {{ form_row(form.nom, {'attr': {'class': 'form-control', 'placeholder': 'Nom de l\'événement'}}) }}
            </div>

            <div class="mb-4">
                {{ form_row(form.weekend, {'attr': {'class': 'form-control'}}) }}
            </div>

            <div class="mb-4">
                {{ form_row(form.date_debut, {'attr': {'class': 'form-control'}, 'label': 'Date de l\'événement'}) }}
            </div>

            <div class="form-row mb-4">
                <div class="form-col">
                    {{ form_row(form.heure_debut, {'attr': {'class': 'form-control', 'id': 'heure-debut'}}) }}
                </div>
                <div class="form-col">
                    <label class="form-label" style="font-weight: 600; color: #1f2937; margin-bottom: 0.5rem; display: block;">
                        Durée <span style="color: #dc2626;">*</span>
                    </label>
                    <div style="display: flex; gap: 0.5rem;">
                        {{ form_widget(form.duree_minutes, {'attr': {'class': 'form-control', 'id': 'duree-minutes', 'placeholder': 'Ex: 120', 'style': 'flex: 1;'}}) }}
                        <select id="unite-duree" class="form-control" style="width: 120px;">
                            <option value="minutes">Minutes</option>
                            <option value="heures">Heures</option>
                        </select>
                    </div>
                    {{ form_errors(form.duree_minutes) }}
                </div>
            </div>

            <div class="mb-4" id="recapitulatif-container" style="display: none; background-color: #f0f9ff; border: 2px solid #3b82f6; border-radius: 0.5rem; padding: 1rem;">
                <h3 style="color: #1e40af; font-size: 1.1rem; margin-bottom: 0.75rem; font-weight: 600;">
                    📅 Récapitulatif de l'événement
                </h3>
                <div style="display: grid; gap: 0.5rem;">
                    <div style="display: flex; justify-content: space-between;">
                        <span style="font-weight: 600; color: #374151;">Début :</span>
                        <span id="recap-debut" style="color: #059669; font-weight: 600;"></span>
                    </div>
                    <div style="display: flex; justify-content: space-between;">
                        <span style="font-weight: 600; color: #374151;">Fin :</span>
                        <span id="recap-fin" style="color: #dc2626; font-weight: 600;"></span>
                    </div>
                    <div style="display: flex; justify-content: space-between; padding-top: 0.5rem; border-top: 1px solid #bfdbfe;">
                        <span style="font-weight: 600; color: #374151;">Durée totale :</span>
                        <span id="recap-duree" style="color: #7c3aed; font-weight: 600;"></span>
                    </div>
                </div>
            </div>

            <div class="mb-4">
                {{ form_row(form.lieu, {'attr': {'class': 'form-control', 'placeholder': 'Lieu de l\'événement'}}) }}
            </div>

            <div class="mb-4">
                {{ form_row(form.description, {'attr': {'class': 'form-control', 'rows': 5, 'placeholder': 'Description de l\'événement...'}}) }}
            </div>

            <div class="mb-4">
                {{ form_label(form.imageFile) }}
                {{ form_widget(form.imageFile, {'attr': {'class': 'form-control', 'accept': 'image/*'}}) }}
                {{ form_errors(form.imageFile) }}
                <small class="text-muted">Format acceptés : JPEG, PNG, GIF, WebP (max 5 Mo)</small>
                <div id="image-preview" class="mt-3" style="display: none;">
                    <img id="preview-img" src="" alt="Aperçu" style="max-width: 300px; max-height: 200px; border-radius: 8px; border: 2px solid #e5e7eb;">
                </div>
            </div>

            <div class="text-center mt-8">
                <button type="submit" class="btn-night-blue">
                    Créer l'événement
                </button>
                <a href="{{ path('app_evenements') }}" class="btn-outline-night-blue ml-3">
                    Annuler
                </a>
            </div>

            <div style="display: none;">
                {{ form_rest(form) }}
            </div>

        {{ form_end(form, {'render_rest': false}) }}
    </div>
</div>

<style>
.ml-3 {
    margin-left: 1rem;
}

.text-muted {
    color: #6b7280;
    font-size: 0.875rem;
    margin-top: 0.25rem;
    display: block;
}

.form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
}

.form-col {
    flex: 1;
}

@media (max-width: 768px) {
    .form-row {
        grid-template-columns: 1fr;
    }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    console.log('Script chargé');
    
    // Symfony génère des IDs avec le préfixe du formulaire
    const dateDebutInput = document.querySelector('input[type="date"]');
    const heureDebutInput = document.querySelector('input[type="time"]');
    const dureeInput = document.querySelector('input[name*="duree_minutes"]');
    const uniteSelect = document.getElementById('unite-duree');
    const recapContainer = document.getElementById('recapitulatif-container');
    const recapDebut = document.getElementById('recap-debut');
    const recapFin = document.getElementById('recap-fin');
    const recapDuree = document.getElementById('recap-duree');
    const imageInput = document.querySelector('input[type="file"]');
    const imagePreview = document.getElementById('image-preview');
    const previewImg = document.getElementById('preview-img');

    console.log('Date début input:', dateDebutInput);
    console.log('Heure début input:', heureDebutInput);
    console.log('Durée input:', dureeInput);

    // Fonction pour formater la date en français
    function formatDateFr(date) {
        const jours = ['Dimanche', 'Lundi', 'Mardi', 'Mercredi', 'Jeudi', 'Vendredi', 'Samedi'];
        const mois = ['janvier', 'février', 'mars', 'avril', 'mai', 'juin', 'juillet', 'août', 'septembre', 'octobre', 'novembre', 'décembre'];
        
        return `${jours[date.getDay()]} ${date.getDate()} ${mois[date.getMonth()]} ${date.getFullYear()}`;
    }

    // Fonction pour formater l'heure
    function formatHeure(date) {
        const heures = String(date.getHours()).padStart(2, '0');
        const minutes = String(date.getMinutes()).padStart(2, '0');
        return `${heures}h${minutes}`;
    }

    // Fonction pour convertir la durée en minutes
    function getDureeEnMinutes() {
        const valeur = parseFloat(dureeInput.value);
        const unite = uniteSelect.value;
        
        if (!valeur || valeur <= 0) return 0;
        
        if (unite === 'heures') {
            return valeur * 60;
        }
        return valeur;
    }

    // Fonction pour formater la durée
    function formatDuree(minutes) {
        const heures = Math.floor(minutes / 60);
        const mins = minutes % 60;
        
        if (heures === 0) {
            return `${mins} minute${mins > 1 ? 's' : ''}`;
        } else if (mins === 0) {
            return `${heures} heure${heures > 1 ? 's' : ''}`;
        } else {
            return `${heures}h${String(mins).padStart(2, '0')}`;
        }
    }

    // Calcul automatique du récapitulatif
    function calculerRecapitulatif() {
        if (!dateDebutInput || !heureDebutInput || !dureeInput || !recapContainer) {
            console.log('Éléments manquants');
            return;
        }

        const dateDebut = dateDebutInput.value;
        const heureDebut = heureDebutInput.value;
        const dureeMinutes = getDureeEnMinutes();

        console.log('Date début:', dateDebut, 'Heure début:', heureDebut, 'Durée (minutes):', dureeMinutes);

        if (dateDebut && heureDebut && dureeMinutes > 0) {
            // Créer un objet Date pour le début
            const [annee, mois, jour] = dateDebut.split('-');
            const [heures, minutes] = heureDebut.split(':');
            
            const debut = new Date(parseInt(annee), parseInt(mois) - 1, parseInt(jour), parseInt(heures), parseInt(minutes));
            
            // Créer un objet Date pour la fin
            const fin = new Date(debut.getTime());
            fin.setMinutes(fin.getMinutes() + dureeMinutes);
            
            // Afficher le récapitulatif
            recapDebut.textContent = `${formatDateFr(debut)} à ${formatHeure(debut)}`;
            recapFin.textContent = `${formatDateFr(fin)} à ${formatHeure(fin)}`;
            recapDuree.textContent = formatDuree(dureeMinutes);
            
            recapContainer.style.display = 'block';
            console.log('Récapitulatif calculé');
        } else {
            recapContainer.style.display = 'none';
        }
    }

    // Écouteurs d'événements pour le calcul automatique
    if (dateDebutInput) {
        dateDebutInput.addEventListener('change', calculerRecapitulatif);
        dateDebutInput.addEventListener('input', calculerRecapitulatif);
    }
    
    if (heureDebutInput) {
        heureDebutInput.addEventListener('change', calculerRecapitulatif);
        heureDebutInput.addEventListener('input', calculerRecapitulatif);
        heureDebutInput.addEventListener('keyup', calculerRecapitulatif);
    }
    
    if (dureeInput) {
        dureeInput.addEventListener('change', calculerRecapitulatif);
        dureeInput.addEventListener('input', calculerRecapitulatif);
        dureeInput.addEventListener('keyup', calculerRecapitulatif);
    }
    
    if (uniteSelect) {
        uniteSelect.addEventListener('change', calculerRecapitulatif);
    }

    // Calcul initial au chargement si les champs ont déjà des valeurs
    setTimeout(calculerRecapitulatif, 100);

    // Aperçu de l'image
    if (imageInput) {
        imageInput.addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    previewImg.src = e.target.result;
                    imagePreview.style.display = 'block';
                };
                reader.readAsDataURL(file);
            } else {
                imagePreview.style.display = 'none';
            }
        });
    }
});
</script>
{% endblock %}
