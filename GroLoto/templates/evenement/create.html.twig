{% extends 'base.html.twig' %}

{% block title %}Créer un événement{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/modele.css') }}">
    <link rel="stylesheet" href="{{ asset('css/festival/festival-common.css') }}">
    <link rel="stylesheet" href="{{ asset('css/festival/festival-create.css') }}">
{% endblock %}

{% block body %}
<div class="hero-section weekend-hero">
    <div class="shine"></div>
    <div class="hero-content">
        <h1 class="hero-title">Créer un Événement</h1>
        <p class="hero-description">Planifiez un nouvel événement caritatif.</p>
        <a href="{{ path('app_evenements') }}" class="btn-login">Voir tous les événements</a>
    </div>
</div>

<div class="weekend-create-container">
    <div class="weekend-form-card">
        <div class="weekend-form-header">
            <h2>Informations de l'Événement</h2>
        </div>

        {{ form_start(form, {'attr': {'class': 'form-night-blue', 'id': 'evenement-form', 'enctype': 'multipart/form-data'}}) }}

            <div class="mb-4">
                {{ form_row(form.nom, {'attr': {'class': 'form-control', 'placeholder': 'Nom de l\'événement'}}) }}
            </div>

            <div class="mb-4">
                {{ form_row(form.weekend, {'attr': {'class': 'form-control'}}) }}
                <div id="weekend-day-choices" style="margin-top:0.75rem;"></div>
            </div>

            {# Champ date supprimé, remplacé par champ caché pour garder compatibilité #}
            <input type="hidden" id="evenement_date" name="evenement[date_debut]">

            <div class="form-row mb-4">
                <div class="form-col">
                    {{ form_row(form.heure_debut, {'attr': {'class': 'form-control', 'id': 'heure-debut'}}) }}
                </div>
                <div class="form-col">
                    <label class="form-label" style="font-weight: 600; color: #1f2937; margin-bottom: 0.5rem; display: block;">
                        Durée <span style="color: #dc2626;">*</span>
                    </label>
                    <div style="display: flex; gap: 0.5rem;">
                        {{ form_widget(form.duree_minutes, {'attr': {'class': 'form-control', 'id': 'duree-minutes', 'style': 'flex: 1;'}}) }}
                        <select id="unite-duree" class="form-control" style="width: 120px;">
                            <option value="minutes">Minutes</option>
                            <option value="heures">Heures</option>
                        </select>
                    </div>
                    {{ form_errors(form.duree_minutes) }}
                </div>
            </div>

            <div class="mb-4" id="recapitulatif-container" style="display: none; background-color: #f0f9ff; border: 2px solid #3b82f6; border-radius: 0.5rem; padding: 1rem;">
                <h3 style="color: #1e40af; font-size: 1.1rem; margin-bottom: 0.75rem; font-weight: 600;">
                    📅 Récapitulatif de l'événement
                </h3>
                <div style="display: grid; gap: 0.5rem;">
                    <div style="display: flex; justify-content: space-between;">
                        <span style="font-weight: 600; color: #374151;">Début :</span>
                        <span id="recap-debut" style="color: #059669; font-weight: 600;"></span>
                    </div>
                    <div style="display: flex; justify-content: space-between;">
                        <span style="font-weight: 600; color: #374151;">Fin :</span>
                        <span id="recap-fin" style="color: #dc2626; font-weight: 600;"></span>
                    </div>
                    <div style="display: flex; justify-content: space-between; padding-top: 0.5rem; border-top: 1px solid #bfdbfe;">
                        <span style="font-weight: 600; color: #374151;">Durée totale :</span>
                        <span id="recap-duree" style="color: #7c3aed; font-weight: 600;"></span>
                    </div>
                </div>
            </div>

            <div class="mb-4">
                {{ form_row(form.lieu, {'attr': {'class': 'form-control', 'placeholder': 'Lieu de l\'événement'}}) }}
            </div>

            <div class="mb-4">
                {{ form_row(form.description, {'attr': {'class': 'form-control', 'rows': 5, 'placeholder': 'Description de l\'événement...'}}) }}
            </div>

            <div class="mb-4">
                {{ form_label(form.imageFile) }}
                {{ form_widget(form.imageFile, {'attr': {'class': 'form-control', 'accept': 'image/*'}}) }}
                {{ form_errors(form.imageFile) }}
                <small class="text-muted">Formats acceptés : JPEG, PNG, GIF, WebP (max 5 Mo)</small>
                <div id="image-preview" class="mt-3" style="display: none;">
                    <img id="preview-img" src="" alt="Aperçu" style="max-width: 300px; max-height: 200px; border-radius: 8px; border: 2px solid #e5e7eb;">
                </div>
            </div>

            <div class="text-center mt-8">
                <button type="submit" class="btn-night-blue">Créer l'événement</button>
                <a href="{{ path('app_evenements') }}" class="btn-outline-night-blue ml-3">Annuler</a>
            </div>

            <div style="display: none;">
                {{ form_rest(form) }}
            </div>

        {{ form_end(form, {'render_rest': false}) }}
    </div>
</div>

<style>
.ml-3 { margin-left: 1rem; }
.text-muted { color: #6b7280; font-size: 0.875rem; margin-top: 0.25rem; display: block; }
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
.form-col { flex: 1; }
@media (max-width: 768px) { .form-row { grid-template-columns: 1fr; } }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const dateHiddenInput = document.getElementById('evenement_date');
    const heureDebutInput = document.querySelector('input[type="time"]');
    const dureeInput = document.querySelector('input[name*="duree_minutes"]');
    const uniteSelect = document.getElementById('unite-duree');
    const recapContainer = document.getElementById('recapitulatif-container');
    const recapDebut = document.getElementById('recap-debut');
    const recapFin = document.getElementById('recap-fin');
    const recapDuree = document.getElementById('recap-duree');

    function formatDateFr(date) {
        const jours = ['Dimanche', 'Lundi', 'Mardi', 'Mercredi', 'Jeudi', 'Vendredi', 'Samedi'];
        const mois = ['janvier', 'février', 'mars', 'avril', 'mai', 'juin', 'juillet', 'août', 'septembre', 'octobre', 'novembre', 'décembre'];
        return `${jours[date.getDay()]} ${date.getDate()} ${mois[date.getMonth()]} ${date.getFullYear()}`;
    }

    function formatHeure(date) {
        return `${String(date.getHours()).padStart(2, '0')}h${String(date.getMinutes()).padStart(2, '0')}`;
    }

    function getDureeEnMinutes() {
        const val = parseFloat(dureeInput.value);
        return isNaN(val) || val <= 0 ? 0 : (uniteSelect.value === 'heures' ? val * 60 : val);
    }

    function formatDuree(minutes) {
        const h = Math.floor(minutes / 60), m = minutes % 60;
        if (!h) return `${m} minute${m > 1 ? 's' : ''}`;
        if (!m) return `${h} heure${h > 1 ? 's' : ''}`;
        return `${h}h${String(m).padStart(2, '0')}`;
    }

    function calculerRecapitulatif() {
        if (!dateHiddenInput.value || !heureDebutInput.value || !dureeInput.value) return recapContainer.style.display = 'none';
        const [y, mo, d] = dateHiddenInput.value.split('-');
        const [h, mi] = heureDebutInput.value.split(':');
        const debut = new Date(y, mo - 1, d, h, mi);
        const fin = new Date(debut.getTime() + getDureeEnMinutes() * 60000);
        recapDebut.textContent = `${formatDateFr(debut)} à ${formatHeure(debut)}`;
        recapFin.textContent = `${formatDateFr(fin)} à ${formatHeure(fin)}`;
        recapDuree.textContent = formatDuree(getDureeEnMinutes());
        recapContainer.style.display = 'block';
    }

    [heureDebutInput, dureeInput, uniteSelect].forEach(el => {
        if (el) el.addEventListener('input', calculerRecapitulatif);
    });

    // Gestion des radios du week-end
    const weekendSelect = document.querySelector('select[name$="[weekend]"]');
    const weekendDayContainer = document.getElementById('weekend-day-choices');

    function clearWeekendDayChoices() {
        weekendDayContainer.innerHTML = '';
    }

    function createDayRadio(id, label, value, checked=false) {
        const wrapper = document.createElement('label');
        wrapper.style.display = 'inline-flex';
        wrapper.style.alignItems = 'center';
        wrapper.style.gap = '0.5rem';
        wrapper.style.marginRight = '0.75rem';
        wrapper.style.cursor = 'pointer';

        const input = document.createElement('input');
        input.type = 'radio';
        input.name = 'weekend_day_choice';
        input.value = value;
        input.id = id;
        if (checked) input.checked = true;

        const span = document.createElement('span');
        span.textContent = label;
        wrapper.appendChild(input);
        wrapper.appendChild(span);

        input.addEventListener('change', () => {
            if (input.checked) {
                dateHiddenInput.value = input.value;
                calculerRecapitulatif();
            }
        });

        return wrapper;
    }

    function onWeekendChange() {
        clearWeekendDayChoices();
        const opt = weekendSelect.selectedOptions[0];
        if (!opt) return;
        const jours = ['vendredi', 'samedi', 'dimanche'];
        jours.forEach(j => {
            const date = opt.dataset[j];
            if (date) {
                const label = j.charAt(0).toUpperCase() + j.slice(1) + ' ' + (new Date(date)).toLocaleDateString();
                weekendDayContainer.appendChild(createDayRadio('wd_' + j, label, date, weekendDayContainer.children.length === 0));
            }
        });
        const first = weekendDayContainer.querySelector('input[type="radio"]');
        if (first) {
            first.checked = true;
            dateHiddenInput.value = first.value;
            calculerRecapitulatif();
        }
    }

    if (weekendSelect) {
        weekendSelect.addEventListener('change', onWeekendChange);
        setTimeout(onWeekendChange, 100);
    }
});
</script>
{% endblock %}
