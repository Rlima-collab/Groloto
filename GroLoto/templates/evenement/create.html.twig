{% extends 'base.html.twig' %}

{% block title %}Créer un événement{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/modele.css') }}">
    <link rel="stylesheet" href="{{ asset('css/festival/festival-common.css') }}">
    <link rel="stylesheet" href="{{ asset('css/festival/festival-create.css') }}">
{% endblock %}

{% block body %}
<div class="hero-section weekend-hero">
    <div class="shine"></div>
    <div class="hero-content">
        <h1 class="hero-title">Créer un Événement</h1>
        <p class="hero-description">Planifiez un nouvel événement caritatif.</p>
        <a href="{{ path('app_evenements') }}" class="btn-login">Voir tous les événements</a>
    </div>
</div>

<div class="weekend-create-container">
    <div class="weekend-form-card">
        <div class="weekend-form-header">
            <h2>Informations de l'Événement</h2>
        </div>

        {{ form_start(form, {'attr': {'class': 'form-night-blue', 'id': 'evenement-form', 'enctype': 'multipart/form-data'}}) }}

            <div class="mb-4">
                {{ form_row(form.nom, {'attr': {'class': 'form-control', 'placeholder': 'Nom de l\'événement'}}) }}
            </div>

            <div class="mb-4">
                {{ form_row(form.weekend, {'attr': {'class': 'form-control'}}) }}
            </div>

            <div class="mb-4">
                {{ form_row(form.date_debut, {'attr': {'class': 'form-control'}}) }}
            </div>

            <div class="form-row mb-4">
                <div class="form-col">
                    {{ form_row(form.heure_debut, {'attr': {'class': 'form-control', 'id': 'heure-debut'}}) }}
                </div>
                <div class="form-col">
                    <label class="form-label" style="font-weight: 600; color: #1f2937; margin-bottom: 0.5rem; display: block;">
                        Durée <span style="color: #dc2626;">*</span>
                    </label>
                    <div style="display: flex; gap: 0.5rem;">
                        {{ form_widget(form.duree_minutes, {'attr': {'class': 'form-control', 'id': 'duree-minutes', 'style': 'flex: 1;'}}) }}
                        <select id="unite-duree" class="form-control" style="width: 120px;">
                            <option value="minutes">Minutes</option>
                            <option value="heures">Heures</option>
                        </select>
                    </div>
                    {{ form_errors(form.duree_minutes) }}
                </div>
            </div>

            <div class="mb-4">
                {{ form_row(form.lieu, {'attr': {'class': 'form-control', 'placeholder': 'Lieu de l\'événement'}}) }}
            </div>

            <div class="mb-4">
                {{ form_row(form.description, {'attr': {'class': 'form-control', 'rows': 5, 'placeholder': 'Description de l\'événement...'}}) }}
            </div>

            <div class="mb-4">
                {{ form_label(form.imageFile) }}
                {{ form_widget(form.imageFile, {'attr': {'class': 'form-control', 'accept': 'image/*'}}) }}
                {{ form_errors(form.imageFile) }}
                <small class="text-muted">Formats acceptés : JPEG, PNG, GIF, WebP (max 5 Mo)</small>
                <div id="image-preview" class="mt-3" style="display: none;">
                    <img id="preview-img" src="" alt="Aperçu" style="max-width: 300px; max-height: 200px; border-radius: 8px; border: 2px solid #e5e7eb;">
                </div>
            </div>

            <div class="text-center mt-8">
                <button type="submit" id="submit-button" class="btn-night-blue">Créer l'événement</button>
                <a href="{{ path('app_evenements') }}" class="btn-outline-night-blue ml-3">Annuler</a>
            </div>

            <div style="display: none;">
                {{ form_rest(form) }}
            </div>

        {{ form_end(form, {'render_rest': false}) }}
    </div>
</div>

<style>
.ml-3 { margin-left: 1rem; }
.text-muted { color: #6b7280; font-size: 0.875rem; margin-top: 0.25rem; display: block; }
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
.form-col { flex: 1; }
@media (max-width: 768px) { .form-row { grid-template-columns: 1fr; } }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const dureeInput = document.querySelector('input[name*="duree_minutes"]');
    const uniteSelect = document.getElementById('unite-duree');
    
    // Conversion automatique des heures en minutes lors de la soumission
    const form = document.getElementById('evenement-form');
    if (form) {
        form.addEventListener('submit', function() {
            if (uniteSelect.value === 'heures') {
                const val = parseFloat(dureeInput.value);
                if (!isNaN(val)) {
                    dureeInput.value = Math.round(val * 60);
                }
            }
});
</script>
{% endblock %}
