{% extends 'base.html.twig' %}

{% block title %}Liste des événements{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/modele.css') }}">
    <link rel="stylesheet" href="{{ asset('css/weekends_cards.css') }}">
    <link rel="stylesheet" href="{{ asset('css/festival/festival-common.css') }}">
{% endblock %}

{% block body %}
<!-- Hero Section -->
<div class="full-width-hero">
    <div class="hero-section weekend-hero">
        <div class="shine"></div>
        <div class="hero-content">
            <h1 class="hero-title">Gestion des Événements</h1>
            <p class="hero-description">Consultez et gérez tous les événements GroLoto</p>
            {% if isAdmin %}
                <a href="{{ path('app_evenements_create') }}" class="btn-login">Créer un événement</a>
            {% endif %}
        </div>
    </div>
</div>

<div class="weekends-container">
    <!-- Filtres -->
    <div class="filters-card">
        <form method="get" action="{{ path('app_evenements_liste') }}" id="filter-form">
            <div class="filters-grid">
                <div class="filter-group">
                    <label for="weekend-filter" class="filter-label">
                        <svg class="filter-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                        </svg>
                        Week-end
                    </label>
                    <select name="weekend" id="weekend-filter" class="filter-select" onchange="document.getElementById('filter-form').submit()">
                        <option value="all" {% if weekendFilter == 'all' %}selected{% endif %}>Tous les week-ends</option>
                        {% for weekend in weekends %}
                            <option value="{{ weekend.id }}" {% if weekendFilter == weekend.id ~ '' %}selected{% endif %}>
                                {{ weekend.nom }} ({{ weekend.dateDebut|date('d/m/Y') }})
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div class="filter-group">
                    <label for="statut-filter" class="filter-label">
                        <svg class="filter-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        Statut
                    </label>
                    <select name="statut" id="statut-filter" class="filter-select" onchange="document.getElementById('filter-form').submit()">
                        <option value="all" {% if statutFilter == 'all' %}selected{% endif %}>Tous</option>
                        <option value="futurs" {% if statutFilter == 'futurs' %}selected{% endif %}>À venir</option>
                        <option value="passes" {% if statutFilter == 'passes' %}selected{% endif %}>Passés</option>
                    </select>
                </div>
            </div>
        </form>
    </div>

    <!-- Résumé des résultats -->
    <div class="results-summary">
        <svg class="summary-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
        </svg>
        <span>{{ evenements|length }} événement{{ evenements|length > 1 ? 's' : '' }} trouvé{{ evenements|length > 1 ? 's' : '' }}</span>
    </div>

    <!-- Liste des événements -->
    {% if evenements|length > 0 %}
        <div class="weekends-grid">
            {% for evenement in evenements %}
                {% set isPasse = evenement.dateFin < date() %}
                <div class="weekend-card">
                    <!-- Image ou icône -->
                    <div class="weekend-card-image">
                        {% if evenement.image %}
                            <img src="{{ asset('images/evenements/' ~ evenement.image) }}" alt="{{ evenement.nom }}">
                        {% else %}
                            <i class="fas fa-calendar-alt"></i>
                        {% endif %}
                    </div>

                    <div class="weekend-card-body">
                        <h3 class="weekend-card-title">{{ evenement.nom }}</h3>
                        {% if evenement.description %}
                        <div class="weekend-card-description" style="margin-top:0.5rem;">
                            {{ evenement.description|striptags|slice(0,120) }}{% if evenement.description|length > 120 %}...{% endif %}
                        </div>
                        {% endif %}
                        
                        <div class="weekend-card-dates">
                            <i class="far fa-calendar"></i>
                            <span>Du {{ evenement.dateDebut|date('d/m/Y') }} au {{ evenement.dateFin|date('d/m/Y') }}</span>
                        </div>

                        {% if evenement.lieu %}
                        <div class="weekend-card-location" style="margin-bottom:0.75rem; color:#4b5563; font-weight:600;">
                            <i class="fas fa-map-marker-alt" style="margin-right:0.5rem;color:#1e3a5f;"></i>
                            {{ evenement.lieu }}
                        </div>
                        {% endif %}

                        <div class="weekend-card-info">
                            <div class="weekend-info-item">
                                <i class="far fa-calendar-check"></i>
                                <div class="value">{{ evenement.heureDebut ? evenement.heureDebut|date('H:i') : '-' }}</div>
                                <div class="label">Début</div>
                            </div>
                            <div class="weekend-info-item">
                                <i class="far fa-clock"></i>
                                <div class="value">
                                    {% if evenement.dureeMinutes %}
                                        {% set h = (evenement.dureeMinutes / 60)|round(0, 'floor') %}
                                        {% set m = evenement.dureeMinutes % 60 %}
                                        {% if h > 0 %}{{ h }}h{% endif %}{% if m > 0 %}{{ m }}m{% endif %}
                                    {% else %}
                                        -
                                    {% endif %}
                                </div>
                                <div class="label">Durée</div>
                            </div>
                        </div>
                    </div>

                    <div class="weekend-card-footer">
                        <div>
                            {% if isPasse %}
                                <span class="weekend-status past">Passé</span>
                            {% else %}
                                <span class="weekend-status upcoming">À venir</span>
                            {% endif %}
                        </div>
                        <div style="flex:1; display:flex; justify-content:flex-end; gap: 0.5rem;">
                            {% if isAdmin %}
                            <a href="{{ path('app_evenement_edit', {id: evenement.id}) }}" class="weekend-view-btn" title="Modifier">
                                <i class="fas fa-edit"></i>
                                Modifier
                            </a>
                            <form method="post" action="{{ path('app_evenement_delete', {'id': evenement.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet événement ?');" style="display: inline-block;">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ evenement.id) }}">
                                <button class="weekend-view-btn danger" title="Supprimer">
                                    <i class="fas fa-trash"></i>
                                    Supprimer
                                </button>
                            </form>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="empty-state">
            <svg class="empty-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            <h3>Aucun événement trouvé</h3>
            <p>Essayez de modifier les filtres ou créez un nouvel événement.</p>
            {% if isAdmin %}
            <a href="{{ path('app_evenements_create') }}" class="btn-login">
                Créer un événement
            </a>
            {% endif %}
        </div>
    {% endif %}
</div>

<link rel="stylesheet" href="{{ asset('css/evenements.css') }}">
{% endblock %}
