{% extends 'base.html.twig' %}

{% block title %}Événements - {{ weekend.nom }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/modele.css') }}">
    <link rel="stylesheet" href="{{ asset('css/benevoles/benevoles-common.css') }}">
    <link rel="stylesheet" href="{{ asset('css/benevoles/benevoles-list.css') }}">
    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.css" rel="stylesheet">
{% endblock %}

{% block body %}
<div class="hero-section benevoles-hero">
    <div class="shine"></div>
    <div class="hero-content">
        <h1 class="hero-title">{{ weekend.nom }}</h1>
        <p class="hero-description">
            <i class="bi bi-calendar-event"></i>
            Du {{ weekend.dateDebut|date('d/m/Y') }} au {{ weekend.dateFin|date('d/m/Y') }}
        </p>
        <div style="display: flex; gap: 1rem; justify-content: center; margin-top: 1rem;">
            <a href="{{ path('app_evenements') }}" class="btn-login">
                <i class="bi bi-arrow-left"></i> Retour aux weekends
            </a>
            <a href="{{ path('app_evenements_weekend_pdf', {id: weekend.id}) }}" class="btn-download">
                <i class="bi bi-download"></i> Télécharger en PDF
            </a>
        </div>
    </div>
</div>

<div class="container">
    <div class="view-toggle" style="text-align: center; margin-bottom: 1.5rem;">
        <button class="btn-view active" id="btn-calendar" onclick="switchView('calendar')">
            <i class="bi bi-calendar-week"></i> Vue Calendrier
        </button>
        <button class="btn-view" id="btn-timeline" onclick="switchView('timeline')">
            <i class="bi bi-list-ul"></i> Vue Timeline
        </button>
    </div>

    <div class="card">
        <div class="card-header">
            <h5 class="card-title">Événements - {{ evenements|length }} événement{{ evenements|length > 1 ? 's' : '' }}</h5>
        </div>
        <div class="card-content">
            {% if weekend.description %}
                <div class="weekend-info">
                    <h6><i class="bi bi-info-circle"></i> Description du weekend</h6>
                    <p>{{ weekend.description|nl2br }}</p>
                </div>
            {% endif %}

            {# Vue Calendrier #}
            <div id="calendar-view" style="display: block;">
                <div id="calendar"></div>
            </div>

            {# Vue Timeline #}
            <div id="timeline-view" style="display: none;">
                <div class="planning-timeline">
                {% set currentDate = null %}
                {% for evenement in evenements %}
                    {% set evenementDate = evenement.dateDebut|date('Y-m-d') %}
                    {% if currentDate != evenementDate %}
                        {% set currentDate = evenementDate %}
                        <div class="date-separator">
                            <span class="date-badge">
                                {{ evenement.dateDebut|date('l d F Y')|capitalize }}
                            </span>
                        </div>
                    {% endif %}

                    <div class="tache-item">
                        <div class="tache-time">
                            <div class="time-badge">
                                <i class="bi bi-clock"></i>
                                {% if evenement.heureDebut %}
                                    {{ evenement.heureDebut|date('H:i') }}
                                {% else %}
                                    --:--
                                {% endif %}
                            </div>
                            <div class="time-line"></div>
                        </div>
                        <div class="tache-content">
                            <div class="tache-card">
                                <h4 class="tache-title">{{ evenement.nom }}</h4>
                                <div class="tache-details">
                                    <span class="detail-item">
                                        <i class="bi bi-hourglass-split"></i>
                                        {% if evenement.heureDebut %}
                                            {{ evenement.heureDebut|date('H:i') }}
                                            {% if evenement.heureFin %}
                                                - {{ evenement.heureFin|date('H:i') }}
                                                <small>({{ ((evenement.heureFin.timestamp - evenement.heureDebut.timestamp) / 60)|number_format(0) }}min)</small>
                                            {% endif %}
                                        {% else %}
                                            Horaire non spécifié
                                        {% endif %}
                                    </span>
                                    {% if evenement.lieu %}
                                        <span class="detail-item">
                                            <i class="bi bi-geo-alt"></i>
                                            {{ evenement.lieu }}
                                        </span>
                                    {% endif %}
                                </div>
                                {% if evenement.description %}
                                    <div class="tache-remarque">
                                        <i class="bi bi-chat-left-text"></i>
                                        <span>{{ evenement.description }}</span>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
            </div>

            <div class="planning-summary">
                <h6>Résumé</h6>
                <div class="summary-stats">
                    <div class="stat-item">
                        <i class="bi bi-list-check"></i>
                        <span>{{ evenements|length }} événement{{ evenements|length > 1 ? 's' : '' }}</span>
                    </div>
                    {% set totalMinutes = 0 %}
                    {% for evenement in evenements %}
                        {% if evenement.heureFin %}
                            {% set totalMinutes = totalMinutes + ((evenement.heureFin.timestamp - evenement.heureDebut.timestamp) / 60) %}
                        {% endif %}
                    {% endfor %}
                    {% if totalMinutes > 0 %}
                        <div class="stat-item">
                            <i class="bi bi-hourglass"></i>
                            <span>{% if totalMinutes >= 60 %}{{ (totalMinutes / 60)|number_format(1) }}h{% else %}{{ totalMinutes|number_format(0) }}min{% endif %} au total</span>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="{{ asset('css/evenements.css') }}">

<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.js"></script>
<script>
// Calculer la date de début et de fin pour le calendrier
let calendarStart, calendarEnd;

// Préparer les événements pour FullCalendar
const events = [
    {% for evenement in evenements %}
    {
        id: {{ evenement.id }},
        title: '{{ evenement.nom|e('js') }}',
        start: '{{ evenement.dateDebut|date('Y-m-d') }}T{% if evenement.heureDebut %}{{ evenement.heureDebut|date('H:i:s') }}{% else %}10:00:00{% endif %}',
        durationMinutes: {{ evenement.dureeMinutes|default(60) }},
        backgroundColor: '#10b981',
        borderColor: '#059669',
        extendedProps: {
            lieu: '{{ evenement.lieu|default('')|e('js') }}',
            description: '{{ evenement.description|default('')|e('js') }}'
        }
    }{{ not loop.last ? ',' : '' }}
    {% endfor %}
];

// Calculer dynamiquement la fin des événements (gère le passage à minuit)
const eventsWithEnd = events.map(e => {
    try {
        const startDate = new Date(e.start);
        const minutes = (typeof e.durationMinutes === 'number' && e.durationMinutes > 0) ? e.durationMinutes : 60;
        const endDate = new Date(startDate.getTime() + minutes * 60000);
        // FullCalendar accepte ISO sans timezone; on coupe à yyyy-MM-ddTHH:mm:ss
        const endStr = endDate.toISOString().slice(0,19);
        return { ...e, end: endStr };
    } catch (_) {
        return e;
    }
});

// Calculer la date de début (premier événement ou début du weekend)
const weekendStart = new Date('{{ weekend.dateDebut|date('Y-m-d') }}');
const weekendEnd = new Date('{{ weekend.dateFin|date('Y-m-d') }}');

if (events.length > 0) {
    const firstEventDate = new Date(events[0].start);
    const lastEventDate = new Date(events[events.length - 1].end);
    
    // Prendre la date la plus précoce entre le premier événement et le début du weekend
    calendarStart = firstEventDate < weekendStart ? firstEventDate : weekendStart;
    
    // Prendre la date la plus tardive entre le dernier événement et la fin du weekend
    calendarEnd = lastEventDate > weekendEnd ? lastEventDate : weekendEnd;
} else {
    calendarStart = weekendStart;
    calendarEnd = weekendEnd;
}

// Initialiser FullCalendar
document.addEventListener('DOMContentLoaded', function() {
    const calendarEl = document.getElementById('calendar');
    
    if (calendarEl && typeof FullCalendar !== 'undefined') {
        const calendar = new FullCalendar.Calendar(calendarEl, {
            initialView: 'timeGridWeek',
            locale: 'fr',
            height: 'auto',
            initialDate: calendarStart,
            validRange: {
                start: calendarStart,
                end: new Date(calendarEnd.getTime() + 24 * 60 * 60 * 1000) // +1 jour
            },
            headerToolbar: {
                left: 'prev,next',
                center: 'title',
                right: ''
            },
            buttonText: {
                today: 'Aujourd\'hui'
            },
            slotMinTime: '00:00:00',
            slotMaxTime: '24:00:00',
            allDaySlot: false,
            nowIndicator: true,
            dayHeaderFormat: { weekday: 'long', day: 'numeric', month: 'long' },
            events: eventsWithEnd,
            eventClick: function(info) {
                const props = info.event.extendedProps;
                let details = info.event.title + '\n\n';
                details += '🕐 ' + info.event.start.toLocaleString('fr-FR') + '\n';
                details += '   → ' + info.event.end.toLocaleString('fr-FR') + '\n';
                
                const duration = (info.event.end - info.event.start) / (1000 * 60 * 60);
                details += '⏱️  Durée: ' + duration.toFixed(1) + 'h\n';
                
                if (props.lieu) details += '\n📍 Lieu: ' + props.lieu;
                if (props.description) details += '\n\n💬 ' + props.description;
                
                alert(details);
            },
            eventContent: function(arg) {
                return {
                    html: '<div style="padding: 2px 4px; font-size: 0.85rem;">' +
                          '<strong>' + arg.event.title + '</strong><br>' +
                          '<small>' + arg.timeText + '</small>' +
                          (arg.event.extendedProps.lieu ? '<br><small>📍 ' + arg.event.extendedProps.lieu + '</small>' : '') +
                          '</div>'
                };
            },
            firstDay: 1 // Lundi en premier
        });
        
        calendar.render();
        window.calendarInstance = calendar;
    }
});

function switchView(view) {
    const calendarView = document.getElementById('calendar-view');
    const timelineView = document.getElementById('timeline-view');
    const btnCalendar = document.getElementById('btn-calendar');
    const btnTimeline = document.getElementById('btn-timeline');
    
    if (view === 'calendar') {
        calendarView.style.display = 'block';
        timelineView.style.display = 'none';
        btnCalendar.classList.add('active');
        btnTimeline.classList.remove('active');
        
        // Forcer le re-render du calendrier
        if (window.calendarInstance) {
            setTimeout(() => window.calendarInstance.updateSize(), 100);
        }
    } else {
        calendarView.style.display = 'none';
        timelineView.style.display = 'block';
        btnCalendar.classList.remove('active');
        btnTimeline.classList.add('active');
    }
}
</script>

{% endblock %}
