<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Planning Événements - {{ weekend.nom }}</title>
    <style>
        @page {
            margin: 16mm 14mm;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            font-size: 11px;
            color: #1e293b;
            line-height: 1.4;
        }

        .header {
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
            color: white;
            padding: 16px;
            margin-bottom: 12px;
            border-radius: 8px;
        }

        .header h1 {
            font-size: 20px;
            font-weight: bold;
            margin-bottom: 6px;
        }

        .header-info {
            font-size: 11px;
            opacity: 0.9;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .info-group {
            display: inline-block;
        }

        .info-label {
            font-weight: 600;
            margin-right: 4px;
        }

        .description-box {
            background: #f8fafc;
            border-left: 4px solid #2563eb;
            padding: 12px;
            margin-bottom: 12px;
            border-radius: 4px;
        }

        .description-box p {
            color: #475569;
            line-height: 1.5;
        }

        .date-section {
            margin-bottom: 14px;
            page-break-inside: avoid;
        }

        .date-header {
            background: #0f172a;
            color: white;
            padding: 8px 12px;
            font-weight: bold;
            font-size: 12px;
            border-radius: 6px;
            margin-bottom: 8px;
        }

        .evenement-card {
            background: white;
            border: 2px solid #e2e8f0;
            border-radius: 8px;
            padding: 12px;
            margin-bottom: 8px;
            page-break-inside: avoid;
        }

        .evenement-card:hover {
            border-color: #cbd5e1;
        }

        .evenement-title {
            font-size: 13px;
            font-weight: bold;
            color: #0f172a;
            margin-bottom: 6px;
        }

        .evenement-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-bottom: 6px;
        }

        .meta-item {
            font-size: 10px;
            color: #64748b;
        }

        .meta-label {
            font-weight: 600;
            color: #475569;
        }

        .evenement-description {
            color: #475569;
            font-size: 10px;
            line-height: 1.5;
            margin-top: 6px;
            padding-top: 6px;
            border-top: 1px solid #e2e8f0;
        }

        .type-badge {
            display: inline-block;
            background: #f1f5f9;
            border: 1px solid #cbd5e1;
            padding: 3px 8px;
            border-radius: 4px;
            font-size: 9px;
            font-weight: 600;
            color: #475569;
            margin-top: 6px;
        }

        .summary-box {
            background: #f8fafc;
            border: 2px solid #e2e8f0;
            border-radius: 8px;
            padding: 12px;
            margin-top: 12px;
            page-break-inside: avoid;
        }

        .summary-title {
            font-size: 12px;
            font-weight: bold;
            color: #0f172a;
            margin-bottom: 6px;
        }

        .summary-content {
            color: #475569;
            font-size: 10px;
        }

        .footer {
            position: fixed;
            bottom: 8mm;
            left: 14mm;
            right: 14mm;
            text-align: center;
            font-size: 9px;
            color: #94a3b8;
            border-top: 1px solid #e2e8f0;
            padding-top: 6px;
        }

        .no-events {
            text-align: center;
            padding: 24px;
            color: #64748b;
        }

        .benevoles-list {
            margin-top: 8px;
            padding: 8px;
            background: #f8fafc;
            border-radius: 4px;
        }

        .benevoles-title {
            font-size: 10px;
            font-weight: bold;
            color: #0f172a;
            margin-bottom: 4px;
        }

        .benevole-item {
            display: inline-block;
            background: #dcfce7;
            color: #166534;
            padding: 3px 10px;
            border-radius: 12px;
            font-size: 9px;
            margin: 3px 4px 3px 0;
        }

        .benevole-item.confirme {
            background: #dbeafe;
            color: #1e40af;
        }

        .benevole-horaire {
            font-size: 8px;
            opacity: 0.8;
            margin-left: 4px;
        }

        .item-type-tache {
            border-left: 4px solid #2563eb;
        }

        .item-type-evenement {
            border-left: 4px solid #7c3aed;
        }

        .type-badge {
            display: inline-block;
            padding: 2px 6px;
            border-radius: 4px;
            font-size: 8px;
            font-weight: bold;
            margin-left: 8px;
        }

        .type-badge.tache {
            background: #dbeafe;
            color: #1e40af;
        }

        .type-badge.evenement {
            background: #f3e8ff;
            color: #7c3aed;
        }

        .legend-box {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 6px;
            padding: 10px 14px;
            margin-bottom: 16px;
            font-size: 9px;
        }

        .legend-title {
            font-weight: bold;
            color: #0f172a;
            margin-bottom: 6px;
            font-size: 10px;
        }

        .legend-items {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
        }

        .legend-item {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .legend-color {
            width: 14px;
            height: 14px;
            border-radius: 4px;
            display: inline-block;
        }

        .legend-color.tache {
            background: #2563eb;
        }

        .legend-color.evenement {
            background: #7c3aed;
        }

        .legend-color.confirme {
            background: #dbeafe;
            border: 1px solid #1e40af;
        }

        .legend-color.assigne {
            background: #dcfce7;
            border: 1px solid #166534;
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>{{ weekend.nom }}</h1>
        <div class="header-info">
            <div class="info-group">
                <span class="info-label">Période:</span>
                <span>{{ weekend.dateDebut|date('d/m/Y') }} - {{ weekend.dateFin|date('d/m/Y') }}</span>
            </div>
            <div class="info-group">
                <span class="info-label">Événements:</span>
                <span>{{ evenements|length }}</span>
            </div>
        </div>
    </div>

    {% if weekend.description %}
        <div class="description-box">
            <p>{{ weekend.description }}</p>
        </div>
    {% endif %}

    <div class="legend-box">
        <div class="legend-title">Légende des couleurs</div>
        <div class="legend-items">
            <div class="legend-item">
                <span class="legend-color tache"></span>
                <span>Tâche</span>
            </div>
            <div class="legend-item">
                <span class="legend-color evenement"></span>
                <span>Événement</span>
            </div>
            <div class="legend-item">
                <span class="legend-color confirme"></span>
                <span>Bénévole demandé (en attente)</span>
            </div>
            <div class="legend-item">
                <span class="legend-color assigne"></span>
                <span>Bénévole confirmé</span>
            </div>
        </div>
    </div>

    {% if planningParJour is defined and planningParJour|length > 0 %}
        {% for jour, dayData in planningParJour %}
            <div class="date-section">
                <div class="date-header">
                    {{ dayData.jourNom }} {{ dayData.date }}
                </div>

                {% for item in dayData.items %}
                    <div class="evenement-card item-type-{{ item.type }}">
                        <div class="evenement-title">
                            {{ item.titre }}
                            <span class="type-badge {{ item.type }}">{{ item.type == 'tache' ? 'Tâche' : 'Événement' }}</span>
                        </div>
                        
                        <div class="evenement-meta">
                            <span class="meta-item">
                                <span class="meta-label">Horaire:</span>
                                {{ item.horaire }}
                            </span>
                            
                            {% if item.lieu %}
                                <span class="meta-item">
                                    <span class="meta-label">{{ item.type == 'tache' ? 'Poste:' : 'Lieu:' }}</span>
                                    {{ item.lieu }}
                                </span>
                            {% endif %}
                            
                            {% if item.maxPersonnes is defined and item.maxPersonnes %}
                                <span class="meta-item">
                                    <span class="meta-label">Effectif:</span>
                                    {{ item.benevoles|length }}/{{ item.maxPersonnes }}
                                </span>
                            {% endif %}
                        </div>

                        {% if item.description %}
                            <div class="evenement-description">
                                {{ item.description }}
                            </div>
                        {% endif %}

                        {% if item.benevoles|length > 0 %}
                            <div class="benevoles-list">
                                <div class="benevoles-title">Bénévoles assignés ({{ item.benevoles|length }}):</div>
                                {% for benevole in item.benevoles %}
                                    <span class="benevole-item {{ benevole.statut }}">{{ benevole.nom }}{% if benevole.horaire %}<span class="benevole-horaire">({{ benevole.horaire }})</span>{% endif %}</span>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        {% endfor %}

        <div class="summary-box">
            <div class="summary-title">Résumé</div>
            <div class="summary-content">
                {% set totalItems = 0 %}
                {% for jour, dayData in planningParJour %}
                    {% set totalItems = totalItems + dayData.items|length %}
                {% endfor %}
                Ce planning comprend <strong>{{ totalItems }} activité{{ totalItems > 1 ? 's' : '' }}</strong>
                pour le weekend du {{ weekend.dateDebut|date('d/m/Y') }} au {{ weekend.dateFin|date('d/m/Y') }}.
            </div>
        </div>
    {% else %}
        <div class="no-events">
            <p>Aucun événement ou tâche n'est prévu pour ce weekend.</p>
        </div>
    {% endif %}

    <div class="footer">
        Planning généré le {{ "now"|date('d/m/Y à H\\hi') }}
    </div>
</body>
</html>
