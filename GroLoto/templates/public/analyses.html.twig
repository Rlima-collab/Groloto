{% extends 'base.html.twig' %}

{% block title %}Analyses & Statistiques{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/public/public-common.css') }}">
    <link rel="stylesheet" href="{{ asset('css/stocks/stocks-list.css') }}">
    <style>
        .charts-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 25px;
            margin-bottom: 30px;
        }
        
        @media (max-width: 992px) {
            .charts-grid {
                grid-template-columns: 1fr;
            }
        }
        
        .chart-card {
            background: white;
            border-radius: 15px;
            padding: 25px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
            transition: transform 0.3s ease;
        }
        
        .chart-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.12);
        }
        
        .chart-card h3 {
            color: #1a1f3a;
            font-size: 1.4rem;
            margin-bottom: 8px;
            font-weight: 700;
        }
        
        .chart-card p {
            color: #6c757d;
            font-size: 0.95rem;
            margin-bottom: 20px;
        }
        
        .chart-wrapper {
            height: 250px;
            position: relative;
        }
        
        .chart-wrapper canvas {
            max-height: 300px !important;
        }
        
        .chart-legend {
            margin-top: 15px;
            padding-top: 15px;
            border-top: 1px solid #e9ecef;
            display: flex;
            flex-wrap: wrap;
            gap: 15px;
        }
        
        .legend-item {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.9rem;
            color: #495057;
        }
        
        .legend-color {
            width: 16px;
            height: 16px;
            border-radius: 4px;
        }
        
        .insights-section {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 15px;
            padding: 30px;
            color: white;
            margin-bottom: 30px;
        }
        
        .insights-section h3 {
            font-size: 1.5rem;
            margin-bottom: 20px;
            font-weight: 700;
        }
        
        .insights-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
        }
        
        .insight-card {
            background: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(10px);
            border-radius: 12px;
            padding: 20px;
            border: 1px solid rgba(255, 255, 255, 0.2);
        }
        
        .insight-label {
            font-size: 0.9rem;
            opacity: 0.9;
            margin-bottom: 5px;
        }
        
        .insight-value {
            font-size: 1.8rem;
            font-weight: 700;
        }
    </style>
{% endblock %}

{% block body %}
<div class="container-fluid">
    <!-- Hero Section -->
    <div class="hero-section public-hero">
        <div class="hero-content">
            <div class="hero-text">
                <h1 class="hero-title">Analyses & Statistiques</h1>
                <p class="hero-description">Visualisez les tendances et suivez l'évolution de vos participants</p>
            </div>
        </div>
    </div>
    <br>

    <!-- Metrics Grid -->
    <div class="metrics-grid">
        <div class="metric-card">
            <div class="metric-value">{{ total_inscrits }}</div>
            <div class="metric-label">Total Participants</div>
        </div>
        <div class="metric-card">
            <div class="metric-value">+{{ nouveaux }}</div>
            <div class="metric-label">Nouveaux ce mois</div>
        </div>
        <div class="metric-card">
            <div class="metric-value">{{ revenus|number_format(2, ',', ' ') }} €</div>
            <div class="metric-label">Revenus Générés</div>
        </div>
        <div class="metric-card">
            <div class="metric-value">{{ fideles }}</div>
            <div class="metric-label">Participants Fidèles</div>
        </div>
    </div>

    <!-- Insights Section -->
    <div class="insights-section">
        <h3>Insights Clés</h3>
        <div class="insights-grid">
            <div class="insight-card">
                <div class="insight-label">Taux de croissance</div>
                <div class="insight-value">
                    {% if total_inscrits > 0 and nouveaux > 0 %}
                        +{{ ((nouveaux / total_inscrits) * 100)|number_format(1) }}%
                    {% else %}
                        0%
                    {% endif %}
                </div>
            </div>
            <div class="insight-card">
                <div class="insight-label">Taux de fidélisation</div>
                <div class="insight-value">
                    {% if total_inscrits > 0 %}
                        {{ ((fideles / total_inscrits) * 100)|number_format(1) }}%
                    {% else %}
                        0%
                    {% endif %}
                </div>
            </div>
            <div class="insight-card">
                <div class="insight-label">Revenu moyen par participant</div>
                <div class="insight-value">
                    {% if total_inscrits > 0 %}
                        {{ (revenus / total_inscrits)|number_format(2) }} €
                    {% else %}
                        0 €
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Grid -->
    <div class="charts-grid">
        <!-- Évolution des inscriptions -->
        <div class="chart-card">
            <h3>Évolution des Inscriptions</h3>
            <p>Nombre d'inscriptions par mois sur les 12 derniers mois</p>
            <div class="chart-wrapper">
                <canvas id="inscriptionsChart"></canvas>
            </div>
            <div class="chart-legend">
                <div class="legend-item">
                    <div class="legend-color" style="background: #006909;"></div>
                    <span><strong>{{ total_inscrits }}</strong> participants au total</span>
                </div>
                <div class="legend-item">
                    <div class="legend-color" style="background: #28a745;"></div>
                    <span><strong>{{ nouveaux }}</strong> nouveaux ce mois</span>
                </div>
            </div>
        </div>

        <!-- Répartition par rôle -->
        <div class="chart-card">
            <h3>Répartition par Rôle</h3>
            <p>Distribution des participants selon leur type</p>
            <div class="chart-wrapper">
                <canvas id="rolesChart"></canvas>
            </div>
            <div class="chart-legend">
                {% for role in analytics.repartition_roles %}
                <div class="legend-item">
                    <div class="legend-color" style="background: {{ role.couleur }};"></div>
                    <span><strong>{{ role.count }}</strong> {{ role.nom }}</span>
                </div>
                {% endfor %}
            </div>
        </div>

        <!-- Taux de fidélité -->
        <div class="chart-card">
            <h3>Analyse de Fidélité</h3>
            <p>Répartition des participants selon leur ancienneté</p>
            <div class="chart-wrapper">
                <canvas id="fideliteChart"></canvas>
            </div>
            <div class="chart-legend">
                <div class="legend-item">
                    <div class="legend-color" style="background: #ffc107;"></div>
                    <span>Nouveaux (moins de 6 mois)</span>
                </div>
                <div class="legend-item">
                    <div class="legend-color" style="background: #17a2b8;"></div>
                    <span>Réguliers (6-12 mois)</span>
                </div>
                <div class="legend-item">
                    <div class="legend-color" style="background: #28a745;"></div>
                    <span>Fidèles (plus d'1 an)</span>
                </div>
            </div>
        </div>

        <!-- Sources d'inscription -->
        <div class="chart-card">
            <h3>Sources d'Inscription</h3>
            <p>Origine des nouvelles inscriptions</p>
            <div class="chart-wrapper">
                <canvas id="sourcesChart"></canvas>
            </div>
            <div class="chart-legend">
                <div class="legend-item">
                    <div class="legend-color" style="background: #007BFF;"></div>
                    <span>HelloAsso - 65%</span>
                </div>
                <div class="legend-item">
                    <div class="legend-color" style="background: #28A745;"></div>
                    <span>Site web - 25%</span>
                </div>
                <div class="legend-item">
                    <div class="legend-color" style="background: #FFC107;"></div>
                    <span>Réseaux sociaux - 10%</span>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Graphique des inscriptions (ligne)
            const inscriptionsCtx = document.getElementById('inscriptionsChart');
            if (inscriptionsCtx) {
                new Chart(inscriptionsCtx, {
                    type: 'line',
                    data: {
                        labels: {{ analytics.evolution_inscriptions.mois|json_encode|raw }},
                        datasets: [{
                            label: 'Inscriptions',
                            data: {{ analytics.evolution_inscriptions.donnees|json_encode|raw }},
                            borderColor: '#006909',
                            backgroundColor: 'rgba(0, 105, 9, 0.1)',
                            tension: 0.4,
                            fill: true,
                            pointBackgroundColor: '#006909',
                            pointBorderColor: '#fff',
                            pointBorderWidth: 2,
                            pointRadius: 4,
                            pointHoverRadius: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                display: false
                            },
                            tooltip: {
                                backgroundColor: 'rgba(0, 0, 0, 0.8)',
                                padding: 12,
                                titleFont: { size: 14 },
                                bodyFont: { size: 13 }
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                grid: {
                                    color: 'rgba(0, 0, 0, 0.05)'
                                }
                            },
                            x: {
                                grid: {
                                    display: false
                                }
                            }
                        }
                    }
                });
            }
            
            // Graphique des rôles (doughnut)
            const rolesCtx = document.getElementById('rolesChart');
            if (rolesCtx) {
                const rolesData = {{ analytics.repartition_roles|json_encode|raw }};
                new Chart(rolesCtx, {
                    type: 'doughnut',
                    data: {
                        labels: rolesData.map(role => role.nom),
                        datasets: [{
                            data: rolesData.map(role => role.count),
                            backgroundColor: rolesData.map(role => role.couleur),
                            borderWidth: 2,
                            borderColor: '#fff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                display: false
                            },
                            tooltip: {
                                backgroundColor: 'rgba(0, 0, 0, 0.8)',
                                padding: 12,
                                callbacks: {
                                    label: function(context) {
                                        const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                        const percentage = ((context.parsed / total) * 100).toFixed(1);
                                        return `${context.label}: ${context.parsed} (${percentage}%)`;
                                    }
                                }
                            }
                        }
                    }
                });
            }
            
            // Graphique de fidélité (barres)
            const fideliteCtx = document.getElementById('fideliteChart');
            if (fideliteCtx) {
                // Calculer la répartition réelle
                const nouveaux = {{ total_inscrits - fideles }};
                const reguliers = Math.floor(nouveaux * 0.6); // Estimation: 60% des non-fidèles sont réguliers
                const vraimentNouveaux = nouveaux - reguliers;
                
                new Chart(fideliteCtx, {
                    type: 'bar',
                    data: {
                        labels: ['Nouveaux', 'Réguliers', 'Fidèles'],
                        datasets: [{
                            data: [vraimentNouveaux, reguliers, {{ fideles }}],
                            backgroundColor: ['#ffc107', '#17a2b8', '#28a745'],
                            borderRadius: 8,
                            borderSkipped: false
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                display: false
                            },
                            tooltip: {
                                backgroundColor: 'rgba(0, 0, 0, 0.8)',
                                padding: 12,
                                callbacks: {
                                    label: function(context) {
                                        const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                        const percentage = ((context.parsed.y / total) * 100).toFixed(1);
                                        return `${context.parsed.y} participants (${percentage}%)`;
                                    }
                                }
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                grid: {
                                    color: 'rgba(0, 0, 0, 0.05)'
                                }
                            },
                            x: {
                                grid: {
                                    display: false
                                }
                            }
                        }
                    }
                });
            }
            
            // Graphique des sources (pie)
            const sourcesCtx = document.getElementById('sourcesChart');
            if (sourcesCtx) {
                new Chart(sourcesCtx, {
                    type: 'pie',
                    data: {
                        labels: ['HelloAsso', 'Site web', 'Réseaux sociaux'],
                        datasets: [{
                            data: [65, 25, 10],
                            backgroundColor: ['#007BFF', '#28A745', '#FFC107'],
                            borderWidth: 2,
                            borderColor: '#fff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                display: false
                            },
                            tooltip: {
                                backgroundColor: 'rgba(0, 0, 0, 0.8)',
                                padding: 12,
                                callbacks: {
                                    label: function(context) {
                                        return `${context.label}: ${context.parsed}%`;
                                    }
                                }
                            }
                        }
                    }
                });
            }
        });
    </script>
{% endblock %}
