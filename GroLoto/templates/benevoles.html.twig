{% extends 'base.html.twig' %}

{% block title %}Gestion des Bénévoles{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/modele.css') }}">
    <link rel="stylesheet" href="{{ asset('css/benevoles.css') }}">
    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.css" rel="stylesheet">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}

{% block body %}
<div class="hero-section">
    <div class="shine"></div>
    <div class="hero-content">
        <h1 class="hero-title">Gestion des Bénévoles</h1>
        <p class="hero-description">Inscriptions, disponibilités et planning pour vos événements caritatifs.</p>
        <a href="#liste-benevoles" class="hero-btn yellow">Voir les bénévoles</a>
    </div>
</div>

<div class="page-header">
    <h1 class="page-title">Bénévoles & Planning</h1>
</div>

<div class="benevoles-page">

<!-- Key Metrics Cards -->
<div class="metrics-grid">
    <div class="card metric-card">
        <div class="card-header">
            <span class="metric-title">Total bénévoles</span>
        </div>
        <div class="card-content">
            <div class="metric-value">{{ metriques.total }}</div>
            <p class="metric-change positive">Bénévoles actifs</p>
        </div>
    </div>

    <div class="card metric-card">
        <div class="card-header">
            <span class="metric-title">Nouveaux ce mois</span>
        </div>
        <div class="card-content">
            <div class="metric-value">{{ metriques.nouveaux }}</div>
            <p class="metric-change positive">Inscriptions récentes</p>
        </div>
    </div>

    <div class="card metric-card">
        <div class="card-header">
            <span class="metric-title">Disponibles</span>
        </div>
        <div class="card-content">
            <div class="metric-value">{{ metriques.disponibles }}</div>
            <p class="metric-change positive">Prêts à aider</p>
        </div>
    </div>
</div>

<div class="container">
    
    <div class="tabs">
        <a href="#" class="tab" id="tab-benevoles" onclick="showTab('benevoles')">
            <span class="tab-icon">👥</span>
            <span class="tab-text">Liste des bénévoles</span>
        </a>
        <a href="#" class="tab" id="tab-planning" onclick="showTab('planning')">
            <span class="tab-icon">📅</span>
            <span class="tab-text">Planning</span>
        </a>
    </div>
    
    <!-- Liste des bénévoles -->
    <div id="content-benevoles" class="tab-content main-content">
        <div class="card main-card" id="liste-benevoles">
            <div class="card-header">
                <h2 class="card-title">Liste des Bénévoles</h2>
                <p class="card-description">Gestion des bénévoles inscrits</p>
            </div>
            <div class="card-content">
                {% if benevoles|length > 0 %}
                    <div class="benevoles-grid">
                        {% for benevole in benevoles %}
                            <div class="benevole-card">
                                <div class="benevole-header">
                                    <h3 class="benevole-name">
                                        {{ benevole.utilisateur.prenom }} {{ benevole.utilisateur.nom }}
                                    </h3>
                                    <span class="badge status success">Actif</span>
                                </div>
                                
                                <div class="benevole-info">
                                    <div class="info-item">
                                        <span class="info-icon">✉️</span>
                                        <span class="info-text">{{ benevole.utilisateur.email }}</span>
                                    </div>
                                    {% if benevole.utilisateur.telephone %}
                                    <div class="info-item">
                                        <span class="info-icon">📞</span>
                                        <span class="info-text">{{ benevole.utilisateur.telephone }}</span>
                                    </div>
                                    {% endif %}
                                    <div class="info-item">
                                        <span class="info-icon">📅</span>
                                        <span class="info-text">Inscrit le {{ benevole.utilisateur.dateCreation|date('d/m/Y') }}</span>
                                    </div>
                                </div>

                                {% if benevole.remarque %}
                                <div class="benevole-notes">
                                    <strong>Notes:</strong> {{ benevole.remarque|slice(0, 50) }}{% if benevole.remarque|length > 50 %}...{% endif %}
                                </div>
                                {% endif %}
                                
                                {% if is_granted('ROLE_ADMIN') %}
                                <div class="benevole-actions">
                                    <a href="{{ path('benevole_edit', {'id': benevole.id}) }}" class="btn btn-small btn-primary">Modifier</a>
                                    <a href="#" class="btn btn-small btn-secondary">Planning</a>
                                    <button type="button" 
                                            class="btn btn-small btn-danger" 
                                            data-benevole-id="{{ benevole.id }}"
                                            data-benevole-nom="{{ benevole.utilisateur.prenom }} {{ benevole.utilisateur.nom }}"
                                            data-csrf-token="{{ csrf_token('delete_benevole_' ~ benevole.id) }}"
                                            onclick="confirmDelete(this)">🗑️</button>
                                </div>
                                {% endif %}
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="empty-state">
                        <div class="empty-icon">👥</div>
                        <h3>Aucun bénévole trouvé</h3>
                        <p>Commencez par ajouter des bénévoles à votre base de données.</p>
                        {% if is_granted('ROLE_ADMIN') %}
                        <a href="#" class="btn btn-primary">Ajouter un bénévole</a>
                        {% endif %}
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
    
    <!-- Planning des créneaux -->
    <div id="content-planning" class="tab-content main-content" style="display: none;">
        <div class="card main-card">
            <div class="card-header">
                <h2 class="card-title">Planning des Créneaux</h2>
                <p class="card-description">Planification pour les vendredis, samedis et dimanches</p>
            </div>
            <div class="card-content">
                <div class="row" style="display: flex; gap: 20px;">
                    <div style="flex: 2;">
                        <div class="card">
                            <div class="card-header">
                                <h5 class="card-title">Calendrier des créneaux (Week-end seulement)</h5>
                            </div>
                            <div class="card-content">
                                <div style="margin-bottom: 1em;">
                                    <button class="btn btn-outline-primary" id="btn-month" onclick="changeCalendarView('dayGridMonth')">Mois</button>
                                    <button class="btn btn-outline-primary" id="btn-week" onclick="changeCalendarView('timeGridWeek')">Semaine</button>
                                </div>
                                <div id="calendar"></div>
                            </div>
                        </div>
                    </div>
                    
                    <div style="flex: 1;">
                        <div class="card">
                            <div class="card-header">
                                <h5 class="card-title">Créneaux à venir</h5>
                            </div>
                            <div class="card-content">
                                {% if creneaux_proches is defined and creneaux_proches is not empty %}
                                    {% for creneau in creneaux_proches %}
                                        <div class="card" style="margin-bottom: 10px; padding: 10px; border: 1px solid #ddd;">
                                            <h6>{{ creneau.titre }}</h6>
                                            <p style="font-size: 0.9em; margin: 5px 0;">
                                                📅 {{ creneau.debut|date('d/m/Y H:i') }}
                                                {% if creneau.posteRequis %}
                                                    <br>💼 {{ creneau.posteRequis }}
                                                {% endif %}
                                            </p>
                                        </div>
                                    {% endfor %}
                                {% else %}
                                    <div style="text-align: center; padding: 20px; color: #666;">
                                        ℹ️ Aucun créneau planifié.
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
</div>

<script>
// Variable globale pour le calendrier
window.calendarInstance = null;

// Fonction de chargement de FullCalendar
function loadFullCalendarScript() {
    return new Promise((resolve, reject) => {
        // Vérifier si FullCalendar est déjà chargé
        if (typeof FullCalendar !== 'undefined') {
            console.log('FullCalendar déjà disponible');
            resolve();
            return;
        }
        
        const script = document.createElement('script');
        script.src = 'https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.js';
        console.log('Chargement de FullCalendar depuis CDN:', script.src);
        
        script.onload = function() {
            console.log('Script FullCalendar chargé');
            // Attendre un peu que la variable soit disponible
            setTimeout(() => {
                console.log('Vérification de la disponibilité de FullCalendar...');
                console.log('window.FullCalendar:', typeof window.FullCalendar);
                console.log('FullCalendar:', typeof FullCalendar);
                console.log('Objets disponibles dans window:', Object.keys(window).filter(key => key.toLowerCase().includes('calendar')));
                
                if (typeof FullCalendar !== 'undefined') {
                    console.log('FullCalendar disponible !');
                    resolve();
                } else if (typeof window.FullCalendar !== 'undefined') {
                    console.log('FullCalendar disponible via window.FullCalendar');
                    window.FullCalendar = window.FullCalendar;
                    resolve();
                } else {
                    console.error('FullCalendar non trouvé après chargement');
                    reject(new Error('FullCalendar non disponible après chargement'));
                }
            }, 100);
        };
        
        script.onerror = function(error) {
            console.error('Échec du chargement de FullCalendar:', error);
            reject(new Error('Impossible de charger FullCalendar'));
        };
        
        document.head.appendChild(script);
    });
}

// Fonction pour initialiser le calendrier
function initializeCalendar(viewType = 'dayGridMonth') {
    console.log('Tentative d\'initialisation du calendrier...');
    const calendarEl = document.getElementById('calendar');
    if (!calendarEl) {
        console.error('Element #calendar non trouvé dans le DOM');
        return;
    }
    if (typeof FullCalendar === 'undefined') {
        loadFullCalendarScript().then(() => {
            setTimeout(() => {
                initializeCalendar(viewType);
            }, 100);
        }).catch(error => {
            loadFullCalendarAlternative();
        });
        return;
    }
    // Détruire l'instance existante si elle existe
    if (window.calendarInstance) {
        window.calendarInstance.destroy();
        window.calendarInstance = null;
    }
    const events = {{ creneaux|json_encode|raw }};
    try {
        window.calendarInstance = new FullCalendar.Calendar(calendarEl, {
            initialView: viewType,
            locale: 'fr',
            height: 'auto',
            hiddenDays: [1, 2, 3, 4], // Masquer lundi(1), mardi(2), mercredi(3), jeudi(4) - garder vendredi(5), samedi(6), dimanche(0)
            headerToolbar: {
                left: 'prev,next today',
                center: 'title',
                right: ''
            },
            buttonText: {
                today: 'Aujourd\'hui',
                month: 'Mois',
                week: 'Semaine',
                day: 'Jour',
            },
            events: events,
            eventClick: function(info) {
                const event = info.event;
                const props = event.extendedProps;
                let details = 'Titre: ' + event.title + '\n';
                details += 'Début: ' + event.start.toLocaleString() + '\n';
                details += 'Fin: ' + event.end.toLocaleString() + '\n';
                if (props.evenement) details += 'Événement: ' + props.evenement + '\n';
                if (props.poste_requis) details += 'Poste: ' + props.poste_requis + '\n';
                if (props.max_personnes) details += 'Max personnes: ' + props.max_personnes + '\n';
                if (props.notes) details += 'Notes: ' + props.notes + '\n';
                alert(details);
            },
            eventDisplay: 'block',
            nowIndicator: true,
            slotMinTime: '07:00:00',
            slotMaxTime: '22:00:00',
            allDaySlot: false,
            firstDay: 1 // Commencer la semaine le lundi
        });
        window.calendarInstance.render();
    } catch (error) {
        loadFullCalendarAlternative();
    }
}

// Fonction pour changer la vue du calendrier
function changeCalendarView(viewType) {
    if (window.calendarInstance) {
        window.calendarInstance.changeView(viewType);
    } else {
        initializeCalendar(viewType);
    }
    // Mettre à jour le style des boutons
    document.getElementById('btn-month').classList.toggle('active', viewType === 'dayGridMonth');
    document.getElementById('btn-week').classList.toggle('active', viewType === 'timeGridWeek');
}

// Fonction de chargement alternatif
function loadFullCalendarAlternative() {
    console.log('Tentative de chargement alternatif de FullCalendar...');
    const calendarEl = document.getElementById('calendar');
    if (calendarEl) {
        calendarEl.innerHTML = '<div style="text-align: center; padding: 20px; color: #666;">' +
            '<p>⚠️ Impossible de charger le calendrier</p>' +
            '<p>Vérifiez votre connexion internet</p>' +
            '</div>';
    }
}

function showTab(tabName) {
    console.log('Changing to tab:', tabName);
    
    // Masquer tous les contenus
    document.querySelectorAll('.tab-content').forEach(content => {
        content.style.display = 'none';
    });
    
    // Désactiver tous les onglets
    document.querySelectorAll('.tab').forEach(tab => {
        tab.classList.remove('selected');
    });
    
    // Afficher le contenu sélectionné
    const contentEl = document.getElementById('content-' + tabName);
    if (contentEl) {
        contentEl.style.display = 'block';
        console.log('Contenu affiché pour:', tabName);
    } else {
        console.error('Contenu non trouvé pour:', tabName);
    }
    
    // Activer l'onglet sélectionné
    const tabEl = document.getElementById('tab-' + tabName);
    if (tabEl) {
        tabEl.classList.add('selected');
    }
    
    // Initialiser le calendrier si c'est l'onglet planning
    if (tabName === 'planning') {
        console.log('Onglet planning activé, initialisation du calendrier...');
        
        // Attendre un délai pour que l'élément soit visible
        setTimeout(() => {
            initializeCalendar();
        }, 200);
    }
}

// Initialiser avec l'onglet bénévoles actif
document.addEventListener('DOMContentLoaded', function() {
    console.log('DOM Content Loaded');
    
    // Activer l'onglet bénévoles par défaut
    document.getElementById('tab-benevoles').classList.add('selected');
});

// Fonction de confirmation de suppression
function confirmDelete(button) {
    const benevoleId = button.getAttribute('data-benevole-id');
    const benevoleNom = button.getAttribute('data-benevole-nom');
    const csrfToken = button.getAttribute('data-csrf-token');
    
    if (confirm(`Êtes-vous sûr de vouloir supprimer le bénévole "${benevoleNom}" ?\n\nCette action est irréversible et supprimera toutes les données associées.`)) {
        // Créer un formulaire pour la suppression
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = `/benevoles/${benevoleId}/delete`;
        
        // Ajouter le token CSRF
        const csrfInput = document.createElement('input');
        csrfInput.type = 'hidden';
        csrfInput.name = '_token';
        csrfInput.value = csrfToken;
        form.appendChild(csrfInput);
        
        // Ajouter le formulaire au body et le soumettre
        document.body.appendChild(form);
        form.submit();
    }
}
</script>
{% endblock %}
