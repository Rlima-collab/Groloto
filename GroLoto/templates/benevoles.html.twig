{% extends 'base.html.twig' %}
{% block title %}Gestion des Bénévoles{% endblock %}
{% block stylesheets %}
{{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/modele.css') }}">
    <link rel="stylesheet" href="{{ asset('css/benevoles/benevoles-common.css') }}">
    <link rel="stylesheet" href="{{ asset('css/benevoles/benevoles-list.css') }}">
    <link rel="stylesheet" href="{{ asset('css/mecenes.css') }}">
    <link rel="stylesheet" href="{{ asset('css/search.css') }}">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
{% endblock %}

{% block body %}
<div class="hero-section benevoles-hero">
    <div class="shine"></div>
    <div class="hero-content">
        <h1 class="hero-title">Gestion des Bénévoles</h1>
        <p class="hero-description">Inscriptions, disponibilités et planning pour vos événements caritatifs.</p>
        <a href="#liste-benevoles" class="btn-login">Voir les bénévoles</a>
    </div>
</div>

<br>

<div class="metrics-grid">
    <div class="metric-card">
        <h3>Total bénévoles</h3>
        <p class="metric-value">{{ metriques.total }}</p>
        <p class="metric-detail">Bénévoles actifs</p>
    </div>
    <div class="metric-card">
        <h3>Nouveaux ce mois</h3>
        <p class="metric-value">{{ metriques.nouveaux }}</p>
        <p class="metric-detail">Inscriptions récentes</p>
    </div>
    <div class="metric-card">
        <h3>Disponibles</h3>
        <p class="metric-value">{{ metriques.disponibles }}</p>
        <p class="metric-detail">Prêts à aider</p>
    </div>
</div>

<div class="container">
    <div class="card main-card" id="liste-benevoles">
        <div class="card-header">
            <h2 class="card-title">Liste des Bénévoles</h2>
            <p class="card-description">Gestion des bénévoles inscrits</p>
            {% if is_granted('ROLE_ADMIN') %}
            <div class="header-actions">
                <a href="{{ path('benevoles_export_csv') }}" class="btn btn-primary" title="Exporter la liste complète en CSV">
                    <i class="bi bi-file-earmark-spreadsheet"></i> Export CSV
                </a>
                <a href="{{ path('benevoles_export_pdf') }}" class="btn btn-primary" title="Exporter la liste complète en PDF">
                    <i class="bi bi-file-earmark-pdf"></i> Export PDF
                </a>
            </div>
            {% endif %}
        </div>

        <!-- Barre de recherche et filtres -->
        <div class="search-filter-section">
            <form method="GET" id="filtersForm">
                <div class="search-bar-container">
                    <input type="text" id="searchInput" name="search" class="search-input" placeholder="Rechercher par nom, prénom, email..." value="{{ app.request.query.get('search') }}">
                </div>
                
                <div class="filters-container">
                    <div class="filter-group">
                        <label for="sortBy" class="filter-label">Trier par :</label>
                        <select id="sortBy" name="sort" class="filter-select" onchange="document.getElementById('filtersForm').submit()">
                            <option value="date-desc" {% if app.request.query.get('sort') == 'date-desc' or not app.request.query.get('sort') %}selected{% endif %}>Date (Plus récent)</option>
                            <option value="date-asc" {% if app.request.query.get('sort') == 'date-asc' %}selected{% endif %}>Date (Plus ancien)</option>
                            <option value="nom-asc" {% if app.request.query.get('sort') == 'nom-asc' %}selected{% endif %}>Nom (A-Z)</option>
                            <option value="nom-desc" {% if app.request.query.get('sort') == 'nom-desc' %}selected{% endif %}>Nom (Z-A)</option>
                            <option value="prenom-asc" {% if app.request.query.get('sort') == 'prenom-asc' %}selected{% endif %}>Prénom (A-Z)</option>
                            <option value="prenom-desc" {% if app.request.query.get('sort') == 'prenom-desc' %}selected{% endif %}>Prénom (Z-A)</option>
                        </select>
                    </div>

                    <div class="filter-group">
                        <label for="itemsPerPage" class="filter-label">Afficher :</label>
                        <select id="itemsPerPage" name="per_page" class="filter-select" onchange="document.getElementById('filtersForm').submit()">
                            <option value="10" {% if app.request.query.get('per_page') == '10' or not app.request.query.get('per_page') %}selected{% endif %}>10 par page</option>
                            <option value="20" {% if app.request.query.get('per_page') == '20' %}selected{% endif %}>20 par page</option>
                            <option value="50" {% if app.request.query.get('per_page') == '50' %}selected{% endif %}>50 par page</option>
                            <option value="all" {% if app.request.query.get('per_page') == 'all' %}selected{% endif %}>Tous</option>
                        </select>
                    </div>

                    <div class="filter-group">
                        <button type="button" id="resetFilters" class="btn-reset-filters" onclick="resetFilters()">Réinitialiser</button>
                    </div>
                </div>
            </form>

            <div id="resultsCount" class="results-count">
                Affichage de <span id="countCurrent">{{ benevoles|length }}</span> bénévole(s)
            </div>
        </div>

        <div class="card-content">
            {% if benevoles|length > 0 %}
                <div class="benevoles-grid" id="benevolesGrid">
                    {% for item in benevoles %}
                        {% set benevole = item.benevole %}
                        <div class="benevole-card" 
                             data-nom="{{ benevole.utilisateur.nom|lower }}" 
                             data-prenom="{{ benevole.utilisateur.prenom|lower }}" 
                             data-email="{{ benevole.utilisateur.email|lower }}">
                            <div class="benevole-header">
                                <h3 class="benevole-name">
                                    {{ benevole.utilisateur.prenom }} {{ benevole.utilisateur.nom }}
                                </h3>
                                <span class="badge status success">Actif</span>
                            </div>
                            <div class="benevole-info">
                                <div class="info-item">
                                    <span class="info-icon">✉️</span>
                                    <span class="info-text">{{ benevole.utilisateur.email }}</span>
                                </div>
                                {% if benevole.utilisateur.telephone %}
                                <div class="info-item">
                                    <span class="info-icon">📞</span>
                                    <span class="info-text">{{ benevole.utilisateur.telephone }}</span>
                                </div>
                                {% endif %}
                                <div class="info-item">
                                    <span class="info-icon"></span>
                                    <span class="info-text">Inscrit le {{ benevole.utilisateur.dateCreation|date('d/m/Y') }}</span>
                                </div>
                                <div class="info-item">
                                    <span class="info-icon"><i class="bi bi-check-circle-fill" style="color: #10b981;"></i></span>
                                    <span class="info-text"><strong>{{ item.nb_taches_realisees }}</strong> tâche{% if item.nb_taches_realisees > 1 %}s{% endif %} réalisée{% if item.nb_taches_realisees > 1 %}s{% endif %}</span>
                                </div>
                                {# Disponibilités (résumé) #}
                                {% set dmap = {'lundi':'Lun.','mardi':'Mar.','mercredi':'Mer.','jeudi':'Jeu.','vendredi':'Ven.','samedi':'Sam.','dimanche':'Dim.'} %}
                                {% set smap = {'matin':'Matin','pm':'Après-midi','soir':'Soir'} %}
                                {% set dispos = benevole.disponibilites %}
                                <div class="info-item">
                                    <span class="info-icon">🗓️</span>
                                    <span class="info-text">
                                        {% if dispos %}
                                            {% set labels = [] %}
                                            {% for v in dispos %}
                                                {% set parts = v|split('_') %}
                                                {% if parts|length == 2 %}
                                                    {% set labels = labels|merge([ (dmap[parts[0]]|default(parts[0]|capitalize)) ~ ' ' ~ (smap[parts[1]]|default(parts[1])) ]) %}
                                                {% endif %}
                                            {% endfor %}
                                            {{ labels|slice(0,6)|join(', ') }}{% if labels|length > 6 %}…{% endif %}
                                        {% else %}
                                            Aucune dispo renseignée
                                        {% endif %}
                                    </span>
                                </div>
                            </div>
                            {% if benevole.remarque %}
                            <div class="benevole-notes">
                                <strong>Notes:</strong> {{ benevole.remarque|slice(0, 50) }}{% if benevole.remarque|length > 50 %}...{% endif %}
                            </div>
                            {% endif %}
                            {% if is_granted('ROLE_ADMIN') %}
                            <div class="benevole-actions">
                                <a href="{{ path('benevole_edit', {'id': benevole.id}) }}" class="btn btn-small btn-primary">Modifier</a>
                                <a href="{{ path('benevole_planning', {'id': benevole.id}) }}" class="btn btn-small btn-secondary">Voir planning</a>
                                <button type="button"
                                        class="btn btn-small btn-danger"
                                        data-benevole-id="{{ benevole.id }}"
                                        data-benevole-nom="{{ benevole.utilisateur.prenom }} {{ benevole.utilisateur.nom }}"
                                        data-csrf-token="{{ csrf_token('delete_benevole_' ~ benevole.id) }}"
                                        onclick="confirmDelete(this)">Supprimer</button>
                            </div>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <div class="empty-state">
                    <div class="empty-icon"></div>
                    <h3>Aucun bénévole trouvé</h3>
                    <p>Commencez par ajouter des bénévoles à votre base de données.</p>
                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="#" class="btn btn-primary">Ajouter un bénévole</a>
                    {% endif %}
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
function confirmDelete(button) {
    const benevoleId = button.getAttribute('data-benevole-id');
    const benevoleNom = button.getAttribute('data-benevole-nom');
    const csrfToken = button.getAttribute('data-csrf-token');
    if (confirm(`Êtes-vous sûr de vouloir supprimer le bénévole "${benevoleNom}" ?\n\nCette action est irréversible et supprimera toutes les données associées.`)) {
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = `/benevoles/${benevoleId}/delete`;
        const csrfInput = document.createElement('input');
        csrfInput.type = 'hidden';
        csrfInput.name = '_token';
        csrfInput.value = csrfToken;
        form.appendChild(csrfInput);
        document.body.appendChild(form);
        form.submit();
    }
}

// === FILTRES ET RECHERCHE (même logique que mécènes) ===
document.addEventListener('DOMContentLoaded', function () {
    const searchInput = document.getElementById('searchInput');
    const sortSelect = document.getElementById('sortBy');
    const itemsPerPageSelect = document.getElementById('itemsPerPage');
    const resetBtn = document.getElementById('resetFilters');
    const grid = document.getElementById('benevolesGrid');
    const cards = grid ? Array.from(grid.querySelectorAll('.benevole-card')) : [];
    const countCurrent = document.getElementById('countCurrent');

    if (!grid) return;

    // Fonction de filtrage
    function filterBenevoles() {
        const query = searchInput ? searchInput.value.trim().toLowerCase() : '';

        let visibleCount = 0;
        cards.forEach(card => {
            const nom = card.getAttribute('data-nom') || '';
            const prenom = card.getAttribute('data-prenom') || '';
            const email = card.getAttribute('data-email') || '';

            const match = nom.includes(query) || prenom.includes(query) || email.includes(query);
            card.style.display = match ? '' : 'none';
            if (match) visibleCount++;
        });

        // Mise à jour du compteur
        if (countCurrent) {
            countCurrent.textContent = visibleCount;
        }

        // Afficher un message si aucun résultat
        let noResult = grid.querySelector('.no-result');
        if (!noResult && visibleCount === 0 && query !== '') {
            noResult = document.createElement('div');
            noResult.className = 'no-result';
            noResult.innerHTML = `<p style="text-align:center; color:#6b7280; padding:2rem; grid-column:1/-1;">Aucun bénévole trouvé pour "<strong>${query}</strong>"</p>`;
            grid.appendChild(noResult);
        } else if (noResult && visibleCount > 0) {
            noResult.remove();
        } else if (noResult && query === '') {
            noResult.remove();
        }
    }

    // Recherche en temps réel
    if (searchInput) {
        searchInput.addEventListener('input', filterBenevoles);
    }

    // Bouton réinitialiser - Remet tous les filtres par défaut (comme mécènes)
    if (resetBtn) {
        resetBtn.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            
            // Réinitialiser les champs
            if (searchInput) searchInput.value = '';
            if (sortSelect) sortSelect.value = 'date-desc';
            if (itemsPerPageSelect) itemsPerPageSelect.value = '10';
            
            // Réafficher toutes les cartes
            cards.forEach(card => card.style.display = '');
            
            // Mettre à jour le compteur
            if (countCurrent) countCurrent.textContent = cards.length;
            
            // Supprimer le message "aucun résultat"
            const noResult = grid.querySelector('.no-result');
            if (noResult) noResult.remove();
        });
    }
});

// Fonction globale de secours
function resetFilters() {
    const searchInput = document.getElementById('searchInput');
    const sortSelect = document.getElementById('sortBy');
    const itemsPerPageSelect = document.getElementById('itemsPerPage');
    const grid = document.getElementById('benevolesGrid');
    const countCurrent = document.getElementById('countCurrent');
    
    if (searchInput) searchInput.value = '';
    if (sortSelect) sortSelect.value = 'date-desc';
    if (itemsPerPageSelect) itemsPerPageSelect.value = '10';
    
    if (grid) {
        const cards = grid.querySelectorAll('.benevole-card');
        cards.forEach(card => card.style.display = '');
        if (countCurrent) countCurrent.textContent = cards.length;
        
        const noResult = grid.querySelector('.no-result');
        if (noResult) noResult.remove();
    }
}
</script>
{% endblock %}