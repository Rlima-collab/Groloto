{% extends 'base.html.twig' %}

{% block title %}Gestion des Événements{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="{{ asset('css/modele.css') }}" rel="stylesheet">
    <link href="{{ asset('css/festival/festival-common.css') }}" rel="stylesheet">
    <link href="{{ asset('css/festival/festival-list.css') }}" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.css" rel="stylesheet">
{% endblock %}

{% block body %}
<div class="hero-section weekend-hero">
    <div class="shine"></div>
    <div class="hero-content">
        <h1 class="hero-title">
            {% if is_granted('IS_AUTHENTICATED_REMEMBERED') %}
                Gestion des Événements
            {% else %}
                Voir les Événements
            {% endif %}
        </h1>
        <p class="hero-description">Organisez et planifiez vos événements caritatifs avec efficacité.</p>
        <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
            {% if isAdmin %}
                <a href="{{ path('app_evenements_create') }}" class="btn-login">Créer un Événement</a>
            {% endif %}
            <a href="{{ path('app_evenements_liste') }}" class="btn-login" style="background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);">
                <svg style="width: 20px; height: 20px; display: inline-block; vertical-align: middle; margin-right: 0.5rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"/>
                </svg>
                Liste complète
            </a>
        </div>
    </div>
</div>

<br>

<div class="metrics-grid">
    <div class="metric-card">
        <h3>Total Événements</h3>
        <p class="metric-value">{{ metriques.total }}</p>
        <p class="metric-detail">Tous les événements</p>
    </div>
    <div class="metric-card">
        <h3>Événements Futurs</h3>
        <p class="metric-value">{{ metriques.futurs }}</p>
        <p class="metric-detail">À venir</p>
    </div>
    <div class="metric-card">
        <h3>Événements Passés</h3>
        <p class="metric-value">{{ metriques.passes }}</p>
        <p class="metric-detail">Terminés</p>
    </div>
    <div class="metric-card">
        <h3>Ce mois-ci</h3>
        <p class="metric-value">{{ evenements_ce_mois }}</p>
        <p class="metric-detail">Événements planifiés</p>
    </div>
</div>

<div class="dashboard-grid">
    <div class="card">
        <div class="card-header">
            <h5 class="card-title">Calendrier des Événements</h5>
        </div>
        <div class="card-content">
            <div style="margin-bottom: 1rem; text-align: center;">
                <button class="btn-outline-night-blue active" id="btn-month">Mois</button>
                <button class="btn-outline-night-blue" id="btn-week">Semaine</button>
            </div>
            <div id="calendar"></div>
        </div>
    </div>
    
    <div class="card">
        <div class="card-header">
            <h5 class="card-title">Prochains Événements</h5>
        </div>
        <div class="card-content">
            <div class="events-list">
                {% if evenements_futurs|length > 0 %}
                    {% for evenement in evenements_futurs|slice(0, 20) %}
                        <div class="event-item blue-night-accent animate-fade-in">
                            <div class="event-date">
                                <div class="event-month">{{ evenement.dateDebut|date('M')|upper }}</div>
                                <div class="event-day">{{ evenement.dateDebut|date('d') }}</div>
                            </div>
                            <div class="event-details">
                                <h4 class="event-title">{{ evenement.nom }}</h4>
                                <p class="event-time">{{ evenement.dateDebut|date('H\\hi') }} - {{ evenement.lieu }}</p>
                            </div>
                            {% if isAdmin %}
                                <div class="event-actions" style="margin-left: auto;">
                                    <a href="{{ path('app_evenement_edit', {id: evenement.id}) }}" class="btn-edit" title="Modifier">
                                        <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                        </svg>
                                    </a>
                                </div>
                            {% endif %}
                        </div>
                    {% endfor %}
                {% else %}
                    <p style="text-align: center; color: #64748b; padding: 2rem;">Aucun événement à venir.</p>
                {% endif %}
            </div>
        </div>
    </div>
</div>

<div class="full-width-container">
    <div class="card history-card">
        <div class="card-header">
            <h3 class="card-title">Historique des Événements</h3>
        </div>
        <div class="card-content">
            <div class="history-list">
                {% if evenements_passes|length > 0 %}
                    {% for evenement in evenements_passes|slice(0, 10) %}
                        <div class="history-item blue-night-accent">
                            <div class="history-date">
                                <div class="history-day">{{ evenement.dateDebut|date('d') }}</div>
                                <div class="history-month">{{ evenement.dateDebut|date('M')|upper }}</div>
                            </div>
                            <div class="history-details">
                                <h4 class="history-title">{{ evenement.nom }} - Terminé</h4>
                                <p class="history-description">
                                    {{ evenement.description|default('Événement organisé avec succès')|slice(0, 80) }}{{ evenement.description|length > 80 ? '...' }}
                                </p>
                                <p class="history-meta">
                                    Événement du {{ evenement.dateDebut|date('d/m/Y') }}
                                    {% if evenement.lieu %} - {{ evenement.lieu }}{% endif %}
                                </p>
                            </div>
                            {% if isAdmin %}
                                <div class="history-actions" style="margin-left: auto;">
                                    <a href="{{ path('app_evenement_edit', {id: evenement.id}) }}" class="btn-edit" title="Modifier">
                                        <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                        </svg>
                                    </a>
                                </div>
                            {% endif %}
                        </div>
                    {% endfor %}
                {% else %}
                    <p style="text-align: center; color: #64748b; padding: 2rem;">Aucun événement dans l'historique.</p>
                {% endif %}
            </div>
        </div>
    </div>
</div>

<!-- Modal d'événement (détails + actions) -->
<div id="event-modal" style="display:none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 9999; align-items: center; justify-content: center;">
    <div style="background:#fff; border-radius:12px; width:min(520px, 92vw); box-shadow:0 20px 60px rgba(0,0,0,.3); overflow:hidden;">
        <div style="padding:1rem 1.25rem; border-bottom:1px solid #e5e7eb; display:flex; align-items:center; justify-content:space-between;">
            <h3 id="em-title" style="margin:0; font-size:1.1rem; color:#0d1b2a; font-weight:700;">Événement</h3>
            <button id="em-close" aria-label="Fermer" style="background:transparent; border:none; font-size:1.25rem; cursor:pointer; color:#6b7280;">×</button>
        </div>
        <div style="padding:1rem 1.25rem;">
            <div id="em-dates" style="color:#1f2937; font-weight:600; margin-bottom:0.5rem;"></div>
            <div id="em-lieu" style="color:#4b5563; margin-bottom:0.5rem;"></div>
            <div id="em-desc" style="color:#6b7280; font-size:0.95rem; line-height:1.5;"></div>
        </div>
        <div id="em-actions" style="padding:0.9rem 1.25rem; border-top:1px solid #e5e7eb; display:flex; gap:0.5rem; justify-content:flex-end;">
            <!-- Actions injectées dynamiquement -->
        </div>
    </div>
 </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        window.calendarEvents = {{ taches|raw }};
    </script>

    <script>
        window.calendarInstance = null;

        const loadFullCalendar = () => {
            return new Promise((resolve, reject) => {
                if (typeof FullCalendar !== 'undefined') return resolve();
                const script = document.createElement('script');
                script.src = 'https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.js';
                script.onload = () => setTimeout(resolve, 100);
                script.onerror = reject;
                document.head.appendChild(script);
            });
        };

        const initCalendar = (view = 'dayGridMonth') => {
            const el = document.getElementById('calendar');
            if (!el) return;

            if (typeof FullCalendar === 'undefined') {
                loadFullCalendar().then(() => setTimeout(() => initCalendar(view), 100));
                return;
            }

            if (window.calendarInstance) window.calendarInstance.destroy();

            const events = window.calendarEvents || [];

            window.calendarInstance = new FullCalendar.Calendar(el, {
                initialView: view,
                locale: 'fr',
                height: 'auto',
                headerToolbar: { left: 'prev,next today', center: 'title', right: '' },
                buttonText: { today: 'Aujourd\'hui', month: 'Mois', week: 'Semaine' },
                weekends: true,
                firstDay: 1,
                events: events,
                eventClick: info => {
                    const e = info.event;
                    const p = e.extendedProps || {};
                    const isEvt = p.entity === 'evenement';

                    // Remplir le contenu
                    const modal = document.getElementById('event-modal');
                    const titleEl = document.getElementById('em-title');
                    const datesEl = document.getElementById('em-dates');
                    const lieuEl = document.getElementById('em-lieu');
                    const descEl = document.getElementById('em-desc');
                    const actionsEl = document.getElementById('em-actions');

                    titleEl.textContent = e.title || (isEvt ? 'Événement' : 'Tâche');
                    const startTxt = e.start ? e.start.toLocaleString() : '';
                    const endTxt = e.end ? (' — ' + e.end.toLocaleString()) : '';
                    datesEl.textContent = `${startTxt}${endTxt}`;

                    lieuEl.textContent = p.lieu ? `Lieu : ${p.lieu}` : '';
                    descEl.textContent = p.description ? String(p.description).slice(0, 400) : '';

                    // Actions
                    actionsEl.innerHTML = '';
                    if (isEvt && p.isAdmin) {
                        // Modifier
                        if (p.editUrl) {
                            const a = document.createElement('a');
                            a.href = p.editUrl;
                            a.textContent = 'Modifier';
                            a.className = 'btn-login';
                            a.style.background = '#0d1b2a';
                            actionsEl.appendChild(a);
                        }
                        // Supprimer (POST + CSRF)
                        if (p.deleteUrl && p.csrfToken) {
                            const form = document.createElement('form');
                            form.method = 'post';
                            form.action = p.deleteUrl;
                            form.onsubmit = () => confirm('Supprimer cet événement ? Cette action est définitive.');
                            const input = document.createElement('input');
                            input.type = 'hidden';
                            input.name = '_token';
                            input.value = p.csrfToken;
                            form.appendChild(input);
                            const btn = document.createElement('button');
                            btn.type = 'submit';
                            btn.textContent = 'Supprimer';
                            btn.className = 'btn-login';
                            btn.style.background = 'linear-gradient(135deg, #fca5a5 0%, #ef4444 100%)';
                            form.appendChild(btn);
                            actionsEl.appendChild(form);
                        }
                    }

                    modal.style.display = 'flex';
                },
                nowIndicator: true,
                slotMinTime: '07:00:00',
                slotMaxTime: '22:00:00',
                allDaySlot: false
            });
            window.calendarInstance.render();
        };

        const changeView = view => {
            if (window.calendarInstance) window.calendarInstance.changeView(view);
            document.getElementById('btn-month').classList.toggle('active', view === 'dayGridMonth');
            document.getElementById('btn-week').classList.toggle('active', view === 'timeGridWeek');
        };

        document.addEventListener('DOMContentLoaded', () => {
            document.getElementById('btn-month')?.addEventListener('click', () => changeView('dayGridMonth'));
            document.getElementById('btn-week')?.addEventListener('click', () => changeView('timeGridWeek'));
            setTimeout(() => initCalendar(), 200);

            // Modal wiring
            const modal = document.getElementById('event-modal');
            const closeBtn = document.getElementById('em-close');
            closeBtn?.addEventListener('click', () => modal.style.display = 'none');
            modal?.addEventListener('click', (e) => { if (e.target === modal) modal.style.display = 'none'; });
        });
    </script>
{% endblock %}
