{% extends 'base.html.twig' %}

{% block title %}Gestion des Événements{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="{{ asset('css/dashboard.css') }}" rel="stylesheet">
    <link href="{{ asset('css/evenements.css') }}" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.css" rel="stylesheet">
{% endblock %}

{% block body %}
<div class="hero-section">
    <div class="shine"></div>
    <div class="hero-content">
        <h1 class="hero-title">Gestion des Événements</h1>
        <p class="hero-description">Organisez et planifiez vos événements caritatifs avec efficacité.</p>
        <a href="{% if isAdmin %}{{ path('app_evenements_create') }}{% else %}#calendar{% endif %}" class="hero-btn yellow">{% if isAdmin %}Créer un événement{% else %}Voir le planning{% endif %}</a>
    </div>
</div>

<div class="page-header">
    <h1 class="page-title">Planning des Événements</h1>
</div>

<div class="metrics-grid">
    <div class="card metric-card yellow-border">
        <div class="card-header">
            <span class="metric-title">Total Événements</span>
            <span class="icon yellow">📊</span>
        </div>
        <div class="card-content">
            <div class="metric-value">{{ total_evenements }}</div>
            <p class="metric-change positive">Tous les événements</p>
        </div>
    </div>
    <div class="card metric-card green-border">
        <div class="card-header">
            <span class="metric-title">Événements Futurs</span>
            <span class="icon green">🔮</span>
        </div>
        <div class="card-content">
            <div class="metric-value">{{ evenements_futurs|length }}</div>
            <p class="metric-change positive">À venir</p>
        </div>
    </div>
    <div class="card metric-card blue-border">
        <div class="card-header">
            <span class="metric-title">Événements Passés</span>
            <span class="icon blue">📚</span>
        </div>
        <div class="card-content">
            <div class="metric-value">{{ evenements_passes|length }}</div>
            <p class="metric-change warning">Terminés</p>
        </div>
    </div>
    <div class="card metric-card yellow-border">
        <div class="card-header">
            <span class="metric-title">Ce mois-ci</span>
            <span class="icon yellow">📅</span>
        </div>
        <div class="card-content">
            <div class="metric-value">{{ evenements_ce_mois|default(0) }}</div>
            <p class="metric-change positive">Événements planifiés</p>
        </div>
    </div>
        </div>
    </div>
</div>

<div class="row" style="display: flex; gap: 20px; margin: 0 20px;">
    <div style="flex: 2;">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title">📅 Calendrier des événements (Week-end seulement)</h5>
            </div>
            <div class="card-content">
                <div style="margin-bottom: 1rem; text-align: center;">
                    <button class="btn btn-outline-primary active" id="btn-month">Mois</button>
                    <button class="btn btn-outline-primary" id="btn-week">Semaine</button>
                </div>
                <div id="calendar"></div>
            </div>
        </div>
    </div>
    
    <div style="flex: 1;">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title">🔮 Prochains Événements</h5>
            </div>
                        <div class="card-content">
                            <div class="events-list">
                                {% if evenements_futurs|length > 0 %}
                                    {% for evenement in evenements_futurs|slice(0, 5) %}
                                        <div class="event-item {{ loop.index0 % 3 == 0 ? 'yellow-accent' : loop.index0 % 3 == 1 ? 'green-accent' : 'blue-accent' }}">
                                            <div class="event-date">
                                                <div class="event-month">{{ evenement.dateDebut|date('M')|upper }}</div>
                                                <div class="event-day">{{ evenement.dateDebut|date('d') }}</div>
                                            </div>
                                            <div class="event-details">
                                                <h4 class="event-title">{{ evenement.nom }}</h4>
                                                <p class="event-time">{{ evenement.dateDebut|date('H\\hi') }} - {{ evenement.lieu }}</p>
                                            </div>
                                        </div>
                                    {% endfor %}
                                {% else %}
                                    <p>Aucun événement à venir.</p>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>

<div class="full-width-container">
    <div class="card history-card">
        <div class="card-header">
            <h3 class="card-title">🕒 Historique des Événements</h3>
        </div>
        <div class="card-content">
            <div class="history-list">
                {% if evenements_passes|length > 0 %}
                    {% for evenement in evenements_passes|slice(0, 5) %}
                        <div class="history-item {{ loop.index0 % 3 == 0 ? 'yellow-accent' : loop.index0 % 3 == 1 ? 'green-accent' : 'blue-accent' }}">
                            <div class="history-date">
                                <div class="history-day">{{ evenement.dateDebut|date('d') }}</div>
                                <div class="history-month">{{ evenement.dateDebut|date('M')|upper }}</div>
                            </div>
                            <div class="history-details">
                                <h4 class="history-title">{{ evenement.nom }} - Terminé</h4>
                                <p class="history-description">
                                    {% if evenement.description %}
                                        {{ evenement.description|slice(0, 80) }}{% if evenement.description|length > 80 %}...{% endif %}
                                    {% else %}
                                        Événement organisé avec succès
                                    {% endif %}
                                </p>
                                <p class="history-meta">
                                    Événement du {{ evenement.dateDebut|date('d/m/Y') }}
                                    {% if evenement.lieu %} - {{ evenement.lieu }}{% endif %}
                                </p>
                            </div>
                        </div>
                    {% endfor %}
                {% else %}
                    <p style="text-align: center; color: #6b7280; padding: 2rem;">Aucun événement dans l'historique.</p>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
// Variables globales
window.calendarInstance = null;

// Fonction de chargement de FullCalendar
window.loadFullCalendarScript = function() {
    return new Promise((resolve, reject) => {
        // Vérifier si FullCalendar est déjà chargé
        if (typeof FullCalendar !== 'undefined') {
            console.log('FullCalendar déjà disponible');
            resolve();
            return;
        }
        
        const script = document.createElement('script');
        script.src = 'https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.js';
        console.log('Chargement de FullCalendar depuis CDN:', script.src);
        
        script.onload = function() {
            console.log('Script FullCalendar chargé');
            // Attendre un peu que la variable soit disponible
            setTimeout(() => {
                console.log('Vérification de la disponibilité de FullCalendar...');
                console.log('window.FullCalendar:', typeof window.FullCalendar);
                console.log('FullCalendar:', typeof FullCalendar);
                
                if (typeof FullCalendar !== 'undefined') {
                    console.log('FullCalendar disponible !');
                    resolve();
                } else if (typeof window.FullCalendar !== 'undefined') {
                    console.log('FullCalendar disponible via window.FullCalendar');
                    window.FullCalendar = window.FullCalendar;
                    resolve();
                } else {
                    console.error('FullCalendar non trouvé après chargement');
                    reject(new Error('FullCalendar non disponible après chargement'));
                }
            }, 100);
        };
        
        script.onerror = function(error) {
            console.error('Échec du chargement de FullCalendar:', error);
            reject(new Error('Impossible de charger FullCalendar'));
        };
        
        document.head.appendChild(script);
    });
};

// Fonction pour initialiser le calendrier
window.initializeCalendar = function(viewType = 'dayGridMonth') {
    console.log('Tentative d\'initialisation du calendrier...');
    const calendarEl = document.getElementById('calendar');
    if (!calendarEl) {
        console.error('Element #calendar non trouvé dans le DOM');
        return;
    }
    
    if (typeof FullCalendar === 'undefined') {
        window.loadFullCalendarScript().then(() => {
            setTimeout(() => {
                window.initializeCalendar(viewType);
            }, 100);
        }).catch(error => {
            window.loadFullCalendarAlternative();
        });
        return;
    }
    
    // Détruire l'instance existante si elle existe
    if (window.calendarInstance) {
        window.calendarInstance.destroy();
        window.calendarInstance = null;
    }
    
    const events = {{ taches|raw }};
    console.log('📊 Données événements chargées:', events);
    console.log('📈 Nombre d\'éléments:', events.length);
    
    try {
        window.calendarInstance = new FullCalendar.Calendar(calendarEl, {
            initialView: viewType,
            locale: 'fr',
            height: 'auto',
            headerToolbar: {
                left: 'prev,next today',
                center: 'title',
                right: ''
            },
            buttonText: {
                today: 'Aujourd\'hui',
                month: 'Mois',
                week: 'Semaine',
                day: 'Jour',
            },
            // Afficher seulement vendredi, samedi et dimanche
            hiddenDays: [1, 2, 3, 4], // Cacher lundi (1), mardi (2), mercredi (3), jeudi (4)
            weekends: true, // S'assurer que les weekends sont affichés
            firstDay: 5, // Commencer la semaine par vendredi (5)
            events: events,
            eventClick: function(info) {
                const event = info.event;
                const props = event.extendedProps;
                let details = 'Titre: ' + event.title + '\n';
                details += 'Début: ' + event.start.toLocaleString() + '\n';
                if (event.end) details += 'Fin: ' + event.end.toLocaleString() + '\n';
                
                if (props.type === 'evenement') {
                    if (props.description) details += 'Description: ' + props.description + '\n';
                    if (props.lieu) details += 'Lieu: ' + props.lieu + '\n';
                } else if (props.type === 'tache') {
                    if (props.evenement) details += 'Événement: ' + props.evenement + '\n';
                    if (props.poste_requis) details += 'Poste: ' + props.poste_requis + '\n';
                    if (props.max_personnes) details += 'Max personnes: ' + props.max_personnes + '\n';
                    if (props.notes) details += 'Notes: ' + props.notes + '\n';
                }
                
                alert(details);
            },
            eventDisplay: 'block',
            nowIndicator: true,
            slotMinTime: '07:00:00',
            slotMaxTime: '22:00:00',
            allDaySlot: false,
            firstDay: 1 // Commencer la semaine le lundi
        });
        
        window.calendarInstance.render();
        console.log('✅ Calendrier rendu avec succès !');
    } catch (error) {
        console.error('💥 Erreur lors de la création du calendrier:', error);
        window.loadFullCalendarAlternative();
    }
};

// Fonction pour changer la vue du calendrier
window.changeCalendarView = function(viewType) {
    console.log('🔄 Changement de vue vers:', viewType);
    if (window.calendarInstance) {
        window.calendarInstance.changeView(viewType);
    } else {
        window.initializeCalendar(viewType);
    }
    // Mettre à jour le style des boutons
    document.getElementById('btn-month').classList.toggle('active', viewType === 'dayGridMonth');
    document.getElementById('btn-week').classList.toggle('active', viewType === 'timeGridWeek');
};

// Fonction de chargement alternatif
window.loadFullCalendarAlternative = function() {
    console.log('Tentative de chargement alternatif de FullCalendar...');
    const calendarEl = document.getElementById('calendar');
    if (calendarEl) {
        calendarEl.innerHTML = '<div style="text-align: center; padding: 20px; color: #666;">' +
            '<p>⚠️ Impossible de charger le calendrier</p>' +
            '<p>Vérifiez votre connexion internet</p>' +
            '</div>';
    }
};

// Initialisation au chargement de la page
document.addEventListener('DOMContentLoaded', function() {
    console.log('🚀 DOM Content Loaded - Initialisation du planning des événements...');
    
    // Ajouter les event listeners pour les boutons
    const btnMonth = document.getElementById('btn-month');
    const btnWeek = document.getElementById('btn-week');
    
    if (btnMonth) {
        btnMonth.addEventListener('click', function() {
            console.log('Clic sur bouton Mois');
            window.changeCalendarView('dayGridMonth');
        });
    }
    
    if (btnWeek) {
        btnWeek.addEventListener('click', function() {
            console.log('Clic sur bouton Semaine');
            window.changeCalendarView('timeGridWeek');
        });
    }
    
    // Attendre un délai pour que l'élément soit visible
    setTimeout(() => {
        window.initializeCalendar();
    }, 200);
});
    </script>
{% endblock %}