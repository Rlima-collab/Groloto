{% extends 'base.html.twig' %}

{% block title %}Gestion des Événements{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="{{ asset('css/evenements.css') }}" rel="stylesheet">
    {# FullCalendar CSS local pour éviter les erreurs MIME du CDN #}
    <link href="{{ asset('css/fullcalendar-fix.css') }}" rel="stylesheet">
{% endblock %}

{% block body %}
<div class="hero-section">
    <div class="shine"></div>
    <div class="hero-content">
        <h1 class="hero-title">Gestion des Événements</h1>
        <p class="hero-description">Organisez et planifiez vos événements caritatifs avec efficacité.</p>
        <a href="#calendar" class="hero-btn yellow">Voir le planning</a>
    </div>
</div>

<div class="page-header">
    <h1 class="page-title">Planning des Événements</h1>
</div>

<div class="metrics-grid">
    <div class="card metric-card yellow-border">
        <div class="card-header">
            <span class="metric-title">Total Événements</span>
            <span class="icon yellow">📊</span>
        </div>
        <div class="card-content">
            <div class="metric-value">{{ total_evenements }}</div>
            <p class="metric-change positive">Tous les événements</p>
        </div>
    </div>
    <div class="card metric-card green-border">
        <div class="card-header">
            <span class="metric-title">Événements Futurs</span>
            <span class="icon green">🔮</span>
        </div>
        <div class="card-content">
            <div class="metric-value">{{ evenements_futurs|length }}</div>
            <p class="metric-change positive">À venir</p>
        </div>
    </div>
    <div class="card metric-card blue-border">
        <div class="card-header">
            <span class="metric-title">Événements Passés</span>
            <span class="icon blue">📚</span>
        </div>
        <div class="card-content">
            <div class="metric-value">{{ evenements_passes|length }}</div>
            <p class="metric-change warning">Terminés</p>
        </div>
    </div>
    <div class="card metric-card yellow-border">
        <div class="card-header">
            <span class="metric-title">Ce mois-ci</span>
            <span class="icon yellow">📅</span>
        </div>
        <div class="card-content">
            <div class="metric-value">{{ evenements_ce_mois|default(0) }}</div>
            <p class="metric-change positive">Événements planifiés</p>
        </div>
    </div>
</div>

<div class="dashboard-grid">
    <div class="card">
        <div class="card-header">
            <h5 class="card-title">📅 Calendrier des événements (Week-end seulement)</h5>
        </div>
        <div class="card-content">
            <div style="margin-bottom: 1rem; text-align: center;">
                <button class="btn btn-outline-primary active" id="btn-month">Mois</button>
                <button class="btn btn-outline-primary" id="btn-week">Semaine</button>
            </div>
            <div id="calendar"></div>
        </div>
    </div>
    
    <div class="card">
        <div class="card-header">
            <h5 class="card-title">🔮 Prochains Événements</h5>
        </div>
        <div class="card-content">
            <div class="events-list">
                {% if evenements_futurs|length > 0 %}
                    {% for evenement in evenements_futurs|slice(0, 20) %}
                        <div class="event-item {{ loop.index0 % 3 == 0 ? 'yellow-accent' : loop.index0 % 3 == 1 ? 'green-accent' : 'blue-accent' }}">
                            <div class="event-date">
                                <div class="event-month">{{ evenement.dateDebut|date('M')|upper }}</div>
                                <div class="event-day">{{ evenement.dateDebut|date('d') }}</div>
                            </div>
                            <div class="event-details">
                                <h4 class="event-title">{{ evenement.nom }}</h4>
                                <p class="event-time">{{ evenement.dateDebut|date('H\\hi') }} - {{ evenement.lieu }}</p>
                            </div>
                        </div>
                    {% endfor %}
                {% else %}
                    <p>Aucun événement à venir.</p>
                {% endif %}
            </div>
        </div>
    </div>
</div>

<div class="full-width-container">
    <div class="card history-card">
        <div class="card-header">
            <h3 class="card-title">🕒 Historique des Événements</h3>
        </div>
        <div class="card-content">
            <div class="history-list">
                {% if evenements_passes|length > 0 %}
                    {% for evenement in evenements_passes|slice(0, 5) %}
                        <div class="history-item {{ loop.index0 % 3 == 0 ? 'yellow-accent' : loop.index0 % 3 == 1 ? 'green-accent' : 'blue-accent' }}">
                            <div class="history-date">
                                <div class="history-day">{{ evenement.dateDebut|date('d') }}</div>
                                <div class="history-month">{{ evenement.dateDebut|date('M')|upper }}</div>
                            </div>
                            <div class="history-details">
                                <h4 class="history-title">{{ evenement.nom }} - Terminé</h4>
                                <p class="history-description">
                                    {% if evenement.description %}
                                        {{ evenement.description|slice(0, 80) }}{% if evenement.description|length > 80 %}...{% endif %}
                                    {% else %}
                                        Événement organisé avec succès
                                    {% endif %}
                                </p>
                                <p class="history-meta">
                                    Événement du {{ evenement.dateDebut|date('d/m/Y') }}
                                    {% if evenement.lieu %} - {{ evenement.lieu }}{% endif %}
                                </p>
                            </div>
                        </div>
                    {% endfor %}
                {% else %}
                    <p style="text-align: center; color: #6b7280; padding: 2rem;">Aucun événement dans l'historique.</p>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {# Passer les données du serveur au JavaScript via une variable globale #}
    <script>
        window.calendarEvents = {{ creneaux|default('[]')|raw }};
    </script>
    
    
    <script>
    // Utiliser un namespace global pour éviter les conflits Turbo
    window.GroLotoCalendar = window.GroLotoCalendar || {
        instance: null,
        initialized: false,
        
        // Fonction de chargement de FullCalendar
        loadScript: function() {
            return new Promise((resolve, reject) => {
                // Vérifier si FullCalendar est déjà chargé
                if (typeof FullCalendar !== 'undefined') {
                    console.log('FullCalendar déjà disponible');
                    resolve();
                    return;
                }
                
                // Vérifier si le script n'est pas déjà en cours de chargement
                if (document.querySelector('script[src*="fullcalendar"]')) {
                    console.log('Script FullCalendar déjà en cours de chargement');
                    // Attendre que le script soit chargé
                    let attempts = 0;
                    const checkInterval = setInterval(() => {
                        attempts++;
                        if (typeof FullCalendar !== 'undefined') {
                            clearInterval(checkInterval);
                            console.log('FullCalendar maintenant disponible');
                            resolve();
                        } else if (attempts > 20) {
                            clearInterval(checkInterval);
                            reject(new Error('Timeout en attendant FullCalendar'));
                        }
                    }, 250);
                    return;
                }
                
                const script = document.createElement('script');
                // Charger FullCalendar depuis un fichier local (évite CDN/MIME issues)
                script.src = '{{ asset('js/fullcalendar/index.global.min.js') }}';
                console.log('Chargement de FullCalendar depuis asset local:', script.src);
                
                script.onload = function() {
                    console.log('Script FullCalendar chargé');
                    // Attendre un peu que la variable soit disponible
                    setTimeout(() => {
                        console.log('Vérification de la disponibilité de FullCalendar...');
                        console.log('window.FullCalendar:', typeof window.FullCalendar);
                        console.log('FullCalendar:', typeof FullCalendar);
                        
                        if (typeof FullCalendar !== 'undefined') {
                            console.log('FullCalendar disponible !');
                            resolve();
                        } else if (typeof window.FullCalendar !== 'undefined') {
                            console.log('FullCalendar disponible via window.FullCalendar');
                            window.FullCalendar = window.FullCalendar;
                            resolve();
                        } else {
                            console.error('FullCalendar non trouvé après chargement');
                            reject(new Error('FullCalendar non disponible après chargement'));
                        }
                    }, 100);
                };
                
                script.onerror = function(error) {
                    console.error('Échec du chargement de FullCalendar:', error);
                    reject(new Error('Impossible de charger FullCalendar'));
                };
                
                document.head.appendChild(script);
            });
        },
        
        // Fonction pour initialiser le calendrier
        init: function() {
            const calendarEl = document.getElementById('calendar');
            if (!calendarEl) {
                console.error('Élément calendar non trouvé');
                return;
            }
            
            // Détruire l'instance précédente si elle existe
            if (this.instance) {
                try {
                    this.instance.destroy();
                } catch(e) {
                    console.log('Erreur lors de la destruction du calendrier précédent:', e);
                }
            }
            
            const eventsData = window.calendarEvents || [];
            console.log('Initialisation du calendrier avec', eventsData.length, 'événements');
            
            // Afficher un message de chargement
            calendarEl.innerHTML = '';
            
            this.instance = new FullCalendar.Calendar(calendarEl, {
                initialView: 'dayGridMonth',
                locale: 'fr',
                height: 'auto',
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: '' // On retire les boutons par défaut car on utilise nos boutons personnalisés
                },
                buttonText: {
                    today: 'Aujourd\'hui'
                },
                // Week-end uniquement : vendredi, samedi, dimanche
                hiddenDays: [1, 2, 3, 4],
                weekends: true,
                firstDay: 5,
                events: eventsData,
                eventClick: function(info) {
                    const event = info.event;
                    let details = `📅 ${event.title}\\n`;
                    details += `📍 ${event.start.toLocaleDateString('fr-FR')}\\n`;
                    if (event.end) {
                        details += `⏰ Fin: ${event.end.toLocaleDateString('fr-FR')}\\n`;
                    }
                    if (event.extendedProps.description) {
                        details += `📝 ${event.extendedProps.description}\\n`;
                    }
                    if (event.extendedProps.lieu) {
                        details += `🏢 ${event.extendedProps.lieu}`;
                    }
                    alert(details);
                },
                eventDidMount: function(info) {
                    info.el.style.borderRadius = '4px';
                    info.el.style.border = 'none';
                }
            });
            
            this.instance.render();
            console.log('Calendrier rendu avec succès');
            
            // Connecter les boutons personnalisés aux fonctions FullCalendar
            this.setupButtons();
        },
        
        // Fonction pour configurer les boutons
        setupButtons: function() {
            const btnMonth = document.getElementById('btn-month');
            const btnWeek = document.getElementById('btn-week');
            
            if (btnMonth) {
                btnMonth.onclick = () => {
                    if (this.instance) {
                        this.instance.changeView('dayGridMonth');
                        btnMonth.classList.add('active');
                        if (btnWeek) btnWeek.classList.remove('active');
                    }
                };
            }
            
            if (btnWeek) {
                btnWeek.onclick = () => {
                    if (this.instance) {
                        this.instance.changeView('timeGridWeek');
                        btnWeek.classList.add('active');
                        if (btnMonth) btnMonth.classList.remove('active');
                    }
                };
            }
        },
        
        // Fonction principale d'initialisation
        start: function() {
            if (this.initialized) {
                console.log('Calendrier déjà initialisé, réinitialisation...');
                this.init();
                return;
            }
            
            console.log('DOM chargé, démarrage de l\'initialisation du calendrier');
            this.initialized = true;
            
            this.loadScript()
                .then(() => {
                    console.log('FullCalendar chargé avec succès, initialisation du calendrier...');
                    this.init();
                })
                .catch((error) => {
                    console.error('Erreur lors du chargement de FullCalendar:', error);
                    this.initialized = false;
                    const calendarEl = document.getElementById('calendar');
                    if (calendarEl) {
                        calendarEl.innerHTML = `
                            <div style="padding:20px;text-align:center;border:2px solid #dc3545;border-radius:8px;background:#f8d7da;color:#721c24;">
                                <h5>❌ Erreur de chargement</h5>
                                <p>Impossible de charger FullCalendar: ${error.message}</p>
                                <button onclick="location.reload()" style="margin-top:10px;padding:5px 10px;background:#dc3545;color:white;border:none;border-radius:4px;cursor:pointer;">
                                    Recharger la page
                                </button>
                            </div>
                        `;
                    }
                });
        }
    };

    // Initialisation compatible avec Turbo
    document.addEventListener('DOMContentLoaded', function() {
        window.GroLotoCalendar.start();
    });

    // Réinitialisation lors des navigations Turbo
    document.addEventListener('turbo:load', function() {
        if (document.getElementById('calendar')) {
            console.log('Navigation Turbo détectée, réinitialisation du calendrier');
            window.GroLotoCalendar.start();
        }
    });

    // Nettoyage lors des navigations Turbo
    document.addEventListener('turbo:before-render', function() {
        if (window.GroLotoCalendar.instance) {
            try {
                window.GroLotoCalendar.instance.destroy();
                console.log('Calendrier détruit avant navigation Turbo');
            } catch(e) {
                console.log('Erreur lors de la destruction du calendrier:', e);
            }
        }
    });
    </script>
{% endblock %}