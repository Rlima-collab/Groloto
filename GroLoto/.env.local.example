# .env.local - Configuration locale pour le développement
# Copiez ce fichier en .env.local et adaptez les valeurs

###> Symfony Framework ###
APP_ENV=dev
APP_DEBUG=true
APP_SECRET=YourSecureRandomSecretKeyHere

# Asset Base Path - local development (root)
ASSET_BASE_PATH=/

# Application URL - local development
APP_URL=http://localhost:8000/
###< Symfony Framework ###

###> Database ###
# SQLite (local development - default)
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"

# PostgreSQL (if using Docker)
# DATABASE_URL="pgsql://postgres:password@db:5432/groloto?serverVersion=15&charset=utf8"
###< Database ###

###> Mailer ###
CONTACT_EMAIL=your-email@example.com
MAILER_DSN=smtp://username:password@smtp.mailtrap.io:2525?encryption=tls&auth_mode=login
###< Mailer ###
