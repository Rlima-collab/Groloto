# .env.local.hostinger - Configuration pour Hostinger
# Utilisez ce fichier sur votre serveur Hostinger

###> Symfony Framework ###
APP_ENV=prod
APP_DEBUG=false
APP_SECRET=YourSecureRandomSecretKeyHere

# Asset Base Path - Point to root if deployed at domain root
# If deployed in subdirectory like /groloto/, use: ASSET_BASE_PATH=/groloto/
ASSET_BASE_PATH=/

# Application URL - Adjust to your domain
APP_URL=https://votredomaine.com/
###< Symfony Framework ###

###> Database ###
# PostgreSQL (recommended for Hostinger)
DATABASE_URL="pgsql://user:password@localhost:5432/database_name?serverVersion=15&charset=utf8"

# Use SQLite only for testing (not recommended for production)
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"
###< Database ###

###> Mailer ###
CONTACT_EMAIL=contact@votredomaine.com
MAILER_DSN=smtp://username:password@smtp.mailtrap.io:2525?encryption=tls&auth_mode=login
###< Mailer ###
